<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alderTheme="using:Alder.Avalonia.Themes"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:alder="using:Alder.Avalonia.Controls"
             x:Class="Alder.Avalonia.Gallery.App"
             RequestedThemeVariant="Light"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels" xmlns:converters="using:Avalonia.Data.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <StreamGeometry x:Key="GalleryIconGitHub">M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.49c-2.23.49-2.7-.94-2.7-.94-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.22 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.65-.89-3.65-3.96 0-.88.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.08-1.87 3.75-3.66 3.95.29.25.55.74.55 1.49v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z</StreamGeometry>
      <!-- Simple Icons payment marks. -->
      <StreamGeometry x:Key="GalleryIconMastercard">F1 M11.343 18.031c.058.049.12.098.181.146-1.177.783-2.59 1.238-4.107 1.238C3.32 19.416 0 16.096 0 12c0-4.095 3.32-7.416 7.416-7.416 1.518 0 2.931.456 4.105 1.238-.06.051-.12.098-.165.15C9.6 7.489 8.595 9.688 8.595 12c0 2.311 1.001 4.51 2.748 6.031zm5.241-13.447c-1.52 0-2.931.456-4.105 1.238.06.051.12.098.165.15C14.4 7.489 15.405 9.688 15.405 12c0 2.31-1.001 4.507-2.748 6.031-.058.049-.12.098-.181.146 1.177.783 2.588 1.238 4.107 1.238C20.68 19.416 24 16.096 24 12c0-4.094-3.32-7.416-7.416-7.416zM12 6.174c-.096.075-.189.15-.28.231C10.156 7.764 9.169 9.765 9.169 12c0 2.236.987 4.236 2.551 5.595.09.08.185.158.28.232.096-.074.189-.152.28-.232 1.563-1.359 2.551-3.359 2.551-5.595 0-2.235-.987-4.236-2.551-5.595-.09-.08-.184-.156-.28-.231z</StreamGeometry>
      <StreamGeometry x:Key="GalleryIconVisa">F1 M9.112 8.262L5.97 15.758H3.92L2.374 9.775c-.094-.368-.175-.503-.461-.658C1.447 8.864.677 8.627 0 8.479l.046-.217h3.3a.904.904 0 01.894.764l.817 4.338 2.018-5.102zm8.033 5.049c.008-1.979-2.736-2.088-2.717-2.972.006-.269.262-.555.822-.628a3.66 3.66 0 011.913.336l.34-1.59a5.207 5.207 0 00-1.814-.333c-1.917 0-3.266 1.02-3.278 2.479-.012 1.079.963 1.68 1.698 2.04.756.367 1.01.603 1.006.931-.005.504-.602.725-1.16.734-.975.015-1.54-.263-1.992-.473l-.351 1.642c.453.208 1.289.39 2.156.398 2.037 0 3.37-1.006 3.377-2.564m5.061 2.447H24l-1.565-7.496h-1.656a.883.883 0 00-.826.55l-2.909 6.946h2.036l.405-1.12h2.488zm-2.163-2.656l1.02-2.815.588 2.815zm-8.16-4.84l-1.603 7.496H8.34l1.605-7.496z</StreamGeometry>
      <StreamGeometry x:Key="GalleryIconPayPal">F1 M15.607 4.653H8.941L6.645 19.251H1.82L4.862 0h7.995c3.754 0 6.375 2.294 6.473 5.513-.648-.478-2.105-.86-3.722-.86m6.57 5.546c0 3.41-3.01 6.853-6.958 6.853h-2.493L11.595 24H6.74l1.845-11.538h3.592c4.208 0 7.346-3.634 7.153-6.949a5.24 5.24 0 0 1 2.848 4.686M9.653 5.546h6.408c.907 0 1.942.222 2.363.541-.195 2.741-2.655 5.483-6.441 5.483H8.714Z</StreamGeometry>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Views/NavigationPreviewResources.axaml" />
        <ResourceInclude Source="/Views/GalleryNavigationIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="AiModelRow" x:DataType="vm:AiModelChoice">
        <Grid ColumnDefinitions="18,*,Auto,Auto" ColumnSpacing="5" Background="Transparent"
              alder:AlderToolTip.Placement="Left" alder:AlderToolTip.Offset="22" alder:AlderToolTip.ShowDelay="320" alder:AlderToolTip.SurfaceCornerRadius="14">
          <alder:AlderImage Width="16" Height="16" Source="{CompiledBinding Image}" />
          <alder:AlderTextBlock Grid.Column="1" Text="{CompiledBinding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="2" VerticalAlignment="Center" Background="{DynamicResource GalleryCodeSelection}" CornerRadius="12" Padding="6,1" IsVisible="{CompiledBinding Badge, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
            <alder:AlderTextBlock Text="{CompiledBinding Badge}" FontSize="12" Foreground="{DynamicResource AlderAccent}" />
          </Border>
          <alder:AlderTextBlock Grid.Column="3" VerticalAlignment="Center" Text="{CompiledBinding Price}" FontSize="12"
                                Foreground="{DynamicResource AlderMuted}" IsVisible="{CompiledBinding Price, Converter={x:Static converters:ObjectConverters.IsNotNull}}" />
          <alder:AlderToolTip.Tip>
            <StackPanel Width="162" Spacing="5">
              <alder:AlderTextBlock Text="{CompiledBinding Text}" FontWeight="SemiBold" />
              <alder:AlderTextBlock Text="{CompiledBinding Description}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
              <Border Height="1" Background="{DynamicResource AlderSeparator}" Margin="0,4" IsVisible="{CompiledBinding Intelligence, Converter={x:Static converters:ObjectConverters.IsNotNull}}" />
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" IsVisible="{CompiledBinding Intelligence, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                <alder:AlderTextBlock Text="{DynamicResource GalleryText.AiModelReasoningScore}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderTextBlock Grid.Column="1" Text="{CompiledBinding Intelligence}" FontSize="12" />
                <alder:AlderTextBlock Grid.Row="1" Text="{DynamicResource GalleryText.AiModelSpeed}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderTextBlock Grid.Row="1" Grid.Column="1" Text="{CompiledBinding Speed}" FontSize="12" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{CompiledBinding ContextWindow, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                <alder:AlderTextBlock Text="{CompiledBinding ContextWindow}" FontSize="12" />
                <alder:AlderTextBlock Text="{DynamicResource GalleryText.AiModelContext}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
              </StackPanel>
            </StackPanel>
          </alder:AlderToolTip.Tip>
        </Grid>
      </DataTemplate>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="GalleryPreviewSurface" Color="#F5F5F5" />
          <SolidColorBrush x:Key="GalleryCodeSurface" Color="#EDEDEE" />
          <SolidColorBrush x:Key="GalleryMuted" Color="#62626A" />
          <SolidColorBrush x:Key="GalleryCodeInk" Color="#52525B" />
          <SolidColorBrush x:Key="GallerySelectedTab" Color="#FFFFFF" />
          <SolidColorBrush x:Key="GalleryCodeSelection" Color="#330485F7" />
          <SolidColorBrush x:Key="GalleryToolbarCustomBorder" Color="#CCDDDEE0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="GalleryPreviewSurface" Color="#060607" />
          <SolidColorBrush x:Key="GalleryCodeSurface" Color="#17171A" />
          <SolidColorBrush x:Key="GalleryMuted" Color="#A1A1AA" />
          <SolidColorBrush x:Key="GalleryCodeInk" Color="#A1A1AA" />
          <SolidColorBrush x:Key="GallerySelectedTab" Color="#27272A" />
          <SolidColorBrush x:Key="GalleryCodeSelection" Color="#4D61A8FB" />
          <SolidColorBrush x:Key="GalleryToolbarCustomBorder" Color="#CC28282C" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes><ColorPaletteResources x:Key="Light" Accent="#0485F7" /></FluentTheme.Palettes>
    </FluentTheme>
    <alderTheme:AlderTheme />
    <mi:MaterialIconStyles />
    <Style Selector=":is(NumericUpDown)">
      <Setter Property="NumberFormat" Value="{DynamicResource GalleryNumberFormat}" />
    </Style>
    <Style Selector="alder|AlderButton /template/ :is(TemplatedControl)#LeadingIcon PathIcon.alder-icon-vector, alder|AlderButtonGroup PathIcon,
                     alder|AlderToggleButton PathIcon, alder|AlderToolbar PathIcon">
      <Setter Property="Theme" Value="{StaticResource AlderIcon16Theme}" />
    </Style>
    <Style Selector="StackPanel.showcase">
      <Setter Property="MaxWidth" Value="620" /><Setter Property="Margin" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.sampleSurface">
      <Setter Property="MaxWidth" Value="438" /><Setter Property="Margin" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlderBorder}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AlderSurface}" />
    </Style>
    <Style Selector="TextBlock.setting">
      <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="{x:Null}" /><Setter Property="OffContent" Value="{x:Null}" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
  </Application.Styles>
</Application>
