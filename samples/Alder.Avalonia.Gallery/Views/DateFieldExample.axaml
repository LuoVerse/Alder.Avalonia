    <gallery:ExampleCard x:Name="SampleInvalid" Title="{DynamicResource GalleryText.TemporalInvalid}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:DateFieldViewModel /></Border.DataContext>
          <StackPanel MaxWidth="256" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="InvalidLabel" Content="{DynamicResource GalleryText.Date}" Target="{CompiledBinding #InvalidField}" />
            <alder:AlderDateField x:Name="InvalidField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #InvalidLabel}" IsInvalid="True" />
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.TemporalDateError}" FontSize="12" Foreground="{DynamicResource AlderDangerInk}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new DateFieldViewModel();
        var field = new AlderDateField { DataContext = model, FullWidth = true, IsInvalid = true };
        field[!AlderDateField.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Date");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 256, Spacing = 4, Children = { label, field } };
        var detail = new AlderTextBlock { FontSize = 12, TextWrapping = TextWrapping.Wrap };
        detail[!TextBlock.TextProperty] = new DynamicResourceExtension("GalleryText.TemporalDateError");
        detail[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderDangerInk");
        preview.Children.Add(detail);
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleValidationForm" Title="{DynamicResource GalleryText.Controlled}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="4">
          <alder:AlderLabel x:Name="StartLabel" Content="{DynamicResource GalleryText.StartDate}" Target="{Binding #StartDate}" />
          <alder:AlderDateField x:Name="StartDate" Culture="{DynamicResource GalleryCulture}" IsRequired="True" Value="{Binding Date, Mode=TwoWay}"
                           Minimum="{Binding Minimum}" AutomationProperties.LabeledBy="{Binding #StartLabel}">
            <alder:AlderDateField.Prefix><alder:AlderPathIcon Width="16" Height="16" Data="{StaticResource AlderIconCalendar}" Foreground="{DynamicResource AlderMuted}" /></alder:AlderDateField.Prefix>
          </alder:AlderDateField>
          <alder:AlderTextBlock Foreground="{DynamicResource AlderMuted}" Text="{Binding Summary}" />
          <alder:AlderTextBlock Foreground="{DynamicResource AlderDangerInk}" Text="{DynamicResource GalleryText.EnterADateOnOrAfterNovember12026}"
                     TextWrapping="Wrap" MaxWidth="240" IsVisible="{Binding #StartDate.HasInvalidInput}" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <alder:AlderButton Content="{DynamicResource GalleryText.ClearDate}" Command="{CompiledBinding Clear}" Variant="Ghost" Size="Small" HorizontalAlignment="Left" />
            <alder:AlderButton Content="{DynamicResource GalleryText.Reset}" Command="{CompiledBinding Reset}" Variant="Secondary" Size="Small" />
          </WrapPanel>
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var dateField = new AlderDateField
        {
            Culture = CultureInfo.CurrentCulture,
            IsRequired = true,
            Prefix = new AlderPathIcon { Height = 16, Data = (Geometry)this.FindResource("AlderIconCalendar")!, Foreground = (IBrush)this.FindResource("AlderMuted")! },
        };
        dateField.Bind(AlderDateField.ValueProperty, CompiledBinding.Create((DateFieldViewModel model) => model.Date, mode: BindingMode.TwoWay));
        dateField.Bind(AlderDateField.MinimumProperty, CompiledBinding.Create((DateFieldViewModel model) => model.Minimum));

        var model = (DateFieldViewModel)DataContext!;
        var clear = new AlderButton { Content = "Clear date", Size = AlderSize.Small, Variant = ButtonVariant.Ghost };
        var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary };
        clear.Click += (_, _) => model.Clear();
        reset.Click += (_, _) => model.Reset();
        var actions = new WrapPanel { ItemSpacing = 8, LineSpacing = 8, Children = { clear, reset } };
        var preview = new StackPanel { Spacing = 4, Children = { dateField, actions } };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleGermanDateFormat" Title="{DynamicResource GalleryText.GermanDateFormat}">
      <gallery:ExampleCard.Preview>
        <Border Padding="12" CornerRadius="16" Background="{DynamicResource AlderSurface}">
          <StackPanel Spacing="4">
            <alder:AlderLabel x:Name="LocaleLabel" Content="{DynamicResource GalleryText.GermanDateFormat}" Target="{Binding #LocalizedDate}" />
            <alder:AlderDateField x:Name="LocalizedDate" Culture="{Binding GermanCulture}" Variant="Secondary" Value="{Binding Example, Mode=OneWay}"
                             FullWidth="True" AutomationProperties.LabeledBy="{Binding #LocaleLabel}" />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var dateField = new AlderDateField { Variant = InputVariant.Secondary, FullWidth = true };
        dateField.Bind(AlderDateField.CultureProperty, CompiledBinding.Create((DateFieldViewModel model) => model.GermanCulture));
        dateField.Bind(AlderDateField.ValueProperty, CompiledBinding.Create((DateFieldViewModel model) => model.Example, mode: BindingMode.OneWay));
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleReadOnly" Title="{DynamicResource GalleryText.ReadOnly}">
      <gallery:ExampleCard.Preview>
        <alder:AlderDateField Culture="{DynamicResource GalleryCulture}" IsReadOnly="True" Value="{Binding Example, Mode=OneWay}" AutomationProperties.Name="{DynamicResource GalleryText.ReadOnlyDate}" />
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var dateField = new AlderDateField { Culture = CultureInfo.CurrentCulture, IsReadOnly = true };
        dateField.Bind(AlderDateField.ValueProperty, CompiledBinding.Create((DateFieldViewModel model) => model.Example, mode: BindingMode.OneWay));
        AutomationProperties.SetName(dateField, "Read-only date");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleDisabled" Title="{DynamicResource GalleryText.Disabled}">
      <gallery:ExampleCard.Preview>
        <alder:AlderDateField Culture="{DynamicResource GalleryCulture}" IsEnabled="False" AutomationProperties.Name="{DynamicResource GalleryText.DisabledDate}" />
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var dateField = new AlderDateField { Culture = CultureInfo.CurrentCulture, IsEnabled = false };
        AutomationProperties.SetName(dateField, "Disabled date");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
  </gallery:GalleryExampleList>
</UserControl>
