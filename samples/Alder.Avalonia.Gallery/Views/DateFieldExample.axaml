    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleDescription" Title="{DynamicResource GalleryText.TemporalWithDescription}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:DateFieldViewModel /></Border.DataContext>
          <StackPanel MaxWidth="256" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="DescriptionLabel" Content="{DynamicResource GalleryText.Date}" Target="{CompiledBinding #DescriptionField}" />
            <alder:AlderDateField x:Name="DescriptionField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #DescriptionLabel}"  />
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.TemporalPreferredDate}" FontSize="12" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new DateFieldViewModel();
        var field = new AlderDateField { DataContext = model, FullWidth = true };
        field[!AlderDateField.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Date");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 256, Spacing = 4, Children = { label, field } };
        var detail = new AlderTextBlock { FontSize = 12, TextWrapping = TextWrapping.Wrap };
        detail[!TextBlock.TextProperty] = new DynamicResourceExtension("GalleryText.TemporalPreferredDate");
        detail[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        preview.Children.Add(detail);
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleRequired" Title="{DynamicResource GalleryText.AutocompleteRequired}">
