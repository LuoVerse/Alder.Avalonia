<UserControl xmlns:gallery="using:Alder.Avalonia.Gallery.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.DateFieldExample" x:DataType="vm:DateFieldViewModel" FontFamily="fonts:Inter#Inter">
  <Design.DataContext>
    <vm:DateFieldViewModel />
  </Design.DataContext>
  <UserControl.Styles><Style Selector=":is(Label)"><Setter Property="Theme" Value="{StaticResource AlderLabelTheme}" /></Style></UserControl.Styles>
  <gallery:GalleryExampleList>
    <gallery:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:DateFieldViewModel /></Border.DataContext>
          <StackPanel MaxWidth="256" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="UsageLabel" Content="{DynamicResource GalleryText.Date}" Target="{CompiledBinding #UsageField}" />
            <alder:AlderDateField x:Name="UsageField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #UsageLabel}"  />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new DateFieldViewModel();
        var field = new AlderDateField { DataContext = model, FullWidth = true };
        field[!AlderDateField.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Date");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 256, Spacing = 4, Children = { label, field } };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SamplePrefix" Title="{DynamicResource GalleryText.TemporalWithPrefix}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:DateFieldViewModel /></Border.DataContext>
          <StackPanel MaxWidth="256" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="PrefixLabel" Content="{DynamicResource GalleryText.Date}" Target="{CompiledBinding #PrefixField}" />
            <alder:AlderDateField x:Name="PrefixField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #PrefixLabel}" >
              <alder:AlderDateField.Prefix>
                <alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconCalendar}" Foreground="{DynamicResource AlderMuted}" />
              </alder:AlderDateField.Prefix>
            </alder:AlderDateField>
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new DateFieldViewModel();
        var field = new AlderDateField { DataContext = model, FullWidth = true };
        field[!AlderDateField.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Date");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 256, Spacing = 4, Children = { label, field } };
        var prefix = new AlderPathIcon { Width = 16, Height = 16 };
        prefix[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCalendar");
        prefix[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        field.Prefix = prefix;
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
