    <g:ExampleCard x:Name="SampleGroupNotifications" Title="{DynamicResource GalleryText.ProDemoItemCardGroupNotifications}">
      <g:ExampleCard.Preview>
        <Border MaxWidth="506" Padding="2,10" HorizontalAlignment="Stretch">
          <alder:AlderItemCardGroup>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayNotify}" Description="{DynamicResource GalleryText.ProDisplayNotifyHint}">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
              <alder:AlderItemCard.Action>
                <alder:AlderSwitch IsChecked="{CompiledBinding Notifications, Mode=TwoWay}" />
              </alder:AlderItemCard.Action>
            </alder:AlderItemCard>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayNews}" Description="{DynamicResource GalleryText.ProDisplayNewsHint}">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
              <alder:AlderItemCard.Action>
                <alder:AlderSwitch IsChecked="{CompiledBinding ProductNews, Mode=TwoWay}" />
              </alder:AlderItemCard.Action>
            </alder:AlderItemCard>
          </alder:AlderItemCardGroup>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderItemCardGroup();
        group.Items.Add(new AlderItemCard { Title = "Activity notifications", Description = "Get a message when someone mentions you." });
        group.Items.Add(new AlderItemCard { Title = "Product updates", Description = "A monthly summary of releases and changes." });
        var toggle = new AlderSwitch();
        toggle.Bind(ToggleButton.IsCheckedProperty, CompiledBinding.Create((ProDataDisplayViewModel vm) => vm.Notifications, source: model, mode: BindingMode.TwoWay));
        ((AlderItemCard)group.Items[0]!).Action = toggle;
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleGroupPermissions" Title="{DynamicResource GalleryText.ProDemoItemCardGroupPermissions}">
      <g:ExampleCard.Preview>
        <Border MaxWidth="456" Padding="2,10" HorizontalAlignment="Stretch">
          <alder:AlderItemCardGroup Title="{DynamicResource GalleryText.ProDisplayPermissions}">
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayPermissions}" Description="{DynamicResource GalleryText.ProDisplayPermissionsHint}">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
              <alder:AlderItemCard.Action>
                <alder:AlderSelect ItemsSource="{CompiledBinding Permissions}" PlaceholderText="{DynamicResource GalleryText.ProDisplayChoose}" Width="145" />
              </alder:AlderItemCard.Action>
            </alder:AlderItemCard>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayAccount}" Description="{DynamicResource GalleryText.ProDisplayAccountHint}">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
              <alder:AlderItemCard.Action>
                <alder:AlderSelect ItemsSource="{CompiledBinding Permissions}" PlaceholderText="{DynamicResource GalleryText.ProDisplayChoose}" Width="145" SelectionMode="Multiple" />
              </alder:AlderItemCard.Action>
            </alder:AlderItemCard>
          </alder:AlderItemCardGroup>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderItemCardGroup();
        group.Items.Add(new AlderItemCard { Title = "Permissions", Description = "Choose what people can do in this workspace." });
        group.Items.Add(new AlderItemCard { Title = "Account security", Description = "Review connected services and sign-in methods." });
        ((AlderItemCard)group.Items[0]!).Action = new AlderSelect { ItemsSource = model.Permissions };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
