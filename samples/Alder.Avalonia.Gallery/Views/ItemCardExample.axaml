<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.ItemCardExample" x:Name="Example" x:DataType="vm:ProDataDisplayViewModel">
  <StackPanel Spacing="20">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.ProDemoItemCardUsage}">
      <g:ExampleCard.Preview>
        <Border MaxWidth="456" Padding="2,10" HorizontalAlignment="Stretch">
          <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayLanguage}" Description="{DynamicResource GalleryText.ProDisplayLanguageHint}">
            <alder:AlderItemCard.Icon>
              <alder:AlderPathIcon Data="{StaticResource AlderIconGlobe}" Width="16" Height="16" />
            </alder:AlderItemCard.Icon>
            <alder:AlderItemCard.Action>
              <alder:AlderButton Size="Small" Variant="Outline">
                <alder:AlderButton.Flyout>
                  <alder:AlderDropdownFlyout Placement="BottomEdgeAlignedRight" MinMenuWidth="220">
                    <alder:AlderMenuItem Header="{DynamicResource GalleryText.ProDisplayEnglish}" Command="{CompiledBinding #Example.((vm:ProDataDisplayViewModel)DataContext).ChooseItemCardLanguage}" CommandParameter="ProDisplayEnglish" />
                    <alder:AlderMenuItem Header="{DynamicResource GalleryText.ProDisplayChinese}" Command="{CompiledBinding #Example.((vm:ProDataDisplayViewModel)DataContext).ChooseItemCardLanguage}" CommandParameter="ProDisplayChinese" />
                    <alder:AlderMenuItem Header="{DynamicResource GalleryText.ProDisplaySpanish}" Command="{CompiledBinding #Example.((vm:ProDataDisplayViewModel)DataContext).ChooseItemCardLanguage}" CommandParameter="ProDisplaySpanish" />
                  </alder:AlderDropdownFlyout>
                </alder:AlderButton.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <alder:AlderTextBlock Text="{CompiledBinding ItemCardLanguage}" />
                  <alder:AlderPathIcon Data="{StaticResource AlderIconChevronRightCircle}" Width="14" Height="14" />
                </StackPanel>
              </alder:AlderButton>
            </alder:AlderItemCard.Action>
          </alder:AlderItemCard>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var resources = Application.Current!;
        var menu = new AlderDropdownFlyout { Placement = PlacementMode.BottomEdgeAlignedRight, MinMenuWidth = 220 };
        string[] keys = ["ProDisplayEnglish", "ProDisplayChinese", "ProDisplaySpanish"];
        foreach (var (title, key) in model.Languages.Zip(keys))
            menu.Items.Add(new AlderMenuItem
            {
                Header = title, Command = model.ChooseItemCardLanguage, CommandParameter = key
            });

        var label = new AlderTextBlock();
        label.Bind(AlderTextBlock.TextProperty,
            CompiledBinding.Create((ProDataDisplayViewModel vm) => vm.ItemCardLanguage, source: model));
        var trigger = new AlderButton
        {
            Size = AlderSize.Small, Variant = ButtonVariant.Outline, Flyout = menu,
            Content = new StackPanel
            {
                Orientation = Orientation.Horizontal, Spacing = 6, VerticalAlignment = VerticalAlignment.Center,
                Children = { label, new AlderPathIcon
                {
                    Data = (Geometry)resources.FindResource("AlderIconChevronRightCircle")!, Width = 14, Height = 14
                } }
            }
        };
        var language = new AlderItemCard
        {
            Title = "Language", Description = "Choose your preferred language", Action = trigger,
            Icon = new AlderPathIcon { Data = (Geometry)resources.FindResource("AlderIconGlobe")!, Width = 16, Height = 16 }
        };
        var preview = new Border { MaxWidth = 456, Padding = new Thickness(2, 10), Child = language };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleWallet" Title="{DynamicResource GalleryText.ProDemoItemCardWallet}">
      <g:ExampleCard.Preview>
        <Border MaxWidth="456" Padding="2,10" HorizontalAlignment="Stretch">
          <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayWallet}" Description="{DynamicResource GalleryText.ProDisplayWalletHint}">
            <alder:AlderItemCard.Icon>
              <alder:AlderPathIcon Data="{StaticResource AlderIconArchive}" Width="16" Height="16" />
            </alder:AlderItemCard.Icon>
            <alder:AlderItemCard.Action>
              <alder:AlderButton Size="Small" Variant="Secondary" Content="{DynamicResource GalleryText.ProDisplayManage}" Command="{CompiledBinding Report}" CommandParameter="ProDisplayManage" />
            </alder:AlderItemCard.Action>
          </alder:AlderItemCard>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var wallet = new AlderItemCard
        {
            Title = "Travel card",
            Description = "Debit card ending in 7316",
            Action = new AlderButton { Content = "Manage", Command = model.Report, CommandParameter = "ProDisplayManage" }
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleDevices" Title="{DynamicResource GalleryText.ProDemoItemCardDevices}">
      <g:ExampleCard.Preview>
        <Border MaxWidth="456" Padding="2,10" HorizontalAlignment="Stretch">
          <StackPanel Spacing="12" >
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProItemCardDevice}" Description="{DynamicResource GalleryText.ProItemCardDeviceHint}">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
              <alder:AlderItemCard.Action>
                <alder:AlderChip Size="Small" Variant="Soft" Color="Success" Content="{DynamicResource GalleryText.ProItemCardActiveDevice}" />
              </alder:AlderItemCard.Action>
            </alder:AlderItemCard>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProItemCardTablet}" Description="{DynamicResource GalleryText.ProItemCardTabletHint}">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
              <alder:AlderItemCard.Action>
                <alder:AlderButton Size="Small" Variant="Outline" Content="{DynamicResource GalleryText.ProItemCardRevoke}" Command="{CompiledBinding Report}" CommandParameter="ProItemCardRevoke" />
              </alder:AlderItemCard.Action>
            </alder:AlderItemCard>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProItemCardMobile}" Description="{DynamicResource GalleryText.ProItemCardMobileHint}">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
              <alder:AlderItemCard.Action>
                <alder:AlderButton Size="Small" Variant="Outline" Content="{DynamicResource GalleryText.ProItemCardRevoke}" Command="{CompiledBinding Report}" CommandParameter="ProItemCardRevoke" />
              </alder:AlderItemCard.Action>
            </alder:AlderItemCard>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new StackPanel { Spacing = 12 };
        group.Children.Add(new AlderItemCard { Title = "MacBook Pro", Description = "Last active: 2 minutes ago", Action = new AlderChip { Size = AlderSize.Small, Variant = ChipVariant.Soft, Color = AlderStatusColor.Success, Content = "Active" } });
        group.Children.Add(new AlderItemCard { Title = "iMac", Description = "Last active: 3 days ago", Action = new AlderButton { Size = AlderSize.Small, Variant = ButtonVariant.Outline, Content = "Revoke", Command = model.Report, CommandParameter = "ProItemCardRevoke" } });
        group.Children.Add(new AlderItemCard { Title = "iPhone 15 Pro", Description = "Last active: 1 hour ago", Action = new AlderButton { Size = AlderSize.Small, Variant = ButtonVariant.Outline, Content = "Revoke", Command = model.Report, CommandParameter = "ProItemCardRevoke" } });
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVariants" Title="{DynamicResource GalleryText.ProDemoItemCardVariants}">
      <g:ExampleCard.Preview>
        <Border MaxWidth="456" Padding="2,10" HorizontalAlignment="Stretch">
          <StackPanel Spacing="12" >
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayDefault}" Description="{DynamicResource GalleryText.ProItemCardDefaultHint}" Variant="Default">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconArchive}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
            </alder:AlderItemCard>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplaySecondary}" Description="{DynamicResource GalleryText.ProItemCardSecondaryHint}" Variant="Secondary">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconArchive}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
            </alder:AlderItemCard>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayTertiary}" Description="{DynamicResource GalleryText.ProItemCardTertiaryHint}" Variant="Tertiary">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconArchive}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
            </alder:AlderItemCard>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayOutline}" Description="{DynamicResource GalleryText.ProItemCardOutlineHint}" Variant="Outline">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconArchive}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
            </alder:AlderItemCard>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayTransparent}" Description="{DynamicResource GalleryText.ProItemCardTransparentHint}" Variant="Transparent">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconArchive}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
            </alder:AlderItemCard>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var cards = new StackPanel { Spacing = 7 };
        foreach (var variant in Enum.GetValues<ItemCardVariant>())
            cards.Children.Add(new AlderItemCard { Title = variant.ToString(), Variant = variant });
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleWithoutIcon" Title="{DynamicResource GalleryText.ProDemoItemCardWithoutIcon}">
