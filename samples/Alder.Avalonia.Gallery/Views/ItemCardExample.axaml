    <g:ExampleCard x:Name="SampleGroupUsage" Title="{DynamicResource GalleryText.ProDemoItemCardGroupUsage}">
      <g:ExampleCard.Preview>
        <Border MaxWidth="556" Padding="2,10" HorizontalAlignment="Stretch">
          <StackPanel Spacing="12" >
            <alder:AlderItemCardGroup Title="{DynamicResource GalleryText.ProDisplaySourceControl}">
              <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayGitHub}" Description="{DynamicResource GalleryText.ProDisplayGitHubHint}">
                <alder:AlderItemCard.Icon>
                  <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
                </alder:AlderItemCard.Icon>
                <alder:AlderItemCard.Action>
                  <alder:AlderButton Size="Small" Variant="Outline" Content="{DynamicResource GalleryText.ProDisplayManage}" Command="{CompiledBinding Report}" CommandParameter="ProDisplayManage" />
                </alder:AlderItemCard.Action>
              </alder:AlderItemCard>
              <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayGitLab}" Description="{DynamicResource GalleryText.ProDisplayGitLabHint}">
                <alder:AlderItemCard.Icon>
                  <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
                </alder:AlderItemCard.Icon>
                <alder:AlderItemCard.Action>
                  <alder:AlderButton Size="Small" Variant="Outline" Content="{DynamicResource GalleryText.ProDisplayManage}" Command="{CompiledBinding Report}" CommandParameter="ProDisplayManage" />
                </alder:AlderItemCard.Action>
              </alder:AlderItemCard>
            </alder:AlderItemCardGroup>
            <alder:AlderItemCardGroup Title="{DynamicResource GalleryText.ProDisplayIntegrations}">
              <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplaySlack}" Description="{DynamicResource GalleryText.ProDisplaySlackHint}">
                <alder:AlderItemCard.Icon>
                  <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
                </alder:AlderItemCard.Icon>
                <alder:AlderItemCard.Action>
                  <alder:AlderButton Size="Small" Variant="Outline" Content="{DynamicResource GalleryText.ProDisplayConnect}" Command="{CompiledBinding Report}" CommandParameter="ProDisplayConnect" />
                </alder:AlderItemCard.Action>
              </alder:AlderItemCard>
            </alder:AlderItemCardGroup>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderItemCardGroup { Title = "Source control" };
        group.Items.Add(new AlderItemCard { Title = "GitHub", Description = "Connected for project repositories." });
        group.Items.Add(new AlderItemCard { Title = "GitLab", Description = "Connect a hosted repository." });
        group.Items.Add(new AlderItemCard { Title = "Slack", Description = "Share workspace updates with the team." });
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
