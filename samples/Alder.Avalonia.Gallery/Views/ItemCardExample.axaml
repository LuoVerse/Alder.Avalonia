                </alder:AlderItemCard.Icon>
              </alder:AlderItemCard>
            </alder:AlderItemCardGroup>
            <alder:AlderItemCardGroup Title="{DynamicResource GalleryText.ProDisplayTertiary}"
                                     Description="{DynamicResource GalleryText.ProItemCardTertiaryHint}" Variant="Tertiary">
              <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayGitHub}" Description="{DynamicResource GalleryText.ProDisplayGitHubHint}">
                <alder:AlderItemCard.Icon>
                  <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
                </alder:AlderItemCard.Icon>
              </alder:AlderItemCard>
              <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayGitLab}" Description="{DynamicResource GalleryText.ProDisplayGitLabHint}">
                <alder:AlderItemCard.Icon>
                  <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
                </alder:AlderItemCard.Icon>
              </alder:AlderItemCard>
            </alder:AlderItemCardGroup>
            <alder:AlderItemCardGroup Title="{DynamicResource GalleryText.ProDisplayOutline}"
                                     Description="{DynamicResource GalleryText.ProItemCardOutlineHint}" Variant="Outline">
              <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayGitHub}" Description="{DynamicResource GalleryText.ProDisplayGitHubHint}">
                <alder:AlderItemCard.Icon>
                  <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
                </alder:AlderItemCard.Icon>
              </alder:AlderItemCard>
              <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayGitLab}" Description="{DynamicResource GalleryText.ProDisplayGitLabHint}">
                <alder:AlderItemCard.Icon>
                  <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
                </alder:AlderItemCard.Icon>
              </alder:AlderItemCard>
            </alder:AlderItemCardGroup>
            <alder:AlderItemCardGroup Title="{DynamicResource GalleryText.ProDisplayTransparent}"
                                     Description="{DynamicResource GalleryText.ProItemCardTransparentHint}" Variant="Transparent">
              <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayGitHub}" Description="{DynamicResource GalleryText.ProDisplayGitHubHint}">
                <alder:AlderItemCard.Icon>
                  <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
                </alder:AlderItemCard.Icon>
              </alder:AlderItemCard>
              <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayGitLab}" Description="{DynamicResource GalleryText.ProDisplayGitLabHint}">
                <alder:AlderItemCard.Icon>
                  <alder:AlderPathIcon Data="{StaticResource AlderIconInfo}" Width="16" Height="16" />
                </alder:AlderItemCard.Icon>
              </alder:AlderItemCard>
            </alder:AlderItemCardGroup>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var variants = new StackPanel { Spacing = 24 };
        var examples = new (ItemCardVariant Variant, string Description)[]
        {
            (ItemCardVariant.Default, "Surface background with shadow"),
            (ItemCardVariant.Secondary, "Secondary surface, no shadow"),
            (ItemCardVariant.Tertiary, "Tertiary surface, no shadow"),
            (ItemCardVariant.Outline, "Transparent with border, no shadow"),
            (ItemCardVariant.Transparent, "No background, no border, no shadow")
        };
        foreach (var (variant, description) in examples)
        {
            var group = new AlderItemCardGroup { Title = variant.ToString(), Description = description, Variant = variant };
            var icon = (Geometry)this.FindResource("AlderIconInfo")!;
            group.Items.Add(new AlderItemCard { Title = "GitHub", Description = "Connected for project repositories.",
                Icon = new AlderPathIcon { Data = icon, Width = 16, Height = 16 } });
            group.Items.Add(new AlderItemCard { Title = "GitLab", Description = "Connect a hosted repository.",
                Icon = new AlderPathIcon { Data = icon, Width = 16, Height = 16 } });
            variants.Children.Add(group);
        }
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
