    <g:ExampleCard x:Name="SampleGroupWallet" Title="{DynamicResource GalleryText.ProDemoItemCardGroupWallet}">
      <g:ExampleCard.Preview>
        <Border MaxWidth="504" Padding="2,10" HorizontalAlignment="Stretch">
          <alder:AlderItemCardGroup>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayWallet}" Description="{DynamicResource GalleryText.ProDisplayWalletHint}">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconArchive}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
              <alder:AlderItemCard.Action>
                <alder:AlderButton Size="Small" Variant="Secondary" Content="{DynamicResource GalleryText.ProDisplayManage}" Command="{CompiledBinding Report}" CommandParameter="ProDisplayManage" />
              </alder:AlderItemCard.Action>
            </alder:AlderItemCard>
            <alder:AlderItemCard Title="{DynamicResource GalleryText.ProDisplayPersonalWallet}" Description="{DynamicResource GalleryText.ProDisplayPersonalHint}">
              <alder:AlderItemCard.Icon>
                <alder:AlderPathIcon Data="{StaticResource AlderIconArchive}" Width="16" Height="16" />
              </alder:AlderItemCard.Icon>
              <alder:AlderItemCard.Action>
                <alder:AlderButton Size="Small" Variant="Secondary" Content="{DynamicResource GalleryText.ProDisplayManage}" Command="{CompiledBinding Report}" CommandParameter="ProDisplayManage" />
              </alder:AlderItemCard.Action>
            </alder:AlderItemCard>
          </alder:AlderItemCardGroup>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderItemCardGroup();
        group.Items.Add(new AlderItemCard { Title = "Travel card", Description = "Debit card ending in 7316" });
