      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderItemCardGroup();
        group.Items.Add(new AlderItemCard { Title = "Billing preferences", Description = "Manage payment and invoicing options." });
        group.Items.Add(new AlderItemCard { Title = "Account security", Description = "Review connected services and sign-in methods." });
        group.Items.Add(new AlderItemCard { Title = "Permissions", Description = "Choose what people can do in this workspace." });
        foreach (var item in group.Items.OfType<AlderItemCard>())
        {
            item.Command = model.Report;
            item.CommandParameter = "ProDisplayDetails";
        }
      ]]></g:ExampleCard.CSharpSource>
