          </Border>
        </gallery:ExampleCard.Preview>
        <gallery:ExampleCard.CSharpSource><![CDATA[
          var model = new CalendarViewModel();
          var calendar = new AlderCalendar { DataContext = model, HorizontalAlignment = HorizontalAlignment.Center, VisibleMonths = 2 };
          calendar.Bind(AlderCalendar.DisplayDateProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example));
          var preview = calendar;
        ]]></gallery:ExampleCard.CSharpSource>
      </gallery:ExampleCard>
    </gallery:GalleryExampleTemplate>
    <gallery:GalleryExampleTemplate Name="SampleInternational">
      <gallery:ExampleCard Title="{DynamicResource GalleryText.CalendarInternational}">
        <gallery:ExampleCard.Preview>
          <Border Padding="8,16">
            <Border.DataContext><vm:CalendarViewModel /></Border.DataContext>
            <alder:AlderCalendar HorizontalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource GalleryText.ScheduleCalendar}" DisplayDate="{CompiledBinding Example, Mode=OneWay}"
                            Culture="{CompiledBinding ThaiCulture, Mode=OneWay}" />
          </Border>
        </gallery:ExampleCard.Preview>
        <gallery:ExampleCard.CSharpSource><![CDATA[
          var model = new CalendarViewModel();
          var calendar = new AlderCalendar { DataContext = model, HorizontalAlignment = HorizontalAlignment.Center };
          calendar.Bind(AlderCalendar.DisplayDateProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example));
          calendar.Bind(AlderCalendar.CultureProperty, CompiledBinding.Create((CalendarViewModel model) => model.ThaiCulture));
          var preview = calendar;
        ]]></gallery:ExampleCard.CSharpSource>
      </gallery:ExampleCard>
    </gallery:GalleryExampleTemplate>
    <gallery:GalleryExampleTemplate Name="SampleAccent">
      <gallery:ExampleCard Title="{DynamicResource GalleryText.CalendarAccent}">
        <gallery:ExampleCard.Preview>
          <Border Padding="8,16">
            <Border.DataContext><vm:CalendarViewModel /></Border.DataContext>
            <alder:AlderCalendar HorizontalAlignment="Center" Culture="{DynamicResource GalleryCulture}"
                            AutomationProperties.Name="{DynamicResource GalleryText.ScheduleCalendar}" DisplayDate="{CompiledBinding Example, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="{DynamicResource AlderSurface}"
                            BorderBrush="{DynamicResource AlderAccent}" />
          </Border>
        </gallery:ExampleCard.Preview>
        <gallery:ExampleCard.CSharpSource><![CDATA[
          var model = new CalendarViewModel();
          var calendar = new AlderCalendar { DataContext = model, HorizontalAlignment = HorizontalAlignment.Center, BorderThickness = new Thickness(1), CornerRadius = new CornerRadius(12) };
          calendar.Bind(AlderCalendar.DisplayDateProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example));
          calendar[!AlderCalendar.BackgroundProperty] = new DynamicResourceExtension("AlderSurface");
          calendar[!AlderCalendar.BorderBrushProperty] = new DynamicResourceExtension("AlderAccent");
          var preview = calendar;
        ]]></gallery:ExampleCard.CSharpSource>
      </gallery:ExampleCard>
    </gallery:GalleryExampleTemplate>
    <gallery:GalleryExampleTemplate Name="SampleCalendarViews">
      <gallery:ExampleCard Title="{DynamicResource GalleryText.CalendarViews}">
        <gallery:ExampleCard.Preview>
          <StackPanel Spacing="8">
            <alder:AlderButtonGroup Size="Small" Variant="Secondary" HorizontalAlignment="Left">
              <alder:AlderButton Content="{DynamicResource GalleryText.Month}" Command="{Binding ShowMonth}" />
              <alder:AlderButton Content="{DynamicResource GalleryText.Week}" Command="{Binding ShowWeek}" />
              <alder:AlderButton Content="{DynamicResource GalleryText.Day}" Command="{Binding ShowDay}" />
            </alder:AlderButtonGroup>
            <alder:AlderCalendar x:Name="Calendar" Culture="{DynamicResource GalleryCulture}" View="{Binding View}" Value="{Binding Date, Mode=TwoWay}"
                            Minimum="{Binding MonthStart}" Maximum="{Binding MonthEnd}" Today="{Binding Example}"
                            IsDateUnavailable="{Binding Unavailable}" DateIndicator="{Binding Indicator}"
                            AutomationProperties.Name="{DynamicResource GalleryText.ScheduleCalendar}" />
            <alder:AlderTextBlock Text="{Binding Summary}" Foreground="{DynamicResource AlderMuted}" />
          </StackPanel>
        </gallery:ExampleCard.Preview>
        <gallery:ExampleCard.CSharpSource><![CDATA[
          var calendar = new AlderCalendar { Culture = CultureInfo.CurrentCulture };
          calendar.Bind(AlderCalendar.ViewProperty, CompiledBinding.Create((CalendarViewModel model) => model.View));
          calendar.Bind(AlderCalendar.ValueProperty, CompiledBinding.Create((CalendarViewModel model) => model.Date, mode: BindingMode.TwoWay));
          calendar.Bind(AlderCalendar.MinimumProperty, CompiledBinding.Create((CalendarViewModel model) => model.MonthStart));
          calendar.Bind(AlderCalendar.MaximumProperty, CompiledBinding.Create((CalendarViewModel model) => model.MonthEnd));
          calendar.Bind(AlderCalendar.TodayProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example));
          calendar.Bind(AlderCalendar.IsDateUnavailableProperty, CompiledBinding.Create((CalendarViewModel model) => model.Unavailable));
          calendar.Bind(AlderCalendar.DateIndicatorProperty, CompiledBinding.Create((CalendarViewModel model) => model.Indicator));
          AutomationProperties.SetName(calendar, "Schedule calendar");
        ]]></gallery:ExampleCard.CSharpSource>
      </gallery:ExampleCard>
    </gallery:GalleryExampleTemplate>
    <gallery:GalleryExampleTemplate Name="SampleMultipleSelectionAndLocale">
      <gallery:ExampleCard Title="{DynamicResource GalleryText.MultipleSelectionAndLocale}">
        <gallery:ExampleCard.Preview>
          <alder:AlderCalendar x:Name="ThaiCalendar" Culture="{Binding ThaiCulture}" DisplayDate="{Binding Example, Mode=OneWay}"
                          Today="{Binding Example}" SelectionMode="Multiple" FirstDayOfWeek="Monday" VisibleMonths="2" FixedWeeks="True"
                          AutomationProperties.Name="{DynamicResource GalleryText.ThaiBuddhistCalendar}" />
        </gallery:ExampleCard.Preview>
        <gallery:ExampleCard.CSharpSource><![CDATA[
          var calendar = new AlderCalendar
          {
              SelectionMode = AlderCalendarSelection.Multiple,
              FirstDayOfWeek = DayOfWeek.Monday,
              VisibleMonths = 2,
              FixedWeeks = true,
          };
          calendar.Bind(AlderCalendar.CultureProperty, CompiledBinding.Create((CalendarViewModel model) => model.ThaiCulture));
          calendar.Bind(AlderCalendar.DisplayDateProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example, mode: BindingMode.OneWay));
          calendar.Bind(AlderCalendar.TodayProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example));
          AutomationProperties.SetName(calendar, "Thai Buddhist calendar");
        ]]></gallery:ExampleCard.CSharpSource>
      </gallery:ExampleCard>
    </gallery:GalleryExampleTemplate>
  </gallery:GalleryExampleSection.Examples>
</gallery:GalleryExampleSection>
