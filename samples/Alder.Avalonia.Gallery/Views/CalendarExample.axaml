    <gallery:GalleryExampleTemplate Name="SampleNavigationIcons">
      <gallery:ExampleCard Title="{DynamicResource GalleryText.CalendarCustomIcons}">
        <gallery:ExampleCard.Preview>
          <Border Padding="8,16">
            <Border.DataContext><vm:CalendarViewModel /></Border.DataContext>
            <alder:AlderCalendar HorizontalAlignment="Center" Culture="{DynamicResource GalleryCulture}"
                            AutomationProperties.Name="{DynamicResource GalleryText.ScheduleCalendar}" DisplayDate="{CompiledBinding Example, Mode=OneWay}"
                            PreviousIcon="{DynamicResource AlderIconArrowLeft}"
                            NextIcon="{DynamicResource AlderIconArrowRight}" />
          </Border>
        </gallery:ExampleCard.Preview>
        <gallery:ExampleCard.CSharpSource><![CDATA[
          var model = new CalendarViewModel();
          var calendar = new AlderCalendar { DataContext = model, HorizontalAlignment = HorizontalAlignment.Center };
          calendar.Bind(AlderCalendar.DisplayDateProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example));
          calendar[!AlderCalendar.PreviousIconProperty] = new DynamicResourceExtension("AlderIconArrowLeft");
          calendar[!AlderCalendar.NextIconProperty] = new DynamicResourceExtension("AlderIconArrowRight");
          var preview = calendar;
        ]]></gallery:ExampleCard.CSharpSource>
      </gallery:ExampleCard>
    </gallery:GalleryExampleTemplate>
