        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new CalendarViewModel();
        var calendar = new AlderCalendar { DataContext = model, HorizontalAlignment = HorizontalAlignment.Center };
        calendar.Bind(AlderCalendar.DisplayDateProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example));
        calendar.Bind(AlderCalendar.FocusedDateProperty, CompiledBinding.Create((CalendarViewModel model) => model.FocusedExample, mode: BindingMode.TwoWay));
        var preview = calendar;
      ]]></gallery:ExampleCard.CSharpSource>
