<UserControl xmlns:gallery="using:Alder.Avalonia.Gallery.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.CalendarExample" x:DataType="vm:CalendarViewModel" FontFamily="fonts:Inter#Inter">
  <Design.DataContext>
    <vm:CalendarViewModel />
  </Design.DataContext>
  <StackPanel Spacing="20">
    <gallery:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <gallery:ExampleCard.Preview>
        <Border Padding="8,16">
          <Border.DataContext><vm:CalendarViewModel /></Border.DataContext>
          <alder:AlderCalendar HorizontalAlignment="Center" Culture="{DynamicResource GalleryCulture}"
                          AutomationProperties.Name="{DynamicResource GalleryText.ScheduleCalendar}" DisplayDate="{CompiledBinding Example, Mode=OneWay}"
                          ShowYearPicker="False" />
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new CalendarViewModel();
        var calendar = new AlderCalendar { DataContext = model, HorizontalAlignment = HorizontalAlignment.Center, ShowYearPicker = false };
        calendar.Bind(AlderCalendar.DisplayDateProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example));
        var preview = calendar;
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleDisabled" Title="{DynamicResource GalleryText.Disabled}">
      <gallery:ExampleCard.Preview>
        <Border Padding="8,16">
          <Border.DataContext><vm:CalendarViewModel /></Border.DataContext>
          <alder:AlderCalendar HorizontalAlignment="Center" Culture="{DynamicResource GalleryCulture}"
                          AutomationProperties.Name="{DynamicResource GalleryText.ScheduleCalendar}" DisplayDate="{CompiledBinding Example, Mode=OneWay}"
                          Value="{CompiledBinding Example, Mode=TwoWay}"
                          IsEnabled="False" />
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new CalendarViewModel();
        var calendar = new AlderCalendar { DataContext = model, HorizontalAlignment = HorizontalAlignment.Center, IsEnabled = false };
        calendar.Bind(AlderCalendar.DisplayDateProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example));
        calendar.Bind(AlderCalendar.ValueProperty, CompiledBinding.Create((CalendarViewModel model) => model.Example, mode: BindingMode.TwoWay));
        var preview = calendar;
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
