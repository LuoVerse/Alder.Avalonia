<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alder="using:Alder.Avalonia.Controls"
                    xmlns:gallery="using:Alder.Avalonia.Gallery.Controls"
                    xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
                    xmlns:views="using:Alder.Avalonia.Gallery.Views"
                    xmlns:converters="using:Avalonia.Data.Converters">
  <gallery:IconResourceConverter x:Key="NavigationPreviewIconConverter" />
  <StreamGeometry x:Key="NavPreviewIconMonitor">F0 M2,2 H14 A1,1 0 0 1 15,3 V10 A1,1 0 0 1 14,11 H9 V12.5 H11 V14 H5 V12.5 H7 V11 H2 A1,1 0 0 1 1,10 V3 A1,1 0 0 1 2,2 Z M2.5,3.5 V9.5 H13.5 V3.5 Z</StreamGeometry>
  <StreamGeometry x:Key="NavPreviewIconHome">F0 M1,7 L8,1 L15,7 L14,8.2 L13.5,7.8 V14.5 H2.5 V7.8 L2,8.2 Z M4,6.5 V13 H6 V9 H10 V13 H12 V6.5 L8,3 Z</StreamGeometry>
  <StreamGeometry x:Key="NavPreviewIconChecklist">M1,3.5 L2,2.5 L3.4,3.9 L5.8,1.5 L6.8,2.5 L3.4,6 Z M1,9 L2,8 L3.4,9.4 L5.8,7 L6.8,8 L3.4,11.5 Z M8,3 H15 V4.5 H8 Z M8,8.5 H15 V10 H8 Z M8,13 H15 V14.5 H8 Z</StreamGeometry>
  <StreamGeometry x:Key="NavPreviewIconBasket">F0 M1.2,5 H3.2 L5.4,1.8 L6.6,2.6 L5,5 H11 L9.4,2.6 L10.6,1.8 L12.8,5 H14.8 L13,14 H3 Z M3,6.5 L4.2,12.5 H11.8 L13,6.5 Z M5.8,8 H7.2 V11 H5.8 Z M8.8,8 H10.2 V11 H8.8 Z</StreamGeometry>
  <StreamGeometry x:Key="NavPreviewIconPeople">F0 M6,1.5 A3,3 0 1 1 6,7.5 A3,3 0 1 1 6,1.5 Z M6,3 A1.5,1.5 0 1 0 6,6 A1.5,1.5 0 1 0 6,3 Z M1,14 V12.5 C1,10 3.5,8.5 6,8.5 C8.5,8.5 11,10 11,12.5 V14 Z M2.5,12.5 H9.5 C9.5,11.2 8,10 6,10 C4,10 2.5,11.2 2.5,12.5 Z M11,2 A2.75,2.75 0 0 1 11,7.5 V6 A1.25,1.25 0 1 0 11,3.5 Z M11.5,8.5 C13.7,8.5 15,10.2 15,12.2 V14 H12 V12.5 H13.5 V12.2 A2.3,2.3 0 0 0 11.5,10 Z</StreamGeometry>
  <StreamGeometry x:Key="NavPreviewIconInbox">F0 M3.5,2.5 H12.5 L15,8 V13.5 H1 V8 Z M4.5,4 L2.8,7.7 H6.2 L7,9.2 H9 L9.8,7.7 H13.2 L11.5,4 Z M2.5,9.2 V12 H13.5 V9.2 H10.7 L9.9,10.7 H6.1 L5.3,9.2 Z</StreamGeometry>
  <StreamGeometry x:Key="NavPreviewIconFolder">F0 M1,3.5 A1,1 0 0 1 2,2.5 H6 L7.5,4 H14 A1,1 0 0 1 15,5 V12.5 A1,1 0 0 1 14,13.5 H2 A1,1 0 0 1 1,12.5 Z M2.5,4 V12 H13.5 V5.5 H7 L5.5,4 Z</StreamGeometry>
  <StreamGeometry x:Key="NavPreviewIconBook">F0 M2,1.5 H13.5 V14.5 H4 C2.3,14.5 1.5,13.6 1.5,12 V2 Z M3,3 V9.8 C3.3,9.6 3.7,9.5 4,9.5 H12 V3 Z M4,11 C3.3,11 3,11.5 3,12 C3,12.5 3.3,13 4,13 H12 V11 Z</StreamGeometry>
  <StreamGeometry x:Key="NavPreviewIconChat">F0 M3,2 H13 A2,2 0 0 1 15,4 V10 A2,2 0 0 1 13,12 H7 L3,15 V12 A2,2 0 0 1 1,10 V4 A2,2 0 0 1 3,2 Z M3,3.5 Q2.5,3.5 2.5,4 V10 Q2.5,10.5 3,10.5 H4.5 V12 L6.5,10.5 H13 Q13.5,10.5 13.5,10 V4 Q13.5,3.5 13,3.5 Z</StreamGeometry>

  <TreeDataTemplate x:Key="NavigationPreviewTree" x:DataType="vm:NavigationPreviewItem" ItemsSource="{Binding Children}">
    <alder:AlderTextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
  </TreeDataTemplate>

  <ControlTheme x:Key="NavigationPreviewRow" TargetType="alder:AlderSidebarItem"
                BasedOn="{StaticResource {x:Type alder:AlderSidebarItem}}" x:DataType="vm:NavigationPreviewItem">
    <Setter Property="Icon" Value="{Binding Icon, Converter={StaticResource NavigationPreviewIconConverter}}" />
    <Setter Property="RailToolTip" Value="{Binding Title}" />
    <Setter Property="Badge" Value="{Binding BadgeContent}" />
    <Setter Property="BadgeTemplate">
      <DataTemplate x:DataType="vm:NavigationPreviewItem">
        <Grid>
          <alder:AlderChip Size="Small" Variant="Soft" Color="Success" Content="{Binding Badge}" IsVisible="{Binding HasNewBadge}" />
          <alder:AlderTextBlock Text="{Binding Badge}" FontSize="11" IsVisible="{Binding !HasNewBadge}" />
        </Grid>
      </DataTemplate>
    </Setter>
    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="SelectOnInvoke" Value="{Binding SelectOnInvoke}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
  </ControlTheme>

  <DataTemplate x:Key="NavigationPreviewGroup" x:DataType="vm:NavigationPreviewGroup">
    <alder:AlderSidebarGroup Header="{Binding Title}">
      <alder:AlderSidebarMenu ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource NavigationPreviewTree}"
                              ItemContainerTheme="{StaticResource NavigationPreviewRow}" />
    </alder:AlderSidebarGroup>
  </DataTemplate>

  <DataTemplate x:Key="NavigationPreviewSidebar" x:DataType="vm:NavigationPreview">
    <views:NavigationPreviewSidebar />
  </DataTemplate>
  <DataTemplate x:Key="NavigationPreviewNavbar" x:DataType="vm:NavigationPreview">
    <views:NavigationPreviewNavbar />
  </DataTemplate>
  <DataTemplate x:Key="NavigationPreviewSummary" x:DataType="vm:NavigationPreview">
    <alder:AlderTextBlock Text="{Binding Summary}" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" MaxWidth="720"
               HorizontalAlignment="Left" LineHeight="21" />
  </DataTemplate>
  <DataTemplate x:Key="NavigationPreviewTitleAndSummary" x:DataType="vm:NavigationPreview">
    <StackPanel Spacing="8">
      <alder:AlderTextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
      <alder:AlderTextBlock Text="{Binding Summary}" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" MaxWidth="720"
                 HorizontalAlignment="Left" LineHeight="21" />
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
