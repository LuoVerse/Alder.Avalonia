<UserControl xmlns:gallery="using:Alder.Avalonia.Gallery.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.TimeFieldExample" x:DataType="vm:TimeFieldViewModel" FontFamily="fonts:Inter#Inter">
  <Design.DataContext>
    <vm:TimeFieldViewModel />
  </Design.DataContext>
  <UserControl.Styles><Style Selector=":is(Label)"><Setter Property="Theme" Value="{StaticResource AlderLabelTheme}" /></Style></UserControl.Styles>
  <gallery:GalleryExampleList>
    <gallery:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:TimeFieldViewModel /></Border.DataContext>
          <StackPanel MaxWidth="256" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="UsageLabel" Content="{DynamicResource GalleryText.Time}" Target="{CompiledBinding #UsageField}" />
            <alder:AlderTimeField x:Name="UsageField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #UsageLabel}"  />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new TimeFieldViewModel();
        var field = new AlderTimeField { DataContext = model, FullWidth = true };
        field[!AlderTimeField.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Time");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 256, Spacing = 4, Children = { label, field } };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SamplePrefix" Title="{DynamicResource GalleryText.TemporalWithPrefix}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:TimeFieldViewModel /></Border.DataContext>
          <StackPanel MaxWidth="256" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="PrefixLabel" Content="{DynamicResource GalleryText.Time}" Target="{CompiledBinding #PrefixField}" />
            <alder:AlderTimeField x:Name="PrefixField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #PrefixLabel}" >
              <alder:AlderTimeField.Prefix>
                <alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconClock}" Foreground="{DynamicResource AlderMuted}" />
              </alder:AlderTimeField.Prefix>
            </alder:AlderTimeField>
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new TimeFieldViewModel();
        var field = new AlderTimeField { DataContext = model, FullWidth = true };
        field[!AlderTimeField.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Time");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 256, Spacing = 4, Children = { label, field } };
        var prefix = new AlderPathIcon { Width = 16, Height = 16 };
        prefix[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconClock");
        prefix[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        field.Prefix = prefix;
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
