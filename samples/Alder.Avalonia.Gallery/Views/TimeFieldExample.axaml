      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleDescription" Title="{DynamicResource GalleryText.TemporalWithDescription}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:TimeFieldViewModel /></Border.DataContext>
          <StackPanel MaxWidth="256" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="DescriptionLabel" Content="{DynamicResource GalleryText.Time}" Target="{CompiledBinding #DescriptionField}" />
            <alder:AlderTimeField x:Name="DescriptionField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #DescriptionLabel}"  />
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.TemporalPreferredTime}" FontSize="12" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new TimeFieldViewModel();
        var field = new AlderTimeField { DataContext = model, FullWidth = true };
        field[!AlderTimeField.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Time");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 256, Spacing = 4, Children = { label, field } };
        var detail = new AlderTextBlock { FontSize = 12, TextWrapping = TextWrapping.Wrap };
        detail[!TextBlock.TextProperty] = new DynamicResourceExtension("GalleryText.TemporalPreferredTime");
        detail[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        preview.Children.Add(detail);
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleRequired" Title="{DynamicResource GalleryText.AutocompleteRequired}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:TimeFieldViewModel /></Border.DataContext>
          <StackPanel MaxWidth="256" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="RequiredLabel" Content="{DynamicResource GalleryText.Time}" Target="{CompiledBinding #RequiredField}" />
            <alder:AlderTimeField x:Name="RequiredField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #RequiredLabel}" IsRequired="True" />
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.TemporalTimeRequired}" FontSize="12" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new TimeFieldViewModel();
        var field = new AlderTimeField { DataContext = model, FullWidth = true, IsRequired = true };
        field[!AlderTimeField.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Time");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 256, Spacing = 4, Children = { label, field } };
        var detail = new AlderTextBlock { FontSize = 12, TextWrapping = TextWrapping.Wrap };
        detail[!TextBlock.TextProperty] = new DynamicResourceExtension("GalleryText.TemporalTimeRequired");
        detail[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        preview.Children.Add(detail);
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleFullWidth" Title="{DynamicResource GalleryText.FullWidth}">
