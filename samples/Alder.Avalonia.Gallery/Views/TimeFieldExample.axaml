    <gallery:ExampleCard x:Name="SampleInvalid" Title="{DynamicResource GalleryText.TemporalInvalid}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:TimeFieldViewModel /></Border.DataContext>
          <StackPanel MaxWidth="256" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="InvalidLabel" Content="{DynamicResource GalleryText.Time}" Target="{CompiledBinding #InvalidField}" />
            <alder:AlderTimeField x:Name="InvalidField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #InvalidLabel}" IsInvalid="True" />
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.TemporalTimeError}" FontSize="12" Foreground="{DynamicResource AlderDangerInk}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new TimeFieldViewModel();
        var field = new AlderTimeField { DataContext = model, FullWidth = true, IsInvalid = true };
        field[!AlderTimeField.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Time");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 256, Spacing = 4, Children = { label, field } };
        var detail = new AlderTextBlock { FontSize = 12, TextWrapping = TextWrapping.Wrap };
        detail[!TextBlock.TextProperty] = new DynamicResourceExtension("GalleryText.TemporalTimeError");
        detail[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderDangerInk");
        preview.Children.Add(detail);
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleValidationForm" Title="{DynamicResource GalleryText.Controlled}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="4">
          <alder:AlderLabel x:Name="StartLabel" Content="{DynamicResource GalleryText.AppointmentTime}" Target="{Binding #Appointment}" />
          <alder:AlderTimeField x:Name="Appointment" Culture="{DynamicResource GalleryCulture}" Value="{Binding Time, Mode=TwoWay}" IsRequired="True"
                           Minimum="{Binding Opens}" Maximum="{Binding Closes}" AutomationProperties.LabeledBy="{Binding #StartLabel}">
            <alder:AlderTimeField.Prefix><alder:AlderPathIcon Width="16" Height="16" Data="{StaticResource AlderIconClock}" Foreground="{DynamicResource AlderMuted}" /></alder:AlderTimeField.Prefix>
          </alder:AlderTimeField>
          <alder:AlderTextBlock Foreground="{DynamicResource AlderMuted}" Text="{Binding Summary}" />
          <alder:AlderTextBlock Foreground="{DynamicResource AlderDangerInk}" Text="{DynamicResource GalleryText.EnterATimeBetween9AMAnd5PM}"
                     TextWrapping="Wrap" MaxWidth="230" IsVisible="{Binding #Appointment.HasInvalidInput}" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <alder:AlderButton Content="{DynamicResource GalleryText.ClearTime}" Command="{CompiledBinding Clear}" Variant="Ghost" Size="Small" HorizontalAlignment="Left" />
            <alder:AlderButton Content="{DynamicResource GalleryText.Reset}" Command="{CompiledBinding Reset}" Variant="Secondary" Size="Small" />
          </WrapPanel>
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var timeField = new AlderTimeField
        {
            Culture = CultureInfo.CurrentCulture,
            IsRequired = true,
            Prefix = new AlderPathIcon { Height = 16, Data = (Geometry)this.FindResource("AlderIconClock")!, Foreground = (IBrush)this.FindResource("AlderMuted")! },
        };
        timeField.Bind(AlderTimeField.ValueProperty, CompiledBinding.Create((TimeFieldViewModel model) => model.Time, mode: BindingMode.TwoWay));
        timeField.Bind(AlderTimeField.MinimumProperty, CompiledBinding.Create((TimeFieldViewModel model) => model.Opens));
        timeField.Bind(AlderTimeField.MaximumProperty, CompiledBinding.Create((TimeFieldViewModel model) => model.Closes));

        var model = (TimeFieldViewModel)DataContext!;
        var clear = new AlderButton { Content = "Clear time", Size = AlderSize.Small, Variant = ButtonVariant.Ghost };
        var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary };
        clear.Click += (_, _) => model.Clear();
        reset.Click += (_, _) => model.Reset();
        var actions = new WrapPanel { ItemSpacing = 8, LineSpacing = 8, Children = { clear, reset } };
        var preview = new StackPanel { Spacing = 4, Children = { timeField, actions } };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="Sample24HourClockWithSeconds" Title="{DynamicResource GalleryText.24HourClockWithSeconds}">
      <gallery:ExampleCard.Preview>
        <Border Padding="12" CornerRadius="16" Background="{DynamicResource AlderSurface}">
          <StackPanel Spacing="4">
            <alder:AlderLabel x:Name="TimeLabel" Content="{DynamicResource GalleryText.24HourClockWithSeconds}" Target="{Binding #Seconds}" />
            <alder:AlderTimeField x:Name="Seconds" Culture="{DynamicResource GalleryCulture}" Clock="TwentyFourHour" Granularity="Second"
                             Variant="Secondary" FullWidth="True" Value="{Binding Example, Mode=OneWay}"
                             AutomationProperties.LabeledBy="{Binding #TimeLabel}">
              <alder:AlderTimeField.Suffix><alder:AlderTextBlock Text="UTC" Foreground="{DynamicResource AlderMuted}" /></alder:AlderTimeField.Suffix>
            </alder:AlderTimeField>
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var timeField = new AlderTimeField
        {
            Culture = CultureInfo.CurrentCulture,
            Clock = TimeFieldClock.TwentyFourHour,
            Granularity = TimeFieldGranularity.Second,
            Variant = InputVariant.Secondary,
            FullWidth = true,
            Suffix = new AlderTextBlock { Text = "UTC", Foreground = (IBrush)this.FindResource("AlderMuted")! },
        };
        timeField.Bind(AlderTimeField.ValueProperty, CompiledBinding.Create((TimeFieldViewModel model) => model.Example, mode: BindingMode.OneWay));
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleReadOnly" Title="{DynamicResource GalleryText.ReadOnly}">
      <gallery:ExampleCard.Preview>
        <alder:AlderTimeField Culture="{DynamicResource GalleryCulture}" IsReadOnly="True" Value="{Binding Example, Mode=OneWay}" AutomationProperties.Name="{DynamicResource GalleryText.ReadOnlyTime}" />
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var timeField = new AlderTimeField { Culture = CultureInfo.CurrentCulture, IsReadOnly = true };
        timeField.Bind(AlderTimeField.ValueProperty, CompiledBinding.Create((TimeFieldViewModel model) => model.Example, mode: BindingMode.OneWay));
        AutomationProperties.SetName(timeField, "Read-only time");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleDisabled" Title="{DynamicResource GalleryText.Disabled}">
      <gallery:ExampleCard.Preview>
        <alder:AlderTimeField Culture="{DynamicResource GalleryCulture}" IsEnabled="False" AutomationProperties.Name="{DynamicResource GalleryText.DisabledTime}" />
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var timeField = new AlderTimeField { Culture = CultureInfo.CurrentCulture, IsEnabled = false };
        AutomationProperties.SetName(timeField, "Disabled time");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
  </gallery:GalleryExampleList>
</UserControl>
