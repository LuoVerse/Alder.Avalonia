<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:a="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls" xmlns:c="using:Avalonia.Data.Converters" xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels" x:Class="Alder.Avalonia.Gallery.Views.ModelSelectorExample" x:DataType="vm:AiExampleViewModel">
  <StackPanel Spacing="20">
    <g:ExampleCard x:Name="SampleDefault" Classes="chat-message-preview" Title="{DynamicResource GalleryText.AiDefault}">
      <g:ExampleCard.Preview>
        <Border Padding="8,24" Container.Name="ModelSelectorComposer" Container.Sizing="Width">
          <Border.DataContext>
            <vm:AiExampleViewModel Scenario="ModelUsage" />
          </Border.DataContext>
          <a:AlderPromptInput Theme="{StaticResource AlderModelComposerTheme}" MaxWidth="640"
                              Text="{CompiledBinding Draft, Mode=TwoWay}" SendCommand="{CompiledBinding Send}" IsRunning="{CompiledBinding Running}"
                              StopCommand="{CompiledBinding Stop}" Placeholder="{DynamicResource GalleryText.AiAskAnything}">
            <a:AlderPromptInput.Attachments>
              <a:AlderChatAttachment FileName="{CompiledBinding FileName}" IsVisible="{CompiledBinding FileName, Converter={x:Static c:ObjectConverters.IsNotNull}}"
                                     RemoveCommand="{CompiledBinding Remove}" />
            </a:AlderPromptInput.Attachments>
            <a:AlderPromptInput.LeadingTools>
              <a:AlderButton Theme="{StaticResource AlderModelComposerAttachTheme}" Command="{CompiledBinding Attach}"
                             a:AlderToolTip.Tip="{DynamicResource GalleryText.AiAddContext}" AutomationProperties.Name="{DynamicResource GalleryText.AiAddContext}" />
            </a:AlderPromptInput.LeadingTools>
            <a:AlderPromptInput.Tools>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0">
                <a:AlderModelSelector ItemTemplate="{DynamicResource AiModelRow}" ItemsSource="{CompiledBinding Models}" Efforts="{CompiledBinding Efforts}"
                                      SelectedEffort="{CompiledBinding Effort, Mode=TwoWay}" SelectedModel="{CompiledBinding Model, Mode=TwoWay}" />
                <a:AlderToggleButton Name="Voice" Theme="{StaticResource AlderModelComposerVoiceTheme}"
                                     IsChecked="{CompiledBinding VoicePreviewActive, Mode=TwoWay}"
                                     AutomationProperties.Name="{DynamicResource GalleryText.AiVoice}" a:AlderToolTip.Tip="{DynamicResource GalleryText.AiVoice}" />
              </StackPanel>
            </a:AlderPromptInput.Tools>
          </a:AlderPromptInput>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var model = new AiExampleViewModel { Scenario = AiGalleryScenario.ModelUsage };
        ControlTheme Theme(string key) => (ControlTheme)Application.Current!.FindResource(key)!;
        var selector = new AlderModelSelector();
        selector.Bind(AlderModelSelector.ItemsSourceProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Models));
        selector.Bind(AlderModelSelector.EffortsProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Efforts));
        selector[!AlderModelSelector.ItemTemplateProperty] = new DynamicResourceExtension("AiModelRow");
        selector.Bind(AlderModelSelector.SelectedModelProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Model, mode: BindingMode.TwoWay));
        selector.Bind(AlderModelSelector.SelectedEffortProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Effort, mode: BindingMode.TwoWay));
        var voice = new AlderToggleButton { Name = "Voice", Theme = Theme("AlderModelComposerVoiceTheme") };
        voice.Bind(AlderToggleButton.IsCheckedProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.VoicePreviewActive, mode: BindingMode.TwoWay));
        voice[!AutomationProperties.NameProperty] = new DynamicResourceExtension("GalleryText.AiVoice");
        voice[!AlderToolTip.TipProperty] = new DynamicResourceExtension("GalleryText.AiVoice");
        var attach = new AlderButton { Theme = Theme("AlderModelComposerAttachTheme"), Command = model.Attach };
        attach[!AutomationProperties.NameProperty] = new DynamicResourceExtension("GalleryText.AiAddContext");
        attach[!AlderToolTip.TipProperty] = new DynamicResourceExtension("GalleryText.AiAddContext");
        var attachment = new AlderChatAttachment { RemoveCommand = model.Remove };
        attachment.Bind(AlderChatAttachment.FileNameProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.FileName));
        attachment.Bind(Visual.IsVisibleProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.FileName,
            converter: global::Avalonia.Data.Converters.ObjectConverters.IsNotNull));
        var composer = new AlderPromptInput
        {
            MaxWidth = 640, Theme = Theme("AlderModelComposerTheme"),
            SendCommand = model.Send, StopCommand = model.Stop, Attachments = attachment, LeadingTools = attach,
            Tools = new StackPanel
            {
                Orientation = Orientation.Horizontal, Spacing = 8, Margin = new Thickness(0, 0, 8, 0),
                Children = { selector, voice }
            }
        };
        var preview = new Border { DataContext = model, Padding = new Thickness(8, 24), Child = composer };
        Container.SetName(preview, "ModelSelectorComposer");
        Container.SetSizing(preview, ContainerSizing.Width);
        composer.Bind(AlderPromptInput.TextProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Draft, mode: BindingMode.TwoWay));
        composer.Bind(AlderPromptInput.IsRunningProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Running));
        composer[!AlderPromptInput.PlaceholderProperty] = new DynamicResourceExtension("GalleryText.AiAskAnything");
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleEffortLevels" Title="{DynamicResource GalleryText.AiVariantEffortLevels}">
      <g:ExampleCard.Preview>
        <Border Padding="22,24" MinHeight="92">
          <Border.DataContext>
            <vm:AiExampleViewModel Scenario="Effort" />
          </Border.DataContext>
          <a:AlderModelSelector ItemTemplate="{DynamicResource AiModelRow}"
                                HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="640"
                                ItemsSource="{CompiledBinding Models}" Efforts="{CompiledBinding Efforts}"
                                SelectedModel="{CompiledBinding Model, Mode=TwoWay}" SelectedEffort="{CompiledBinding Effort, Mode=TwoWay}" />
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var model = new AiExampleViewModel { Scenario = AiGalleryScenario.Effort };
        var selector = new AlderModelSelector
        {
            HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Top, MaxWidth = 640
        };
        selector[!AlderModelSelector.ItemTemplateProperty] = new DynamicResourceExtension("AiModelRow");
        selector.Bind(AlderModelSelector.ItemsSourceProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Models));
        selector.Bind(AlderModelSelector.EffortsProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Efforts));
        selector.Bind(AlderModelSelector.SelectedModelProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Model, mode: BindingMode.TwoWay));
        selector.Bind(AlderModelSelector.SelectedEffortProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Effort, mode: BindingMode.TwoWay));
        var preview = new Border
        {
            DataContext = model, Padding = new Thickness(22, 24), MinHeight = 92, Child = selector
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleWithoutOuterSparks" Title="{DynamicResource GalleryText.AiVariantWithoutOuterSparks}">
      <g:ExampleCard.Preview>
        <Border Padding="22,24" MinHeight="92">
          <Border.DataContext>
            <vm:AiExampleViewModel Scenario="ModelUsage" />
          </Border.DataContext>
          <a:AlderModelSelector ItemTemplate="{DynamicResource AiModelRow}"
                                HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="640" ShowOuterSparks="False"
                                ItemsSource="{CompiledBinding Models}" Efforts="{CompiledBinding Efforts}"
                                SelectedModel="{CompiledBinding Model, Mode=TwoWay}" SelectedEffort="{CompiledBinding Effort, Mode=TwoWay}" />
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var model = new AiExampleViewModel { Scenario = AiGalleryScenario.ModelUsage };
        var selector = new AlderModelSelector
        {
            HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Top, MaxWidth = 640, ShowOuterSparks = false
        };
        selector[!AlderModelSelector.ItemTemplateProperty] = new DynamicResourceExtension("AiModelRow");
        selector.Bind(AlderModelSelector.ItemsSourceProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Models));
        selector.Bind(AlderModelSelector.EffortsProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Efforts));
        selector.Bind(AlderModelSelector.SelectedModelProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Model, mode: BindingMode.TwoWay));
        selector.Bind(AlderModelSelector.SelectedEffortProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Effort, mode: BindingMode.TwoWay));
        var preview = new Border
        {
            DataContext = model, Padding = new Thickness(22, 24), MinHeight = 92, Child = selector
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleCustomParts" Title="{DynamicResource GalleryText.AiVariantCustomParts}">
      <g:ExampleCard.Preview>
        <Border Padding="22,24" MinHeight="92">
          <Border.DataContext>
            <vm:AiExampleViewModel />
          </Border.DataContext>
          <a:AlderModelSelector ItemTemplate="{DynamicResource AiModelRow}"
                                HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="640"
                                ItemsSource="{CompiledBinding Models}" Efforts="{CompiledBinding Efforts}"
                                SelectedModel="{CompiledBinding Model, Mode=TwoWay}" SelectedEffort="{CompiledBinding Effort, Mode=TwoWay}" />
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var model = new AiExampleViewModel();
        var selector = new AlderModelSelector
        {
            HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Top, MaxWidth = 640
        };
        selector[!AlderModelSelector.ItemTemplateProperty] = new DynamicResourceExtension("AiModelRow");
        selector.Bind(AlderModelSelector.ItemsSourceProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Models));
        selector.Bind(AlderModelSelector.EffortsProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Efforts));
        selector.Bind(AlderModelSelector.SelectedModelProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Model, mode: BindingMode.TwoWay));
        selector.Bind(AlderModelSelector.SelectedEffortProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Effort, mode: BindingMode.TwoWay));
        var preview = new Border
        {
            DataContext = model, Padding = new Thickness(22, 24), MinHeight = 92, Child = selector
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleComposition" Title="{DynamicResource GalleryText.AiVariantComposition}">
      <g:ExampleCard.Preview>
        <Border Padding="22,24" MinHeight="92">
          <Border.DataContext>
            <vm:AiExampleViewModel Scenario="Models" />
          </Border.DataContext>
          <a:AlderModelSelector ItemTemplate="{DynamicResource AiModelRow}"
                                HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="640" MinHeight="40" ShowSearch="True" EffortNote="{DynamicResource GalleryText.AiModelPriceNote}"
                                ItemsSource="{CompiledBinding Models}" Efforts="{CompiledBinding Efforts}"
                                SelectedModel="{CompiledBinding Model, Mode=TwoWay}" SelectedEffort="{CompiledBinding Effort, Mode=TwoWay}" />
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var model = new AiExampleViewModel { Scenario = AiGalleryScenario.Models };
        var selector = new AlderModelSelector
        {
            HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Top, MaxWidth = 640, MinHeight = 40, ShowSearch = true
        };
        selector[!AlderModelSelector.ItemTemplateProperty] = new DynamicResourceExtension("AiModelRow");
        selector.Bind(AlderModelSelector.ItemsSourceProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Models));
        selector.Bind(AlderModelSelector.EffortsProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Efforts));
        selector.Bind(AlderModelSelector.SelectedModelProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Model, mode: BindingMode.TwoWay));
        selector.Bind(AlderModelSelector.SelectedEffortProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Effort, mode: BindingMode.TwoWay));
        selector[!AlderModelSelector.EffortNoteProperty] = new DynamicResourceExtension("GalleryText.AiModelPriceNote");
        var preview = new Border
        {
            DataContext = model, Padding = new Thickness(22, 24), MinHeight = 92, Child = selector
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleControlled" Title="{DynamicResource GalleryText.AiVariantControlled}">
      <g:ExampleCard.Preview>
        <Border Padding="22,24" MinHeight="92">
          <Border.DataContext>
            <vm:AiExampleViewModel />
          </Border.DataContext>
          <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="640">
            <a:AlderModelSelector ItemTemplate="{DynamicResource AiModelRow}"
                                  ItemsSource="{CompiledBinding Models}" Efforts="{CompiledBinding Efforts}"
                                  SelectedModel="{CompiledBinding Model, Mode=TwoWay}" SelectedEffort="{CompiledBinding Effort, Mode=TwoWay}" />
            <StackPanel Spacing="8" Orientation="Horizontal" HorizontalAlignment="Center">
              <a:AlderTextBlock Text="{CompiledBinding Model}" TextWrapping="Wrap" />
              <a:AlderTextBlock Text="·" TextWrapping="Wrap" />
              <a:AlderTextBlock Text="{CompiledBinding Effort}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var model = new AiExampleViewModel();
        var selector = new AlderModelSelector();
        selector[!AlderModelSelector.ItemTemplateProperty] = new DynamicResourceExtension("AiModelRow");
        selector.Bind(AlderModelSelector.ItemsSourceProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Models));
        selector.Bind(AlderModelSelector.EffortsProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Efforts));
        selector.Bind(AlderModelSelector.SelectedModelProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Model, mode: BindingMode.TwoWay));
        selector.Bind(AlderModelSelector.SelectedEffortProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Effort, mode: BindingMode.TwoWay));
        var modelLabel = new AlderTextBlock { TextWrapping = TextWrapping.Wrap };
        modelLabel.Bind(TextBlock.TextProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Model));
        var effortLabel = new AlderTextBlock { TextWrapping = TextWrapping.Wrap };
        effortLabel.Bind(TextBlock.TextProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Effort));
        var readout = new StackPanel
        {
            Orientation = Orientation.Horizontal, Spacing = 8, HorizontalAlignment = HorizontalAlignment.Center,
            Children = { modelLabel, new AlderTextBlock { Text = "·", TextWrapping = TextWrapping.Wrap }, effortLabel }
        };
        var content = new StackPanel
        {
            Spacing = 8, HorizontalAlignment = HorizontalAlignment.Center, VerticalAlignment = VerticalAlignment.Top,
            MaxWidth = 640, Children = { selector, readout }
        };
        var preview = new Border
        {
            DataContext = model, Padding = new Thickness(22, 24), MinHeight = 92, Child = content
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
