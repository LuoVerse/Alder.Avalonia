<UserControl xmlns:gallery="using:Alder.Avalonia.Gallery.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.TextAreaExample" x:DataType="vm:TextAreaViewModel" FontFamily="fonts:Inter#Inter">
  <UserControl.Styles>
    <Style Selector=":is(Label)"><Setter Property="Theme" Value="{StaticResource AlderLabelTheme}" /></Style>
    <Style Selector="TextBlock.detail"><Setter Property="Foreground" Value="{DynamicResource AlderMuted}" /></Style>
    <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource AlderDangerInk}" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="20">
    <gallery:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="4" MaxWidth="400" HorizontalAlignment="Left">
          <alder:AlderLabel x:Name="AnnouncementLabel" Content="{DynamicResource GalleryText.Announcement}" Target="{Binding #Announcement}" />
          <alder:AlderTextArea x:Name="Announcement" FullWidth="True" Rows="3" MaxLength="280" IsRequired="True"
                          IsInvalid="{Binding IsTooShort}" Text="{Binding Announcement, Mode=TwoWay}"
                          PlaceholderText="{DynamicResource GalleryText.ShareAQuickProjectUpdate}" AutomationProperties.LabeledBy="{Binding #AnnouncementLabel}" />
          <alder:AlderTextBlock Classes="detail" Text="{Binding Count}" />
          <alder:AlderTextBlock Classes="error" IsVisible="{Binding IsTooShort}" Text="{DynamicResource GalleryText.EnterAtLeast12Characters}" />
          <alder:AlderButton Content="{DynamicResource GalleryText.Clear}" Variant="Ghost" Size="Small" HorizontalAlignment="Left" Command="{Binding Clear}" />
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var textArea = new AlderTextArea
        {
            FullWidth = true,
            Rows = 3,
            MaxLength = 280,
            IsRequired = true,
            PlaceholderText = "Share a quick project update…",
        };
        textArea.Bind(AlderTextArea.IsInvalidProperty, CompiledBinding.Create((TextAreaViewModel model) => model.IsTooShort));
        textArea.Bind(AlderTextArea.TextProperty, CompiledBinding.Create((TextAreaViewModel model) => model.Announcement, mode: BindingMode.TwoWay));
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleRowsAndResizing" Title="{DynamicResource GalleryText.RowsAndResizing}">
      <gallery:ExampleCard.Preview>
        <WrapPanel ItemSpacing="16" LineSpacing="12">
          <Border Background="{DynamicResource AlderSurface}" CornerRadius="16" Padding="12" MaxWidth="284">
            <StackPanel Spacing="4">
              <alder:AlderLabel x:Name="NotesLabel" Content="{DynamicResource GalleryText.DetailedNotes}" Target="{Binding #Notes}" />
              <alder:AlderTextArea x:Name="Notes" Variant="Secondary" FullWidth="True" Rows="6" PlaceholderText="{DynamicResource GalleryText.WriteOutTheFullMeetingNotes}"
                              AutomationProperties.LabeledBy="{Binding #NotesLabel}" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="4" MaxWidth="256">
            <alder:AlderLabel x:Name="FixedLabel" Content="{DynamicResource GalleryText.ShortFeedback}" Target="{Binding #Fixed}" />
            <alder:AlderTextArea x:Name="Fixed" Rows="2" Width="256" ResizeMode="None" PlaceholderText="{DynamicResource GalleryText.WhatWentWell}"
                            AutomationProperties.LabeledBy="{Binding #FixedLabel}" />
          </StackPanel>
        </WrapPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var textArea1 = new AlderTextArea
        {
            Variant = InputVariant.Secondary,
            FullWidth = true,
            Rows = 6,
            PlaceholderText = "Write out the full meeting notes…",
        };

        var textArea2 = new AlderTextArea
        {
            Rows = 2,
            Width = 256,
            ResizeMode = TextAreaResize.None,
            PlaceholderText = "What went well?",
        };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleReadOnly" Title="{DynamicResource GalleryText.ReadOnly}">
      <gallery:ExampleCard.Preview>
        <alder:AlderTextArea Width="242" IsReadOnly="True" Text="{DynamicResource GalleryText.TheseNotesHaveBeenArchived}" AutomationProperties.Name="{DynamicResource GalleryText.ReadOnlyNotes}" />
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var textArea = new AlderTextArea
        {
            Width = 242,
            IsReadOnly = true,
            Text = "These notes have been archived.",
        };
        AutomationProperties.SetName(textArea, "Read-only notes");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleDisabled" Title="{DynamicResource GalleryText.Disabled}">
      <gallery:ExampleCard.Preview>
        <alder:AlderTextArea Width="242" IsEnabled="False" Text="{DynamicResource GalleryText.EditingIsDisabled}" AutomationProperties.Name="{DynamicResource GalleryText.DisabledNotes}" />
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var textArea = new AlderTextArea { Width = 242, IsEnabled = false, Text = "Editing is disabled." };
        AutomationProperties.SetName(textArea, "Disabled notes");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
  </StackPanel>
</UserControl>
