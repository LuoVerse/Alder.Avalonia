<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.EmojiPickerExample" x:DataType="vm:EmojiPickerViewModel">
  <StackPanel Spacing="20">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <g:ExampleCard.Preview>
        <Border Padding="24" MinHeight="120">
          <alder:AlderEmojiPicker HorizontalAlignment="Center" VerticalAlignment="Center"
                                  SelectedEmoji="{CompiledBinding Selected}" RecentEmojis="{CompiledBinding Recents}" />
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderEmojiPicker { SelectedEmoji = "😀" };
        picker.EmojiPicked += (_, args) => Console.WriteLine(args.Emoji);
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>

    <g:ExampleCard x:Name="SampleCustomCategories" Title="{DynamicResource GalleryText.EmojiCustomCategories}">
      <g:ExampleCard.Preview>
        <Border Padding="24" MinHeight="120">
          <alder:AlderEmojiPicker HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Categories="{CompiledBinding CustomCategories}" SelectedEmoji="😀" ShowRecent="False" />
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var categories = AlderEmojiPicker.DefaultCategories.ToArray();
        categories[0] = categories[0] with
        {
            IconData = Avalonia.Media.Geometry.Parse(
                "M2 8 A6 6 0 1 1 14 8 A6 6 0 1 1 2 8 M5.5 6 H5.6 M10.4 6 H10.5 M5.5 9.5 Q8 12 10.5 9.5")
        };
        var picker = new AlderEmojiPicker
        {
            SelectedEmoji = "😀", Categories = categories, ShowRecent = false
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>

    <g:ExampleCard x:Name="SampleInline" Title="{DynamicResource GalleryText.EmojiInline}">
      <g:ExampleCard.Preview>
        <Border Padding="16,24,16,38">
          <alder:AlderEmojiPicker HorizontalAlignment="Center" IsInline="True" SelectedEmoji="😀"
                                  RecentEmojis="{CompiledBinding Recents}" />
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderEmojiPicker { IsInline = true, SelectedEmoji = "😀" };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>

    <g:ExampleCard x:Name="SampleSizes" Title="{DynamicResource GalleryText.Sizes}">
      <g:ExampleCard.Preview>
        <Border Padding="24" MinHeight="120">
          <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="6">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.EmojiSizeSmall}" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
              <alder:AlderEmojiPicker Size="Small" SelectedEmoji="😎" RecentEmojis="{CompiledBinding Recents}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.EmojiSizeMedium}" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
              <alder:AlderEmojiPicker Size="Medium" SelectedEmoji="😎" RecentEmojis="{CompiledBinding Recents}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.EmojiSizeLarge}" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
              <alder:AlderEmojiPicker Size="Large" SelectedEmoji="😎" RecentEmojis="{CompiledBinding Recents}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var small = new AlderEmojiPicker { Size = AlderSize.Small, SelectedEmoji = "😎" };
        var medium = new AlderEmojiPicker { Size = AlderSize.Medium, SelectedEmoji = "😎" };
        var large = new AlderEmojiPicker { Size = AlderSize.Large, SelectedEmoji = "😎" };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
