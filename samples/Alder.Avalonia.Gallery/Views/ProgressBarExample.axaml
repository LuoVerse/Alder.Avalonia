<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:gallery="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.ProgressBarExample" x:DataType="vm:FeedbackViewModel">
  <StackPanel Spacing="20">
    <gallery:ExampleCard x:Name="SampleBasic" Title="{DynamicResource GalleryText.FeedbackBasic}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="14" MaxWidth="360">
          <alder:AlderProgressBar Color="{CompiledBinding PreviewColor}" Size="{CompiledBinding PreviewSize}"
                             Label="{DynamicResource GalleryText.FeedbackTransfer}" MaxWidth="256" Value="{CompiledBinding PreviewValue}"
                             IsIndeterminate="{CompiledBinding PreviewIsIndeterminate}" FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderSlider MaxWidth="256" Theme="{StaticResource AlderSliderTheme}" Maximum="100" SmallChange="1" LargeChange="10"
                  Value="{CompiledBinding PreviewValue, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource GalleryText.FeedbackValue}" />
          <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Center">
            <alder:AlderSelect MinWidth="108" Variant="Secondary"
                               AutomationProperties.Name="{DynamicResource GalleryText.FeedbackColors}"
                               SelectedItem="{CompiledBinding PreviewColor, Mode=TwoWay}"
                               ItemsSource="{CompiledBinding PreviewColors}" TextSelector="{CompiledBinding PreviewColorCaption}" />
            <alder:AlderSelect MinWidth="108" Variant="Secondary"
                               AutomationProperties.Name="{DynamicResource GalleryText.Sizes}"
                               SelectedItem="{CompiledBinding PreviewSize, Mode=TwoWay}"
                               ItemsSource="{CompiledBinding PreviewSizes}" TextSelector="{CompiledBinding PreviewSizeCaption}" />
          </WrapPanel>
          <alder:AlderCheckBox HorizontalAlignment="Center" Content="{DynamicResource GalleryText.FeedbackIndeterminate}"
                          IsChecked="{CompiledBinding PreviewIsIndeterminate, Mode=TwoWay}" />
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var indicator = new AlderProgressBar();
        indicator.Bind(AlderProgressBar.ColorProperty, CompiledBinding.Create((FeedbackViewModel model) => model.PreviewColor));
        indicator.Bind(AlderProgressBar.SizeProperty, CompiledBinding.Create((FeedbackViewModel model) => model.PreviewSize));
        indicator.Bind(RangeBase.ValueProperty, CompiledBinding.Create((FeedbackViewModel model) => model.PreviewValue));
        indicator.Bind(AlderProgressIndicator.IsIndeterminateProperty, CompiledBinding.Create((FeedbackViewModel model) => model.PreviewIsIndeterminate));
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleSizes" Title="{DynamicResource GalleryText.Sizes}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="256">
          <alder:AlderProgressBar Size="Small" Label="{DynamicResource GalleryText.Small}" Color="Accent" Value="40" FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderProgressBar Size="Medium" Label="{DynamicResource GalleryText.Medium}" Color="Accent" Value="60" FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderProgressBar Size="Large" Label="{DynamicResource GalleryText.Large}" Color="Accent" Value="80" FormatCulture="{DynamicResource GalleryCulture}" />
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var small = new AlderProgressBar { Size = AlderSize.Small, Color = FeedbackColor.Accent, Value = 40 };
        var medium = new AlderProgressBar { Size = AlderSize.Medium, Color = FeedbackColor.Accent, Value = 60 };
        var large = new AlderProgressBar { Size = AlderSize.Large, Color = FeedbackColor.Accent, Value = 80 };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleColors" Title="{DynamicResource GalleryText.FeedbackColors}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="256">
          <alder:AlderProgressBar Label="{DynamicResource GalleryText.FeedbackDefault}" Color="Default" Value="50" FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderProgressBar Label="{DynamicResource GalleryText.FeedbackAccent}" Color="Accent" Value="50" FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderProgressBar Label="{DynamicResource GalleryText.FeedbackSuccess}" Color="Success" Value="50" FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderProgressBar Label="{DynamicResource GalleryText.FeedbackWarning}" Color="Warning" Value="50" FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderProgressBar Label="{DynamicResource GalleryText.FeedbackDanger}" Color="Danger" Value="50" FormatCulture="{DynamicResource GalleryCulture}" />
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var defaultIndicator = new AlderProgressBar { Color = FeedbackColor.Default, Value = 50 };
        var accentIndicator = new AlderProgressBar { Color = FeedbackColor.Accent, Value = 50 };
        var successIndicator = new AlderProgressBar { Color = FeedbackColor.Success, Value = 50 };
        var warningIndicator = new AlderProgressBar { Color = FeedbackColor.Warning, Value = 50 };
        var dangerIndicator = new AlderProgressBar { Color = FeedbackColor.Danger, Value = 50 };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleNoLabel" Title="{DynamicResource GalleryText.FeedbackWithoutLabel}">
      <gallery:ExampleCard.Preview>
        <alder:AlderProgressBar MaxWidth="256" Value="45" ShowValue="False" AutomationProperties.Name="{DynamicResource GalleryText.FeedbackTransfer}" />
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var indicator = new AlderProgressBar { Value = 45, ShowValue = false };
        AutomationProperties.SetName(indicator, "File transfer");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleIndeterminate" Title="{DynamicResource GalleryText.FeedbackIndeterminate}">
      <gallery:ExampleCard.Preview>
        <StackPanel MaxWidth="256" Spacing="12">
          <alder:AlderProgressBar Label="{DynamicResource GalleryText.Loading}" Value="60"
                             IsIndeterminate="{CompiledBinding IsIndeterminate}" FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderCheckBox Content="{DynamicResource GalleryText.FeedbackIndeterminate}" IsChecked="{CompiledBinding IsIndeterminate, Mode=TwoWay}" />
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var progress = new AlderProgressBar { Label = "Loading", Value = 60 };
        progress.Bind(AlderProgressIndicator.IsIndeterminateProperty, CompiledBinding.Create((FeedbackViewModel model) => model.IsIndeterminate));
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleRange" Title="{DynamicResource GalleryText.FeedbackCustomRange}">
      <gallery:ExampleCard.Preview>
        <StackPanel MaxWidth="208" Spacing="12">
          <alder:AlderProgressBar Label="{DynamicResource GalleryText.FeedbackTransfer}" Minimum="100" Maximum="1000"
                       Value="{CompiledBinding Work}" FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderSlider Minimum="100" Maximum="1000" SmallChange="1" LargeChange="100" Theme="{StaticResource AlderSliderTheme}"
                  Value="{CompiledBinding Work, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource GalleryText.FeedbackTransfer}" />
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var indicator = new AlderProgressBar
        {
            Minimum = 100, Maximum = 1000, Label = "File transfer"
        };
        indicator.Bind(RangeBase.ValueProperty, CompiledBinding.Create((FeedbackViewModel model) => model.Work));
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleCustom" Title="{DynamicResource GalleryText.CustomStyles}">
      <gallery:ExampleCard.Preview>
        <alder:AlderProgressBar MaxWidth="256" Label="{DynamicResource GalleryText.FeedbackUpload}" Value="45"
                           CustomValueText="{DynamicResource GalleryText.FeedbackUploadValue}"
                           IndicatorBrush="{DynamicResource AlderSoftInk}" TrackBrush="{DynamicResource AlderSoft}" />
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var progress = new AlderProgressBar { Label = "Uploading files", Value = 45, CustomValueText = "9 of 20 files" };
        progress[!AlderRangeIndicator.IndicatorBrushProperty] = new DynamicResourceExtension("AlderSoftInk");
        progress[!AlderRangeIndicator.TrackBrushProperty] = new DynamicResourceExtension("AlderSoft");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleStates" Title="{DynamicResource GalleryText.FeedbackProgressStates}">
      <gallery:ExampleCard.Preview>
        <StackPanel MaxWidth="256" Spacing="12">
          <alder:AlderProgressBar Label="{DynamicResource GalleryText.FeedbackNotStarted}" Value="0"
                             FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderProgressBar Label="{DynamicResource GalleryText.FeedbackComplete}" Value="100" Color="Success"
                             FormatCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderProgressBar Label="{DynamicResource GalleryText.Disabled}" Value="60" IsEnabled="False"
                             FormatCulture="{DynamicResource GalleryCulture}" />
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var empty = new AlderProgressBar { Label = "Not started", Value = 0 };
        var complete = new AlderProgressBar { Label = "Complete", Value = 100, Color = FeedbackColor.Success };
        var disabled = new AlderProgressBar { Label = "Disabled", Value = 60, IsEnabled = false };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
  </StackPanel>
</UserControl>
