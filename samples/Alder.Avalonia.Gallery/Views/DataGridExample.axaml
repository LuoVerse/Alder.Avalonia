<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.DataGridExample" x:DataType="vm:DataGridViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="GridStatus" x:DataType="vm:DataGridDemoRow">
      <alder:AlderChip Size="Small" Variant="Soft" Color="{CompiledBinding Color}" Content="{CompiledBinding Status}" HorizontalAlignment="Left" />
    </DataTemplate>
    <DataTemplate x:Key="GridPerson" x:DataType="vm:DataGridDemoRow">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <alder:AlderTextBlock Text="{CompiledBinding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <alder:AlderTextBlock Text="{CompiledBinding Detail}" FontSize="12" Foreground="{DynamicResource AlderMuted}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GridAvatarPerson" x:DataType="vm:DataGridDemoRow">
      <Grid ColumnDefinitions="28,*" ColumnSpacing="8" VerticalAlignment="Center">
        <Border CornerRadius="14" Width="28" Height="28" Background="{DynamicResource AlderSurfaceSecondary}">
          <alder:AlderTextBlock Text="{CompiledBinding Initials}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <alder:AlderTextBlock Text="{CompiledBinding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <alder:AlderTextBlock Text="{CompiledBinding Detail}" FontSize="12" Foreground="{DynamicResource AlderMuted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <StreamGeometry x:Key="GridFolderIcon">M1 3 H7 L9 5 H15 V13 H1 Z</StreamGeometry>
    <StreamGeometry x:Key="GridFileIcon">M3 1 H9 L13 5 V15 H3 Z</StreamGeometry>
    <DataTemplate x:Key="GridFileName" x:DataType="vm:DataGridDemoRow">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <alder:AlderPathIcon Data="{StaticResource GridFolderIcon}" Width="14" Height="14" Foreground="{DynamicResource AlderStatusWarning}" IsVisible="{CompiledBinding IsFolder}" />
        <alder:AlderPathIcon Data="{StaticResource GridFileIcon}" Width="13" Height="14" Foreground="{DynamicResource AlderMuted}" IsVisible="{CompiledBinding !IsFolder}" />
        <alder:AlderTextBlock Text="{CompiledBinding Name}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GridTaskPriority" x:DataType="vm:DataGridDemoRow">
      <alder:AlderChip Size="Small" Variant="Soft" Color="{CompiledBinding RoleColor}" Content="{CompiledBinding Role}" />
    </DataTemplate>
    <DataTemplate x:Key="GridPriorityLabel" x:DataType="vm:DataGridPriority">
      <alder:AlderChip Size="Small" Variant="Soft" Color="{CompiledBinding Color}" Content="{CompiledBinding Text}" />
    </DataTemplate>
    <DataTemplate x:Key="GridCompany" x:DataType="vm:DataGridDemoRow">
      <StackPanel Orientation="Horizontal" Spacing="7">
        <alder:AlderAvatar Width="18" Height="18" Fallback="{CompiledBinding CompanyMark}" />
        <alder:AlderTextBlock Text="{CompiledBinding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GridCategories" x:DataType="vm:DataGridDemoRow">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <alder:AlderChip Size="Small" Variant="Soft" Color="Warning" Content="{CompiledBinding SecondaryTag}" />
        <alder:AlderChip Size="Small" Variant="Soft" Color="{CompiledBinding RoleColor}" Content="{CompiledBinding Role}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GridCapacity" x:DataType="vm:DataGridDemoRow">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <alder:AlderProgressCircle Diameter="15" StrokeThickness="1.75" Color="{CompiledBinding CapacityColor}"
                                   Value="{CompiledBinding Capacity}" AutomationProperties.Name="{DynamicResource GalleryText.DataGridCapacity}" />
        <alder:AlderTextBlock Text="{CompiledBinding Detail}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GridRequests" x:DataType="vm:DataGridDemoRow">
      <alder:AlderAreaChart Width="90" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Categories="{CompiledBinding RequestCategories}" Series="{CompiledBinding RequestSeries}"
                            ShowXAxis="False" ShowYAxis="False" ShowGrid="False" ShowTooltip="False" ShowHoverMarker="True"
                            IsAnimationEnabled="False" ClipToBounds="True" Focusable="False" Padding="0,2,0,0"
                            AutomationProperties.Name="{DynamicResource GalleryText.DataGridRequests}">
        <alder:AlderAreaChart.OpacityMask>
          <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Color="Transparent" Offset="0" />
            <GradientStop Color="Black" Offset="0.1" />
            <GradientStop Color="Black" Offset="0.9" />
            <GradientStop Color="Transparent" Offset="1" />
          </LinearGradientBrush>
        </alder:AlderAreaChart.OpacityMask>
      </alder:AlderAreaChart>
    </DataTemplate>
    <DataTemplate x:Key="GridProductName" x:DataType="vm:DataGridDemoRow">
      <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
        <Border CornerRadius="8" Width="40" Height="40" Background="{DynamicResource AlderNeutral}">
          <alder:AlderTextBlock Text="{CompiledBinding CompanyMark}" Foreground="{DynamicResource AlderMuted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <alder:AlderTextBlock Grid.Column="1" Text="{CompiledBinding Name}" VerticalAlignment="Center"
                   FontWeight="Medium" TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="GridRating" x:DataType="vm:DataGridDemoRow">
      <StackPanel Orientation="Horizontal" AutomationProperties.Name="{CompiledBinding RatingLabel}">
        <alder:AlderTextBlock Text="{CompiledBinding RatedStars}" Foreground="{DynamicResource AlderStatusWarning}" />
        <alder:AlderTextBlock Text="{CompiledBinding UnratedStars}" Foreground="{DynamicResource AlderSeparator}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="GridPaymentActions" x:DataType="vm:DataGridDemoRow">
      <alder:AlderButton Theme="{StaticResource AlderDataGridRowActionsButtonTheme}"
                         AutomationProperties.Name="{DynamicResource GalleryText.DataGridActions}">
        <alder:AlderButton.Flyout>
          <alder:AlderDropdownFlyout MinMenuWidth="180">
            <alder:AlderMenuItem Header="{DynamicResource GalleryText.DataGridCopyPaymentId}" Command="{CompiledBinding CopyPaymentIdAction}" CommandParameter="{CompiledBinding $self}">
              <MenuItem.Icon><alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconCopy}" /></MenuItem.Icon>
            </alder:AlderMenuItem>
            <alder:AlderMenuItem Header="{DynamicResource GalleryText.DataGridDetails}" Command="{CompiledBinding ViewAction}">
              <MenuItem.Icon><alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconEye}" /></MenuItem.Icon>
            </alder:AlderMenuItem>
            <alder:AlderMenuItem Header="{DynamicResource GalleryText.DataGridEditPayment}" Command="{CompiledBinding EditAction}">
              <MenuItem.Icon><alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconPencil}" /></MenuItem.Icon>
            </alder:AlderMenuItem>
            <alder:AlderMenuItem Header="{DynamicResource GalleryText.DataGridDelete}" Command="{CompiledBinding DeleteAction}" Classes="danger">
              <MenuItem.Icon><alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconTrash}" /></MenuItem.Icon>
            </alder:AlderMenuItem>
          </alder:AlderDropdownFlyout>
        </alder:AlderButton.Flyout>
      </alder:AlderButton>
    </DataTemplate>
    <DataTemplate x:Key="GridTeamActions" x:DataType="vm:DataGridDemoRow">
      <alder:AlderButton Theme="{StaticResource AlderDataGridRowActionsButtonTheme}"
                         AutomationProperties.Name="{DynamicResource GalleryText.DataGridActions}">
        <alder:AlderButton.Flyout>
          <alder:AlderDropdownFlyout>
            <alder:AlderMenuItem Header="{DynamicResource GalleryText.DataGridView}" Command="{CompiledBinding ViewAction}">
              <MenuItem.Icon><alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconEye}" /></MenuItem.Icon>
            </alder:AlderMenuItem>
            <alder:AlderMenuItem Header="{DynamicResource GalleryText.DataGridEdit}" Command="{CompiledBinding EditAction}">
              <MenuItem.Icon><alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconPencil}" /></MenuItem.Icon>
            </alder:AlderMenuItem>
            <alder:AlderMenuItem Header="{DynamicResource GalleryText.DataGridDelete}" Command="{CompiledBinding DeleteAction}" Classes="danger">
              <MenuItem.Icon><alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconTrash}" /></MenuItem.Icon>
            </alder:AlderMenuItem>
          </alder:AlderDropdownFlyout>
        </alder:AlderButton.Flyout>
      </alder:AlderButton>
    </DataTemplate>
    <DataTemplate x:Key="GridEditAction" x:DataType="vm:DataGridDemoRow">
      <alder:AlderButton Size="Small" Variant="Ghost" Height="30" MinHeight="30" Padding="6,2" Content="{DynamicResource GalleryText.DataGridEdit}" Command="{CompiledBinding EditAction}" />
    </DataTemplate>
    <DataTemplate x:Key="GridNameEditor" x:DataType="vm:DataGridDemoRow">
      <alder:AlderInput Text="{CompiledBinding Name, Mode=TwoWay}" Variant="Secondary" Height="30" FullWidth="True" Padding="5,4" Background="Transparent"
                        AutomationProperties.Name="{DynamicResource GalleryText.DataGridFeature}" />
    </DataTemplate>
    <DataTemplate x:Key="GridPriorityEditor" x:DataType="vm:DataGridDemoRow">
      <alder:AlderSelect ItemsSource="{CompiledBinding Priorities}" SelectedIndex="{CompiledBinding Priority, Mode=TwoWay}"
                         Theme="{StaticResource AlderNavbarInlineSelectTheme}" Width="112" DropDownMinWidth="125"
                         SelectionTemplate="{StaticResource GridPriorityLabel}" ItemTemplate="{StaticResource GridPriorityLabel}"
                         AutomationProperties.Name="{DynamicResource GalleryText.DataGridPriority}" />
    </DataTemplate>
    <DataTemplate x:Key="GridPointsEditor" x:DataType="vm:DataGridDemoRow">
      <alder:AlderNumberStepper Size="Small" Value="{CompiledBinding Points, Mode=TwoWay}"
                             Minimum="0" Maximum="99" ClipValueToMinMax="True" FormatString="0" AutomationProperties.Name="{DynamicResource GalleryText.DataGridStoryPoints}" />
    </DataTemplate>
    <DataTemplate x:Key="GridEnabledEditor" x:DataType="vm:DataGridDemoRow">
      <alder:AlderSwitch Theme="{StaticResource AlderSwitchTheme}" Size="Small" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}"
                    HorizontalAlignment="Center" AutomationProperties.Name="{DynamicResource GalleryText.DataGridEnabled}" />
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.grid-preview-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.grid-preview-note">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource AlderMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="20">
    <g:ExampleCard x:Name="SampleUsers" Title="{DynamicResource GalleryText.DataGridUsage}">
      <g:ExampleCard.Preview>
        <Border Padding="12,20" MinHeight="444">
          <StackPanel Spacing="12" MaxWidth="896" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                <StackPanel Spacing="4">
                  <alder:AlderTextBlock Classes="grid-preview-title" Text="{DynamicResource GalleryText.DataGridUsers}" />
                  <alder:AlderTextBlock Classes="grid-preview-note" Text="{DynamicResource GalleryText.DataGridUsersDescription}" />
                </StackPanel>
                <Panel Grid.Column="1" HorizontalAlignment="Right"><alder:AlderButton Size="Small" Variant="Secondary" Content="{DynamicResource GalleryText.DataGridAddUser}" Command="{CompiledBinding AddUser}" /></Panel>
            </Grid>
            <alder:AlderDataGrid ItemsSource="{CompiledBinding Users}" RowKeySelector="{CompiledBinding RowKey}"
                                 AutomationProperties.Name="{DynamicResource GalleryText.DataGridUsage}" Variant="Secondary" MinRowHeight="45">
              <alder:AlderTableColumn Key="name" Header="{DynamicResource GalleryText.DataGridName}" Width="1.15*" MinWidth="120" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Name}" />
              <alder:AlderTableColumn Key="title" Header="{DynamicResource GalleryText.DataGridTitle}" Width="1.35*" MinWidth="125" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Role}" />
              <alder:AlderTableColumn Key="email" Header="{DynamicResource GalleryText.DataGridEmail}" Width="1.65*" MinWidth="150" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Detail}" />
              <alder:AlderTableColumn Key="role" Header="{DynamicResource GalleryText.DataGridRole}" Width="*" MinWidth="82" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Status}" />
              <alder:AlderTableColumn Key="actions" Header="" Width="64" CellTemplate="{StaticResource GridEditAction}" />
            </alder:AlderDataGrid>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var grid = new AlderDataGrid { Variant = TableVariant.Secondary, MinRowHeight = 45 };
        grid.Bind(AlderDataGrid.ItemsSourceProperty, CompiledBinding.Create((DataGridViewModel model) => model.Users));
        grid.Bind(AlderDataGrid.RowKeySelectorProperty, CompiledBinding.Create((DataGridViewModel model) => model.RowKey));
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "name",
            Header = "Name",
            Width = new GridLength(1.15, GridUnitType.Star),
            MinWidth = 120,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Name)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "title",
            Header = "Title",
            Width = new GridLength(1.35, GridUnitType.Star),
            MinWidth = 125,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Role)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "email",
            Header = "Email",
            Width = new GridLength(1.65, GridUnitType.Star),
            MinWidth = 150,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Detail)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "role",
            Header = "Role",
            Width = new GridLength(1, GridUnitType.Star),
            MinWidth = 82,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Status)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "actions",
            Header = "Actions",
            Width = new GridLength(64),
            CellTemplate = (IDataTemplate)this.FindResource("GridEditAction")!
        });
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SamplePayments" Title="{DynamicResource GalleryText.DataGridPayments}">
      <g:ExampleCard.Preview>
        <Border Padding="12,20" MinHeight="450">
          <StackPanel Spacing="12" MaxWidth="1020" VerticalAlignment="Center">
            <alder:AlderDataGrid ItemsSource="{CompiledBinding Payments}" RowKeySelector="{CompiledBinding RowKey}"
                                 AutomationProperties.Name="{DynamicResource GalleryText.DataGridPayments}" MinRowHeight="62" SelectionMode="Multiple" ShowSelectionCheckboxes="True" CanResizeColumns="True">
              <alder:AlderTableColumn Key="name" Header="{DynamicResource GalleryText.DataGridCustomer}" Width="240" MinWidth="200" CanSort="True" SortComparison="{CompiledBinding CompareName}" CellTemplate="{StaticResource GridPerson}" />
              <alder:AlderTableColumn Key="code" Header="{DynamicResource GalleryText.DataGridTransactionId}" Width="130" MinWidth="130" CanSort="True" SortComparison="{CompiledBinding CompareCode}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding Code}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="status" Header="{DynamicResource GalleryText.DataGridStatus}" Width="120" MinWidth="120" CanSort="True" SortComparison="{CompiledBinding CompareStatus}" CellTemplate="{StaticResource GridStatus}" />
              <alder:AlderTableColumn Key="amount" Header="{DynamicResource GalleryText.DataGridAmount}" Width="110" MinWidth="110" HorizontalContentAlignment="Right" CanSort="True" SortComparison="{CompiledBinding CompareAmount}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding AmountLabel}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="fee" Header="{DynamicResource GalleryText.DataGridFee}" Width="90" MinWidth="90" HorizontalContentAlignment="Right" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding FeeLabel}" />
              <alder:AlderTableColumn Key="net" Header="{DynamicResource GalleryText.DataGridNet}" Width="110" MinWidth="110" HorizontalContentAlignment="Right" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding NetLabel}" />
              <alder:AlderTableColumn Key="paymentMethod" Header="{DynamicResource GalleryText.DataGridPaymentMethod}" Width="170" MinWidth="170" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Method}" />
              <alder:AlderTableColumn Key="region" Header="{DynamicResource GalleryText.DataGridRegion}" Width="130" MinWidth="130" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Region}" />
              <alder:AlderTableColumn Key="description" Header="{DynamicResource GalleryText.DataGridDescription}" Width="240" MinWidth="240" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Role}" />
              <alder:AlderTableColumn Key="date" Header="{DynamicResource GalleryText.DataGridDate}" Width="120" MinWidth="120" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Date}" />
              <alder:AlderTableColumn Key="actions" Header="" Width="75" CanUserResize="False" HorizontalContentAlignment="Center" Pin="End" CellTheme="{StaticResource AlderDataGridActionsCellTheme}" CellTemplate="{StaticResource GridPaymentActions}" />
            </alder:AlderDataGrid>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var grid = new AlderDataGrid { MinRowHeight = 62, SelectionMode = TableSelectionMode.Multiple, ShowSelectionCheckboxes = true, CanResizeColumns = true };
        grid.Bind(AlderDataGrid.ItemsSourceProperty, CompiledBinding.Create((DataGridViewModel model) => model.Payments));
        grid.Bind(AlderDataGrid.RowKeySelectorProperty, CompiledBinding.Create((DataGridViewModel model) => model.RowKey));
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "name",
            Header = "Customer",
            Width = new GridLength(240),
            MinWidth = 200,
            CanSort = true,
            SortComparison = viewModel.CompareName,
            CellTemplate = (IDataTemplate)this.FindResource("GridPerson")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "code",
            Header = "Transaction ID",
            Width = new GridLength(130),
            MinWidth = 130,
            CanSort = true,
            SortComparison = viewModel.CompareCode,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Code)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "status",
            Header = "Status",
            Width = new GridLength(120),
            MinWidth = 120,
            CanSort = true,
            SortComparison = viewModel.CompareStatus,
            CellTemplate = (IDataTemplate)this.FindResource("GridStatus")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "amount",
            Header = "Amount",
            Width = new GridLength(110),
            MinWidth = 110,
            HorizontalContentAlignment = HorizontalAlignment.Right,
            CanSort = true,
            SortComparison = viewModel.CompareAmount,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.AmountLabel)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "fee",
            Header = "Fee",
            Width = new GridLength(90),
            MinWidth = 90,
            HorizontalContentAlignment = HorizontalAlignment.Right,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.FeeLabel)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "net",
            Header = "Net",
            Width = new GridLength(110),
            MinWidth = 110,
            HorizontalContentAlignment = HorizontalAlignment.Right,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.NetLabel)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "paymentMethod",
            Header = "Payment Method",
            Width = new GridLength(170),
            MinWidth = 170,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Method)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "region",
            Header = "Region",
            Width = new GridLength(130),
            MinWidth = 130,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Region)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "description",
            Header = "Description",
            Width = new GridLength(240),
            MinWidth = 240,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Role)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "date",
            Header = "Date",
            Width = new GridLength(120),
            MinWidth = 120,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Date)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "actions",
            Header = "Actions",
            Width = new GridLength(75),
            CanUserResize = false,
            HorizontalContentAlignment = HorizontalAlignment.Center,
            Pin = TableColumnPin.End,
            CellTheme = (ControlTheme)this.FindResource("AlderDataGridActionsCellTheme")!,
            CellTemplate = (IDataTemplate)this.FindResource("GridPaymentActions")!
        });
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleTeam" Title="{DynamicResource GalleryText.DataGridTeamMembers}">
      <g:ExampleCard.Preview>
        <Border Padding="12,20" MinHeight="670">
          <StackPanel Spacing="12" MaxWidth="1020" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <alder:AlderTextBlock Classes="grid-preview-title" Text="{DynamicResource GalleryText.DataGridTeamMembers}" />
                  <alder:AlderChip Size="Small" Content="{CompiledBinding TeamCount}" VerticalAlignment="Center" />
                </StackPanel>
                <Panel Grid.Column="1" HorizontalAlignment="Right"><alder:AlderButton Size="Small" Variant="Primary" Content="{DynamicResource GalleryText.DataGridAddMember}" Command="{CompiledBinding AddMember}" Icon="{DynamicResource AlderIconPlus}" /></Panel>
            </Grid>
            <WrapPanel ItemSpacing="6" LineSpacing="6" HorizontalAlignment="Left">
              <alder:AlderSearchField Width="170" Variant="Secondary" PlaceholderText="{DynamicResource GalleryText.DataGridSearch}" Text="{CompiledBinding TeamSearch, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource GalleryText.DataGridSearch}" />
              <alder:AlderSelect ItemsSource="{CompiledBinding WorkerOptions}" SelectedIndex="{CompiledBinding WorkerFilter, Mode=TwoWay}" Variant="Secondary" Width="138" AutomationProperties.Name="{DynamicResource GalleryText.DataGridWorkerType}" />
              <alder:AlderSelect ItemsSource="{CompiledBinding StatusOptions}" SelectedIndex="{CompiledBinding StatusFilter, Mode=TwoWay}" Variant="Secondary" Width="138" AutomationProperties.Name="{DynamicResource GalleryText.DataGridStatus}" />
              <alder:AlderButton Size="Small" Variant="Secondary" Content="{DynamicResource GalleryText.DataGridSort}" Command="{CompiledBinding SortTeam}" />
              <alder:AlderButton Size="Small" Variant="Secondary" Content="{DynamicResource GalleryText.DataGridColumns}">
                <alder:AlderButton.Flyout>
                  <alder:AlderPopover Placement="BottomEdgeAlignedLeft" ContentPadding="12" SurfaceCornerRadius="12">
                    <StackPanel Spacing="8" MinWidth="120">
                      <alder:AlderCheckBox Content="{DynamicResource GalleryText.DataGridCountry}" IsChecked="{CompiledBinding ShowTeamCountry, Mode=TwoWay}" />
                      <alder:AlderCheckBox Content="{DynamicResource GalleryText.DataGridRole}" IsChecked="{CompiledBinding ShowTeamRole, Mode=TwoWay}" />
                    </StackPanel>
                  </alder:AlderPopover>
                </alder:AlderButton.Flyout>
              </alder:AlderButton>
              <alder:AlderButton Size="Small" Variant="Secondary" Content="{DynamicResource GalleryText.Reset}" Command="{CompiledBinding ResetTeam}" />
            </WrapPanel>
            <alder:AlderDataGrid ItemsSource="{CompiledBinding TeamRows}" RowKeySelector="{CompiledBinding RowKey}"
                                 AutomationProperties.Name="{DynamicResource GalleryText.DataGridTeamMembers}" Height="614" MinRowHeight="52" SortMode="External" SelectionMode="Multiple" ShowSelectionCheckboxes="True" CanResizeColumns="True"
                                 SortDescriptor="{CompiledBinding TeamSort, Mode=TwoWay}"
                                 SelectedKeys="{CompiledBinding TeamSelection, Mode=TwoWay}">
              <alder:AlderTableColumn Key="code" Header="{DynamicResource GalleryText.DataGridWorkerId}" Width="122" MinWidth="100" CanSort="True" SortComparison="{CompiledBinding CompareCode}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding Code}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="externalId" Header="{DynamicResource GalleryText.DataGridExternalId}" Width="171" MinWidth="160" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Reference}" />
              <alder:AlderTableColumn Key="name" Header="{DynamicResource GalleryText.DataGridMember}" Width="235" MinWidth="220" CanSort="True" SortComparison="{CompiledBinding CompareName}" CellTemplate="{StaticResource GridAvatarPerson}" />
              <alder:AlderTableColumn Key="country" Header="{DynamicResource GalleryText.DataGridCountry}" Width="149" MinWidth="140" IsVisible="{CompiledBinding ShowTeamCountry}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding Region}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="role" Header="{DynamicResource GalleryText.DataGridRole}" Width="149" MinWidth="140" IsVisible="{CompiledBinding ShowTeamRole}">
