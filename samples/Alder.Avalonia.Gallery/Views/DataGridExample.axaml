              <alder:AlderTableColumn Key="priority" Header="{DynamicResource GalleryText.DataGridPriority}" Width="1*" MinWidth="105" CellTemplate="{StaticResource GridPriorityEditor}" />
              <alder:AlderTableColumn Key="storyPoints" Header="{DynamicResource GalleryText.DataGridStoryPoints}" Width="1*" MinWidth="110" HorizontalContentAlignment="Center" CellTemplate="{StaticResource GridPointsEditor}" />
              <alder:AlderTableColumn Key="enabled" Header="{DynamicResource GalleryText.DataGridEnabled}" Width="*" MinWidth="84" CellTemplate="{StaticResource GridEnabledEditor}" />
              <alder:AlderDataGrid.Footer>
                <alder:AlderTextBlock Classes="grid-preview-note" Text="{CompiledBinding FeatureSummary}" />
              </alder:AlderDataGrid.Footer>
            </alder:AlderDataGrid>
          </StackPanel>
        </Border>
