              <alder:AlderTableColumn Key="workerType" Header="{DynamicResource GalleryText.DataGridWorkerType}" Width="120" MinWidth="110" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Category}" />
              <alder:AlderTableColumn Key="status" Header="{DynamicResource GalleryText.DataGridStatus}" Width="122" MinWidth="100" CanSort="True" SortComparison="{CompiledBinding CompareStatus}" CellTemplate="{StaticResource GridStatus}" />
              <alder:AlderTableColumn Key="startDate" Header="{DynamicResource GalleryText.DataGridStartDate}" Width="160" MinWidth="150" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Date}" />
              <alder:AlderTableColumn Key="teams" Header="{DynamicResource GalleryText.DataGridTeams}" Width="277" MinWidth="260" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Method}" />
              <alder:AlderTableColumn Key="actions" Header="" Width="53" MinWidth="50" HorizontalContentAlignment="Center" CellTheme="{StaticResource AlderDataGridActionsCellTheme}" CellTemplate="{StaticResource GridTeamActions}" />
              <alder:AlderDataGrid.Footer>
                <alder:AlderPagination Size="Small" CurrentPage="{CompiledBinding TeamPage, Mode=TwoWay}" PageCount="{CompiledBinding TeamPageCount}" Summary="{CompiledBinding TeamSummary}" />
              </alder:AlderDataGrid.Footer>
            </alder:AlderDataGrid>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var grid = new AlderDataGrid { Height = 614, MinRowHeight = 52, SortMode = DataGridSortMode.External, SelectionMode = TableSelectionMode.Multiple, ShowSelectionCheckboxes = true, CanResizeColumns = true };
        grid.Bind(AlderDataGrid.ItemsSourceProperty, CompiledBinding.Create((DataGridViewModel model) => model.TeamRows));
        grid.Bind(AlderDataGrid.SelectedKeysProperty, CompiledBinding.Create((DataGridViewModel model) => model.TeamSelection, mode: BindingMode.TwoWay));
        var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary };
        reset.Bind(Button.CommandProperty, CompiledBinding.Create((DataGridViewModel model) => model.ResetTeam));
        grid.Bind(AlderDataGrid.RowKeySelectorProperty, CompiledBinding.Create((DataGridViewModel model) => model.RowKey));
        grid.Bind(AlderDataGrid.SortDescriptorProperty, CompiledBinding.Create((DataGridViewModel model) => model.TeamSort, mode: BindingMode.TwoWay));
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "code",
            Header = "Worker ID",
            Width = new GridLength(122),
            MinWidth = 100,
            CanSort = true,
            SortComparison = viewModel.CompareCode,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Code)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "externalId",
            Header = "External Worker ID",
            Width = new GridLength(171),
            MinWidth = 160,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Reference)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "name",
            Header = "Member",
            Width = new GridLength(235),
            MinWidth = 220,
            CanSort = true,
            SortComparison = viewModel.CompareName,
            CellTemplate = (IDataTemplate)this.FindResource("GridAvatarPerson")!
        });
        var columnCountry = new AlderTableColumn
        {
            Key = "country",
            Header = "Country",
            Width = new GridLength(149),
            MinWidth = 140,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Region)
        };
        columnCountry.Bind(TableViewColumn.IsVisibleProperty, CompiledBinding.Create((DataGridViewModel model) => model.ShowTeamCountry));
        grid.Columns.Add(columnCountry);
        var columnRole = new AlderTableColumn
        {
            Key = "role",
            Header = "Role",
            Width = new GridLength(149),
            MinWidth = 140,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Role)
        };
        columnRole.Bind(TableViewColumn.IsVisibleProperty, CompiledBinding.Create((DataGridViewModel model) => model.ShowTeamRole));
        grid.Columns.Add(columnRole);
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "workerType",
            Header = "Worker Type",
            Width = new GridLength(120),
            MinWidth = 110,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Category)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "status",
            Header = "Status",
            Width = new GridLength(122),
            MinWidth = 100,
            CanSort = true,
            SortComparison = viewModel.CompareStatus,
            CellTemplate = (IDataTemplate)this.FindResource("GridStatus")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "startDate",
            Header = "Start Date",
            Width = new GridLength(160),
            MinWidth = 150,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Date)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "teams",
            Header = "Teams",
            Width = new GridLength(277),
            MinWidth = 260,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Method)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "actions",
            Header = "Actions",
            Width = new GridLength(53),
            MinWidth = 50,
            HorizontalContentAlignment = HorizontalAlignment.Center,
            CellTheme = (ControlTheme)this.FindResource("AlderDataGridActionsCellTheme")!,
            CellTemplate = (IDataTemplate)this.FindResource("GridTeamActions")!
        });
        var footer = new AlderPagination { Size = AlderSize.Small };
        footer.Bind(AlderPagination.CurrentPageProperty, CompiledBinding.Create((DataGridViewModel model) => model.TeamPage, mode: BindingMode.TwoWay));
        footer.Bind(AlderPagination.PageCountProperty, CompiledBinding.Create((DataGridViewModel model) => model.TeamPageCount));
        footer.Bind(AlderPagination.SummaryProperty, CompiledBinding.Create((DataGridViewModel model) => model.TeamSummary));
        grid.Footer = footer;

        var preview = new StackPanel { Spacing = 12, Children = { reset, grid } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
