              <alder:AlderTableColumn Key="fee" Header="{DynamicResource GalleryText.DataGridFee}" Width="90" MinWidth="90" HorizontalContentAlignment="Right" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding FeeLabel}" />
              <alder:AlderTableColumn Key="net" Header="{DynamicResource GalleryText.DataGridNet}" Width="110" MinWidth="110" HorizontalContentAlignment="Right" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding NetLabel}" />
              <alder:AlderTableColumn Key="paymentMethod" Header="{DynamicResource GalleryText.DataGridPaymentMethod}" Width="170" MinWidth="170" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Method}" />
              <alder:AlderTableColumn Key="region" Header="{DynamicResource GalleryText.DataGridRegion}" Width="130" MinWidth="130" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Region}" />
              <alder:AlderTableColumn Key="description" Header="{DynamicResource GalleryText.DataGridDescription}" Width="240" MinWidth="240" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Role}" />
              <alder:AlderTableColumn Key="date" Header="{DynamicResource GalleryText.DataGridDate}" Width="120" MinWidth="120" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Date}" />
              <alder:AlderTableColumn Key="actions" Header="" Width="75" CanUserResize="False" HorizontalContentAlignment="Center" Pin="End" CellTheme="{StaticResource AlderDataGridActionsCellTheme}" CellTemplate="{StaticResource GridPaymentActions}" />
            </alder:AlderDataGrid>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var grid = new AlderDataGrid { Height = 324, HeadingHeight = 36, MinRowHeight = 62, SelectionMode = TableSelectionMode.Multiple, ShowSelectionCheckboxes = true, CanResizeColumns = true };
        grid.Bind(AlderDataGrid.ItemsSourceProperty, CompiledBinding.Create((DataGridViewModel model) => model.Payments));
        grid.Bind(AlderDataGrid.RowKeySelectorProperty, CompiledBinding.Create((DataGridViewModel model) => model.RowKey));
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "name",
            Header = "Customer",
            Width = new GridLength(240),
            MinWidth = 200,
            CanSort = true,
            SortComparison = viewModel.CompareName,
            CellTemplate = (IDataTemplate)this.FindResource("GridPerson")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "code",
            Header = "Transaction ID",
            Width = new GridLength(130),
            MinWidth = 130,
            CanSort = true,
            SortComparison = viewModel.CompareCode,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Code)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "status",
            Header = "Status",
            Width = new GridLength(120),
            MinWidth = 120,
            CanSort = true,
            SortComparison = viewModel.CompareStatus,
            CellTemplate = (IDataTemplate)this.FindResource("GridStatus")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "amount",
            Header = "Amount",
            Width = new GridLength(110),
            MinWidth = 110,
            HorizontalContentAlignment = HorizontalAlignment.Right,
            CanSort = true,
            SortComparison = viewModel.CompareAmount,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.AmountLabel)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "fee",
            Header = "Fee",
            Width = new GridLength(90),
            MinWidth = 90,
            HorizontalContentAlignment = HorizontalAlignment.Right,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.FeeLabel)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "net",
            Header = "Net",
            Width = new GridLength(110),
            MinWidth = 110,
            HorizontalContentAlignment = HorizontalAlignment.Right,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.NetLabel)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "paymentMethod",
            Header = "Payment Method",
            Width = new GridLength(170),
            MinWidth = 170,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Method)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "region",
            Header = "Region",
            Width = new GridLength(130),
            MinWidth = 130,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Region)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "description",
            Header = "Description",
            Width = new GridLength(240),
            MinWidth = 240,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Role)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "date",
            Header = "Date",
            Width = new GridLength(120),
            MinWidth = 120,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Date)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "actions",
            Header = "Actions",
            Width = new GridLength(75),
            CanUserResize = false,
            HorizontalContentAlignment = HorizontalAlignment.Center,
            Pin = TableColumnPin.End,
            CellTheme = (ControlTheme)this.FindResource("AlderDataGridActionsCellTheme")!,
            CellTemplate = (IDataTemplate)this.FindResource("GridPaymentActions")!
        });
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVirtual" Title="{DynamicResource GalleryText.DataGridVirtualized}">
      <g:ExampleCard.Preview>
        <Border Padding="12,20" MinHeight="716">
          <StackPanel Spacing="12" MaxWidth="1020" VerticalAlignment="Center">
            <Border Container.Name="ProductFilters" Container.Sizing="Width">
              <Border.Styles>
                <Style Selector="WrapPanel.product-filters">
                  <Setter Property="Grid.Column" Value="1" />
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
                <ContainerQuery Name="ProductFilters" Query="max-width:700">
                  <Style Selector="WrapPanel.product-filters">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                  </Style>
                </ContainerQuery>
              </Border.Styles>
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                <alder:AlderSegment Size="Small" HorizontalAlignment="Left" SelectedKey="{CompiledBinding StockFilter, Mode=TwoWay}"
                                    AutomationProperties.Name="{DynamicResource GalleryText.DataGridStock}">
                  <alder:AlderSegmentItem Key="all" Content="{DynamicResource GalleryText.DataGridAll}" />
                  <alder:AlderSegmentItem Key="in" Content="{DynamicResource GalleryText.DataGridInStock}" />
                  <alder:AlderSegmentItem Key="out" Content="{DynamicResource GalleryText.DataGridOutOfStock}" />
                  <alder:AlderSegmentItem Key="low" Content="{DynamicResource GalleryText.DataGridLowStock}" />
                </alder:AlderSegment>
                <WrapPanel Classes="product-filters" ItemSpacing="6" LineSpacing="6">
                  <alder:AlderSearchField Width="236" PlaceholderText="{DynamicResource GalleryText.DataGridSearch}"
                                          Text="{CompiledBinding ProductSearch, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource GalleryText.DataGridSearch}" />
                  <alder:AlderButton Size="Small" Variant="Secondary" Content="{DynamicResource GalleryText.Reset}" Command="{CompiledBinding ResetProducts}" />
                </WrapPanel>
              </Grid>
            </Border>
            <alder:AlderDataGrid ItemsSource="{CompiledBinding ProductRows}" RowKeySelector="{CompiledBinding RowKey}"
                                 AutomationProperties.Name="{DynamicResource GalleryText.DataGridVirtualized}" Height="644" HeadingHeight="37" RowHeight="58" Virtualized="True" SelectionMode="Multiple" ShowSelectionCheckboxes="True"
                                 SelectedKeys="{CompiledBinding ProductSelection, Mode=TwoWay}"
                                 SortDescriptor="{CompiledBinding ProductSort, Mode=TwoWay}">
              <alder:AlderTableColumn Key="name" Header="{DynamicResource GalleryText.DataGridProduct}" Width="3*" MinWidth="216" CanSort="True" SortComparison="{CompiledBinding CompareName}" CellTemplate="{StaticResource GridProductName}" />
              <alder:AlderTableColumn Key="code" Header="{DynamicResource GalleryText.DataGridSku}" Width="1*" MinWidth="95" CanSort="True" SortComparison="{CompiledBinding CompareCode}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding Code}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="status" Header="{DynamicResource GalleryText.DataGridStatus}" Width="1.4*" MinWidth="108" CanSort="True" SortComparison="{CompiledBinding CompareStatus}" CellTemplate="{StaticResource GridStatus}" />
              <alder:AlderTableColumn Key="count" Header="{DynamicResource GalleryText.DataGridStock}" Width="1*" HorizontalContentAlignment="Right" MinWidth="88" CanSort="True" SortComparison="{CompiledBinding CompareCount}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding CountLabel}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="amount" Header="{DynamicResource GalleryText.DataGridPrice}" Width="1*" HorizontalContentAlignment="Right" MinWidth="86" CanSort="True" SortComparison="{CompiledBinding CompareAmount}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding PriceLabel}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="cost" Header="{DynamicResource GalleryText.DataGridCost}" Width="1*" HorizontalContentAlignment="Right" MinWidth="85" CanSort="True" SortComparison="{CompiledBinding CompareCost}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding CostLabel}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="rating" Header="{DynamicResource GalleryText.DataGridRating}" Width="1*" MinWidth="90" CanSort="True" SortComparison="{CompiledBinding CompareRating}" CellTemplate="{StaticResource GridRating}" />
              <alder:AlderTableColumn Key="sales" Header="{DynamicResource GalleryText.DataGridSales}" Width="1*" HorizontalContentAlignment="Right" MinWidth="80" CanSort="True" SortComparison="{CompiledBinding CompareSales}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding SalesLabel}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderDataGrid.Footer>
                <alder:AlderTextBlock Classes="grid-preview-note" Text="{CompiledBinding ProductSummary}" />
              </alder:AlderDataGrid.Footer>
            </alder:AlderDataGrid>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var grid = new AlderDataGrid { Height = 644, HeadingHeight = 37, RowHeight = 58, Virtualized = true, SelectionMode = TableSelectionMode.Multiple, ShowSelectionCheckboxes = true };
        grid.Bind(AlderDataGrid.ItemsSourceProperty, CompiledBinding.Create((DataGridViewModel model) => model.ProductRows));
        grid.Bind(AlderDataGrid.SelectedKeysProperty, CompiledBinding.Create((DataGridViewModel model) => model.ProductSelection, mode: BindingMode.TwoWay));
        grid.Bind(AlderDataGrid.SortDescriptorProperty, CompiledBinding.Create((DataGridViewModel model) => model.ProductSort, mode: BindingMode.TwoWay));
        var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary };
        reset.Bind(Button.CommandProperty, CompiledBinding.Create((DataGridViewModel model) => model.ResetProducts));
        grid.Bind(AlderDataGrid.RowKeySelectorProperty, CompiledBinding.Create((DataGridViewModel model) => model.RowKey));
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "name",
            Header = "Product",
            Width = new GridLength(3, GridUnitType.Star),
            MinWidth = 216,
            CanSort = true,
            SortComparison = viewModel.CompareName,
            CellTemplate = (IDataTemplate)this.FindResource("GridProductName")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "code",
            Header = "Sku",
            Width = new GridLength(1, GridUnitType.Star),
            MinWidth = 95,
            CanSort = true,
            SortComparison = viewModel.CompareCode,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Code)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "status",
            Header = "Status",
            Width = new GridLength(1.4, GridUnitType.Star),
            MinWidth = 108,
            CanSort = true,
            SortComparison = viewModel.CompareStatus,
            CellTemplate = (IDataTemplate)this.FindResource("GridStatus")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "count",
            Header = "Stock",
            Width = new GridLength(1, GridUnitType.Star),
            HorizontalContentAlignment = HorizontalAlignment.Right,
            MinWidth = 88,
            CanSort = true,
            SortComparison = viewModel.CompareCount,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.CountLabel)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "amount",
            Header = "Price",
            Width = new GridLength(1, GridUnitType.Star),
            HorizontalContentAlignment = HorizontalAlignment.Right,
            MinWidth = 86,
            CanSort = true,
            SortComparison = viewModel.CompareAmount,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.PriceLabel)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "cost",
            Header = "Cost",
            Width = new GridLength(1, GridUnitType.Star),
            HorizontalContentAlignment = HorizontalAlignment.Right,
            MinWidth = 85,
            CanSort = true,
            SortComparison = viewModel.CompareCost,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.CostLabel)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "rating",
            Header = "Rating",
            Width = new GridLength(1, GridUnitType.Star),
            MinWidth = 90,
            CanSort = true,
            SortComparison = viewModel.CompareRating,
            CellTemplate = (IDataTemplate)this.FindResource("GridRating")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "sales",
            Header = "Sales",
            Width = new GridLength(1, GridUnitType.Star),
            HorizontalContentAlignment = HorizontalAlignment.Right,
            MinWidth = 80,
            CanSort = true,
            SortComparison = viewModel.CompareSales,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.SalesLabel)
        });
        var stockFilters = new AlderSegment
        {
            Size = AlderSegmentSize.Small,
            Items =
            {
                new AlderSegmentItem { Key = "all", Content = "All" },
                new AlderSegmentItem { Key = "in", Content = "In Stock" },
                new AlderSegmentItem { Key = "out", Content = "Out of Stock" },
                new AlderSegmentItem { Key = "low", Content = "Low Stock" }
            }
        };
        stockFilters.Bind(AlderSegment.SelectedKeyProperty, CompiledBinding.Create((DataGridViewModel model) => model.StockFilter, mode: BindingMode.TwoWay));
        var summary = new AlderTextBlock();
        summary.Bind(TextBlock.TextProperty, CompiledBinding.Create((DataGridViewModel model) => model.ProductSummary));
        grid.Footer = summary;

        var search = new AlderSearchField { Width = 236, PlaceholderText = "Search" };
        search.Bind(AlderSearchField.TextProperty, CompiledBinding.Create((DataGridViewModel model) => model.ProductSearch, mode: BindingMode.TwoWay));
        var filters = new WrapPanel { ItemSpacing = 6, LineSpacing = 6, Children = { stockFilters, search, reset } };
        var preview = new StackPanel { Spacing = 12, Children = { filters, grid } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
