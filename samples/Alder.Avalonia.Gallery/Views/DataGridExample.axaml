      <g:ExampleCard.CSharpSource><![CDATA[
        var grid = new AlderDataGrid { MinRowHeight = 57 };
        grid.Bind(AlderDataGrid.ItemsSourceProperty, CompiledBinding.Create((DataGridViewModel model) => model.Features));
        var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary };
        reset.Bind(Button.CommandProperty, CompiledBinding.Create((DataGridViewModel model) => model.ResetFeatures));
        grid.Bind(AlderDataGrid.RowKeySelectorProperty, CompiledBinding.Create((DataGridViewModel model) => model.RowKey));
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "feature",
            Header = "Feature",
            Width = new GridLength(1.6, GridUnitType.Star),
            MinWidth = 142,
            CellTemplate = (IDataTemplate)this.FindResource("GridNameEditor")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "priority",
            Header = "Priority",
            Width = new GridLength(1, GridUnitType.Star),
            MinWidth = 105,
            CellTemplate = (IDataTemplate)this.FindResource("GridPriorityEditor")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "storyPoints",
            Header = "Story Points",
            Width = new GridLength(1, GridUnitType.Star),
            MinWidth = 110,
            HorizontalContentAlignment = HorizontalAlignment.Center,
            CellTemplate = new FuncDataTemplate<DataGridDemoRow>((_, _) =>
            {
                var stepper = new AlderNumberStepper
                {
                    Size = AlderSize.Small, Minimum = 0, Maximum = 99, FormatString = "0"
                };
                stepper.Bind(NumericUpDown.ValueProperty,
                    CompiledBinding.Create((DataGridDemoRow row) => row.Points, mode: BindingMode.TwoWay));
                AutomationProperties.SetName(stepper, "Story Points");
                return stepper;
            })
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "enabled",
            Header = "Enabled",
            Width = new GridLength(1, GridUnitType.Star),
            MinWidth = 84,
            CellTemplate = (IDataTemplate)this.FindResource("GridEnabledEditor")!
        });

        var preview = new StackPanel { Spacing = 12, Children = { reset, grid } };
      ]]></g:ExampleCard.CSharpSource>
