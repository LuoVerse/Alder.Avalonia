                                 AutomationProperties.Name="{DynamicResource GalleryText.DataGridServers}" MinRowHeight="61" SortMode="External" SelectionMode="Multiple" ShowSelectionCheckboxes="True"
                                 SortDescriptor="{CompiledBinding ServerSort, Mode=TwoWay}"
                                 SelectedKeys="{CompiledBinding ServerSelection, Mode=TwoWay}">
              <alder:AlderTableColumn Key="code" Header="{DynamicResource GalleryText.DataGridClusterId}" Width="1.2*" MinWidth="113" CanSort="True" SortComparison="{CompiledBinding CompareCode}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding Code}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="count" Header="{DynamicResource GalleryText.DataGridInstances}" Width="*" HorizontalContentAlignment="Right" MinWidth="89" CanSort="True" SortComparison="{CompiledBinding CompareCount}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding CountLabel}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="status" Header="{DynamicResource GalleryText.DataGridStatus}" Width="*" MinWidth="104" CanSort="True" SortComparison="{CompiledBinding CompareStatus}" CellTemplate="{StaticResource GridStatus}" />
              <alder:AlderTableColumn Key="region" Header="{DynamicResource GalleryText.DataGridRegion}" Width="1.25*" MinWidth="116" IsVisible="{CompiledBinding ShowServerRegion}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding Region}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="capacity" Header="{DynamicResource GalleryText.DataGridCapacity}" Width="*" MinWidth="94" CellTemplate="{StaticResource GridCapacity}" />
              <alder:AlderTableColumn Key="amount" Header="{DynamicResource GalleryText.DataGridCost}" Width="*" HorizontalContentAlignment="Right" MinWidth="100" IsVisible="{CompiledBinding ShowServerCost}" CanSort="True" SortComparison="{CompiledBinding CompareAmount}">
                <alder:AlderTableColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:DataGridDemoRow">
                    <alder:AlderTextBlock Text="{CompiledBinding AmountLabel}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </alder:AlderTableColumn.CellTemplate>
              </alder:AlderTableColumn>
              <alder:AlderTableColumn Key="requests" Header="{DynamicResource GalleryText.DataGridRequests}" Width="1.35*" MinWidth="114" CellTemplate="{StaticResource GridRequests}" />
            </alder:AlderDataGrid>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var grid = new AlderDataGrid { MinRowHeight = 61, SortMode = DataGridSortMode.External, SelectionMode = TableSelectionMode.Multiple, ShowSelectionCheckboxes = true };
        grid.Bind(AlderDataGrid.ItemsSourceProperty, CompiledBinding.Create((DataGridViewModel model) => model.Servers));
        grid.Bind(AlderDataGrid.SelectedKeysProperty, CompiledBinding.Create((DataGridViewModel model) => model.ServerSelection, mode: BindingMode.TwoWay));
        var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary };
        reset.Bind(Button.CommandProperty, CompiledBinding.Create((DataGridViewModel model) => model.ResetServers));
        grid.Bind(AlderDataGrid.RowKeySelectorProperty, CompiledBinding.Create((DataGridViewModel model) => model.RowKey));
        grid.Bind(AlderDataGrid.SortDescriptorProperty, CompiledBinding.Create((DataGridViewModel model) => model.ServerSort, mode: BindingMode.TwoWay));
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "code",
            Header = "Cluster ID",
            Width = new GridLength(1.2, GridUnitType.Star),
            MinWidth = 113,
            CanSort = true,
            SortComparison = viewModel.CompareCode,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Code)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "count",
            Header = "Instances",
            Width = new GridLength(1, GridUnitType.Star),
            HorizontalContentAlignment = HorizontalAlignment.Right,
            MinWidth = 89,
            CanSort = true,
            SortComparison = viewModel.CompareCount,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.CountLabel)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "status",
            Header = "Status",
            Width = new GridLength(1, GridUnitType.Star),
            MinWidth = 104,
            CanSort = true,
            SortComparison = viewModel.CompareStatus,
            CellTemplate = (IDataTemplate)this.FindResource("GridStatus")!
        });
        var columnRegion = new AlderTableColumn
        {
            Key = "region",
            Header = "Region",
            Width = new GridLength(1.25, GridUnitType.Star),
            MinWidth = 116,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Region)
        };
        columnRegion.Bind(TableViewColumn.IsVisibleProperty, CompiledBinding.Create((DataGridViewModel model) => model.ShowServerRegion));
        grid.Columns.Add(columnRegion);
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "capacity",
            Header = "Capacity",
            Width = new GridLength(1, GridUnitType.Star),
            MinWidth = 94,
            CellTemplate = (IDataTemplate)this.FindResource("GridCapacity")!
        });
        var columnCost = new AlderTableColumn
        {
            Key = "amount",
            Header = "Cost",
            Width = new GridLength(1, GridUnitType.Star),
            HorizontalContentAlignment = HorizontalAlignment.Right,
            MinWidth = 100,
            CanSort = true,
            SortComparison = viewModel.CompareAmount,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.AmountLabel)
        };
        columnCost.Bind(TableViewColumn.IsVisibleProperty, CompiledBinding.Create((DataGridViewModel model) => model.ShowServerCost));
        grid.Columns.Add(columnCost);
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "requests",
            Header = "Requests",
            Width = new GridLength(1.35, GridUnitType.Star),
            MinWidth = 114,
            CellTemplate = (IDataTemplate)this.FindResource("GridRequests")!
        });

        var preview = new StackPanel { Spacing = 12, Children = { reset, grid } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleBulk" Title="{DynamicResource GalleryText.DataGridBulkActions}">
      <g:ExampleCard.Preview>
        <Border Padding="12,20" MinHeight="510">
          <StackPanel Spacing="12" MaxWidth="896" VerticalAlignment="Center">
            <alder:AlderButton Size="Small" Variant="Secondary" HorizontalAlignment="Right" Content="{DynamicResource GalleryText.Reset}" Command="{CompiledBinding ResetBulk}" />
            <alder:AlderDataGrid ItemsSource="{CompiledBinding Employees}" RowKeySelector="{CompiledBinding RowKey}"
                                 AutomationProperties.Name="{DynamicResource GalleryText.DataGridBulkActions}" MinRowHeight="52" SelectionMode="Multiple" ShowSelectionCheckboxes="True"
                                 SelectedKeys="{CompiledBinding BulkSelection, Mode=TwoWay}"
                                 SortDescriptor="{CompiledBinding BulkSort, Mode=TwoWay}">
              <alder:AlderTableColumn Key="name" Header="{DynamicResource GalleryText.DataGridEmployee}" Width="2*" MinWidth="206" CanSort="True" SortComparison="{CompiledBinding CompareName}" CellTemplate="{StaticResource GridAvatarPerson}" />
              <alder:AlderTableColumn Key="department" Header="{DynamicResource GalleryText.DataGridDepartment}" Width="1.25*" MinWidth="108" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Role}" />
              <alder:AlderTableColumn Key="status" Header="{DynamicResource GalleryText.DataGridStatus}" Width="1*" MinWidth="95" CanSort="True" SortComparison="{CompiledBinding CompareStatus}" CellTemplate="{StaticResource GridStatus}" />
              <alder:AlderTableColumn Key="joined" Header="{DynamicResource GalleryText.DataGridJoined}" Width="1.25*" MinWidth="112" x:DataType="vm:DataGridDemoRow" Binding="{CompiledBinding Date}" />
            </alder:AlderDataGrid>
            <Border IsVisible="{CompiledBinding HasBulkSelection}" Background="{DynamicResource AlderSurfaceSecondary}" CornerRadius="12" Padding="12,8" HorizontalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <alder:AlderTextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{CompiledBinding BulkSummary}" />
                <alder:AlderButton Size="Small" Variant="Secondary" Content="{DynamicResource GalleryText.DataGridActivate}" Command="{CompiledBinding BulkActivate}" />
                <alder:AlderButton Size="Small" Variant="DangerSoft" Content="{DynamicResource GalleryText.DataGridRemove}" Command="{CompiledBinding BulkRemove}" />
                <alder:AlderButton Size="Small" Variant="Ghost" Content="{DynamicResource GalleryText.DataGridClear}" Command="{CompiledBinding ClearSelection}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var grid = new AlderDataGrid { MinRowHeight = 52, SelectionMode = TableSelectionMode.Multiple, ShowSelectionCheckboxes = true };
        grid.Bind(AlderDataGrid.ItemsSourceProperty, CompiledBinding.Create((DataGridViewModel model) => model.Employees));
        grid.Bind(AlderDataGrid.SortDescriptorProperty, CompiledBinding.Create((DataGridViewModel model) => model.BulkSort, mode: BindingMode.TwoWay));
        var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary };
        reset.Bind(Button.CommandProperty, CompiledBinding.Create((DataGridViewModel model) => model.ResetBulk));
        grid.Bind(AlderDataGrid.RowKeySelectorProperty, CompiledBinding.Create((DataGridViewModel model) => model.RowKey));
        grid.Bind(AlderDataGrid.SelectedKeysProperty, CompiledBinding.Create((DataGridViewModel model) => model.BulkSelection, mode: BindingMode.TwoWay));
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "name",
            Header = "Employee",
            Width = new GridLength(2, GridUnitType.Star),
            MinWidth = 206,
            CanSort = true,
            SortComparison = viewModel.CompareName,
            CellTemplate = (IDataTemplate)this.FindResource("GridAvatarPerson")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "department",
            Header = "Department",
            Width = new GridLength(1.25, GridUnitType.Star),
            MinWidth = 108,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Role)
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "status",
            Header = "Status",
            Width = new GridLength(1, GridUnitType.Star),
            MinWidth = 95,
            CanSort = true,
            SortComparison = viewModel.CompareStatus,
            CellTemplate = (IDataTemplate)this.FindResource("GridStatus")!
        });
        grid.Columns.Add(new AlderTableColumn
        {
            Key = "joined",
            Header = "Joined",
            Width = new GridLength(1.25, GridUnitType.Star),
            MinWidth = 112,
            Binding = CompiledBinding.Create((DataGridDemoRow row) => row.Date)
        });
        var activate = new AlderButton { Content = "Activate", Command = viewModel.BulkActivate };
        var remove = new AlderButton { Content = "Remove", Command = viewModel.BulkRemove };
        var clear = new AlderButton { Content = "Clear", Command = viewModel.ClearSelection };

        var actions = new WrapPanel { ItemSpacing = 8, LineSpacing = 8, Children = { activate, remove, clear } };
        actions.Bind(Visual.IsVisibleProperty, CompiledBinding.Create((DataGridViewModel model) => model.HasBulkSelection));
        var preview = new StackPanel { Spacing = 12, Children = { reset, grid, actions } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
