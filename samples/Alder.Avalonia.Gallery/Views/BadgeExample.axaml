<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.BadgeExample" x:DataType="vm:StatusIndicatorViewModel">
  <StackPanel Spacing="20">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="300" TextElement.FontFamily="fonts:Inter#Inter">
          <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" ItemSpacing="24" LineSpacing="16">
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Danger" AutomationProperties.Name="{DynamicResource GalleryText.BadgeUnread}" Content="5" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="AB" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/orange.jpg" />
              <alder:AlderBadge Size="Small" Color="Accent" Content="{DynamicResource GalleryText.BadgeNew}" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="CD" Source="avares://Alder.Avalonia.Gallery/Assets/Card/blue.jpg" />
              <alder:AlderBadge Size="Small" Color="Success" Placement="BottomRight" AutomationProperties.Name="{DynamicResource GalleryText.StatusOnline}" />
            </alder:AlderBadgeAnchor>
          </WrapPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var avatar = new AlderAvatar { Fallback = "JD" };
        var notifications = new AlderBadge { Content = 5, Size = AlderSize.Small, Color = AlderStatusColor.Danger };
        var anchor = new AlderBadgeAnchor { Children = { avatar, notifications } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVariants" Title="{DynamicResource GalleryText.Variants}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="382" TextElement.FontFamily="fonts:Inter#Inter">
          <alder:AlderItemsControl ClipToBounds="False" ItemsSource="{CompiledBinding BadgeVariants}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BadgeExampleVariant">
                <StackPanel>
                  <StackPanel Spacing="16">
                    <alder:AlderTextBlock Text="{CompiledBinding Label}" FontSize="14" LineHeight="20" FontWeight="SemiBold" Foreground="{DynamicResource AlderMuted}" />
                    <alder:AlderItemsControl ClipToBounds="False" ItemsSource="{CompiledBinding Badges}">
                      <alder:AlderItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="24" LineSpacing="12" /></ItemsPanelTemplate>
                      </alder:AlderItemsControl.ItemsPanel>
                      <alder:AlderItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BadgeExample">
                          <alder:AlderBadgeAnchor>
                            <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
                            <alder:AlderBadge Size="Small" Content="5" Variant="{CompiledBinding Variant}" Color="{CompiledBinding Color}" />
                          </alder:AlderBadgeAnchor>
                        </DataTemplate>
                      </alder:AlderItemsControl.ItemTemplate>
                    </alder:AlderItemsControl>
                  </StackPanel>
                  <alder:AlderSeparator Margin="0,32" IsVisible="{CompiledBinding ShowDivider}" />
                </StackPanel>
              </DataTemplate>
            </alder:AlderItemsControl.ItemTemplate>
          </alder:AlderItemsControl>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var badge = new AlderBadge { Size = AlderSize.Small, Content = 5, Color = AlderStatusColor.Accent, Variant = BadgeVariant.Soft };
        var example = new AlderBadgeAnchor { Children = { new AlderAvatar { Fallback = "JD" }, badge } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleSizes" Title="{DynamicResource GalleryText.Sizes}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" ItemSpacing="24" LineSpacing="16">
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" Size="Small" />
              <alder:AlderBadge Color="Danger" Size="Small" Content="5" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" Size="Medium" />
              <alder:AlderBadge Color="Danger" Size="Medium" Content="5" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" Size="Large" />
              <alder:AlderBadge Color="Danger" Size="Large" Content="5" />
            </alder:AlderBadgeAnchor>
          </WrapPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var sizes = new[] { AlderSize.Small, AlderSize.Medium, AlderSize.Large };
        foreach (var size in sizes)
        {
            var badge = new AlderBadge { Size = size, Content = 5, Color = AlderStatusColor.Danger };
            var avatar = new AlderAvatar { Size = size, Fallback = "JD" };
            examples.Children.Add(new AlderBadgeAnchor { Children = { avatar, badge } });
        }
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleColors" Title="{DynamicResource GalleryText.BadgeColors}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" ItemSpacing="24" LineSpacing="16">
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Default" AutomationProperties.Name="{DynamicResource GalleryText.StatusDefault}" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Accent" AutomationProperties.Name="{DynamicResource GalleryText.StatusAccent}" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Success" AutomationProperties.Name="{DynamicResource GalleryText.StatusSuccess}" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Warning" AutomationProperties.Name="{DynamicResource GalleryText.StatusWarning}" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Danger" AutomationProperties.Name="{DynamicResource GalleryText.StatusDanger}" />
            </alder:AlderBadgeAnchor>
          </WrapPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        foreach (var color in Enum.GetValues<AlderStatusColor>())
        {
            var badge = new AlderBadge { Size = AlderSize.Small, Color = color };
            examples.Children.Add(new AlderBadgeAnchor { Children = { new AlderAvatar { Fallback = "JD" }, badge } });
        }
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SamplePlacements" Title="{DynamicResource GalleryText.BadgePlacements}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" ItemSpacing="32" LineSpacing="16">
            <StackPanel Spacing="8">
              <alder:AlderBadgeAnchor HorizontalAlignment="Center">
                <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
                <alder:AlderBadge Size="Small" Color="Accent" Placement="TopRight" />
              </alder:AlderBadgeAnchor>
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.BadgeTopRight}" HorizontalAlignment="Center"
                         FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
            </StackPanel>
            <StackPanel Spacing="8">
              <alder:AlderBadgeAnchor HorizontalAlignment="Center">
                <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
                <alder:AlderBadge Size="Small" Color="Accent" Placement="TopLeft" />
              </alder:AlderBadgeAnchor>
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.BadgeTopLeft}" HorizontalAlignment="Center"
                         FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
            </StackPanel>
            <StackPanel Spacing="8">
              <alder:AlderBadgeAnchor HorizontalAlignment="Center">
                <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
                <alder:AlderBadge Size="Small" Color="Accent" Placement="BottomRight" />
              </alder:AlderBadgeAnchor>
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.BadgeBottomRight}" HorizontalAlignment="Center"
                         FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
            </StackPanel>
            <StackPanel Spacing="8">
              <alder:AlderBadgeAnchor HorizontalAlignment="Center">
                <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
                <alder:AlderBadge Size="Small" Color="Accent" Placement="BottomLeft" />
              </alder:AlderBadgeAnchor>
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.BadgeBottomLeft}" HorizontalAlignment="Center"
                         FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
            </StackPanel>
          </WrapPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        foreach (var placement in Enum.GetValues<BadgePlacement>())
        {
            var badge = new AlderBadge { Size = AlderSize.Small, Color = AlderStatusColor.Accent, Placement = placement };
            examples.Children.Add(new AlderBadgeAnchor { Children = { new AlderAvatar { Fallback = "JD" }, badge } });
        }
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleDot" Title="{DynamicResource GalleryText.BadgeDot}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" ItemSpacing="24" LineSpacing="16">
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Card/blue.jpg" />
              <alder:AlderBadge Size="Small" Color="Accent" Placement="BottomRight" AutomationProperties.Name="{DynamicResource GalleryText.StatusAvailable}" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Success" Placement="BottomRight" AutomationProperties.Name="{DynamicResource GalleryText.StatusOnline}" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/orange.jpg" />
              <alder:AlderBadge Size="Small" Color="Warning" Placement="BottomRight" AutomationProperties.Name="{DynamicResource GalleryText.StatusPending}" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Card/red.jpg" />
              <alder:AlderBadge Size="Small" Color="Danger" Placement="BottomRight" AutomationProperties.Name="{DynamicResource GalleryText.StatusBusy}" />
            </alder:AlderBadgeAnchor>
          </WrapPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var presence = new AlderBadge { Color = AlderStatusColor.Success, Size = AlderSize.Small, Placement = BadgePlacement.BottomRight };
        AutomationProperties.SetName(presence, "Online");
        var anchor = new AlderBadgeAnchor { Children = { new AlderAvatar { Fallback = "AB" }, presence } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleContent" Title="{DynamicResource GalleryText.BadgeWithContent}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" ItemSpacing="24" LineSpacing="16">
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Danger" Content="5" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Danger" Content="{DynamicResource GalleryText.BadgeNew}" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Danger" Content="99+" />
            </alder:AlderBadgeAnchor>
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/green.jpg" />
              <alder:AlderBadge Size="Small" Color="Accent" IconSize="10" Icon="{DynamicResource AlderIconBell}" AutomationProperties.Name="{DynamicResource GalleryText.BadgeUnread}" />
            </alder:AlderBadgeAnchor>
          </WrapPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var updates = new AlderBadge { Size = AlderSize.Small, Content = "99+", Color = AlderStatusColor.Danger };
        var bell = new AlderBadge { Size = AlderSize.Small, IconSize = 10, Color = AlderStatusColor.Accent };
        bell[!AlderBadge.IconProperty] = new DynamicResourceExtension("AlderIconBell");
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleCustom" Title="{DynamicResource GalleryText.CustomStyles}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" ItemSpacing="24" LineSpacing="16">
            <alder:AlderBadgeAnchor VerticalAlignment="Center">
              <alder:AlderAvatar Fallback="KW" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/purple.jpg" />
              <alder:AlderBadge Size="Small" Color="Accent" Variant="Soft" MinWidth="20" FontWeight="SemiBold" Content="5" />
            </alder:AlderBadgeAnchor>
          </WrapPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var badge = new AlderBadge
        {
            Size = AlderSize.Small,
            Color = AlderStatusColor.Accent,
            Variant = BadgeVariant.Soft,
            MinWidth = 20,
            FontWeight = FontWeight.SemiBold,
            Content = 5
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
