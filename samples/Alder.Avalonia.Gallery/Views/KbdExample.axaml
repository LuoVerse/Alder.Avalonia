<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.KbdExample" x:DataType="vm:KbdViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="ShortcutPart" x:DataType="vm:KbdExamplePart">
      <Panel>
        <alder:AlderKbdKey KeyValue="{CompiledBinding Key}" IsVisible="{CompiledBinding IsKey}" />
        <alder:AlderTextBlock Text="{CompiledBinding Text}" IsVisible="{CompiledBinding !IsKey}" LineHeight="20" VerticalAlignment="Center" />
      </Panel>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel Spacing="20">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="300" TextElement.FontFamily="fonts:Inter#Inter"
                TextElement.Foreground="{DynamicResource AlderTertiaryInk}">
          <WrapPanel ItemSpacing="16" LineSpacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderKbd><alder:AlderKbdKey KeyValue="Command" /><x:String>K</x:String></alder:AlderKbd>
            <alder:AlderKbd><alder:AlderKbdKey KeyValue="Shift" /><x:String>P</x:String></alder:AlderKbd>
            <alder:AlderKbd><alder:AlderKbdKey KeyValue="Ctrl" /><x:String>C</x:String></alder:AlderKbd>
            <alder:AlderKbd><alder:AlderKbdKey KeyValue="Option" /><x:String>D</x:String></alder:AlderKbd>
          </WrapPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        AlderKbd Shortcut(KbdKey modifier, string letter) =>
            new() { Items = { new AlderKbdKey { KeyValue = modifier }, letter } };

        var row = new WrapPanel
        {
            ItemSpacing = 16,
            LineSpacing = 8,
            Children =
            {
                Shortcut(KbdKey.Command, "K"),
                Shortcut(KbdKey.Shift, "P"),
                Shortcut(KbdKey.Ctrl, "C"),
                Shortcut(KbdKey.Option, "D")
            }
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVariants" Title="{DynamicResource GalleryText.Variants}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="228" TextElement.FontFamily="fonts:Inter#Inter"
                TextElement.Foreground="{DynamicResource AlderTertiaryInk}">
          <alder:AlderItemsControl ItemsSource="{CompiledBinding EditingShortcuts}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="20" /></ItemsPanelTemplate>
            </alder:AlderItemsControl.ItemsPanel>
            <alder:AlderItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KbdExampleShortcut">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <alder:AlderTextBlock Text="{CompiledBinding Label}" FontSize="16" VerticalAlignment="Center" />
                  <alder:AlderKbd ItemsSource="{CompiledBinding Keys}" ItemTemplate="{StaticResource ShortcutPart}" />
                  <alder:AlderKbd ItemsSource="{CompiledBinding Keys}" ItemTemplate="{StaticResource ShortcutPart}" Variant="Light" />
                </StackPanel>
              </DataTemplate>
            </alder:AlderItemsControl.ItemTemplate>
          </alder:AlderItemsControl>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        AlderKbd Shortcut(KbdVariant variant) => new()
        {
            Variant = variant,
            Items = { new AlderKbdKey { KeyValue = KbdKey.Command }, "C" }
        };

        var filled = Shortcut(KbdVariant.Default);
        var transparent = Shortcut(KbdVariant.Light);
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleNavigation" Title="{DynamicResource GalleryText.KbdNavigationKeys}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter"
                TextElement.Foreground="{DynamicResource AlderTertiaryInk}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.KbdArrowKeys}" Foreground="{DynamicResource AlderMuted}" FontSize="14" VerticalAlignment="Center" />
              <alder:AlderKbd><alder:AlderKbdKey KeyValue="Up" /></alder:AlderKbd>
              <alder:AlderKbd><alder:AlderKbdKey KeyValue="Down" /></alder:AlderKbd>
              <alder:AlderKbd><alder:AlderKbdKey KeyValue="Left" /></alder:AlderKbd>
              <alder:AlderKbd><alder:AlderKbdKey KeyValue="Right" /></alder:AlderKbd>
            </WrapPanel>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.KbdPageNavigation}" Foreground="{DynamicResource AlderMuted}" FontSize="14" VerticalAlignment="Center" />
              <alder:AlderKbd><alder:AlderKbdKey KeyValue="PageUp" /></alder:AlderKbd>
              <alder:AlderKbd><alder:AlderKbdKey KeyValue="PageDown" /></alder:AlderKbd>
              <alder:AlderKbd><alder:AlderKbdKey KeyValue="Home" /></alder:AlderKbd>
              <alder:AlderKbd><alder:AlderKbdKey KeyValue="End" /></alder:AlderKbd>
            </WrapPanel>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var keys = new WrapPanel { ItemSpacing = 8, LineSpacing = 8 };
        foreach (var key in new[] { KbdKey.Up, KbdKey.Down, KbdKey.Left, KbdKey.Right })
            keys.Children.Add(new AlderKbd { Items = { new AlderKbdKey { KeyValue = key } } });
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleInline" Title="{DynamicResource GalleryText.KbdInlineUsage}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter"
                TextElement.Foreground="{DynamicResource AlderTertiaryInk}">
          <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderTextBlock FontSize="14" LineHeight="24" TextWrapping="Wrap">
              <Run Text="{DynamicResource GalleryText.KbdPress}" /><InlineUIContainer BaselineAlignment="Center">
                <alder:AlderKbd><x:String>Esc</x:String></alder:AlderKbd>
              </InlineUIContainer><Run Text="{DynamicResource GalleryText.KbdDismissEnd}" />
            </alder:AlderTextBlock>
            <alder:AlderTextBlock FontSize="14" LineHeight="24" TextWrapping="Wrap">
              <Run Text="{DynamicResource GalleryText.KbdUse}" /><InlineUIContainer BaselineAlignment="Center">
                <alder:AlderKbd><alder:AlderKbdKey KeyValue="Command" /><x:String>K</x:String></alder:AlderKbd>
              </InlineUIContainer><Run Text="{DynamicResource GalleryText.KbdPaletteEnd}" />
            </alder:AlderTextBlock>
            <alder:AlderTextBlock FontSize="14" LineHeight="24" TextWrapping="Wrap">
              <Run Text="{DynamicResource GalleryText.KbdMoveWith}" /><InlineUIContainer BaselineAlignment="Center">
                <alder:AlderKbd><alder:AlderKbdKey KeyValue="Up" /></alder:AlderKbd>
              </InlineUIContainer><Run Text="{DynamicResource GalleryText.KbdAnd}" /><InlineUIContainer BaselineAlignment="Center">
                <alder:AlderKbd><alder:AlderKbdKey KeyValue="Down" /></alder:AlderKbd>
              </InlineUIContainer><Run Text="{DynamicResource GalleryText.KbdArrowEnd}" />
            </alder:AlderTextBlock>
            <alder:AlderTextBlock FontSize="14" LineHeight="24" TextWrapping="Wrap">
              <Run Text="{DynamicResource GalleryText.KbdSaveWith}" /><InlineUIContainer BaselineAlignment="Center">
                <alder:AlderKbd><alder:AlderKbdKey KeyValue="Command" /><x:String>S</x:String></alder:AlderKbd>
              </InlineUIContainer><Run Text="{DynamicResource GalleryText.KbdRegularly}" />
            </alder:AlderTextBlock>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var instruction = new AlderTextBlock
        {
            FontSize = 14,
            LineHeight = 24,
            TextWrapping = TextWrapping.Wrap,
            Inlines = new InlineCollection
            {
                new Run("Press "),
                new InlineUIContainer(new AlderKbd { Items = { "Esc" } }) { BaselineAlignment = BaselineAlignment.Center },
                new Run(" to close the dialog.")
            }
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleInstructions" Title="{DynamicResource GalleryText.KbdInstructionalText}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter"
                TextElement.Foreground="{DynamicResource AlderTertiaryInk}">
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource AlderSurface}"
                  Padding="16" CornerRadius="8">
            <StackPanel Spacing="8">
              <alder:AlderTypography Type="BodySmall" FontWeight="SemiBold" LineHeight="20"
                                Text="{DynamicResource GalleryText.KbdQuickActions}" />
              <alder:AlderItemsControl ItemsSource="{CompiledBinding QuickActions}">
                <alder:AlderItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </alder:AlderItemsControl.ItemsPanel>
                <alder:AlderItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:KbdExampleShortcut">
                    <alder:AlderTextBlock FontSize="14" LineHeight="24" TextWrapping="Wrap">
                      <Run Text="• " /><Run Text="{CompiledBinding Label}" /><Run Text=" " /><InlineUIContainer BaselineAlignment="Center">
                        <alder:AlderKbd ItemsSource="{CompiledBinding Keys}" ItemTemplate="{StaticResource ShortcutPart}" />
                      </InlineUIContainer>
                    </alder:AlderTextBlock>
                  </DataTemplate>
                </alder:AlderItemsControl.ItemTemplate>
              </alder:AlderItemsControl>
            </StackPanel>
          </Border>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var key = new AlderKbd { Items = { new AlderKbdKey { KeyValue = KbdKey.Command }, "K" } };
        var action = new AlderTextBlock
        {
            FontSize = 14,
            LineHeight = 24,
            Inlines = new InlineCollection
            {
                new Run("• Open search: "),
                new InlineUIContainer(key) { BaselineAlignment = BaselineAlignment.Center }
            }
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleSpecial" Title="{DynamicResource GalleryText.KbdSpecialKeys}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter"
                TextElement.Foreground="{DynamicResource AlderTertiaryInk}">
          <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderTextBlock FontSize="14" LineHeight="24" TextWrapping="Wrap">
              <Run Text="{DynamicResource GalleryText.KbdPress}" /><InlineUIContainer BaselineAlignment="Center">
                <alder:AlderKbd><alder:AlderKbdKey KeyValue="Enter" /></alder:AlderKbd>
              </InlineUIContainer><Run Text="{DynamicResource GalleryText.KbdConfirmOr}" /><InlineUIContainer BaselineAlignment="Center">
                <alder:AlderKbd><alder:AlderKbdKey KeyValue="Escape" /></alder:AlderKbd>
              </InlineUIContainer><Run Text="{DynamicResource GalleryText.KbdCancelEnd}" />
            </alder:AlderTextBlock>
            <alder:AlderTextBlock FontSize="14" LineHeight="24" TextWrapping="Wrap">
              <Run Text="{DynamicResource GalleryText.KbdUse}" /><InlineUIContainer BaselineAlignment="Center">
                <alder:AlderKbd><alder:AlderKbdKey KeyValue="Tab" /></alder:AlderKbd>
              </InlineUIContainer><Run Text="{DynamicResource GalleryText.KbdNavigateFields}" /><InlineUIContainer BaselineAlignment="Center">
                <alder:AlderKbd><alder:AlderKbdKey KeyValue="Shift" /><alder:AlderKbdKey KeyValue="Tab" /></alder:AlderKbd>
              </InlineUIContainer><Run Text="{DynamicResource GalleryText.KbdGoBackEnd}" />
            </alder:AlderTextBlock>
            <alder:AlderTextBlock FontSize="14" LineHeight="24" TextWrapping="Wrap">
              <Run Text="{DynamicResource GalleryText.KbdHold}" /><InlineUIContainer BaselineAlignment="Center">
                <alder:AlderKbd><alder:AlderKbdKey KeyValue="Space" /></alder:AlderKbd>
              </InlineUIContainer><Run Text="{DynamicResource GalleryText.KbdPanEnd}" />
            </alder:AlderTextBlock>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var enter = new AlderKbd { Items = { new AlderKbdKey { KeyValue = KbdKey.Enter } } };
        var escape = new AlderKbd { Items = { new AlderKbdKey { KeyValue = KbdKey.Escape } } };
        var shiftTab = new AlderKbd
        {
            Items = { new AlderKbdKey { KeyValue = KbdKey.Shift }, new AlderKbdKey { KeyValue = KbdKey.Tab } }
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleCustom" Title="{DynamicResource GalleryText.CustomStyles}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter"
                TextElement.Foreground="{DynamicResource AlderTertiaryInk}">
          <WrapPanel ItemSpacing="12" LineSpacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderKbd Padding="10,0" Background="{DynamicResource AlderSoft}" Foreground="{DynamicResource AlderSoftInk}">
              <alder:AlderKbdKey KeyValue="Command" />
              <x:String>K</x:String>
            </alder:AlderKbd>
            <alder:AlderKbd Padding="10,0">
              <alder:AlderKbdKey KeyValue="Shift" />
              <x:String>P</x:String>
            </alder:AlderKbd>
          </WrapPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var shortcut = new AlderKbd
        {
            Padding = new Thickness(10, 0),
            Items = { new AlderKbdKey { KeyValue = KbdKey.Command }, "K" }
        };
        shortcut[!TemplatedControl.BackgroundProperty] = new DynamicResourceExtension("AlderSoft");
        shortcut[!TemplatedControl.ForegroundProperty] = new DynamicResourceExtension("AlderSoftInk");
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
