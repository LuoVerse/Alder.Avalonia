              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackDisabledHold}" Variant="DangerSoft" Icon="{DynamicResource AlderIconTrash}" IsEnabled="False">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="HoldConfirm" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackSecondary}" Variant="Secondary" IsEnabled="False">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="HoldConfirm" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
            </WrapPanel>
            <WrapPanel ItemSpacing="12" LineSpacing="12">
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackDisabledProgress}" Variant="DangerSoft" Icon="{DynamicResource AlderIconTrash}" IsEnabled="False">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="ProgressFeedback" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackSecondary}" Variant="Secondary" IsEnabled="False">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="ProgressFeedback" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleHoldCallback" Title="{DynamicResource GalleryText.PressableFeedbackHoldCallback}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="320">
          <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
            <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackHoldDelete}" Variant="DangerSoft" Icon="{DynamicResource AlderIconTrash}">
              <alder:AlderButton.Feedback>
                <alder:AlderPressableFeedback Effects="HoldConfirm" OverlayBackground="{DynamicResource AlderDanger}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackHoldDelete}" CompletionCommand="{CompiledBinding CompleteHold}" />
              </alder:AlderButton.Feedback>
            </alder:AlderButton>
            <alder:AlderTextBlock Text="{CompiledBinding HoldCaption}" Classes="feedback-muted" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleProgressCallback" Title="{DynamicResource GalleryText.PressableFeedbackProgressCallback}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="320">
          <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
            <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackSend}" Variant="Secondary" Icon="{StaticResource GalleryFeedbackSend}">
              <alder:AlderButton.Feedback>
                <alder:AlderPressableFeedback Effects="ProgressFeedback" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackSend}" CompletionCommand="{CompiledBinding CompleteProgress}" />
              </alder:AlderButton.Feedback>
            </alder:AlderButton>
            <alder:AlderTextBlock Text="{CompiledBinding ProgressCaption}" Classes="feedback-muted" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
