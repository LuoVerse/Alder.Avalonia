<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.PressableFeedbackExample" x:DataType="vm:PressableFeedbackViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="GalleryFeedbackCart">F1 M0.5 1.5 H3.3 L4.2 4 H15.5 L13.8 9.8 H5 L5.55 11 H13.9 V12.3 H4.7 L2.35 2.8 H0.5 Z M5.8 14 A1.25 1.25 0 1 0 8.3 14 A1.25 1.25 0 1 0 5.8 14 Z M10.8 14 A1.25 1.25 0 1 0 13.3 14 A1.25 1.25 0 1 0 10.8 14 Z</StreamGeometry>
    <StreamGeometry x:Key="GalleryFeedbackSend">F1 M0.9 6.7 L14.2 1 A.7.7 0 0 1 15.15 1.9 L11.1 15 A.7.7 0 0 1 9.8 15.15 L7.2 10.5 L11.8 4.3 L5.65 9.15 L.9 8 A.7.7 0 0 1 .9 6.7 Z</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.feedback-muted">
      <Setter Property="Foreground" Value="{DynamicResource AlderMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="16" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="alder|AlderButton.community-right">
      <Setter Property="Grid.Column" Value="1" />
    </Style>
    <ContainerQuery Name="FeedbackPreview" Query="max-width:767">
      <Style Selector="alder|AlderButton[Size=Medium]">
        <Setter Property="MinHeight" Value="40" />
      </Style>
      <Style Selector="alder|AlderButton[Size=Medium][IsIconOnly=True]">
        <Setter Property="Width" Value="40" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <StackPanel Spacing="20" x:Name="Examples" Container.Name="FeedbackPreview" Container.Sizing="Width">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="320">
          <StackPanel Spacing="24" VerticalAlignment="Center" HorizontalAlignment="Center">
            <WrapPanel ItemSpacing="12" LineSpacing="12">
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackPrimary}" Variant="Primary">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackSecondary}" Variant="Secondary">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackTertiary}" Variant="Tertiary">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackOutline}" Variant="Outline">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackGhost}" Variant="Ghost">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackDanger}" Variant="Danger">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
            </WrapPanel>
            <WrapPanel ItemSpacing="12" LineSpacing="12">
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackSearch}" Variant="Primary" Icon="{DynamicResource AlderIconMagnifier}">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackAddMember}" Variant="Secondary" Icon="{DynamicResource AlderIconPlus}">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackEmail}" Variant="Tertiary" Icon="{DynamicResource AlderIconEnvelope}">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackDelete}" Variant="Danger" Icon="{DynamicResource AlderIconTrash}">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
            </WrapPanel>
            <WrapPanel ItemSpacing="12" LineSpacing="12">
              <alder:AlderButton Variant="Tertiary" Icon="{DynamicResource AlderIconEllipsis}" IsIconOnly="True" AutomationProperties.Name="{DynamicResource GalleryText.PressableFeedbackMore}">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Variant="Secondary" Icon="{DynamicResource AlderIconGear}" IsIconOnly="True" AutomationProperties.Name="{DynamicResource GalleryText.PressableFeedbackSettings}">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Variant="Danger" Icon="{DynamicResource AlderIconTrash}" IsIconOnly="True" AutomationProperties.Name="{DynamicResource GalleryText.PressableFeedbackDelete}">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Ripple" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleCards" Title="{DynamicResource GalleryText.PressableFeedbackCards}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="680">
          <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="500">
            <alder:AlderButton Variant="Ghost" Padding="0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" CornerRadius="24" Background="{DynamicResource AlderSurface}" Command="{CompiledBinding Notify}" AutomationProperties.Name="{DynamicResource GalleryText.PressableFeedbackNotify}">
              <alder:AlderButton.Feedback>
                <alder:AlderPressableFeedback Effects="Ripple" />
              </alder:AlderButton.Feedback>
              <Border CornerRadius="24" ClipToBounds="True">
                <Grid Width="{CompiledBinding $parent[alder:AlderButton].Bounds.Width}" Height="214">
                  <alder:AlderImage Stretch="UniformToFill" Source="avares://Alder.Avalonia.Gallery/Assets/Card/neo1.jpeg"/>
                  <StackPanel Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">
                    <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackNeo}" FontWeight="SemiBold" FontSize="12"/>
                    <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackHomeRobot}" FontSize="14"/>
                  </StackPanel>
                  <Border Background="{DynamicResource AlderSurface}" Padding="12,8" VerticalAlignment="Bottom">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackAvailable}" FontWeight="SemiBold" FontSize="12"/>
                        <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackGetNotified}" Classes="feedback-muted"/>
                      </StackPanel>
                      <alder:AlderTextBlock Text="{CompiledBinding NotifyCaption}" FontWeight="Medium" VerticalAlignment="Center" Grid.Column="1"/>
                    </Grid>
                  </Border>
                </Grid>
              </Border>
            </alder:AlderButton>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <alder:AlderButton Variant="Ghost" Padding="0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="154" CornerRadius="24" Background="{DynamicResource AlderSurface}" Classes="community-left" AutomationProperties.Name="{DynamicResource GalleryText.PressableFeedbackIndie}">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Highlight" />
                </alder:AlderButton.Feedback>
                <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="12" Width="{CompiledBinding $parent[alder:AlderButton].Bounds.Width}">
                  <Border Width="48" Height="48" Background="{DynamicResource AlderNeutral}" CornerRadius="12" HorizontalAlignment="Left">
                    <alder:AlderTextBlock Text="IH" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackIndie}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap"/>
                    <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackIndieCount}" Classes="feedback-muted"/>
                    <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackByJohn}" Classes="feedback-muted"/>
                  </StackPanel>
                </StackPanel>
              </alder:AlderButton>
              <alder:AlderButton Variant="Ghost" Padding="0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="154" CornerRadius="24" Background="{DynamicResource AlderSurface}" Classes="community-right" AutomationProperties.Name="{DynamicResource GalleryText.PressableFeedbackBuilders}">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Highlight" />
                </alder:AlderButton.Feedback>
                <StackPanel Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="12" Width="{CompiledBinding $parent[alder:AlderButton].Bounds.Width}">
                  <Border Width="48" Height="48" Background="{DynamicResource AlderNeutral}" CornerRadius="12" HorizontalAlignment="Left">
                    <alder:AlderTextBlock Text="AB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackBuilders}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap"/>
                    <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackBuildersCount}" Classes="feedback-muted"/>
                    <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackByMartha}" Classes="feedback-muted"/>
                  </StackPanel>
                </StackPanel>
              </alder:AlderButton>
            </Grid>
            <alder:AlderButton Variant="Ghost" Padding="0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" CornerRadius="18" AutomationProperties.Name="{DynamicResource GalleryText.PressableFeedbackFuture}">
              <alder:AlderButton.Feedback>
                <alder:AlderPressableFeedback Effects="Ripple" />
              </alder:AlderButton.Feedback>
              <Grid ColumnDefinitions="72,*" ColumnSpacing="12" Width="{CompiledBinding $parent[alder:AlderButton].Bounds.Width}" Margin="8">
                <Border CornerRadius="12" ClipToBounds="True" Width="72" Height="72">
                  <alder:AlderImage Stretch="UniformToFill" Source="avares://Alder.Avalonia.Gallery/Assets/Card/robot1.jpeg"/>
                </Border>
                <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Stretch" Grid.Column="1">
                  <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackFuture}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap"/>
                  <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackToday}" Classes="feedback-muted"/>
                </StackPanel>
              </Grid>
            </alder:AlderButton>
            <alder:AlderButton Variant="Ghost" Padding="0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" CornerRadius="18" AutomationProperties.Name="{DynamicResource GalleryText.PressableFeedbackAvocado}">
              <alder:AlderButton.Feedback>
                <alder:AlderPressableFeedback Effects="Ripple" />
              </alder:AlderButton.Feedback>
              <Grid ColumnDefinitions="72,*" ColumnSpacing="12" Width="{CompiledBinding $parent[alder:AlderButton].Bounds.Width}" Margin="8">
                <Border CornerRadius="12" ClipToBounds="True" Width="72" Height="72">
                  <alder:AlderImage Stretch="UniformToFill" Source="avares://Alder.Avalonia.Gallery/Assets/Card/avocado.jpeg"/>
                </Border>
                <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Stretch" Grid.Column="1">
                  <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackAvocado}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap"/>
                  <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackWednesday}" Classes="feedback-muted"/>
                </StackPanel>
              </Grid>
            </alder:AlderButton>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleCompare" Title="{DynamicResource GalleryText.PressableFeedbackComparison}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="460">
          <StackPanel Spacing="24" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackRipple}" Classes="feedback-muted"/>
              <WrapPanel ItemSpacing="12" LineSpacing="12">
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackPrimary}" Variant="Primary">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="Ripple" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackPrimary}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackSecondary}" Variant="Secondary">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="Ripple" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackSecondary}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackOutline}" Variant="Outline">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="Ripple" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackOutline}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
              </WrapPanel>
            </StackPanel>
            <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackHighlight}" Classes="feedback-muted"/>
              <WrapPanel ItemSpacing="12" LineSpacing="12">
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackPrimary}" Variant="Primary">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="Highlight" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackPrimary}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackSecondary}" Variant="Secondary">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="Highlight" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackSecondary}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackOutline}" Variant="Outline">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="Highlight" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackOutline}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
              </WrapPanel>
            </StackPanel>
            <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackHoldConfirm}" Classes="feedback-muted"/>
              <WrapPanel ItemSpacing="12" LineSpacing="12">
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackPrimary}" Variant="Primary">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="HoldConfirm" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackPrimary}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackSecondary}" Variant="Secondary">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="HoldConfirm" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackSecondary}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackOutline}" Variant="Outline">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="HoldConfirm" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackOutline}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
              </WrapPanel>
            </StackPanel>
            <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.PressableFeedbackProgressFeedback}" Classes="feedback-muted"/>
              <WrapPanel ItemSpacing="12" LineSpacing="12">
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackPrimary}" Variant="Primary">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="ProgressFeedback" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackPrimary}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackSecondary}" Variant="Secondary">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="ProgressFeedback" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackSecondary}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
                <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackOutline}" Variant="Outline">
                  <alder:AlderButton.Feedback>
                    <alder:AlderPressableFeedback Effects="ProgressFeedback" OverlayBackground="{DynamicResource AlderAccent}" OverlayForeground="{DynamicResource AlderOnAccent}" OverlayContent="{DynamicResource GalleryText.PressableFeedbackOutline}" />
                  </alder:AlderButton.Feedback>
                </alder:AlderButton>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleHighlight" Title="{DynamicResource GalleryText.PressableFeedbackWithHighlight}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="320">
          <StackPanel Spacing="24" VerticalAlignment="Center" HorizontalAlignment="Center">
            <WrapPanel ItemSpacing="12" LineSpacing="12">
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackPrimary}" Variant="Primary">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Highlight" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackSecondary}" Variant="Secondary">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Highlight" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackTertiary}" Variant="Tertiary">
                <alder:AlderButton.Feedback>
                  <alder:AlderPressableFeedback Effects="Highlight" />
                </alder:AlderButton.Feedback>
              </alder:AlderButton>
              <alder:AlderButton Content="{DynamicResource GalleryText.PressableFeedbackOutline}" Variant="Outline">
