<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.ResizableExample" x:DataType="vm:ResizableViewModel">
  <UserControl.Resources>
    <ControlTheme x:Key="ResizablePreviewFrame" TargetType="ContentControl">
      <Setter Property="Background" Value="{DynamicResource GalleryPreviewSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlderBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Name="Interior" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding BorderThickness}" ClipToBounds="True">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
            <Border Name="Outline" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <ContainerQuery Name="ResizablePreview" Query="min-width:656">
      <Style Selector="Grid.resizable-inset">
        <Setter Property="Margin" Value="16,0" />
      </Style>
    </ContainerQuery>
    <ContainerQuery Name="ResizablePreview" Query="max-width:655">
      <Style Selector="alder|AlderButton.resizable-collapse-trigger">
        <Setter Property="MinHeight" Value="36" />
      </Style>
    </ContainerQuery>
    <Style Selector="TextBlock.resizable-label">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="LineHeight" Value="20" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.resizable-caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="0.3" />
      <Setter Property="Foreground" Value="{DynamicResource AlderMuted}" />
    </Style>
  </UserControl.Styles>
  <StackPanel x:Name="Examples" Spacing="20" Container.Name="ResizablePreview" Container.Sizing="Width">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <g:ExampleCard.Preview>
        <Grid Classes="resizable-inset" MinHeight="440">
          <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="400" VerticalAlignment="Center">
            <alder:AlderResizable>
              <alder:AlderResizablePanel DefaultSize="180" MinSize="140" MaxSize="260"
                                            GroupResizeBehavior="PreservePixelSize" Size="{CompiledBinding UsageSidebarSize}">
                <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableSidebar}" />
              </alder:AlderResizablePanel>
              <alder:AlderResizableHandle />
              <alder:AlderResizablePanel MinSize="30*">
                <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableMain}" />
              </alder:AlderResizablePanel>
            </alder:AlderResizable>
          </alder:AlderContentControl>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVertical" Title="{DynamicResource GalleryText.ResizableVertical}">
      <g:ExampleCard.Preview>
        <Grid Classes="resizable-inset" MinHeight="460">
          <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="400" VerticalAlignment="Center">
            <alder:AlderResizable Orientation="Vertical">
              <alder:AlderResizablePanel DefaultSize="60*" MinSize="20*">
                <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableTop}" />
              </alder:AlderResizablePanel>
              <alder:AlderResizableHandle />
              <alder:AlderResizablePanel DefaultSize="40*" MinSize="20*">
                <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableBottom}" />
              </alder:AlderResizablePanel>
            </alder:AlderResizable>
          </alder:AlderContentControl>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleTypes" Title="{DynamicResource GalleryText.ResizableTypes}">
      <g:ExampleCard.Preview>
        <Grid Classes="resizable-inset" MinHeight="1010">
          <StackPanel Spacing="24" VerticalAlignment="Center">
            <StackPanel Spacing="8">
              <alder:AlderTextBlock Classes="resizable-caption" Text="{DynamicResource GalleryText.ResizableTypeLine}" />
              <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="200" VerticalAlignment="Center">
                <alder:AlderResizable>
                  <alder:AlderResizablePanel DefaultSize="50*" MinSize="20*" Background="{DynamicResource AlderSurface}">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableLeft}" />
                  </alder:AlderResizablePanel>
                  <alder:AlderResizableHandle Type="Line" />
                  <alder:AlderResizablePanel DefaultSize="50*" MinSize="20*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableRight}" />
                  </alder:AlderResizablePanel>
                </alder:AlderResizable>
              </alder:AlderContentControl>
            </StackPanel>
            <StackPanel Spacing="8">
              <alder:AlderTextBlock Classes="resizable-caption" Text="{DynamicResource GalleryText.ResizableTypeDrag}" />
              <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="200" VerticalAlignment="Center">
                <alder:AlderResizable>
                  <alder:AlderResizablePanel DefaultSize="50*" MinSize="20*" Background="{DynamicResource AlderSurface}">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableLeft}" />
                  </alder:AlderResizablePanel>
                  <alder:AlderResizableHandle Type="Drag" />
                  <alder:AlderResizablePanel DefaultSize="50*" MinSize="20*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableRight}" />
                  </alder:AlderResizablePanel>
                </alder:AlderResizable>
              </alder:AlderContentControl>
            </StackPanel>
            <StackPanel Spacing="8">
              <alder:AlderTextBlock Classes="resizable-caption" Text="{DynamicResource GalleryText.ResizableTypePill}" />
              <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="200" VerticalAlignment="Center">
                <alder:AlderResizable>
                  <alder:AlderResizablePanel DefaultSize="50*" MinSize="20*" Background="{DynamicResource AlderSurface}">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableLeft}" />
                  </alder:AlderResizablePanel>
                  <alder:AlderResizableHandle Type="Pill" />
                  <alder:AlderResizablePanel DefaultSize="50*" MinSize="20*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableRight}" />
                  </alder:AlderResizablePanel>
                </alder:AlderResizable>
              </alder:AlderContentControl>
            </StackPanel>
            <StackPanel Spacing="8">
              <alder:AlderTextBlock Classes="resizable-caption" Text="{DynamicResource GalleryText.ResizableTypeHandle}" />
              <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="200" VerticalAlignment="Center">
                <alder:AlderResizable>
                  <alder:AlderResizablePanel DefaultSize="50*" MinSize="20*" Background="{DynamicResource AlderSurface}">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableLeft}" />
                  </alder:AlderResizablePanel>
                  <alder:AlderResizableHandle Type="Handle" />
                  <alder:AlderResizablePanel DefaultSize="50*" MinSize="20*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableRight}" />
                  </alder:AlderResizablePanel>
                </alder:AlderResizable>
              </alder:AlderContentControl>
            </StackPanel>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVariants" Title="{DynamicResource GalleryText.ResizableVariants}">
      <g:ExampleCard.Preview>
        <Grid Classes="resizable-inset" MinHeight="760">
          <StackPanel Spacing="24" VerticalAlignment="Center">
            <StackPanel Spacing="8">
              <alder:AlderTextBlock Classes="resizable-caption" Text="{DynamicResource GalleryText.ResizableVariantPrimary}" />
              <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="180" VerticalAlignment="Center">
                <alder:AlderResizable>
                  <alder:AlderResizablePanel DefaultSize="50*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableLeft}" />
                  </alder:AlderResizablePanel>
                  <alder:AlderResizableHandle Variant="Default" />
                  <alder:AlderResizablePanel DefaultSize="50*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableRight}" />
                  </alder:AlderResizablePanel>
                </alder:AlderResizable>
              </alder:AlderContentControl>
            </StackPanel>
            <StackPanel Spacing="8">
              <alder:AlderTextBlock Classes="resizable-caption" Text="{DynamicResource GalleryText.ResizableVariantSecondary}" />
              <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="180" VerticalAlignment="Center" Background="{DynamicResource AlderSurface}">
                <alder:AlderResizable>
                  <alder:AlderResizablePanel DefaultSize="50*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableLeft}" />
                  </alder:AlderResizablePanel>
                  <alder:AlderResizableHandle Variant="Secondary" />
                  <alder:AlderResizablePanel DefaultSize="50*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableRight}" />
                  </alder:AlderResizablePanel>
                </alder:AlderResizable>
              </alder:AlderContentControl>
            </StackPanel>
            <StackPanel Spacing="8">
              <alder:AlderTextBlock Classes="resizable-caption" Text="{DynamicResource GalleryText.ResizableVariantTertiary}" />
              <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="180" VerticalAlignment="Center" Background="{DynamicResource AlderSurfaceSecondary}">
                <alder:AlderResizable>
                  <alder:AlderResizablePanel DefaultSize="50*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableLeft}" />
                  </alder:AlderResizablePanel>
                  <alder:AlderResizableHandle Variant="Tertiary" />
                  <alder:AlderResizablePanel DefaultSize="50*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableRight}" />
                  </alder:AlderResizablePanel>
                </alder:AlderResizable>
              </alder:AlderContentControl>
            </StackPanel>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleNested" Title="{DynamicResource GalleryText.ResizableNested}">
      <g:ExampleCard.Preview>
        <Grid Classes="resizable-inset" MinHeight="600">
          <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="500" VerticalAlignment="Center">
            <alder:AlderResizable>
              <alder:AlderResizablePanel DefaultSize="25*" MinSize="15*" Background="{DynamicResource AlderSurface}">
                <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableSidebar}" />
              </alder:AlderResizablePanel>
              <alder:AlderResizableHandle />
              <alder:AlderResizablePanel DefaultSize="75*">
                <alder:AlderResizable Orientation="Vertical">
                  <alder:AlderResizablePanel DefaultSize="65*" MinSize="20*">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableEditor}" />
                  </alder:AlderResizablePanel>
                  <alder:AlderResizableHandle />
                  <alder:AlderResizablePanel DefaultSize="35*" MinSize="15*" Background="{DynamicResource AlderSurfaceSecondary}">
                    <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableTerminal}" />
                  </alder:AlderResizablePanel>
                </alder:AlderResizable>
              </alder:AlderResizablePanel>
            </alder:AlderResizable>
          </alder:AlderContentControl>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleCollapse" Title="{DynamicResource GalleryText.ResizableCollapsible}">
      <g:ExampleCard.Preview>
        <Grid Classes="resizable-inset" MinHeight="540">
          <StackPanel Spacing="12" VerticalAlignment="Center">
            <alder:AlderButton Classes="resizable-collapse-trigger" HorizontalAlignment="Left" Size="Small" Variant="Secondary"
                               Content="{CompiledBinding SidebarAction}" Command="{CompiledBinding ToggleSidebar}" />
            <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="400" VerticalAlignment="Center">
              <alder:AlderResizable>
                <alder:AlderResizablePanel DefaultSize="25*" MinSize="15*" IsCollapsible="True" CollapsedSize="0"
                                              IsCollapsed="{CompiledBinding IsSidebarCollapsed}" Background="{DynamicResource AlderSurface}">
                  <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableSidebar}" />
                </alder:AlderResizablePanel>
                <alder:AlderResizableHandle />
                <alder:AlderResizablePanel DefaultSize="75*">
                  <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableMain}" />
                </alder:AlderResizablePanel>
              </alder:AlderResizable>
            </alder:AlderContentControl>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleIndicator" Title="{DynamicResource GalleryText.ResizableWithIndicator}">
      <g:ExampleCard.Preview>
        <Grid Classes="resizable-inset" MinHeight="500">
          <alder:AlderContentControl Theme="{StaticResource ResizablePreviewFrame}" Height="400" VerticalAlignment="Center">
            <alder:AlderResizable>
              <alder:AlderResizablePanel DefaultSize="40*" MinSize="15*" Background="{DynamicResource AlderSurface}">
                <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableLeft}" />
              </alder:AlderResizablePanel>
              <alder:AlderResizableHandle WithIndicator="True" />
              <alder:AlderResizablePanel DefaultSize="60*">
                <alder:AlderTextBlock Classes="resizable-label" Text="{DynamicResource GalleryText.ResizableRight}" />
              </alder:AlderResizablePanel>
            </alder:AlderResizable>
          </alder:AlderContentControl>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
