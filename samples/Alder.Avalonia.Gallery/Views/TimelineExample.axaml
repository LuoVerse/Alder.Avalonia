<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.TimelineExample" x:DataType="vm:TimelineViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="TimelineFlag">F0 M2 1H3.3V15H2Z M3 2.2C6 0 9.5 4.5 13.1 2.2V9.4C9.5 11.7 6 7.2 3 9.4V8.1C6 6 9.5 10.3 11.8 8.6V3.9C9.5 5.7 6 1.4 3 3.5Z</StreamGeometry>
    <StreamGeometry x:Key="TimelineCanary">F0 M1 5.5L8 2L15 5.5V10.5L8 14L1 10.5Z M2.4 6.3V9.7L8 12.5L13.6 9.7V6.3L8 3.5Z M7.3 6.5H8.7V9.5H7.3Z</StreamGeometry>
    <StreamGeometry x:Key="TimelineDocument">F0 M3 1H9L13 5V15H3Z M4.3 2.3V13.7H11.7V5.8H8.2V2.3Z M9.5 3.2V4.5H10.8Z M5.4 8H10.6V9.2H5.4Z M5.4 10.6H10.6V11.8H5.4Z</StreamGeometry>
    <StreamGeometry x:Key="TimelineCommit">F0 M8 4A4 4 0 1 1 8 12A4 4 0 1 1 8 4Z M8 5.4A2.6 2.6 0 1 0 8 10.6A2.6 2.6 0 1 0 8 5.4Z M1 7.3H4.4V8.7H1Z M11.6 7.3H15V8.7H11.6Z</StreamGeometry>
    <StreamGeometry x:Key="TimelineMerge">F0 M4 1A2.5 2.5 0 1 1 4 6A2.5 2.5 0 1 1 4 1Z M4 2.3A1.2 1.2 0 1 0 4 4.7A1.2 1.2 0 1 0 4 2.3Z M4 10A2.5 2.5 0 1 1 4 15A2.5 2.5 0 1 1 4 10Z M4 11.3A1.2 1.2 0 1 0 4 13.7A1.2 1.2 0 1 0 4 11.3Z M12 9A2.5 2.5 0 1 1 12 14A2.5 2.5 0 1 1 12 9Z M12 10.3A1.2 1.2 0 1 0 12 12.7A1.2 1.2 0 1 0 12 10.3Z M3.3 5H4.7V11H3.3Z M4 5.6H5.4C5.4 8.4 8.4 8.1 10.8 10L10 11C7.2 9.1 4 9 4 5.6Z</StreamGeometry>
    <StreamGeometry x:Key="TimelinePeople">F0 M6 2A2.7 2.7 0 1 1 6 7.4A2.7 2.7 0 1 1 6 2Z M6 3.3A1.4 1.4 0 1 0 6 6.1A1.4 1.4 0 1 0 6 3.3Z M1 13V11.7C1 9.9 3.1 8.5 6 8.5S11 9.9 11 11.7V13Z M2.3 11.7H9.7C9.7 10.8 8.1 9.8 6 9.8S2.3 10.8 2.3 11.7Z M10.1 3.1C12.6 2.3 14.4 5.2 12.7 7C12.1 7.7 11.3 7.9 10.4 7.8L10.6 6.5C12.4 6.7 12.6 4 10.5 4.4Z M11 9H11.7C13.4 9 15 10.2 15 11.8V13H12V11.7H13.7C13.5 10.9 12.7 10.3 11.7 10.3Z</StreamGeometry>
    <StreamGeometry x:Key="TimelineShield">F0 M8 1L14 3.5V7C14 10.6 11.5 13.6 8 15C4.5 13.6 2 10.6 2 7V3.5Z M8 2.5L3.4 4.4V7C3.4 9.8 5.3 12.2 8 13.5C10.7 12.2 12.6 9.8 12.6 7V4.4Z M5.1 7.7L6 6.8L7.5 8.3L10.1 5.7L11 6.6L7.5 10.2Z</StreamGeometry>
    <StreamGeometry x:Key="TimelineBolt">M9 1L2.5 9H7L6.5 15L13.5 6.5H9Z</StreamGeometry>
    <StreamGeometry x:Key="TimelineCreditCard">F0 M3 3H13C14.1 3 15 3.9 15 5V11C15 12.1 14.1 13 13 13H3C1.9 13 1 12.1 1 11V5C1 3.9 1.9 3 3 3Z M3 4.3C2.6 4.3 2.3 4.6 2.3 5V11C2.3 11.4 2.6 11.7 3 11.7H13C13.4 11.7 13.7 11.4 13.7 11V5C13.7 4.6 13.4 4.3 13 4.3Z M2.3 6H13.7V7.3H2.3Z M4 9.2H7V10.4H4Z</StreamGeometry>
    <StreamGeometry x:Key="TimelineMegaphone">F0 M2 5.4H5.7L12.4 2H14V13.5H12.4L6 10.2L7 14H5.6L4.6 10.2H2Z M3.4 6.8V8.8H5.4V6.8Z M6.8 6.5V9.1L12.6 12V3.6Z</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.body, TextBlock.time, TextBlock.title, TextBlock.small-title, TextBlock.heading, TextBlock.stat-label">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="TextBlock.body, TextBlock.time, TextBlock.small-title, TextBlock.stat-label">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.body, TextBlock.time, TextBlock.stat-label">
      <Setter Property="Foreground" Value="{DynamicResource AlderMuted}" />
    </Style>
    <Style Selector="TextBlock.title, TextBlock.small-title, TextBlock.heading">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="TextBlock.stat-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LineHeight" Value="16" />
    </Style>
    <Style Selector="alder|AlderChip[Size=Small]">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="alder|AlderTimelineItem.leading-entry StackPanel.milestone">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="alder|AlderTimelineItem.leading-entry StackPanel.milestone TextBlock">
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="alder|AlderTimelineItem.leading-entry StackPanel.milestone WrapPanel">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>
    <Style Selector="StackPanel.milestone WrapPanel > Control">
      <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>
    <Style Selector="Grid.timeline-timed > :is(Control).timeline-time, Grid.timeline-log > :is(Control).timeline-time, Grid.repository-entry > TextBlock.repository-count">
      <Setter Property="Grid.Column" Value="1" />
    </Style>
    <Style Selector="Grid.timeline-log"><Setter Property="MinHeight" Value="22" /></Style>
    <Style Selector="Grid.timeline-log > :is(Control).timeline-time">
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Grid.repository-entry > TextBlock">
      <Setter Property="LineHeight" Value="16" />
    </Style>
    <Style Selector="StackPanel.compact-log TextBlock.small-title, StackPanel.compact-log TextBlock.timeline-time">
      <Setter Property="LineHeight" Value="15" />
    </Style>
    <Style Selector="Grid.timeline-timed.compact-single"><Setter Property="MinHeight" Value="22" /></Style>
    <Style Selector="Grid.split-stats > StackPanel.secondary-stat"><Setter Property="Grid.Column" Value="1" /></Style>
    <Style Selector="Grid.studio-asset > Image"><Setter Property="Width" Value="140" /></Style>
    <ContainerQuery Name="TimelineMilestones" Query="max-width:639">
      <Style Selector="alder|AlderTimeline"><Setter Property="Size" Value="Small" /></Style>
    </ContainerQuery>
    <ContainerQuery Name="TimelinePreview" Query="max-width:480">
      <Style Selector="Grid.timeline-timed, Grid.timeline-log"><Setter Property="RowSpacing" Value="4" /></Style>
      <Style Selector="Grid.split-stats"><Setter Property="RowSpacing" Value="8" /></Style>
      <Style Selector="Grid.timeline-timed > :is(Control), Grid.timeline-log > :is(Control), Grid.repository-entry > TextBlock, Grid.split-stats > StackPanel">
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </Style>
      <Style Selector="Grid.timeline-timed > :is(Control).timeline-time, Grid.timeline-log > :is(Control).timeline-time,
                       Grid.repository-entry > TextBlock.repository-count, Grid.split-stats > StackPanel.secondary-stat">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="0" />
      </Style>
      <Style Selector="Grid.studio-asset > Image, Grid.studio-asset > StackPanel">
        <Setter Property="Grid.ColumnSpan" Value="2" />
      </Style>
      <Style Selector="Grid.studio-asset > Image">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="NaN" />
        <Setter Property="Height" Value="234" />
      </Style>
      <Style Selector="Grid.studio-asset > StackPanel">
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.Row" Value="1" />
      </Style>
    </ContainerQuery>
  </UserControl.Styles>
  <StackPanel x:Name="Examples" Spacing="20">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.ProDemoTimelineUsage}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="560" Container.Name="TimelinePreview" Container.Sizing="Width">
          <StackPanel Spacing="2">
            <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineRolloutKicker}" />
            <alder:AlderTextBlock Classes="heading" Text="{DynamicResource GalleryText.ProTimelineRolloutHeading}" />
          </StackPanel>
          <alder:AlderTimeline Size="Small">
            <alder:AlderTimelineItem>
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelineFlag}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="4">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineRollout1}" />
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Default" Content="{DynamicResource GalleryText.ProTimelineRollout1Status}" />
                  </WrapPanel>
                  <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRollout1Detail}" />
                </StackPanel>
                <alder:AlderTextBlock Classes="time" Text="09:12" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem MarkerColor="Accent">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelineCanary}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="4">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineRollout2}" />
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Accent" Content="{DynamicResource GalleryText.ProTimelineRollout2Status}" />
                  </WrapPanel>
                  <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRollout2Detail}" />
                </StackPanel>
                <alder:AlderTextBlock Classes="time" Text="09:34" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem MarkerColor="Warning">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelineShield}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="4">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineRollout3}" />
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Warning" Content="{DynamicResource GalleryText.ProTimelineRollout3Status}" />
                  </WrapPanel>
                  <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRollout3Detail}" />
                </StackPanel>
                <alder:AlderTextBlock Classes="time" Text="09:51" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem>
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelineMegaphone}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="4">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineRollout4}" />
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Default" Content="{DynamicResource GalleryText.ProTimelineRollout4Status}" />
                  </WrapPanel>
                  <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRollout4Detail}" />
                </StackPanel>
                <alder:AlderTextBlock Classes="time" Text="10:05" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem>
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource AlderIconClock}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="4">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineRollout5}" />
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Default" Content="{DynamicResource GalleryText.ProTimelineRollout5Status}" />
                  </WrapPanel>
                  <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRollout5Detail}" />
                </StackPanel>
                <alder:AlderTextBlock Classes="time" Text="10:30" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem MarkerColor="Success">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource AlderIconCheckCircleFilled}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="4">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineRollout6}" />
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Success" Content="{DynamicResource GalleryText.ProTimelineRollout6Status}" />
                  </WrapPanel>
                  <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRollout6Detail}" />
                </StackPanel>
                <alder:AlderTextBlock Classes="time" Text="10:42" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
          </alder:AlderTimeline>
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleIncident" Title="{DynamicResource GalleryText.ProDemoTimelineIncident}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="16" MaxWidth="720" Container.Name="TimelinePreview" Container.Sizing="Width">
          <StackPanel Spacing="2">
            <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineIncidentKicker}" />
            <alder:AlderTextBlock Classes="heading" Text="{DynamicResource GalleryText.ProTimelineIncidentHeading}" />
          </StackPanel>
          <alder:AlderTimeline Size="Small">
            <alder:AlderTimelineItem ShowMarkerFrame="False" IsMarkerCentered="True">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderAvatar Width="28" Height="28" FontSize="12" Variant="Soft" Color="Default" Fallback="NV" AutomationProperties.AccessibilityView="Raw" />
              </alder:AlderTimelineItem.Marker>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <alder:AlderInput Variant="Secondary" FullWidth="True" Margin="0,2" Text="{CompiledBinding IncidentDraft, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource GalleryText.ProTimelineIncidentInput}" />
                <alder:AlderButton Grid.Column="1" VerticalAlignment="Center" Size="Small" Command="{CompiledBinding Post}" Content="{DynamicResource GalleryText.ProTimelineIncidentPost}" />
              </Grid>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem MarkerColor="Accent">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource AlderIconInfo}" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="10">
                <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineIncidentFrom}" />
                    <alder:AlderAvatar Width="20" Height="20" FontSize="10" Variant="Soft" Color="Default" Fallback="NV" AutomationProperties.AccessibilityView="Raw" />
                    <alder:AlderTextBlock Classes="small-title" Text="Nora Vazquez" />
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Default" Content="{DynamicResource GalleryText.ProTimelineIncidentOnCall}" />
                  </WrapPanel>
                  <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineIncidentTime28}" Classes.timeline-time="True" VerticalAlignment="Center" />
                </Grid>
                <alder:AlderCard Variant="Transparent" BorderBrush="{DynamicResource AlderBorder}" BorderThickness="1" Padding="12" MinHeight="116">
                  <StackPanel Spacing="12">
                    <alder:AlderTextBlock Classes="title" Text="{DynamicResource GalleryText.ProTimelineIncidentReply}" FontWeight="Normal" LineHeight="23" />
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderChip Size="Small" Variant="Soft" Icon="{StaticResource AlderIconPaperclip}" Content="worker-trace.har – 42 KB" />
                      <alder:AlderLink Content="{DynamicResource GalleryText.ProTimelineIncidentRunbook}" FontSize="12" Foreground="{DynamicResource AlderInk}" ShowExternalIcon="True" Command="{CompiledBinding OpenReference}" CommandParameter="ProTimelineIncidentRunbook" />
                    </WrapPanel>
                  </StackPanel>
                </alder:AlderCard>
              </StackPanel>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem MarkerColor="Warning">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelineBolt}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-log" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <WrapPanel ItemSpacing="6" LineSpacing="4">
                  <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineIncidentLog1}" />
                  <alder:AlderAvatar Width="20" Height="20" FontSize="10" Variant="Soft" Color="Default" Fallback="KR" AutomationProperties.AccessibilityView="Raw" />
                  <alder:AlderTextBlock Classes="small-title" Text="Kaito Reed" />
                </WrapPanel>
                <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineIncidentLog1Time}" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem>
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelinePeople}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-log" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <WrapPanel ItemSpacing="6" LineSpacing="4">
                  <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineIncidentLog2}" />
                  <alder:AlderAvatar Width="20" Height="20" FontSize="10" Variant="Soft" Color="Default" Fallback="MS" AutomationProperties.AccessibilityView="Raw" />
                  <alder:AlderTextBlock Classes="small-title" Text="Mira Stone" />
                </WrapPanel>
                <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineIncidentLog2Time}" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem>
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource AlderIconEnvelope}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-log" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <WrapPanel ItemSpacing="6" LineSpacing="4">
                  <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineIncidentLog3}" />
                  <alder:AlderLink Content="{DynamicResource GalleryText.ProTimelineIncidentChannel}" FontSize="12" Foreground="{DynamicResource AlderInk}" Command="{CompiledBinding OpenReference}" CommandParameter="ProTimelineIncidentChannel" />
                </WrapPanel>
                <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineIncidentLog3Time}" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem MarkerColor="Success">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource AlderIconCheckCircleFilled}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-log" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <WrapPanel ItemSpacing="6" LineSpacing="4">
                  <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineIncidentLog4}" />
                  <alder:AlderTextBlock Classes="small-title" Text="export-worker-3" />
                </WrapPanel>
                <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineIncidentLog4Time}" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem>
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource AlderIconClock}" />
              </alder:AlderTimelineItem.Marker>
              <Grid Classes="timeline-log" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                <WrapPanel ItemSpacing="6" LineSpacing="4">
                  <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineIncidentLog5}" />
                </WrapPanel>
                <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineIncidentLog5Time}" Classes.timeline-time="True" VerticalAlignment="Center" />
              </Grid>
            </alder:AlderTimelineItem>
          </alder:AlderTimeline>
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleRepository" Title="{DynamicResource GalleryText.ProDemoTimelineRepository}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="16" MaxWidth="620" Container.Name="TimelinePreview" Container.Sizing="Width">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Panel>
              <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineRepositoryMonth}" />
            </Panel>
            <alder:AlderSeparator VerticalAlignment="Center" />
          </Grid>
          <alder:AlderTimeline Size="Medium">
            <alder:AlderTimelineItem MarkerColor="Success">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelineCommit}" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="8">
                <StackPanel Spacing="0">
                  <alder:AlderTextBlock Classes="title" Text="{DynamicResource GalleryText.ProTimelineRepositoryCommit}" />
                  <alder:AlderTextBlock Classes="body" Text="Rina Sol" />
                </StackPanel>
                <StackPanel Spacing="4">
                  <Grid Classes="repository-entry" ColumnDefinitions="200,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                    <alder:AlderTextBlock Classes="small-title" Text="lumenforge/interface" />
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRepositoryCommitRepo1}" Classes.repository-count="True" />
                  </Grid>
                  <Grid Classes="repository-entry" ColumnDefinitions="200,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                    <alder:AlderTextBlock Classes="small-title" Text="mistral-bench/checkout" />
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRepositoryCommitRepo2}" Classes.repository-count="True" />
                  </Grid>
                  <Grid Classes="repository-entry" ColumnDefinitions="200,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                    <alder:AlderTextBlock Classes="small-title" Text="pixelwell/cli" />
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRepositoryCommitRepo3}" Classes.repository-count="True" />
                  </Grid>
                  <Grid Classes="repository-entry" ColumnDefinitions="200,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                    <alder:AlderTextBlock Classes="small-title" Text="signalnest/webhooks" />
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRepositoryCommitRepo4}" Classes.repository-count="True" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem MarkerColor="Accent">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelineMerge}" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="8">
                <Grid Classes="timeline-log" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                  <StackPanel Spacing="0">
                    <alder:AlderTextBlock Classes="title" Text="{DynamicResource GalleryText.ProTimelineRepositoryMerge}" />
                    <alder:AlderTextBlock Classes="body" Text="Theo Park" />
                  </StackPanel>
                  <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineRepositoryMergeTime}" Classes.timeline-time="True" VerticalAlignment="Center" />
                </Grid>
                <alder:AlderCard Padding="12" MinHeight="138">
                  <StackPanel Spacing="8">
                    <alder:AlderPathIcon Width="16" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource AlderAccent}" Data="{StaticResource TimelineMerge}" />
                    <alder:AlderTextBlock Classes="title" Text="{DynamicResource GalleryText.ProTimelineRepositoryPullTitle}" />
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRepositoryPullBody}" />
                    <WrapPanel ItemSpacing="6" LineSpacing="4">
                      <alder:AlderChip Size="Small" Variant="Soft" Color="Success" Content="{DynamicResource GalleryText.ProTimelineRepositoryAdded}" />
                      <alder:AlderChip Size="Small" Variant="Soft" Color="Danger" Content="{DynamicResource GalleryText.ProTimelineRepositoryRemoved}" />
                      <StackPanel Spacing="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="9" CornerRadius="1" Background="#17C964" />
                        <Border Width="8" Height="9" CornerRadius="1" Background="#17C964" />
                        <Border Width="8" Height="9" CornerRadius="1" Background="#17C964" />
                        <Border Width="8" Height="9" CornerRadius="1" Background="#FF383C" />
                        <Border Width="8" Height="9" CornerRadius="1" Background="#A1A1AA" />
                      </StackPanel>
                      <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRepositoryComments}" />
                    </WrapPanel>
                  </StackPanel>
                </alder:AlderCard>
              </StackPanel>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem MarkerColor="Warning">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource AlderIconInfo}" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="8">
                <StackPanel Spacing="0">
                  <alder:AlderTextBlock Classes="title" Text="{DynamicResource GalleryText.ProTimelineRepositoryIssue}" />
                  <alder:AlderTextBlock Classes="body" Text="Iris Moon" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <StackPanel Spacing="4">
                    <Grid Classes="repository-entry" ColumnDefinitions="200,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                      <alder:AlderTextBlock Classes="small-title" Text="lumenforge/interface" />
                      <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRepositoryIssueRepo1}" Classes.repository-count="True" />
                    </Grid>
                    <Grid Classes="repository-entry" ColumnDefinitions="200,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                      <alder:AlderTextBlock Classes="small-title" Text="pixelwell/cli" />
                      <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRepositoryIssueRepo2}" Classes.repository-count="True" />
                    </Grid>
                    <Grid Classes="repository-entry" ColumnDefinitions="200,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                      <alder:AlderTextBlock Classes="small-title" Text="signalnest/webhooks" />
                      <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRepositoryIssueRepo3}" Classes.repository-count="True" />
                    </Grid>
                  </StackPanel>
                  <WrapPanel ItemSpacing="4" LineSpacing="4">
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Success" Content="{DynamicResource GalleryText.ProTimelineRepositoryTriaged}" />
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Accent" Content="{DynamicResource GalleryText.ProTimelineRepositoryAssigned}" />
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Danger" Content="{DynamicResource GalleryText.ProTimelineRepositoryOpen}" />
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem>
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource AlderIconEye}" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="8">
                <Grid Classes="timeline-log" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
