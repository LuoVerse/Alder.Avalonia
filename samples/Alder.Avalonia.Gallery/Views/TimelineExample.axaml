                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRepositoryReviewRepo1}" Classes.repository-count="True" />
                  </Grid>
                  <Grid Classes="repository-entry" ColumnDefinitions="200,*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
