    <g:ExampleCard x:Name="SampleCompact" Title="{DynamicResource GalleryText.ProDemoTimelineCompact}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="16" MaxWidth="520" Classes="compact-log" Container.Name="TimelinePreview" Container.Sizing="Width">
          <alder:AlderTimeline Size="Small">
            <alder:AlderTimelineItem MarkerColor="Warning">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelineShield}" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="4">
                <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                  <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelinePayment1}" />
                  <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelinePayment1Time}" Classes.timeline-time="True" VerticalAlignment="Center" />
                </Grid>
                <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelinePaymentDispute}" LineHeight="16.5" />
              </StackPanel>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem MarkerColor="Success">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelineCreditCard}" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="4">
                <Grid Classes="timeline-timed compact-single" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                  <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelinePayment2}" />
                  <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelinePayment2Time}" Classes.timeline-time="True" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem>
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource AlderIconCheckCircle}" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="4">
                <Grid Classes="timeline-timed compact-single" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                  <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelinePayment3}" />
                  <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelinePayment3Time}" Classes.timeline-time="True" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem>
              <alder:AlderTimelineItem.Marker>
                <alder:AlderPathIcon Width="11" Height="11" Data="{StaticResource TimelineDocument}" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="4">
                <Grid Classes="timeline-timed compact-single" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                  <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelinePayment4}" />
                  <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelinePayment4Time}" Classes.timeline-time="True" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </alder:AlderTimelineItem>
          </alder:AlderTimeline>
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleStudio" Title="{DynamicResource GalleryText.ProDemoTimelineStudio}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="620" Container.Name="TimelinePreview" Container.Sizing="Width">
          <StackPanel Spacing="2">
            <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineStudioReviewKicker}" />
            <alder:AlderTextBlock Classes="heading" Text="{DynamicResource GalleryText.ProTimelineStudioReviewHeading}" />
          </StackPanel>
          <alder:AlderTimeline Size="Small">
            <alder:AlderTimelineItem ShowMarkerFrame="False">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderAvatar Width="24" Height="24" FontSize="10" Variant="Soft" Color="Accent" Fallback="MS" AutomationProperties.AccessibilityView="Raw" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="8">
                <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineStudioReview1}" />
                    <alder:AlderChip Size="Small" Variant="Soft" Color="Accent" Content="{DynamicResource GalleryText.ProTimelineStudioReviewStatus}" />
                  </WrapPanel>
                  <WrapPanel ItemSpacing="12" LineSpacing="4" Classes="timeline-time">
                    <alder:AlderTextBlock Classes="body" Text="Mina Sol" />
                    <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineStudioReview1Time}" />
                  </WrapPanel>
                </Grid>
                <Border CornerRadius="24" BorderThickness="1" BorderBrush="{DynamicResource AlderBorder}" ClipToBounds="True">
                  <Grid Classes="studio-asset" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <alder:AlderImage Stretch="UniformToFill" MinHeight="140" AutomationProperties.Name="{DynamicResource GalleryText.ProTimelineStudioImage}">
                      <alder:AlderImage.Source>
                        <CroppedBitmap Source="avares://Alder.Avalonia.Gallery/Assets/Carousel/trail-shoe-views.png" SourceRect="0,0,512,512" />
                      </alder:AlderImage.Source>
                    </alder:AlderImage>
                    <StackPanel Spacing="10" Grid.Column="1" Margin="12" VerticalAlignment="Top">
                      <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineStudioReview1Detail}" />
                      <WrapPanel ItemSpacing="6" LineSpacing="4">
                        <alder:AlderChip Size="Small" Variant="Soft" Color="Default" Content="{DynamicResource GalleryText.ProTimelineStudioHero}" />
                        <alder:AlderChip Size="Small" Variant="Soft" Color="Default" Content="{DynamicResource GalleryText.ProTimelineStudioCrops}" />
                        <alder:AlderLink Content="{DynamicResource GalleryText.ProTimelineStudioBoard}" FontSize="12" Foreground="{DynamicResource AlderInk}" ShowExternalIcon="True" Command="{CompiledBinding OpenReference}" CommandParameter="ProTimelineStudioBoard" />
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem ShowMarkerFrame="False">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderAvatar Width="24" Height="24" FontSize="10" Variant="Soft" Color="Warning" Fallback="OV" AutomationProperties.AccessibilityView="Raw" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="8">
                <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                  <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineStudioReview2}" />
                  <WrapPanel ItemSpacing="12" LineSpacing="4" Classes="timeline-time">
                    <alder:AlderTextBlock Classes="body" Text="Orin Vale" />
                    <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineStudioReview2Time}" />
                  </WrapPanel>
                </Grid>
                <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineStudioReview2Detail}" />
              </StackPanel>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem ShowMarkerFrame="False">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderAvatar Width="24" Height="24" FontSize="10" Variant="Soft" Color="Default" Fallback="PK" AutomationProperties.AccessibilityView="Raw" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="8">
                <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                  <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineStudioReview3}" />
                  <WrapPanel ItemSpacing="12" LineSpacing="4" Classes="timeline-time">
                    <alder:AlderTextBlock Classes="body" Text="Paz Kim" />
                    <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineStudioReview3Time}" />
                  </WrapPanel>
                </Grid>
                <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineStudioReview3Detail}" />
              </StackPanel>
            </alder:AlderTimelineItem>
            <alder:AlderTimelineItem ShowMarkerFrame="False">
              <alder:AlderTimelineItem.Marker>
                <alder:AlderAvatar Width="24" Height="24" FontSize="10" Variant="Soft" Color="Success" Fallback="MS" AutomationProperties.AccessibilityView="Raw" />
              </alder:AlderTimelineItem.Marker>
              <StackPanel Spacing="8">
                <Grid Classes="timeline-timed" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                  <alder:AlderTextBlock Classes="small-title" Text="{DynamicResource GalleryText.ProTimelineStudioReview4}" />
                  <WrapPanel ItemSpacing="12" LineSpacing="4" Classes="timeline-time">
                    <alder:AlderTextBlock Classes="body" Text="Mina Sol" />
                    <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineStudioReview4Time}" />
                  </WrapPanel>
                </Grid>
                <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineStudioReview4Detail}" />
              </StackPanel>
            </alder:AlderTimelineItem>
          </alder:AlderTimeline>
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVersions" Title="{DynamicResource GalleryText.ProDemoTimelineVersions}">
      <g:ExampleCard.Preview>
        <Panel MaxWidth="420" HorizontalAlignment="Stretch">
          <alder:AlderCard Padding="0" IsVisible="{CompiledBinding IsHistoryVisible}">
            <StackPanel Spacing="0">
              <Grid ColumnDefinitions="*,Auto" Margin="20,12">
                <alder:AlderTextBlock Classes="heading" Text="{DynamicResource GalleryText.ProTimelineRevisionHistory}" VerticalAlignment="Center" />
                <alder:AlderButton Grid.Column="1" Size="Small" Variant="Secondary" IsIconOnly="True" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" Foreground="{DynamicResource AlderMuted}" Icon="{StaticResource AlderIconXmark}" Command="{CompiledBinding CloseHistory}" AutomationProperties.Name="{DynamicResource GalleryText.ProTimelineRevisionClose}" />
              </Grid>
              <alder:AlderSeparator />
              <alder:AlderTimeline Size="Small" Margin="20,16">
                <alder:AlderTimelineItem MarkerColor="Accent" ShowMarkerDot="False">
                  <StackPanel Spacing="6">
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderTextBlock Classes="small-title" Text="v8" />
                      <alder:AlderChip Size="Small" Variant="Soft" Color="Accent" Content="{DynamicResource GalleryText.ProTimelineRevision1Status}" />
                    </WrapPanel>
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRevision1Detail}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderAvatar Width="20" Height="20" FontSize="10" Variant="Soft" Color="Default" Fallback="M" AutomationProperties.AccessibilityView="Raw" />
                      <alder:AlderTextBlock Classes="body" Text="Maya Chen" />
                      <alder:AlderTextBlock Classes="body" Text="·" />
                      <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineRevision1Time}" />
                    </WrapPanel>
                  </StackPanel>
                </alder:AlderTimelineItem>
                <alder:AlderTimelineItem MarkerColor="Success" ShowMarkerDot="False">
                  <StackPanel Spacing="6">
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderTextBlock Classes="small-title" Text="v7" />
                      <alder:AlderChip Size="Small" Variant="Soft" Color="Success" Content="{DynamicResource GalleryText.ProTimelineRevision2Status}" />
                    </WrapPanel>
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRevision2Detail}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderAvatar Width="20" Height="20" FontSize="10" Variant="Soft" Color="Default" Fallback="N" AutomationProperties.AccessibilityView="Raw" />
                      <alder:AlderTextBlock Classes="body" Text="Nora Vazquez" />
                      <alder:AlderTextBlock Classes="body" Text="·" />
                      <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineRevision2Time}" />
                    </WrapPanel>
                  </StackPanel>
                </alder:AlderTimelineItem>
                <alder:AlderTimelineItem ShowMarkerDot="False">
                  <StackPanel Spacing="6">
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderTextBlock Classes="small-title" Text="v6" />
                    </WrapPanel>
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRevision3Detail}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderAvatar Width="20" Height="20" FontSize="10" Variant="Soft" Color="Default" Fallback="E" AutomationProperties.AccessibilityView="Raw" />
                      <alder:AlderTextBlock Classes="body" Text="Eli Wong" />
                      <alder:AlderTextBlock Classes="body" Text="·" />
                      <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineRevision3Time}" />
                    </WrapPanel>
                  </StackPanel>
                </alder:AlderTimelineItem>
                <alder:AlderTimelineItem ShowMarkerDot="False">
                  <StackPanel Spacing="6">
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderTextBlock Classes="small-title" Text="v5" />
                    </WrapPanel>
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRevision4Detail}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderAvatar Width="20" Height="20" FontSize="10" Variant="Soft" Color="Default" Fallback="M" AutomationProperties.AccessibilityView="Raw" />
                      <alder:AlderTextBlock Classes="body" Text="Maya Chen" />
                      <alder:AlderTextBlock Classes="body" Text="·" />
                      <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineRevision4Time}" />
                    </WrapPanel>
                  </StackPanel>
                </alder:AlderTimelineItem>
                <alder:AlderTimelineItem ShowMarkerDot="False">
                  <StackPanel Spacing="6">
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderTextBlock Classes="small-title" Text="v4" />
                    </WrapPanel>
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRevision5Detail}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderAvatar Width="20" Height="20" FontSize="10" Variant="Soft" Color="Default" Fallback="N" AutomationProperties.AccessibilityView="Raw" />
                      <alder:AlderTextBlock Classes="body" Text="Nora Vazquez" />
                      <alder:AlderTextBlock Classes="body" Text="·" />
                      <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineRevision5Time}" />
                    </WrapPanel>
                  </StackPanel>
                </alder:AlderTimelineItem>
                <alder:AlderTimelineItem ShowMarkerDot="False">
                  <StackPanel Spacing="6">
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderTextBlock Classes="small-title" Text="v3" />
                    </WrapPanel>
                    <alder:AlderTextBlock Classes="body" Text="{DynamicResource GalleryText.ProTimelineRevision6Detail}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                      <alder:AlderAvatar Width="20" Height="20" FontSize="10" Variant="Soft" Color="Default" Fallback="E" AutomationProperties.AccessibilityView="Raw" />
                      <alder:AlderTextBlock Classes="body" Text="Eli Wong" />
                      <alder:AlderTextBlock Classes="body" Text="·" />
                      <alder:AlderTextBlock Classes="time" Text="{DynamicResource GalleryText.ProTimelineRevision6Time}" />
                    </WrapPanel>
                  </StackPanel>
                </alder:AlderTimelineItem>
              </alder:AlderTimeline>
            </StackPanel>
          </alder:AlderCard>
          <alder:AlderButton HorizontalAlignment="Center" VerticalAlignment="Center" Size="Small" Variant="Secondary" IsVisible="{CompiledBinding !IsHistoryVisible}" Content="{DynamicResource GalleryText.Reset}" Command="{CompiledBinding ResetHistory}" />
        </Panel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
