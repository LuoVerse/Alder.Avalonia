<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.TrendChipExample" x:DataType="vm:TrendChipViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="GalleryTrendUp">F0 M0 0H16V16H0Z M0 0H16V16H0Z M7.25 13.75V4.82 L4.53 7.54 L3.47 6.48 L8 1.95 L12.53 6.48 L11.47 7.54 L8.75 4.82 V13.75 A.75 .75 0 0 1 7.25 13.75 Z</StreamGeometry>
    <StreamGeometry x:Key="GalleryTrendDown">F0 M0 0H16V16H0Z M0 0H16V16H0Z M7.25 2.25 A.75 .75 0 0 1 8.75 2.25 V11.18 L11.47 8.46 L12.53 9.52 L8 14.05 L3.47 9.52 L4.53 8.46 L7.25 11.18 Z</StreamGeometry>
    <StreamGeometry x:Key="GalleryTrendFlame">F0 M0 0H16V16H0Z M0 0H16V16H0Z M8 15 C4.65 15 2.7 12.8 2.7 9.9 C2.7 7.8 3.8 6.2 5.2 4.9 C5.43 5.85 5.88 6.43 6.52 6.84 C6.73 4.71 7.59 3 9.03 1.11 C11.25 3.56 13.3 6.6 13.3 9.9 C13.3 12.83 11.24 15 8 15Z M8 13.5 C10.35 13.5 11.8 11.88 11.8 9.9 C11.8 7.62 10.47 5.16 9.1 3.56 C8 5.31 7.88 6.89 7.88 8.56 C6.59 8.62 5.68 8.03 4.94 7.25 C4.48 8.11 4.2 9 4.2 9.9 C4.2 12.01 5.65 13.5 8 13.5Z M8 13.65 C6.25 13.65 5.55 12.5 5.55 11.34 C5.55 10.34 6.32 9.48 6.85 8.94 L7.6 10.08 C8.27 9.88 8.48 9.13 8.72 8.56 C9.66 9.55 10.45 10.34 10.45 11.34 C10.45 12.5 9.71 13.65 8 13.65Z M8 12.32 A1.06 1.06 0 0 0 9.1 11.32 C9.1 10.98 8.86 10.6 8.62 10.33 C8.11 10.98 7.59 11.13 7.04 11.17 C6.89 11.92 7.4 12.32 8 12.32Z</StreamGeometry>
    <StreamGeometry x:Key="GalleryTrendBolt">F0 M0 0H16V16H0Z M0 0H16V16H0Z M6.57 1.25 H12.04 L9.82 6.15 H13.65 L7.05 14.72 C6.62 15.3 5.7 14.86 5.84 14.17 L6.67 9.86 H2.53 Z M7.53 2.75 L4.96 8.36 H8.45 L7.76 11.91 L10.63 7.65 H7.49 L9.71 2.75 Z</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.feedback-muted">
      <Setter Property="Foreground" Value="{DynamicResource AlderMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="16" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="20" x:Name="Examples">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="320">
          <WrapPanel ItemSpacing="12" LineSpacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
            <alder:AlderTrendChip Content="{CompiledBinding Increase}" Trend="Up" Variant="Soft"/>
            <alder:AlderTrendChip Content="{CompiledBinding Decrease}" Trend="Down" Variant="Soft"/>
            <alder:AlderTrendChip Content="{CompiledBinding Steady}" Trend="Neutral" Variant="Soft" ShowIndicator="False"/>
          </WrapPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVariants" Title="{DynamicResource GalleryText.TrendChipVariants}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="320">
          <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.TrendChipPrimary}" Classes="feedback-muted" VerticalAlignment="Center"/>
              <WrapPanel Grid.Column="1" ItemSpacing="12" LineSpacing="8" VerticalAlignment="Center">
                <alder:AlderTrendChip Content="{CompiledBinding Increase}" Trend="Up" Variant="Primary"/>
                <alder:AlderTrendChip Content="{CompiledBinding Decrease}" Trend="Down" Variant="Primary"/>
                <alder:AlderTrendChip Content="{CompiledBinding Steady}" Trend="Neutral" Variant="Primary" ShowIndicator="False"/>
              </WrapPanel>
            </Grid>
            <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.TrendChipSecondary}" Classes="feedback-muted" VerticalAlignment="Center"/>
              <WrapPanel Grid.Column="1" ItemSpacing="12" LineSpacing="8" VerticalAlignment="Center">
                <alder:AlderTrendChip Content="{CompiledBinding Increase}" Trend="Up" Variant="Secondary"/>
                <alder:AlderTrendChip Content="{CompiledBinding Decrease}" Trend="Down" Variant="Secondary"/>
                <alder:AlderTrendChip Content="{CompiledBinding Steady}" Trend="Neutral" Variant="Secondary" ShowIndicator="False"/>
              </WrapPanel>
            </Grid>
            <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.TrendChipTertiary}" Classes="feedback-muted" VerticalAlignment="Center"/>
              <WrapPanel Grid.Column="1" ItemSpacing="12" LineSpacing="8" VerticalAlignment="Center">
                <alder:AlderTrendChip Content="{CompiledBinding Increase}" Trend="Up" Variant="Tertiary"/>
                <alder:AlderTrendChip Content="{CompiledBinding Decrease}" Trend="Down" Variant="Tertiary"/>
                <alder:AlderTrendChip Content="{CompiledBinding Steady}" Trend="Neutral" Variant="Tertiary" ShowIndicator="False"/>
              </WrapPanel>
            </Grid>
            <Grid ColumnDefinitions="80,*" ColumnSpacing="12">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.TrendChipSoft}" Classes="feedback-muted" VerticalAlignment="Center"/>
              <WrapPanel Grid.Column="1" ItemSpacing="12" LineSpacing="8" VerticalAlignment="Center">
                <alder:AlderTrendChip Content="{CompiledBinding Increase}" Trend="Up" Variant="Soft"/>
                <alder:AlderTrendChip Content="{CompiledBinding Decrease}" Trend="Down" Variant="Soft"/>
                <alder:AlderTrendChip Content="{CompiledBinding Steady}" Trend="Neutral" Variant="Soft" ShowIndicator="False"/>
              </WrapPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleSizes" Title="{DynamicResource GalleryText.TrendChipSizes}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="320">
          <WrapPanel ItemSpacing="12" LineSpacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
            <alder:AlderTrendChip Content="{CompiledBinding Increase}" Trend="Up" Size="Small"/>
            <alder:AlderTrendChip Content="{CompiledBinding Increase}" Trend="Up" Size="Medium"/>
            <alder:AlderTrendChip Content="{CompiledBinding Increase}" Trend="Up" Size="Large"/>
          </WrapPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleAffixes" Title="{DynamicResource GalleryText.TrendChipAffixes}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="320">
          <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
            <alder:AlderTrendChip Content="1,234" Trend="Up" Prefix="+$"/>
            <alder:AlderTrendChip Content="-5.9%" Trend="Down" Suffix="{DynamicResource GalleryText.TrendChipPrevious}"/>
            <alder:AlderTrendChip Content="3.3%" Trend="Up" Prefix="+" Suffix="{DynamicResource GalleryText.TrendChipMom}"/>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleTabular" Title="{DynamicResource GalleryText.TrendChipTabular}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="320">
          <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
            <alder:AlderTrendChip Content="+1.1%" Trend="Up" TabularNumbers="True" ShowIndicator="True"/>
            <alder:AlderTrendChip Content="+22.2%" Trend="Up" TabularNumbers="True" ShowIndicator="True"/>
            <alder:AlderTrendChip Content="-333.3%" Trend="Down" TabularNumbers="True" ShowIndicator="True"/>
            <alder:AlderTrendChip Content="{CompiledBinding Steady}" Trend="Neutral" TabularNumbers="True" ShowIndicator="False"/>
          </StackPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleIndicator" Title="{DynamicResource GalleryText.TrendChipIndicator}">
      <g:ExampleCard.Preview>
        <Grid MinHeight="320">
          <WrapPanel ItemSpacing="12" LineSpacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderTrendChip Content="{CompiledBinding Increase}" Trend="Up" Indicator="{StaticResource GalleryTrendUp}"/>
            <alder:AlderTrendChip Content="{CompiledBinding Decrease}" Trend="Down" Indicator="{StaticResource GalleryTrendDown}"/>
            <alder:AlderTrendChip Content="+12.5%" Trend="Up" Indicator="{StaticResource GalleryTrendFlame}"/>
            <alder:AlderTrendChip Content="{CompiledBinding Steady}" Trend="Neutral" Indicator="{StaticResource GalleryTrendBolt}"/>
          </WrapPanel>
        </Grid>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
