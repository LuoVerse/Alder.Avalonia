<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.CellSliderExample" x:DataType="vm:CellSliderViewModel">
  <StackPanel x:Name="Examples" Spacing="20">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="8" MaxWidth="252">
          <StackPanel Spacing="8">
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.CellDensity}" FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
            <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellSpacing}" Value="0.50" ValueCulture="{DynamicResource GalleryCulture}" />
            <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellFontSizeTitle}" Value="0.30" ValueCulture="{DynamicResource GalleryCulture}" />
          </StackPanel>
          <StackPanel Spacing="8">
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.CellCorners}" FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" Margin="0,0,0,4" />
            <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellGeneralRadius}" Value="0.50" ValueCulture="{DynamicResource GalleryCulture}" />
            <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellFormsRadius}" Value="0.30" ValueCulture="{DynamicResource GalleryCulture}" />
          </StackPanel>
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleControlled" Title="{DynamicResource GalleryText.Controlled}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="8" MaxWidth="252">
          <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellSpacing}" Value="{CompiledBinding Spacing, Mode=TwoWay}" ValueCulture="{DynamicResource GalleryCulture}" />
          <alder:AlderTextBlock Text="{CompiledBinding SpacingResult}" FontSize="12" LineHeight="20" Foreground="{DynamicResource AlderMuted}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleDisabled" Title="{DynamicResource GalleryText.Disabled}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="8" MaxWidth="252">
          <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellSpacing}" Value="0.50" ValueCulture="{DynamicResource GalleryCulture}" IsEnabled="False" />
          <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellFontSizeTitle}" Value="0.30" ValueCulture="{DynamicResource GalleryCulture}" IsEnabled="False" />
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleInteger" Title="{DynamicResource GalleryText.CellIntegerStep}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="8" MaxWidth="252">
          <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellVolume}" Value="75" ValueCulture="{DynamicResource GalleryCulture}" Maximum="100" Step="1" LargeChange="10" ValueFormat="0" />
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleSecondary" Title="{DynamicResource GalleryText.CellSecondaryGroup}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="8" MaxWidth="252">
          <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellSpacing}" Value="0.50" ValueCulture="{DynamicResource GalleryCulture}" Variant="Secondary" />
          <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellFontSizeTitle}" Value="0.30" ValueCulture="{DynamicResource GalleryCulture}" Variant="Secondary" />
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleSettings" Title="{DynamicResource GalleryText.CellSingleSetting}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="8" MaxWidth="252">
          <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellSpacing}" Value="0.50" ValueCulture="{DynamicResource GalleryCulture}" />
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVariants" Title="{DynamicResource GalleryText.Variants}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="252">
          <StackPanel>
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.CellVariantPrimary}" FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
            <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellSpacing}" Value="0.50" ValueCulture="{DynamicResource GalleryCulture}" />
          </StackPanel>
          <StackPanel>
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.CellVariantSecondary}" FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
            <alder:AlderCellSlider Label="{DynamicResource GalleryText.CellSpacing}" Value="0.50" ValueCulture="{DynamicResource GalleryCulture}" Variant="Secondary" />
          </StackPanel>
        </StackPanel>
      </g:ExampleCard.Preview>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
