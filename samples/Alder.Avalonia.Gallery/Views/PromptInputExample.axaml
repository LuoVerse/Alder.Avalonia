    <g:ExampleCard Classes="chat-message-preview" x:Name="SampleCompact" Title="{DynamicResource GalleryText.AiVariantCompact}">
      <g:ExampleCard.Preview>
        <Border Padding="8,24">
          <Border.DataContext>
            <vm:AiExampleViewModel/>
          </Border.DataContext>
          <StackPanel Spacing="4" MaxWidth="640">
            <a:AlderPromptInput Theme="{StaticResource AlderPromptComposerTheme}" Variant="Compact" Text="{CompiledBinding Draft}" SendCommand="{CompiledBinding Send}" IsRunning="{CompiledBinding Running}" StopCommand="{CompiledBinding Stop}" Placeholder="{DynamicResource GalleryText.AiFollowUp}" AttachCommand="{CompiledBinding Attach}">
              <a:AlderPromptInput.Attachments>
                <a:AlderChatAttachment FileName="{CompiledBinding FileName}" IsVisible="{CompiledBinding FileName, Converter={x:Static c:ObjectConverters.IsNotNull}}" RemoveCommand="{CompiledBinding Remove}"/>
