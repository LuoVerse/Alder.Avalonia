<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:a="using:Alder.Avalonia.Controls" xmlns:c="using:Avalonia.Data.Converters" xmlns:g="using:Alder.Avalonia.Gallery.Controls" xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels" x:Class="Alder.Avalonia.Gallery.Views.PromptInputExample" x:DataType="vm:AiExampleViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="PromptQueueGrip">M4 2a1.3 1.3 0 1 0 0 2.6a1.3 1.3 0 1 0 0-2.6 M11 2a1.3 1.3 0 1 0 0 2.6a1.3 1.3 0 1 0 0-2.6 M4 7a1.3 1.3 0 1 0 0 2.6a1.3 1.3 0 1 0 0-2.6 M11 7a1.3 1.3 0 1 0 0 2.6a1.3 1.3 0 1 0 0-2.6 M4 12a1.3 1.3 0 1 0 0 2.6a1.3 1.3 0 1 0 0-2.6 M11 12a1.3 1.3 0 1 0 0 2.6a1.3 1.3 0 1 0 0-2.6</StreamGeometry>
    <StreamGeometry x:Key="PromptAddContextIcon">F0 M8 1.5A6.5 6.5 0 1 0 8 14.5A6.5 6.5 0 1 0 8 1.5Z M8 3A5 5 0 1 1 8 13A5 5 0 1 1 8 3Z M7.25 5H8.75V7.25H11V8.75H8.75V11H7.25V8.75H5V7.25H7.25Z</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Border.prompt-queue-row StackPanel.prompt-queue-actions"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Border.prompt-queue-row:pointerover StackPanel.prompt-queue-actions, Border.prompt-queue-row:focus-within StackPanel.prompt-queue-actions">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="UniformGrid.prompt-suggestions"><Setter Property="Columns" Value="2" /></Style>
    <ContainerQuery Name="ModelSelectorComposer" Query="max-width:560">
      <Style Selector="UniformGrid.prompt-suggestions"><Setter Property="Columns" Value="1" /></Style>
    </ContainerQuery>
    <ContainerQuery Name="ReviewHost" Query="max-width:420">
      <Style Selector="a|AlderButton.review-branch"><Setter Property="IsVisible" Value="False" /></Style>
      <Style Selector="a|AlderModelSelector.review-model"><Setter Property="IsVisible" Value="False" /></Style>
    </ContainerQuery>
  </UserControl.Styles>
  <StackPanel Spacing="20" Container.Name="ModelSelectorComposer" Container.Sizing="Width">
    <g:ExampleCard Classes="chat-message-preview" x:Name="SampleDefault" Title="{DynamicResource GalleryText.AiDefault}">
      <g:ExampleCard.Preview>
        <Border Padding="8,24">
          <Border.DataContext>
            <vm:AiExampleViewModel/>
          </Border.DataContext>
          <StackPanel Spacing="4" MaxWidth="640">
            <a:AlderPromptInput Theme="{StaticResource AlderPromptComposerTheme}" Variant="Primary" Text="{CompiledBinding Draft}" SendCommand="{CompiledBinding Send}" IsRunning="{CompiledBinding Running}" StopCommand="{CompiledBinding Stop}" Placeholder="{DynamicResource GalleryText.AiAsk}" AttachCommand="{CompiledBinding Attach}">
              <a:AlderPromptInput.Attachments>
                <a:AlderChatAttachment FileName="{CompiledBinding FileName}" IsVisible="{CompiledBinding FileName, Converter={x:Static c:ObjectConverters.IsNotNull}}" RemoveCommand="{CompiledBinding Remove}"/>
              </a:AlderPromptInput.Attachments>
              <a:AlderPromptInput.Tools>
                <a:AlderModelSelector ItemTemplate="{DynamicResource AiModelRow}" ItemsSource="{CompiledBinding Models}" SelectedModel="{CompiledBinding Model}"/>
              </a:AlderPromptInput.Tools>
            </a:AlderPromptInput>
            <a:AlderTextBlock Text="{DynamicResource GalleryText.AiDisclaimer}" TextWrapping="Wrap" Foreground="{DynamicResource AlderMuted}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var model = new AiExampleViewModel { Scenario = AiGalleryScenario.Default };
        var prompt = new AlderPromptInput
        {
            DataContext = model, Variant = AiPromptVariant.Primary,
            Theme = (ControlTheme)Application.Current!.FindResource("AlderPromptComposerTheme")!,
            SendCommand = model.Send, StopCommand = model.Stop
        };
        prompt.Bind(AlderPromptInput.TextProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Draft, mode: BindingMode.TwoWay));
        prompt.Bind(AlderPromptInput.IsRunningProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Running));
        prompt[!AlderPromptInput.PlaceholderProperty] = new DynamicResourceExtension("GalleryText.AiAsk");
        var attachment = new AlderChatAttachment { RemoveCommand = model.Remove };
        attachment.Bind(AlderChatAttachment.FileNameProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.FileName));
        attachment.Bind(Visual.IsVisibleProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.FileName,
            converter: ObjectConverters.IsNotNull));
        prompt.Attachments = attachment;
        prompt.AttachCommand = model.Attach;
        var picker = new AlderModelSelector { ItemsSource = model.Models };
        picker.Bind(AlderModelSelector.SelectedModelProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Model));
        picker[!AlderModelSelector.ItemTemplateProperty] = new DynamicResourceExtension("AiModelRow");
        prompt.Tools = picker;
        var footer = new AlderTextBlock { FontSize = 12, TextAlignment = TextAlignment.Center, TextWrapping = TextWrapping.Wrap };
        footer[!TextBlock.TextProperty] = new DynamicResourceExtension("GalleryText.AiDisclaimer");
        footer[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        var preview = new StackPanel { MaxWidth = 640, Spacing = 4, Children = { prompt, footer } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard Classes="chat-message-preview" x:Name="SampleReviewComposer" Title="{DynamicResource GalleryText.AiVariantReviewComposer}">
      <g:ExampleCard.Preview>
        <Border Container.Name="ReviewHost" Container.Sizing="Width" Padding="8,24">
          <Border.DataContext>
            <vm:AiExampleViewModel Scenario="Review"/>
          </Border.DataContext>
          <StackPanel Spacing="10" MaxWidth="660">
            <WrapPanel ItemSpacing="6" LineSpacing="4">
              <a:AlderButton Command="{CompiledBinding Act}" CommandParameter="AiReviewDetail" Variant="Outline" Size="Small"><StackPanel Spacing="5" Orientation="Horizontal" >
<a:AlderTextBlock Text="{DynamicResource GalleryText.AiReviewWord}" TextWrapping="Wrap"  />
<a:AlderTextBlock Text="+469" TextWrapping="Wrap" Foreground="{DynamicResource AlderAiSuccess}" />
<a:AlderTextBlock Text="−34" TextWrapping="Wrap" Foreground="{DynamicResource AlderDanger}" />
</StackPanel></a:AlderButton>
              <a:AlderButton Classes="review-branch" Content="{DynamicResource GalleryText.AiBranchCommit}" Command="{CompiledBinding Act}" CommandParameter="AiBranchCreated" Variant="Outline" Size="Small"/>
            <a:AlderButton Variant="Outline" Size="Small" IsIconOnly="True" Icon="{DynamicResource AlderIconEllipsis}" AutomationProperties.Name="{DynamicResource GalleryText.AiMoreActions}"><a:AlderButton.Flyout><a:AlderMenuFlyout><a:AlderMenuItem Header="agent-browser" Command="{CompiledBinding Suggest}" CommandParameter="/agent-browser " /><a:AlderMenuItem Header="ai-sdk" Command="{CompiledBinding Suggest}" CommandParameter="/ai-sdk " /><a:AlderMenuItem Header="automate" Command="{CompiledBinding Suggest}" CommandParameter="/automate " /><a:AlderMenuItem Header="babysit" Command="{CompiledBinding Suggest}" CommandParameter="/babysit " /><a:AlderMenuItem Header="canvas" Command="{CompiledBinding Suggest}" CommandParameter="/canvas " /></a:AlderMenuFlyout></a:AlderButton.Flyout></a:AlderButton></WrapPanel>
            <a:AlderPromptInput Theme="{StaticResource AlderPromptComposerTheme}" Variant="Inline" Classes="review-composer" Text="{CompiledBinding Draft}" SendCommand="{CompiledBinding Send}" IsRunning="{CompiledBinding Running}" StopCommand="{CompiledBinding Stop}" Placeholder="{DynamicResource GalleryText.AiFollowUp}">
              <a:AlderPromptInput.LeadingTools>
                <a:AlderButton Size="Small" Variant="Tertiary" IsIconOnly="True" Icon="{DynamicResource AlderIconPlus}"
                               Command="{CompiledBinding Attach}" AutomationProperties.Name="{DynamicResource GalleryText.AiAddContext}" />
              </a:AlderPromptInput.LeadingTools>
              <a:AlderPromptInput.EmptyAction>
                <a:AlderToggleButton Theme="{StaticResource AlderPromptReviewVoiceTheme}" AutomationProperties.Name="{DynamicResource GalleryText.AiVoice}" IsChecked="{CompiledBinding VoicePreviewActive, Mode=TwoWay}" />
              </a:AlderPromptInput.EmptyAction>
              <a:AlderPromptInput.Attachments>
                <a:AlderChatAttachment FileName="{CompiledBinding FileName}" IsVisible="{CompiledBinding FileName, Converter={x:Static c:ObjectConverters.IsNotNull}}" RemoveCommand="{CompiledBinding Remove}"/>
              </a:AlderPromptInput.Attachments>
              <a:AlderPromptInput.Tools>
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <a:AlderModelSelector Classes="review-model" ShowIcon="False" ItemTemplate="{DynamicResource AiModelRow}" ItemsSource="{CompiledBinding Models}" SelectedModel="{CompiledBinding Model}" />
                  <a:AlderToggleButton Variant="Ghost" Size="Small" IsIconOnly="True" Icon="{DynamicResource AlderComposerVoiceIcon}"
                                       IsVisible="{CompiledBinding Draft, Converter={x:Static vm:AiExampleViewModel.HasPromptDraft}}"
                                       AutomationProperties.Name="{DynamicResource GalleryText.AiVoice}" IsChecked="{CompiledBinding VoicePreviewActive, Mode=TwoWay}" />
                </StackPanel>
              </a:AlderPromptInput.Tools>
            </a:AlderPromptInput>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="8,0">
              <a:AlderTextBlock Text="develop" TextWrapping="Wrap" Foreground="{DynamicResource AlderMuted}" FontSize="12"/>
              <a:AlderTextBlock Grid.Column="1" Text="{DynamicResource GalleryText.AiLocal}" TextWrapping="Wrap" Foreground="{DynamicResource AlderMuted}" FontSize="12"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <a:AlderProgressCircle Diameter="16" StrokeThickness="2" Value="32" />
                <a:AlderTextBlock Text="32%" VerticalAlignment="Center" Foreground="{DynamicResource AlderMuted}" FontSize="12"/>
              </StackPanel>
            </Grid>
            <a:AlderTextBlock Text="{CompiledBinding Feedback}" TextWrapping="Wrap" Foreground="{DynamicResource AlderMuted}" FontSize="12" IsVisible="{CompiledBinding Feedback, Converter={x:Static c:ObjectConverters.IsNotNull}}"/>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var model = new AiExampleViewModel { Scenario = AiGalleryScenario.Review };
        var prompt = new AlderPromptInput
        {
            DataContext = model, Variant = AiPromptVariant.Inline,
            Theme = (ControlTheme)Application.Current!.FindResource("AlderPromptComposerTheme")!,
            SendCommand = model.Send, StopCommand = model.Stop
        };
        prompt.Bind(AlderPromptInput.TextProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Draft, mode: BindingMode.TwoWay));
        prompt.Bind(AlderPromptInput.IsRunningProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Running));
        prompt[!AlderPromptInput.PlaceholderProperty] = new DynamicResourceExtension("GalleryText.AiFollowUp");
        var attachment = new AlderChatAttachment { RemoveCommand = model.Remove };
        attachment.Bind(AlderChatAttachment.FileNameProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.FileName));
        attachment.Bind(Visual.IsVisibleProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.FileName,
            converter: ObjectConverters.IsNotNull));
        prompt.Attachments = attachment;
        var picker = new AlderModelSelector { ItemsSource = model.Models, ShowIcon = false };
        picker.Bind(AlderModelSelector.SelectedModelProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Model));
        picker[!AlderModelSelector.ItemTemplateProperty] = new DynamicResourceExtension("AiModelRow");
        prompt.Tools = picker;
        prompt.Classes.Add("review-composer");
        var voice = new AlderToggleButton
        {
            Theme = (ControlTheme)Application.Current!.FindResource("AlderPromptReviewVoiceTheme")!
        };
        voice[!AutomationProperties.NameProperty] = new DynamicResourceExtension("GalleryText.AiVoice");
        voice.Bind(AlderToggleButton.IsCheckedProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.VoicePreviewActive, mode: BindingMode.TwoWay));
        var reviewingVoice = new AlderToggleButton { IsIconOnly = true, Size = AlderSize.Small, Variant = ToggleButtonVariant.Ghost };
        reviewingVoice[!AlderToggleButton.IconProperty] = new DynamicResourceExtension("AlderComposerVoiceIcon");
        reviewingVoice[!AutomationProperties.NameProperty] = new DynamicResourceExtension("GalleryText.AiVoice");
        reviewingVoice.Bind(AlderToggleButton.IsCheckedProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.VoicePreviewActive, mode: BindingMode.TwoWay));
        reviewingVoice.Bind(Visual.IsVisibleProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Draft,
            converter: AiExampleViewModel.HasPromptDraft));
        prompt.Tools = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 4, Children = { picker, reviewingVoice } };
        var addContext = new AlderButton { IsIconOnly = true, Size = AlderSize.Small, Variant = ButtonVariant.Tertiary, Command = model.Attach };
        addContext[!AlderButton.IconProperty] = new DynamicResourceExtension("AlderIconPlus");
        prompt.LeadingTools = addContext;
        prompt.EmptyAction = voice;

        var reviewText = new AlderTextBlock();
        reviewText[!TextBlock.TextProperty] = new DynamicResourceExtension("GalleryText.AiReviewWord");
        var added = new AlderTextBlock { Text = "+469" };
        added[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderAiSuccess");
        var removed = new AlderTextBlock { Text = "−34" };
        removed[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderDanger");
        var review = new AlderButton { Size = AlderSize.Small, Variant = ButtonVariant.Outline, Command = model.Act,
            CommandParameter = "AiReviewDetail", Content = new StackPanel { Orientation = Orientation.Horizontal,
                Spacing = 5, Children = { reviewText, added, removed } } };
        var commit = new AlderButton { Size = AlderSize.Small, Variant = ButtonVariant.Outline, Command = model.Act, CommandParameter = "AiBranchCreated" };
        commit[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.AiBranchCommit");
        var commands = new AlderMenuFlyout();
        foreach (string skill in new[] { "agent-browser", "ai-sdk", "automate", "babysit", "canvas" })
            commands.Items.Add(new AlderMenuItem { Header = skill, Command = model.Suggest, CommandParameter = $"/{skill} " });
        var more = new AlderButton { Size = AlderSize.Small, IsIconOnly = true, Variant = ButtonVariant.Outline, Flyout = commands };
        more[!AlderButton.IconProperty] = new DynamicResourceExtension("AlderIconEllipsis");
        AlderTextBlock Caption(string? value = null)
        {
            var label = new AlderTextBlock { Text = value, TextWrapping = TextWrapping.Wrap, FontSize = 12 };
            label[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
            return label;
        }
        var local = Caption();
        local[!TextBlock.TextProperty] = new DynamicResourceExtension("GalleryText.AiLocal");
        var usageText = Caption("32%");
        usageText.VerticalAlignment = VerticalAlignment.Center;
        var usage = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 8,
            Children = { new AlderProgressCircle { Diameter = 16, StrokeThickness = 2, Value = 32 }, usageText } };
        Grid.SetColumn(local, 1);
        Grid.SetColumn(usage, 2);
        var footer = new Grid { ColumnDefinitions = new ColumnDefinitions("Auto,*,Auto"), ColumnSpacing = 12,
            Margin = new Thickness(8, 0), Children = { Caption("develop"), local, usage } };
        var feedback = Caption();
        feedback.Bind(TextBlock.TextProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Feedback));
        feedback.Bind(Visual.IsVisibleProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Feedback,
            converter: ObjectConverters.IsNotNull));
        var preview = new StackPanel { DataContext = model, MaxWidth = 660, Spacing = 10, Children =
            { new WrapPanel { ItemSpacing = 6, LineSpacing = 4, Children = { review, commit, more } }, prompt, footer, feedback } };
        preview.SizeChanged += (_, args) => picker.IsVisible = commit.IsVisible = args.NewSize.Width > 420;
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard Classes="chat-message-preview" x:Name="SampleSecondary" Title="{DynamicResource GalleryText.AiVariantSecondary}">
      <g:ExampleCard.Preview>
        <Border Padding="8,24">
          <Border.DataContext>
            <vm:AiExampleViewModel/>
          </Border.DataContext>
          <StackPanel Spacing="4" MaxWidth="640">
            <a:AlderPromptInput Theme="{StaticResource AlderPromptComposerTheme}" Variant="Secondary" Text="{CompiledBinding Draft}" SendCommand="{CompiledBinding Send}" IsRunning="{CompiledBinding Running}" StopCommand="{CompiledBinding Stop}" Placeholder="{DynamicResource GalleryText.AiAsk}" AttachCommand="{CompiledBinding Attach}">
              <a:AlderPromptInput.Attachments>
                <a:AlderChatAttachment FileName="{CompiledBinding FileName}" IsVisible="{CompiledBinding FileName, Converter={x:Static c:ObjectConverters.IsNotNull}}" RemoveCommand="{CompiledBinding Remove}"/>
              </a:AlderPromptInput.Attachments>
              <a:AlderPromptInput.Tools>
                <a:AlderModelSelector ItemTemplate="{DynamicResource AiModelRow}" ItemsSource="{CompiledBinding Models}" SelectedModel="{CompiledBinding Model}"/>
              </a:AlderPromptInput.Tools>
            </a:AlderPromptInput>
            <a:AlderTextBlock Text="{DynamicResource GalleryText.AiSecondaryInfo}" TextWrapping="Wrap" Foreground="{DynamicResource AlderMuted}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var model = new AiExampleViewModel { Scenario = AiGalleryScenario.Default };
        var prompt = new AlderPromptInput
        {
            DataContext = model, Variant = AiPromptVariant.Secondary,
            Theme = (ControlTheme)Application.Current!.FindResource("AlderPromptComposerTheme")!,
            SendCommand = model.Send, StopCommand = model.Stop
        };
        prompt.Bind(AlderPromptInput.TextProperty,
            CompiledBinding.Create((AiExampleViewModel vm) => vm.Draft, mode: BindingMode.TwoWay));
        prompt.Bind(AlderPromptInput.IsRunningProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Running));
        prompt[!AlderPromptInput.PlaceholderProperty] = new DynamicResourceExtension("GalleryText.AiAsk");
        var attachment = new AlderChatAttachment { RemoveCommand = model.Remove };
        attachment.Bind(AlderChatAttachment.FileNameProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.FileName));
        attachment.Bind(Visual.IsVisibleProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.FileName,
            converter: ObjectConverters.IsNotNull));
        prompt.Attachments = attachment;
        prompt.AttachCommand = model.Attach;
        var picker = new AlderModelSelector { ItemsSource = model.Models };
        picker.Bind(AlderModelSelector.SelectedModelProperty, CompiledBinding.Create((AiExampleViewModel vm) => vm.Model));
        picker[!AlderModelSelector.ItemTemplateProperty] = new DynamicResourceExtension("AiModelRow");
        prompt.Tools = picker;
        var footer = new AlderTextBlock { FontSize = 12, TextAlignment = TextAlignment.Center, TextWrapping = TextWrapping.Wrap };
        footer[!TextBlock.TextProperty] = new DynamicResourceExtension("GalleryText.AiSecondaryInfo");
        footer[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        var preview = new StackPanel { MaxWidth = 640, Spacing = 4, Children = { prompt, footer } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard Classes="chat-message-preview" x:Name="SampleInline" Title="{DynamicResource GalleryText.AiVariantInline}">
      <g:ExampleCard.Preview>
        <Border Padding="8,24">
          <Border.DataContext>
            <vm:AiExampleViewModel/>
          </Border.DataContext>
          <StackPanel Spacing="4" MaxWidth="640">
            <a:AlderPromptInput Theme="{StaticResource AlderPromptComposerTheme}" Variant="Inline" Text="{CompiledBinding Draft}" SendCommand="{CompiledBinding Send}" IsRunning="{CompiledBinding Running}" StopCommand="{CompiledBinding Stop}" Placeholder="{DynamicResource GalleryText.AiFollowUp}" AttachCommand="{CompiledBinding Attach}">
              <a:AlderPromptInput.Attachments>
                <a:AlderChatAttachment FileName="{CompiledBinding FileName}" IsVisible="{CompiledBinding FileName, Converter={x:Static c:ObjectConverters.IsNotNull}}" RemoveCommand="{CompiledBinding Remove}"/>
