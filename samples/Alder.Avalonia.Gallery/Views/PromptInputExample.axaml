            </a:AlderPromptInput>
            <a:AlderTextBlock Text="{DynamicResource GalleryText.AiDisclaimer}" TextWrapping="Wrap" Foreground="{DynamicResource AlderMuted}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
