    <gallery:ExampleCard x:Name="SampleReveal" Title="{DynamicResource GalleryText.TransitionReveal}">
      <gallery:ExampleCard.Preview>
        <StackPanel MaxWidth="480" Spacing="12" DataContext="{CompiledBinding Reveal}" x:DataType="vm:TransitioningContentSample">
          <ContentControl Content="{CompiledBinding}" ContentTemplate="{StaticResource TransitionNavigation}" />
