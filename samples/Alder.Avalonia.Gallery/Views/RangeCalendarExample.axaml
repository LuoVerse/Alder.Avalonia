<gallery:GalleryExampleSection xmlns:gallery="using:Alder.Avalonia.Gallery.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.RangeCalendarExample" x:DataType="vm:RangeCalendarViewModel" FontFamily="fonts:Inter#Inter">
  <Design.DataContext>
    <vm:RangeCalendarViewModel />
  </Design.DataContext>
  <gallery:GalleryExampleSection.Examples>
    <gallery:GalleryExampleTemplate Name="SampleUsage">
      <gallery:ExampleCard Title="{DynamicResource GalleryText.Usage}">
        <gallery:ExampleCard.Preview>
          <Border Padding="8,16">
            <Border.DataContext><vm:RangeCalendarViewModel /></Border.DataContext>
            <alder:AlderRangeCalendar HorizontalAlignment="Center" Culture="{DynamicResource GalleryCulture}"
                            AutomationProperties.Name="{DynamicResource GalleryText.ScheduleCalendar}" DisplayDate="{CompiledBinding PreviewDate, Mode=OneWay}"
                            ShowYearPicker="False" />
          </Border>
        </gallery:ExampleCard.Preview>
        <gallery:ExampleCard.CSharpSource><![CDATA[
          var model = new RangeCalendarViewModel();
          var calendar = new AlderRangeCalendar { DataContext = model, HorizontalAlignment = HorizontalAlignment.Center, ShowYearPicker = false };
          calendar.Bind(AlderRangeCalendar.DisplayDateProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.PreviewDate));
          var preview = calendar;
        ]]></gallery:ExampleCard.CSharpSource>
      </gallery:ExampleCard>
    </gallery:GalleryExampleTemplate>
