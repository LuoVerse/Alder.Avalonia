    <gallery:GalleryExampleTemplate Name="SampleAccent">
      <gallery:ExampleCard Title="{DynamicResource GalleryText.CalendarAccent}">
        <gallery:ExampleCard.Preview>
          <Border Padding="8,16">
            <Border.DataContext><vm:RangeCalendarViewModel /></Border.DataContext>
            <alder:AlderRangeCalendar HorizontalAlignment="Center" Culture="{DynamicResource GalleryCulture}"
                            AutomationProperties.Name="{DynamicResource GalleryText.ScheduleCalendar}" DisplayDate="{CompiledBinding PreviewDate, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Background="{DynamicResource AlderSurface}"
                            BorderBrush="{DynamicResource AlderAccent}" />
          </Border>
        </gallery:ExampleCard.Preview>
        <gallery:ExampleCard.CSharpSource><![CDATA[
          var model = new RangeCalendarViewModel();
          var calendar = new AlderRangeCalendar { DataContext = model, HorizontalAlignment = HorizontalAlignment.Center, BorderThickness = new Thickness(1), CornerRadius = new CornerRadius(12) };
          calendar.Bind(AlderRangeCalendar.DisplayDateProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.PreviewDate));
          calendar[!AlderRangeCalendar.BackgroundProperty] = new DynamicResourceExtension("AlderSurface");
          calendar[!AlderRangeCalendar.BorderBrushProperty] = new DynamicResourceExtension("AlderAccent");
          var preview = calendar;
        ]]></gallery:ExampleCard.CSharpSource>
      </gallery:ExampleCard>
    </gallery:GalleryExampleTemplate>
    <gallery:GalleryExampleTemplate Name="SampleBookAStay">
      <gallery:ExampleCard Title="{DynamicResource GalleryText.BookAStay}">
        <gallery:ExampleCard.Preview>
          <StackPanel Spacing="10">
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.ChooseUpTo15DaysNovember28IsUnavailable}" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
            <alder:AlderRangeCalendar x:Name="StayCalendar" Culture="{DynamicResource GalleryCulture}" VisibleMonths="2" FixedWeeks="True"
                                 Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                 IsDateUnavailable="{Binding Maintenance}" IsRangeEndUnavailable="{Binding StayLimit}"
                                 Value="{Binding Stay, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource GalleryText.StayDates}" />
            <alder:AlderTextBlock Text="{Binding Summary}" Foreground="{DynamicResource AlderMuted}" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <alder:AlderButton Content="{DynamicResource GalleryText.ClearRange}" Command="{CompiledBinding Clear}" Variant="Ghost" Size="Small" HorizontalAlignment="Left" />
              <alder:AlderButton Content="{DynamicResource GalleryText.Reset}" Command="{CompiledBinding Reset}" Variant="Secondary" Size="Small" />
            </WrapPanel>
          </StackPanel>
        </gallery:ExampleCard.Preview>
        <gallery:ExampleCard.CSharpSource><![CDATA[
          var rangeCalendar = new AlderRangeCalendar
          {
              Culture = CultureInfo.CurrentCulture,
              VisibleMonths = 2,
              FixedWeeks = true,
          };
          rangeCalendar.Bind(AlderRangeCalendar.MinimumProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.Minimum));
          rangeCalendar.Bind(AlderRangeCalendar.MaximumProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.Maximum));
          rangeCalendar.Bind(AlderRangeCalendar.IsDateUnavailableProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.Maintenance));
          rangeCalendar.Bind(AlderRangeCalendar.IsRangeEndUnavailableProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.StayLimit));
          rangeCalendar.Bind(AlderRangeCalendar.ValueProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.Stay, mode: BindingMode.TwoWay));
          AutomationProperties.SetName(rangeCalendar, "Stay dates");

          var model = (RangeCalendarViewModel)DataContext!;
          var clear = new AlderButton { Content = "Clear range", Size = AlderSize.Small, Variant = ButtonVariant.Ghost };
          var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary };
          clear.Click += (_, _) => model.Clear();
          reset.Click += (_, _) => model.Reset();
          var actions = new WrapPanel { ItemSpacing = 8, LineSpacing = 8, Children = { clear, reset } };
          var preview = new StackPanel { Spacing = 8, Children = { rangeCalendar, actions } };
        ]]></gallery:ExampleCard.CSharpSource>
      </gallery:ExampleCard>
    </gallery:GalleryExampleTemplate>
  </gallery:GalleryExampleSection.Examples>
</gallery:GalleryExampleSection>
