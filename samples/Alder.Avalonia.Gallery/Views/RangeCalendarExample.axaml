    <gallery:GalleryExampleTemplate Name="SampleControlled">
      <gallery:ExampleCard Title="{DynamicResource GalleryText.Controlled}">
        <gallery:ExampleCard.Preview>
          <Border Padding="8,16">
            <Border.DataContext><vm:RangeCalendarViewModel /></Border.DataContext>
            <StackPanel Spacing="8">
              <alder:AlderRangeCalendar HorizontalAlignment="Center" Culture="{DynamicResource GalleryCulture}"
                              AutomationProperties.Name="{DynamicResource GalleryText.ScheduleCalendar}" DisplayDate="{CompiledBinding PreviewDate, Mode=OneWay}"
                              Value="{CompiledBinding Stay, Mode=TwoWay}" />
              <alder:AlderTextBlock Text="{CompiledBinding Summary}" Foreground="{DynamicResource AlderMuted}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </gallery:ExampleCard.Preview>
        <gallery:ExampleCard.CSharpSource><![CDATA[
          var model = new RangeCalendarViewModel();
          var calendar = new AlderRangeCalendar { DataContext = model, HorizontalAlignment = HorizontalAlignment.Center };
          calendar.Bind(AlderRangeCalendar.DisplayDateProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.PreviewDate));
          calendar.Bind(AlderRangeCalendar.ValueProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.Stay, mode: BindingMode.TwoWay));
          var selected = new AlderTextBlock { HorizontalAlignment = HorizontalAlignment.Center };
          selected.Bind(TextBlock.TextProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.Summary));
          var preview = new StackPanel { DataContext = model, Spacing = 8, Children = { calendar, selected } };
        ]]></gallery:ExampleCard.CSharpSource>
      </gallery:ExampleCard>
    </gallery:GalleryExampleTemplate>
