          calendar.Bind(AlderRangeCalendar.ValueProperty, CompiledBinding.Create((RangeCalendarViewModel model) => model.PreviewRange, mode: BindingMode.TwoWay));
          var preview = calendar;
        ]]></gallery:ExampleCard.CSharpSource>
