<UserControl xmlns:conv="using:Avalonia.Data.Converters" xmlns:gallery="using:Alder.Avalonia.Gallery.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls"
             xmlns:ti="using:Avalonia.Input.TextInput"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.InputGroupExample" x:DataType="vm:InputGroupViewModel"
             FontFamily="fonts:Inter#Inter">
  <UserControl.Styles>
    <Style Selector="alder|AlderInputGroup"><Setter Property="Width" Value="248" /></Style>
    <Style Selector="alder|AlderInputGroup[FullWidth=True]"><Setter Property="Width" Value="NaN" /></Style>
    <Style Selector="PathIcon"><Setter Property="Theme" Value="{StaticResource AlderIcon16Theme}" /></Style>
    <Style Selector="WrapPanel"><Setter Property="ItemSpacing" Value="16" /><Setter Property="LineSpacing" Value="12" /></Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource AlderMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hint.error"><Setter Property="Foreground" Value="{DynamicResource AlderDangerInk}" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="20">
    <gallery:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="4" HorizontalAlignment="Center" MaxWidth="256">
          <alder:AlderLabel x:Name="BasicEmailLabel" Theme="{StaticResource AlderLabelTheme}"
                           Target="{CompiledBinding #BasicEmailInput}" Content="{DynamicResource GalleryText.EmailAddress}" />
          <alder:AlderInputGroup x:Name="BasicEmailInput" FullWidth="True" Type="Email" PlaceholderText="name@email.com"
                                AutomationProperties.LabeledBy="{CompiledBinding #BasicEmailLabel}">
            <alder:AlderInputGroup.Prefix>
              <alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconEnvelope}" />
            </alder:AlderInputGroup.Prefix>
          </alder:AlderInputGroup>
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var icon = new AlderPathIcon { Width = 16, Height = 16 };
        icon[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconEnvelope");
        var input = new AlderInputGroup { Type = InputType.Email, FullWidth = true, PlaceholderText = "name@email.com", Prefix = icon };
        var label = new AlderLabel { Target = input, Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")! };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.EmailAddress");
        AutomationProperties.SetLabeledBy(input, label);
        var preview = new StackPanel { Spacing = 4, MaxWidth = 256, HorizontalAlignment = HorizontalAlignment.Center, Children = { label, input } };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleVariants" Title="{DynamicResource GalleryText.Variants}">
      <gallery:ExampleCard.Preview>
        <WrapPanel>
          <StackPanel Spacing="4">
            <alder:AlderLabel Theme="{StaticResource AlderLabelTheme}" x:Name="PrimaryLabel" Target="{Binding #PrimaryGroup}" Content="{DynamicResource GalleryText.PrimaryVariant}" />
            <alder:AlderInputGroup x:Name="PrimaryGroup" Type="Email" PlaceholderText="name@email.com"
                              AutomationProperties.LabeledBy="{Binding #PrimaryLabel}">
              <alder:AlderInputGroup.Prefix><alder:AlderPathIcon Data="{StaticResource AlderIconEnvelope}" /></alder:AlderInputGroup.Prefix>
            </alder:AlderInputGroup>
          </StackPanel>
          <Border Background="{DynamicResource AlderSurface}" Padding="12" CornerRadius="20" Width="248">
            <StackPanel Spacing="4">
              <alder:AlderLabel Theme="{StaticResource AlderLabelTheme}" x:Name="SecondaryLabel" Target="{Binding #SecondaryGroup}" Content="{DynamicResource GalleryText.SecondaryInASurface}" />
              <alder:AlderInputGroup x:Name="SecondaryGroup" FullWidth="True" Variant="Secondary" Type="Email"
                                PlaceholderText="name@email.com" AutomationProperties.LabeledBy="{Binding #SecondaryLabel}">
                <alder:AlderInputGroup.Prefix><alder:AlderPathIcon Data="{StaticResource AlderIconEnvelope}" /></alder:AlderInputGroup.Prefix>
              </alder:AlderInputGroup>
            </StackPanel>
          </Border>
        </WrapPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var inputGroup1 = new AlderInputGroup
        {
            Type = InputType.Email,
            PlaceholderText = "name@email.com",
            Prefix = new AlderPathIcon { Data = (Geometry)this.FindResource("AlderIconEnvelope")! },
        };

        var inputGroup2 = new AlderInputGroup
        {
            FullWidth = true,
            Variant = InputVariant.Secondary,
            Type = InputType.Email,
            PlaceholderText = "name@email.com",
            Prefix = new AlderPathIcon { Data = (Geometry)this.FindResource("AlderIconEnvelope")! },
        };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SamplePrefixesAndSuffixes" Title="{DynamicResource GalleryText.PrefixesAndSuffixes}">
      <gallery:ExampleCard.Preview>
        <WrapPanel>
          <alder:AlderInputGroup Prefix="https://" Text="alder.example" AutomationProperties.Name="{DynamicResource GalleryText.WebsiteWithProtocolPrefix}" />
          <alder:AlderInputGroup Suffix=".example" Text="alder" AutomationProperties.Name="{DynamicResource GalleryText.WebsiteWithDomainSuffix}" />
          <alder:AlderInputGroup Suffix=".example" Text="alder" AutomationProperties.Name="{DynamicResource GalleryText.WebsiteWithGlobeIconAndDomainSuffix}">
            <alder:AlderInputGroup.Prefix><alder:AlderPathIcon Data="{StaticResource AlderIconGlobe}" /></alder:AlderInputGroup.Prefix>
          </alder:AlderInputGroup>
          <alder:AlderInputGroup Prefix="$" Suffix="USD" Text="10" ti:TextInputOptions.ContentType="Number"
                            AutomationProperties.Name="{DynamicResource GalleryText.PriceInUSDollars}" />
          <alder:AlderInputGroup Type="Email" PlaceholderText="name@email.com" AutomationProperties.Name="{DynamicResource GalleryText.EmailWithSuffixIcon}">
            <alder:AlderInputGroup.Suffix><alder:AlderPathIcon Data="{StaticResource AlderIconEnvelope}" /></alder:AlderInputGroup.Suffix>
          </alder:AlderInputGroup>
        </WrapPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var inputGroup1 = new AlderInputGroup { Prefix = "https://", Text = "alder.example" };
        AutomationProperties.SetName(inputGroup1, "Website with protocol prefix");

        var inputGroup2 = new AlderInputGroup { Suffix = ".example", Text = "alder" };
        AutomationProperties.SetName(inputGroup2, "Website with domain suffix");

        var inputGroup3 = new AlderInputGroup
        {
            Suffix = ".example",
            Text = "alder",
            Prefix = new AlderPathIcon { Data = (Geometry)this.FindResource("AlderIconGlobe")! },
        };
        AutomationProperties.SetName(inputGroup3, "Website with globe icon and domain suffix");

        var inputGroup4 = new AlderInputGroup { Prefix = "$", Suffix = "USD", Text = "10" };
        TextInputOptions.SetContentType(inputGroup4, TextInputContentType.Number);
        AutomationProperties.SetName(inputGroup4, "Price in US dollars");

        var inputGroup5 = new AlderInputGroup
        {
            Type = InputType.Email,
            PlaceholderText = "name@email.com",
            Suffix = new AlderPathIcon { Data = (Geometry)this.FindResource("AlderIconEnvelope")! },
        };
        AutomationProperties.SetName(inputGroup5, "Email with suffix icon");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleSuffixActions" Title="{DynamicResource GalleryText.SuffixActions}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="10">
          <WrapPanel>
            <StackPanel Spacing="4">
              <alder:AlderLabel Theme="{StaticResource AlderLabelTheme}" x:Name="WebsiteLabel" Target="{Binding #WebsiteGroup}" Content="{DynamicResource GalleryText.Website}" />
              <alder:AlderInputGroup x:Name="WebsiteGroup" Text="{Binding Website, Mode=TwoWay}" SuffixPadding="12,0,2,0"
                                AutomationProperties.LabeledBy="{Binding #WebsiteLabel}">
                <alder:AlderInputGroup.Prefix><alder:AlderPathIcon Data="{StaticResource AlderIconGlobe}" /></alder:AlderInputGroup.Prefix>
                <alder:AlderInputGroup.Suffix>
                  <alder:AlderButton x:Name="CopyButton" Size="Small" IsIconOnly="True" Variant="Ghost"
                                Icon="{StaticResource AlderIconCopy}" AutomationProperties.Name="{DynamicResource GalleryText.CopyWebsite}"
                                alder:AlderToolTip.Tip="{DynamicResource GalleryText.CopyWebsite}" Click="CopyWebsite" />
                </alder:AlderInputGroup.Suffix>
              </alder:AlderInputGroup>
            </StackPanel>
            <StackPanel Spacing="4">
              <alder:AlderLabel Theme="{StaticResource AlderLabelTheme}" x:Name="PasswordLabel" Target="{Binding #PasswordGroup}" Content="{DynamicResource GalleryText.Password}" />
              <alder:AlderInputGroup x:Name="PasswordGroup" Type="Password" PlaceholderText="{DynamicResource GalleryText.EnterPassword}"
                                PasswordChar="{Binding PasswordMask}" SuffixPadding="12,0,2,0"
                                AutomationProperties.LabeledBy="{Binding #PasswordLabel}">
                <alder:AlderInputGroup.Suffix>
                  <alder:AlderButton x:Name="PasswordToggle" Classes.revealed="{Binding IsPasswordVisible}"
                                Size="Small" IsIconOnly="True" Variant="Ghost" Command="{Binding TogglePassword}">
                    <alder:AlderButton.Styles>
                      <Style Selector="alder|AlderButton#PasswordToggle">
                        <Setter Property="Icon" Value="{StaticResource AlderIconEye}" />
                        <Setter Property="AutomationProperties.Name" Value="Show password" />
                        <Setter Property="alder:AlderToolTip.Tip" Value="Show password" />
                      </Style>
                      <Style Selector="alder|AlderButton#PasswordToggle.revealed">
                        <Setter Property="Icon" Value="{StaticResource AlderIconEyeSlash}" />
                        <Setter Property="AutomationProperties.Name" Value="Hide password" />
                        <Setter Property="alder:AlderToolTip.Tip" Value="Hide password" />
                      </Style>
                    </alder:AlderButton.Styles>
                  </alder:AlderButton>
                </alder:AlderInputGroup.Suffix>
              </alder:AlderInputGroup>
            </StackPanel>
          </WrapPanel>
          <alder:AlderTextBlock Classes="hint" Text="{Binding CopyStatus}" IsVisible="{Binding CopyStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                     AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var inputGroup1 = new AlderInputGroup
        {
            SuffixPadding = new Thickness(12, 0, 2, 0),
            Prefix = new AlderPathIcon { Data = (Geometry)this.FindResource("AlderIconGlobe")! },
            Suffix = new AlderButton { Name = "CopyButton", Size = AlderSize.Small, IsIconOnly = true, Variant = ButtonVariant.Ghost, Icon = (Geometry)this.FindResource("AlderIconCopy")! },
        };
        inputGroup1.Bind(AlderInputGroup.TextProperty, CompiledBinding.Create((InputGroupViewModel model) => model.Website, mode: BindingMode.TwoWay));

        var inputGroup2 = new AlderInputGroup
        {
            Type = InputType.Password,
            PlaceholderText = "Enter password",
            SuffixPadding = new Thickness(12, 0, 2, 0),
            Suffix = new AlderButton { Name = "PasswordToggle", Size = AlderSize.Small, IsIconOnly = true, Variant = ButtonVariant.Ghost },
        };
        inputGroup2.Bind(AlderInputGroup.PasswordCharProperty, CompiledBinding.Create((InputGroupViewModel model) => model.PasswordMask));
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleLoadingShortcutAndBadge" Title="{DynamicResource GalleryText.LoadingShortcutAndBadge}">
      <gallery:ExampleCard.Preview>
        <WrapPanel>
          <alder:AlderInputGroup Text="{DynamicResource GalleryText.SendingProgress}" IsReadOnly="True" AutomationProperties.Name="{DynamicResource GalleryText.Sending}">
            <alder:AlderInputGroup.Suffix>
              <alder:ButtonSpinner Width="16" Height="16" Foreground="{DynamicResource AlderAccent}" IsHitTestVisible="False"
                               Data="{StaticResource AlderSpinnerGlyph}" OpacityMask="{StaticResource AlderSpinnerMask}" />
            </alder:AlderInputGroup.Suffix>
          </alder:AlderInputGroup>
          <alder:AlderInputGroup x:Name="CommandGroup" PlaceholderText="{DynamicResource GalleryText.Command}" SuffixPadding="12,0,8,0"
                            AutomationProperties.Name="{DynamicResource GalleryText.Command}" AutomationProperties.HelpText="{DynamicResource GalleryText.KeyboardShortcutControlK}">
            <alder:AlderInputGroup.Suffix>
              <Border CornerRadius="5" Background="{DynamicResource AlderNeutral}" Padding="5,2">
                <alder:AlderTextBlock FontSize="12" Text="Ctrl K" />
              </Border>
            </alder:AlderInputGroup.Suffix>
          </alder:AlderInputGroup>
          <alder:AlderInputGroup Type="Email" PlaceholderText="{DynamicResource GalleryText.EmailAddress}" SuffixPadding="12,0,8,0"
                            AutomationProperties.Name="{DynamicResource GalleryText.ProEmailAddress}">
            <alder:AlderInputGroup.Suffix>
              <Border CornerRadius="10" Background="{DynamicResource AlderNeutral}" Padding="8,3">
                <alder:AlderTextBlock FontSize="12" Text="Pro" Foreground="{DynamicResource AlderInk}" />
              </Border>
            </alder:AlderInputGroup.Suffix>
          </alder:AlderInputGroup>
        </WrapPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var inputGroup1 = new AlderInputGroup { Text = "Sending...", IsReadOnly = true };
        AutomationProperties.SetName(inputGroup1, "Sending");

        var inputGroup2 = new AlderInputGroup
        {
            PlaceholderText = "Command",
            SuffixPadding = new Thickness(12, 0, 8, 0),
        };
        AutomationProperties.SetName(inputGroup2, "Command");

        var inputGroup3 = new AlderInputGroup
        {
            Type = InputType.Email,
            PlaceholderText = "Email address",
            SuffixPadding = new Thickness(12, 0, 8, 0),
        };
        AutomationProperties.SetName(inputGroup3, "Pro email address");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleRequiredDisabledAndValidation" Title="{DynamicResource GalleryText.RequiredDisabledAndValidation}">
      <gallery:ExampleCard.Preview>
        <WrapPanel>
          <StackPanel Spacing="4">
            <alder:AlderLabel Theme="{StaticResource AlderLabelTheme}" x:Name="EmailLabel" Target="{Binding #EmailGroup}" Content="{DynamicResource GalleryText.EmailAddress}" />
            <alder:AlderInputGroup x:Name="EmailGroup" Type="Email" Text="{Binding Email, Mode=TwoWay}" IsRequired="True"
                              IsInvalid="{Binding IsEmailInvalid}" AutomationProperties.LabeledBy="{Binding #EmailLabel}"
                              AutomationProperties.HelpText="{DynamicResource GalleryText.EnterACompleteEmailAddress}">
              <alder:AlderInputGroup.Prefix><alder:AlderPathIcon Data="{StaticResource AlderIconEnvelope}" /></alder:AlderInputGroup.Prefix>
            </alder:AlderInputGroup>
            <alder:AlderTextBlock Classes="hint error" Text="{DynamicResource GalleryText.EnterAValidEmailAddress}"
                       IsVisible="{Binding IsEmailInvalid}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <alder:AlderLabel Theme="{StaticResource AlderLabelTheme}" x:Name="PriceLabel" Target="{Binding #PriceGroup}" Content="{DynamicResource GalleryText.SetAPrice}" />
            <alder:AlderInputGroup x:Name="PriceGroup" Text="{Binding Price, Mode=TwoWay}" Prefix="$" Suffix="USD"
                              ti:TextInputOptions.ContentType="Number" IsInvalid="{Binding IsPriceInvalid}"
                              AutomationProperties.LabeledBy="{Binding #PriceLabel}" AutomationProperties.HelpText="{DynamicResource GalleryText.EnterAPriceGreaterThan0}" />
            <alder:AlderTextBlock Classes="hint error" Text="{DynamicResource GalleryText.PriceMustBeGreaterThan0}"
                       IsVisible="{Binding IsPriceInvalid}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <alder:AlderLabel x:Name="DisabledLabel" Theme="{StaticResource AlderLabelTheme}" Target="{Binding #DisabledGroup}" Content="{DynamicResource GalleryText.DisabledEmail}" />
            <alder:AlderInputGroup x:Name="DisabledGroup" Type="Email" Text="name@email.com" IsEnabled="False"
                              AutomationProperties.LabeledBy="{Binding #DisabledLabel}">
              <alder:AlderInputGroup.Prefix><alder:AlderPathIcon Data="{StaticResource AlderIconEnvelope}" /></alder:AlderInputGroup.Prefix>
            </alder:AlderInputGroup>
          </StackPanel>
        </WrapPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var inputGroup1 = new AlderInputGroup
        {
            Type = InputType.Email,
            IsRequired = true,
            Prefix = new AlderPathIcon { Data = (Geometry)this.FindResource("AlderIconEnvelope")! },
        };
        inputGroup1.Bind(AlderInputGroup.TextProperty, CompiledBinding.Create((InputGroupViewModel model) => model.Email, mode: BindingMode.TwoWay));
        inputGroup1.Bind(AlderInputGroup.IsInvalidProperty, CompiledBinding.Create((InputGroupViewModel model) => model.IsEmailInvalid));

        var inputGroup2 = new AlderInputGroup { Prefix = "$", Suffix = "USD" };
        inputGroup2.Bind(AlderInputGroup.TextProperty, CompiledBinding.Create((InputGroupViewModel model) => model.Price, mode: BindingMode.TwoWay));
        TextInputOptions.SetContentType(inputGroup2, TextInputContentType.Number);
        inputGroup2.Bind(AlderInputGroup.IsInvalidProperty, CompiledBinding.Create((InputGroupViewModel model) => model.IsPriceInvalid));

        var inputGroup3 = new AlderInputGroup
        {
            Type = InputType.Email,
            Text = "name@email.com",
            IsEnabled = false,
            Prefix = new AlderPathIcon { Data = (Geometry)this.FindResource("AlderIconEnvelope")! },
        };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleFullWidthAndMultiline" Title="{DynamicResource GalleryText.FullWidthAndMultiline}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="6" MaxWidth="560" HorizontalAlignment="Stretch">
          <alder:AlderInputGroup FullWidth="True" Type="Email" PlaceholderText="you@company.com" Variant="Secondary"
                            AutomationProperties.Name="{DynamicResource GalleryText.WorkEmail}">
            <alder:AlderInputGroup.Prefix><alder:AlderPathIcon Data="{StaticResource AlderIconEnvelope}" /></alder:AlderInputGroup.Prefix>
          </alder:AlderInputGroup>
          <alder:AlderLabel Theme="{StaticResource AlderLabelTheme}" x:Name="FeedbackLabel" Target="{Binding #FeedbackGroup}" Content="{DynamicResource GalleryText.YourFeedback}" Margin="0,6,0,0" />
          <alder:AlderInputGroup x:Name="FeedbackGroup" FullWidth="True" AcceptsReturn="True" MinHeight="92" MaxHeight="180"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{Binding Feedback, Mode=TwoWay}"
                            IsInvalid="{Binding IsFeedbackInvalid}" PlaceholderText="{DynamicResource GalleryText.ShareYourThoughtsOrSuggestions}"
                            SuffixPadding="8,0,8,0" AutomationProperties.LabeledBy="{Binding #FeedbackLabel}"
                            AutomationProperties.HelpText="{DynamicResource GalleryText.Maximum500Characters}">
            <alder:AlderInputGroup.Prefix><alder:AlderPathIcon Data="{StaticResource AlderIconEnvelope}" /></alder:AlderInputGroup.Prefix>
            <alder:AlderInputGroup.Suffix>
              <alder:AlderButton Size="Small" IsIconOnly="True" Icon="{StaticResource AlderIconArrowUp}"
                            alder:AlderToolTip.Tip="{DynamicResource GalleryText.SubmitFeedback}" AutomationProperties.Name="{DynamicResource GalleryText.SubmitFeedback}"
                            Command="{Binding SendFeedback}" />
            </alder:AlderInputGroup.Suffix>
          </alder:AlderInputGroup>
          <Grid ColumnDefinitions="*,Auto">
            <alder:AlderTextBlock Classes="hint" Classes.error="{Binding IsFeedbackInvalid}" Text="{DynamicResource GalleryText.Maximum500Characters}" />
            <alder:AlderTextBlock Grid.Column="1" Classes="hint" Text="{Binding FeedbackCount}" />
          </Grid>
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var inputGroup1 = new AlderInputGroup
        {
            FullWidth = true,
            Type = InputType.Email,
            PlaceholderText = "you@company.com",
            Variant = InputVariant.Secondary,
            Prefix = new AlderPathIcon { Data = (Geometry)this.FindResource("AlderIconEnvelope")! },
        };
        AutomationProperties.SetName(inputGroup1, "Work email");

        var inputGroup2 = new AlderInputGroup
        {
            FullWidth = true,
            AcceptsReturn = true,
            MinHeight = 92,
            PlaceholderText = "Share your thoughts or suggestions...",
            SuffixPadding = new Thickness(8, 0, 8, 0),
            Prefix = new AlderPathIcon { Data = (Geometry)this.FindResource("AlderIconEnvelope")! },
            Suffix = new AlderButton { Size = AlderSize.Small, IsIconOnly = true, Icon = (Geometry)this.FindResource("AlderIconArrowUp")! },
        };
        inputGroup2.Bind(AlderInputGroup.TextProperty, CompiledBinding.Create((InputGroupViewModel model) => model.Feedback, mode: BindingMode.TwoWay));
        inputGroup2.Bind(AlderInputGroup.IsInvalidProperty, CompiledBinding.Create((InputGroupViewModel model) => model.IsFeedbackInvalid));
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
  </StackPanel>
</UserControl>
