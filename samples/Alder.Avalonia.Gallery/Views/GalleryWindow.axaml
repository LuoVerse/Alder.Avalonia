<alder:AlderWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:alder="using:Alder.Avalonia.Controls"
        xmlns:views="using:Alder.Avalonia.Gallery.Views"
        xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
        x:Class="Alder.Avalonia.Gallery.Views.GalleryWindow"
        x:Name="MainWindow" x:DataType="vm:GalleryWindowViewModel"
        Width="1340" Height="914" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowTitleBar="False" CornerRadius="18"
        ToastSafePadding="16,76,16,16" FlowDirection="{DynamicResource GalleryFlowDirection}"
        TransparencyLevelHint="Transparent" Background="{DynamicResource GalleryPreviewSurface}"
        TransparencyBackgroundFallback="{DynamicResource GalleryPreviewSurface}"
        RequestedThemeVariant="{Binding WindowTheme, Mode=TwoWay}"
        Title="{DynamicResource GalleryText.AlderGallery}">
  <alder:AlderWindow.Styles>
    <!-- Keep the page scrollbar clear of the window's edge resize grips. -->
    <Style Selector="alder|AlderScrollViewer.galleryPageScroll /template/ alder|AlderScrollBar#PART_VerticalScrollBar">
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
    <Style Selector="alder|AlderWindow.mac">
      <Setter Property="CaptionMargin" Value="14,18,0,0" />
    </Style>
    <Style Selector="alder|AlderWindow:not(.mac)">
      <Setter Property="CaptionMargin" Value="0,10,12,0" />
    </Style>
    <Style Selector="alder|AlderWindow.mac alder|AlderSidebar.gallerySidebar[(alder|AlderSidebar.Rail)=True] /template/ Border#PART_Header">
      <Setter Property="Padding" Value="0,48,0,6" />
      <Setter Property="MinHeight" Value="84" />
    </Style>
    <Style Selector="alder|AlderWindow.mac alder|AlderSidebar.gallerySidebar[FlowDirection=LeftToRight][(alder|AlderSidebar.Rail)=False] /template/ Border#PART_Header">
      <Setter Property="Padding" Value="82,0,18,0" />
    </Style>
    <Style Selector="alder|AlderWindow:not(.mac) alder|AlderSidebar.gallerySidebar[FlowDirection=RightToLeft][(alder|AlderSidebar.Rail)=False] /template/ Border#PART_Header">
      <Setter Property="Padding" Value="154,0,18,0" />
    </Style>
    <Style Selector="alder|AlderWindow.mac alder|AlderAppLayout.galleryShell[IsSidebarCollapsed=True] /template/ Border#PART_Navbar">
      <Setter Property="Padding" Value="20,0,0,0" />
    </Style>
    <Style Selector="alder|AlderWindow.mac alder|AlderAppLayout.galleryShell:compact /template/ Border#PART_Navbar">
      <Setter Property="Padding" Value="68,0,0,0" />
    </Style>
    <Style Selector="alder|AlderWindow.mac alder|AlderAppLayout.galleryShell[FlowDirection=RightToLeft] /template/ Border#PART_Navbar">
      <Setter Property="Padding" Value="0,0,68,0" />
    </Style>
    <Style Selector="alder|AlderWindow:not(.mac) alder|AlderAppLayout.galleryShell[FlowDirection=LeftToRight] /template/ Border#PART_Navbar">
      <Setter Property="Padding" Value="0,0,152,0" />
    </Style>
    <Style Selector="alder|AlderWindow:not(.mac) alder|AlderAppLayout.galleryShell[FlowDirection=RightToLeft][IsSidebarOpen=False] /template/ Border#PART_Navbar,
                     alder|AlderWindow:not(.mac) alder|AlderAppLayout.galleryShell[FlowDirection=RightToLeft]:compact /template/ Border#PART_Navbar">
      <Setter Property="Padding" Value="112,0,0,0" />
    </Style>
  </alder:AlderWindow.Styles>
  <views:GalleryView x:Name="GalleryContent" />
</alder:AlderWindow>
