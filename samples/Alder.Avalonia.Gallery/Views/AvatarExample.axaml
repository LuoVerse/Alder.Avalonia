<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls" xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             xmlns:m="using:Avalonia.Media"
             x:Class="Alder.Avalonia.Gallery.Views.AvatarExample" x:DataType="vm:AvatarViewModel">
  <StackPanel Spacing="20">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="300" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/portrait-3.jpg" Alt="John Doe" />
            <alder:AlderAvatar Fallback="B" Source="avares://Alder.Avalonia.Gallery/Assets/Card/blue.jpg" Alt="{DynamicResource GalleryText.AvatarBlue}" />
            <alder:AlderAvatar Fallback="JR" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        using var stream = AssetLoader.Open(new Uri("avares://Alder.Avalonia.Gallery/Assets/Avatar/portrait-3.jpg"));
        var avatar = new AlderAvatar { Source = new Bitmap(stream), Alt = "John Doe", Fallback = "JD" };
        var initials = new AlderAvatar { Fallback = "JR" };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleSizes" Title="{DynamicResource GalleryText.Sizes}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderAvatar Fallback="SM" Source="avares://Alder.Avalonia.Gallery/Assets/Card/blue.jpg" Alt="{DynamicResource GalleryText.AvatarSmallAlt}" Size="Small" />
            <alder:AlderAvatar Fallback="MD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/purple.jpg" Alt="{DynamicResource GalleryText.AvatarMediumAlt}" Size="Medium" />
            <alder:AlderAvatar Fallback="LG" Source="avares://Alder.Avalonia.Gallery/Assets/Card/red.jpg" Alt="{DynamicResource GalleryText.AvatarLargeAlt}" Size="Large" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var small = new AlderAvatar { Size = AlderSize.Small, Source = bluePortrait, Fallback = "SM" };
        var medium = new AlderAvatar { Size = AlderSize.Medium, Source = purplePortrait, Fallback = "MD" };
        var large = new AlderAvatar { Size = AlderSize.Large, Source = redPortrait, Fallback = "LG" };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleColors" Title="{DynamicResource GalleryText.FeedbackColors}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderAvatar Fallback="DF" Color="Default" />
            <alder:AlderAvatar Fallback="AC" Color="Accent" />
            <alder:AlderAvatar Fallback="SC" Color="Success" />
            <alder:AlderAvatar Fallback="WR" Color="Warning" />
            <alder:AlderAvatar Fallback="DG" Color="Danger" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var success = new AlderAvatar { Color = AvatarColor.Success, Fallback = "SC" };
        var warning = new AlderAvatar { Color = AvatarColor.Warning, Fallback = "WR" };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVariants" Title="{DynamicResource GalleryText.Variants}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <alder:AlderScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Width="556" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid ColumnDefinitions="96,80,80,80,80,80" ColumnSpacing="12">
                <alder:AlderTextBlock Grid.Column="1" Text="{DynamicResource GalleryText.AvatarColorAccent}" HorizontalAlignment="Center"
                           FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderTextBlock Grid.Column="2" Text="{DynamicResource GalleryText.AvatarColorDefault}" HorizontalAlignment="Center"
                           FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderTextBlock Grid.Column="3" Text="{DynamicResource GalleryText.AvatarColorSuccess}" HorizontalAlignment="Center"
                           FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderTextBlock Grid.Column="4" Text="{DynamicResource GalleryText.AvatarColorWarning}" HorizontalAlignment="Center"
                           FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderTextBlock Grid.Column="5" Text="{DynamicResource GalleryText.AvatarColorDanger}" HorizontalAlignment="Center"
                           FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
              </Grid>
              <Border Height="1" Background="{DynamicResource AlderSeparator}" />
              <Grid ColumnDefinitions="96,80,80,80,80,80" ColumnSpacing="12">
                <alder:AlderTextBlock Text="{DynamicResource GalleryText.AvatarLetter}" VerticalAlignment="Center"
                           FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderAvatar Fallback="AG" Grid.Column="1" Color="Accent" />
                <alder:AlderAvatar Fallback="AG" Grid.Column="2" Color="Default" />
                <alder:AlderAvatar Fallback="AG" Grid.Column="3" Color="Success" />
                <alder:AlderAvatar Fallback="AG" Grid.Column="4" Color="Warning" />
                <alder:AlderAvatar Fallback="AG" Grid.Column="5" Color="Danger" />
              </Grid>
              <Grid ColumnDefinitions="96,80,80,80,80,80" ColumnSpacing="12">
                <alder:AlderTextBlock Text="{DynamicResource GalleryText.AvatarLetterSoft}" VerticalAlignment="Center"
                           FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderAvatar Fallback="AG" Grid.Column="1" Color="Accent" Variant="Soft" />
                <alder:AlderAvatar Fallback="AG" Grid.Column="2" Color="Default" Variant="Soft" />
                <alder:AlderAvatar Fallback="AG" Grid.Column="3" Color="Success" Variant="Soft" />
                <alder:AlderAvatar Fallback="AG" Grid.Column="4" Color="Warning" Variant="Soft" />
                <alder:AlderAvatar Fallback="AG" Grid.Column="5" Color="Danger" Variant="Soft" />
              </Grid>
              <Grid ColumnDefinitions="96,80,80,80,80,80" ColumnSpacing="12">
                <alder:AlderTextBlock Text="{DynamicResource GalleryText.AvatarIcon}" VerticalAlignment="Center"
                           FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderAvatar Grid.Column="1" Color="Accent" />
                <alder:AlderAvatar Grid.Column="2" Color="Default" />
                <alder:AlderAvatar Grid.Column="3" Color="Success" />
                <alder:AlderAvatar Grid.Column="4" Color="Warning" />
                <alder:AlderAvatar Grid.Column="5" Color="Danger" />
              </Grid>
              <Grid ColumnDefinitions="96,80,80,80,80,80" ColumnSpacing="12">
                <alder:AlderTextBlock Text="{DynamicResource GalleryText.AvatarIconSoft}" VerticalAlignment="Center"
                           FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderAvatar Grid.Column="1" Color="Accent" Variant="Soft" />
                <alder:AlderAvatar Grid.Column="2" Color="Default" Variant="Soft" />
                <alder:AlderAvatar Grid.Column="3" Color="Success" Variant="Soft" />
                <alder:AlderAvatar Grid.Column="4" Color="Warning" Variant="Soft" />
                <alder:AlderAvatar Grid.Column="5" Color="Danger" Variant="Soft" />
              </Grid>
              <Grid ColumnDefinitions="96,80,80,80,80,80" ColumnSpacing="12">
                <alder:AlderTextBlock Text="{DynamicResource GalleryText.AvatarImage}" VerticalAlignment="Center"
                           FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
                <alder:AlderAvatar Fallback="A" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/portrait-3.jpg" Alt="{DynamicResource GalleryText.AvatarColorAccent}" Grid.Column="1" Color="Accent" />
                <alder:AlderAvatar Fallback="D" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/portrait-4.jpg" Alt="{DynamicResource GalleryText.AvatarColorDefault}" Grid.Column="2" Color="Default" />
                <alder:AlderAvatar Fallback="S" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/portrait-5.jpg" Alt="{DynamicResource GalleryText.AvatarColorSuccess}" Grid.Column="3" Color="Success" />
                <alder:AlderAvatar Fallback="W" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/portrait-8.jpg" Alt="{DynamicResource GalleryText.AvatarColorWarning}" Grid.Column="4" Color="Warning" />
                <alder:AlderAvatar Fallback="D" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/portrait-16.jpg" Alt="{DynamicResource GalleryText.AvatarColorDanger}" Grid.Column="5" Color="Danger" />
              </Grid>
            </StackPanel>
          </alder:AlderScrollViewer>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var solid = new AlderAvatar { Fallback = "AG", Color = AvatarColor.Accent };
        var soft = new AlderAvatar { Fallback = "AG", Color = AvatarColor.Accent, Variant = AvatarVariant.Soft };
        var icon = new AlderAvatar { Color = AvatarColor.Accent };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleFallback" Title="{DynamicResource GalleryText.AvatarFallback}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderAvatar Fallback="JD" />
            <alder:AlderAvatar />
            <alder:AlderAvatar Fallback="NA" FallbackDelay="0:0:0.6" />
            <alder:AlderAvatar Fallback="GB" Foreground="White">
              <alder:AlderAvatar.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Offset="0" Color="#F6339A" />
                  <GradientStop Offset="1" Color="#AD46FF" />
                </LinearGradientBrush>
              </alder:AlderAvatar.Background>
            </alder:AlderAvatar>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var initials = new AlderAvatar { Fallback = "JD" };
        var defaultIcon = new AlderAvatar();
        var delayed = new AlderAvatar { Fallback = "NA", FallbackDelay = TimeSpan.FromMilliseconds(600) };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleImage" Title="{DynamicResource GalleryText.AvatarCustomImage}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <alder:AlderAvatar Fallback="JD" Alt="John Doe" Source="avares://Alder.Avalonia.Gallery/Assets/Card/blue.jpg">
            <alder:AlderAvatar.ImageTemplate>
              <DataTemplate x:DataType="m:IImage">
                <alder:AlderImage Source="{CompiledBinding}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
              </DataTemplate>
            </alder:AlderAvatar.ImageTemplate>
          </alder:AlderAvatar>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var avatar = new AlderAvatar
        {
            Source = portrait, Alt = "John Doe", Fallback = "JD",
            ImageTemplate = new FuncDataTemplate<IImage>((image, _) => new AlderImage
            {
                Source = image, Stretch = Stretch.UniformToFill
            })
        };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleCustom" Title="{DynamicResource GalleryText.CustomStyles}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <alder:AlderAvatar Fallback="JD" Source="avares://Alder.Avalonia.Gallery/Assets/Avatar/portrait-3.jpg" Alt="John Doe" CornerRadius="8" />
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var avatar = new AlderAvatar { Source = portrait, Fallback = "JD", CornerRadius = new CornerRadius(8) };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
