      <g:ExampleCard.CSharpSource><![CDATA[
        var comboBox = new AlderComboBox { SelectionMode = SelectionMode.Multiple, SelectionPlaceholderText = "No animals selected" };
        comboBox.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.Animals));
        comboBox.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.Caption));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleSurface" Title="{DynamicResource GalleryText.AutocompleteInSurface}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="184" TextElement.FontFamily="fonts:Inter#Inter">
          <alder:AlderSurface MaxWidth="320" Padding="24" CornerRadius="24" VerticalAlignment="Center">
            <StackPanel Spacing="16">
              <alder:AlderComboBox Label="{DynamicResource GalleryText.PickerFavoriteAnimal}" PlaceholderText="{DynamicResource GalleryText.ComboSearchAnimals}"
                              ItemsSource="{CompiledBinding Animals}" TextSelector="{CompiledBinding Caption}"
                              IsRequired="True" FullWidth="True"
                              SelectedItem="{CompiledBinding Surface.Selected, Mode=TwoWay}" Text="{CompiledBinding Surface.Input, Mode=TwoWay}"
                              IsInvalid="{CompiledBinding Surface.IsInvalid}" ErrorText="{CompiledBinding Surface.ErrorText}"
                              Variant="Secondary" />
              <alder:AlderButton Content="{DynamicResource GalleryText.Submit}" Command="{CompiledBinding Surface.Submit}" HorizontalAlignment="Left" />
              <alder:AlderTextBlock Text="{CompiledBinding Surface.Status}" Foreground="{DynamicResource AlderMuted}" FontSize="14" LineHeight="20" TextWrapping="Wrap"
                         IsVisible="{CompiledBinding Surface.Status, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </alder:AlderSurface>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var comboBox = new AlderComboBox { Variant = InputVariant.Secondary, FullWidth = true, IsRequired = true };
        comboBox.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.Animals));
        comboBox.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.Caption));
        comboBox.Bind(SelectingItemsControl.SelectedItemProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.Surface.Selected, mode: BindingMode.TwoWay));
        comboBox.Bind(AlderPicker.TextProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.Surface.Input, mode: BindingMode.TwoWay));
        comboBox.Bind(AlderPicker.IsInvalidProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.Surface.IsInvalid));
        comboBox.Bind(AlderPicker.ErrorTextProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.Surface.ErrorText));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleCustom" Title="{DynamicResource GalleryText.CustomStyles}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderComboBox Label="{DynamicResource GalleryText.ComboFramework}" PlaceholderText="{DynamicResource GalleryText.PickerSearch}"
                            ItemsSource="{CompiledBinding Frameworks}"
                            CornerRadius="12" BorderBrush="{DynamicResource AlderBorder}" BorderThickness="1"
                            DropDownCornerRadius="12" DropDownPadding="4" DropDownBorderBrush="{DynamicResource AlderBorder}" DropDownBorderThickness="1">
              <alder:AlderComboBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource AlderSelectRowTheme}">
                  <Setter Property="CornerRadius" Value="8" />
                </ControlTheme>
              </alder:AlderComboBox.ItemContainerTheme>
            </alder:AlderComboBox>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var comboBox = new AlderComboBox { DropDownCornerRadius = new CornerRadius(12), DropDownPadding = new Thickness(4) };
        comboBox.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.Frameworks));
        comboBox.BorderThickness = comboBox.DropDownBorderThickness = new Thickness(1);
        comboBox[!TemplatedControl.BorderBrushProperty] = new DynamicResourceExtension("AlderBorder");
        comboBox[!AlderComboBox.DropDownBorderBrushProperty] = new DynamicResourceExtension("AlderBorder");
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
