        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderComboBox Label="{DynamicResource GalleryText.ComboFavoriteAnimals}" PlaceholderText="{DynamicResource GalleryText.ComboSearchAnimals}"
                            ItemsSource="{CompiledBinding Animals}" TextSelector="{CompiledBinding Caption}"
                            SelectionMode="Multiple" SelectionPlaceholderText="{DynamicResource GalleryText.ComboNoAnimals}" />
          </StackPanel>
        </Border>
