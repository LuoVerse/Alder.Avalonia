        comboBox.Bind(AlderPicker.TextProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.CustomValidation.Input, mode: BindingMode.TwoWay));
        comboBox.Bind(AlderPicker.IsInvalidProperty, CompiledBinding.Create((ComboBoxViewModel model) => model.CustomValidation.IsInvalid));
