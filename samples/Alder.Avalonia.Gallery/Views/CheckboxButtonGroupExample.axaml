            </alder:AlderCheckboxButtonGroupItem>
          </alder:AlderCheckboxButtonGroup>
        </StackPanel>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var preview = new StackPanel { Spacing = 12, MaxWidth = 520 };
        var heading = new AlderTextBlock { Text = "Security features", FontSize = 14,
            FontWeight = FontWeight.Medium, TextWrapping = TextWrapping.Wrap };
        preview.Children.Add(heading);

        var group = new AlderCheckboxButtonGroup { SelectedKeys = ["2fa", "encryption"] };
        AutomationProperties.SetName(group, "Security features");
        preview.Children.Add(group);

        var item1 = new AlderCheckboxButtonGroupItem
        {
            Description = "Require two-factor authentication for all accounts."
        };
        AlderChoiceGroup.SetKey(item1, "2fa");
        AutomationProperties.SetName(item1, "2FA");
        item1[!TemplatedControl.BackgroundProperty] = new DynamicResourceExtension("AlderNeutral");
        var header1 = new WrapPanel { Orientation = Orientation.Horizontal, ItemSpacing = 10, LineSpacing = 4, Margin = new Thickness(0, 0, 0, 6) };
        var frame1 = new Border { Width = 32, Height = 32, CornerRadius = new CornerRadius(8) };
        frame1[!Border.BackgroundProperty] = new DynamicResourceExtension("AlderSurface");
        frame1[!Border.BoxShadowProperty] = new DynamicResourceExtension("AlderFieldShadow");
        var icon1 = new AlderPathIcon { Width = 16, Height = 16 };
        icon1[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircle");
        frame1.Child = icon1;
        header1.Children.Add(frame1);
        header1.Children.Add(new AlderTextBlock { Text = "2FA", FontWeight = FontWeight.SemiBold, VerticalAlignment = VerticalAlignment.Center });
        item1.Content = header1;
        header1.Children.Add(new AlderChip { Content = "Recommended", Size = AlderSize.Small, Variant = ChipVariant.Soft, Color = AlderStatusColor.Success, VerticalAlignment = VerticalAlignment.Center });
        var indicator1 = new AlderPathIcon { Width = 20, Height = 20 };
        indicator1[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircleFilled");
        indicator1[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderAccent");
        item1.Indicator = indicator1;
        group.Children.Add(item1);

        var item2 = new AlderCheckboxButtonGroupItem
        {
            Description = "Encrypt stored data and network traffic."
        };
        AlderChoiceGroup.SetKey(item2, "encryption");
        AutomationProperties.SetName(item2, "Encryption");
        item2[!TemplatedControl.BackgroundProperty] = new DynamicResourceExtension("AlderNeutral");
        var header2 = new WrapPanel { Orientation = Orientation.Horizontal, ItemSpacing = 10, LineSpacing = 4, Margin = new Thickness(0, 0, 0, 6) };
        var frame2 = new Border { Width = 32, Height = 32, CornerRadius = new CornerRadius(8) };
        frame2[!Border.BackgroundProperty] = new DynamicResourceExtension("AlderSurface");
        frame2[!Border.BoxShadowProperty] = new DynamicResourceExtension("AlderFieldShadow");
        var icon2 = new AlderPathIcon { Width = 16, Height = 16 };
        icon2[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconEyeSlash");
        frame2.Child = icon2;
        header2.Children.Add(frame2);
        header2.Children.Add(new AlderTextBlock { Text = "Encryption", FontWeight = FontWeight.SemiBold, VerticalAlignment = VerticalAlignment.Center });
        item2.Content = header2;
        var indicator2 = new AlderPathIcon { Width = 20, Height = 20 };
        indicator2[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircleFilled");
        indicator2[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderAccent");
        item2.Indicator = indicator2;
        group.Children.Add(item2);

        var item3 = new AlderCheckboxButtonGroupItem
        {
            Description = "Store automatic daily backups in the cloud."
        };
        AlderChoiceGroup.SetKey(item3, "backup");
        AutomationProperties.SetName(item3, "Cloud Backup");
        item3[!TemplatedControl.BackgroundProperty] = new DynamicResourceExtension("AlderNeutral");
        var header3 = new WrapPanel { Orientation = Orientation.Horizontal, ItemSpacing = 10, LineSpacing = 4, Margin = new Thickness(0, 0, 0, 6) };
        var frame3 = new Border { Width = 32, Height = 32, CornerRadius = new CornerRadius(8) };
        frame3[!Border.BackgroundProperty] = new DynamicResourceExtension("AlderSurface");
        frame3[!Border.BoxShadowProperty] = new DynamicResourceExtension("AlderFieldShadow");
        var icon3 = new AlderPathIcon { Width = 16, Height = 16 };
        icon3[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconArchive");
        frame3.Child = icon3;
        header3.Children.Add(frame3);
        header3.Children.Add(new AlderTextBlock { Text = "Cloud Backup", FontWeight = FontWeight.SemiBold, VerticalAlignment = VerticalAlignment.Center });
        item3.Content = header3;
        var indicator3 = new AlderPathIcon { Width = 20, Height = 20 };
        indicator3[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircleFilled");
        indicator3[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderAccent");
        item3.Indicator = indicator3;
        group.Children.Add(item3);

        var item4 = new AlderCheckboxButtonGroupItem
        {
            Description = "Get notified when security incidents occur."
        };
        AlderChoiceGroup.SetKey(item4, "alerts");
        AutomationProperties.SetName(item4, "Alert System");
        item4[!TemplatedControl.BackgroundProperty] = new DynamicResourceExtension("AlderNeutral");
        var header4 = new WrapPanel { Orientation = Orientation.Horizontal, ItemSpacing = 10, LineSpacing = 4, Margin = new Thickness(0, 0, 0, 6) };
        var frame4 = new Border { Width = 32, Height = 32, CornerRadius = new CornerRadius(8) };
        frame4[!Border.BackgroundProperty] = new DynamicResourceExtension("AlderSurface");
        frame4[!Border.BoxShadowProperty] = new DynamicResourceExtension("AlderFieldShadow");
        var icon4 = new AlderPathIcon { Width = 16, Height = 16 };
        icon4[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconBell");
        frame4.Child = icon4;
        header4.Children.Add(frame4);
        header4.Children.Add(new AlderTextBlock { Text = "Alert System", FontWeight = FontWeight.SemiBold, VerticalAlignment = VerticalAlignment.Center });
        item4.Content = header4;
        var indicator4 = new AlderPathIcon { Width = 20, Height = 20 };
        indicator4[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircleFilled");
        indicator4[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderAccent");
        item4.Indicator = indicator4;
        group.Children.Add(item4);
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
