              </WrapPanel>
              <alder:AlderCheckboxButtonGroupItem.Indicator>
                <alder:AlderPathIcon Width="20" Height="20" Data="{DynamicResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderAccent}" />
              </alder:AlderCheckboxButtonGroupItem.Indicator>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="encryption"
                Description="{DynamicResource GalleryText.CardEncryptionDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardEncryption}" Background="{DynamicResource AlderNeutral}">
              <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="4" Margin="0,0,0,6">
                <Border Width="32" Height="32" Background="{DynamicResource AlderSurface}" BoxShadow="{DynamicResource AlderFieldShadow}" CornerRadius="8">
                  <alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconEyeSlash}" />
                </Border>
                <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardEncryption}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </WrapPanel>
              <alder:AlderCheckboxButtonGroupItem.Indicator>
