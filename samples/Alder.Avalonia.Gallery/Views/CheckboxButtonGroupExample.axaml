              </alder:AlderCheckboxButtonGroupItem.Indicator>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="backup"
                Description="{DynamicResource GalleryText.CardCloudBackupDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardCloudBackup}" Background="{DynamicResource AlderNeutral}">
              <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="4" Margin="0,0,0,6">
                <Border Width="32" Height="32" Background="{DynamicResource AlderSurface}" BoxShadow="{DynamicResource AlderFieldShadow}" CornerRadius="8">
                  <alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconArchive}" />
                </Border>
                <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardCloudBackup}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </WrapPanel>
              <alder:AlderCheckboxButtonGroupItem.Indicator>
                <alder:AlderPathIcon Width="20" Height="20" Data="{DynamicResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderAccent}" />
              </alder:AlderCheckboxButtonGroupItem.Indicator>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="alerts"
                Description="{DynamicResource GalleryText.CardAlertSystemDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardAlertSystem}" Background="{DynamicResource AlderNeutral}">
              <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="4" Margin="0,0,0,6">
                <Border Width="32" Height="32" Background="{DynamicResource AlderSurface}" BoxShadow="{DynamicResource AlderFieldShadow}" CornerRadius="8">
                  <alder:AlderPathIcon Width="16" Height="16" Data="{DynamicResource AlderIconBell}" />
                </Border>
