<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls"
             xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.CheckboxButtonGroupExample" x:DataType="vm:CheckboxButtonGroupViewModel">
  <StackPanel Spacing="20">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="360">
          <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardSelectFeatures}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
          <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardFeatureHint}" FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
          <alder:AlderCheckboxButtonGroup SelectedKeys="security,storage"
              AutomationProperties.Name="{DynamicResource GalleryText.CardSelectFeatures}">
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="security"
                Description="{DynamicResource GalleryText.CardSecurityDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardSecurity}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardSecurity}" TextWrapping="Wrap" LineHeight="20" />
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="storage"
                Description="{DynamicResource GalleryText.CardStorageDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardStorage}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardStorage}" TextWrapping="Wrap" LineHeight="20" />
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="analytics"
                Description="{DynamicResource GalleryText.CardAnalyticsDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardAnalytics}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardAnalytics}" TextWrapping="Wrap" LineHeight="20" />
            </alder:AlderCheckboxButtonGroupItem>
          </alder:AlderCheckboxButtonGroup>
        </StackPanel>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var preview = new StackPanel { Spacing = 12, MaxWidth = 360 };
        var heading = new AlderTextBlock { Text = "Select features", FontSize = 14,
            FontWeight = FontWeight.Medium, TextWrapping = TextWrapping.Wrap };
        preview.Children.Add(heading);
        var hint = new AlderTextBlock { FontSize = 12, LineHeight = 16, TextWrapping = TextWrapping.Wrap };
        hint.Text = "Choose the features for your project.";
        hint[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        preview.Children.Add(hint);

        var group = new AlderCheckboxButtonGroup { SelectedKeys = ["security", "storage"] };
        AutomationProperties.SetName(group, "Select features");
        preview.Children.Add(group);

        var item1 = new AlderCheckboxButtonGroupItem
        {
            Description = "Detect and block threats in real time"
        };
        AlderChoiceGroup.SetKey(item1, "security");
        AutomationProperties.SetName(item1, "Security");
        item1.Content = new AlderTextBlock { Text = "Security", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        group.Children.Add(item1);

        var item2 = new AlderCheckboxButtonGroupItem
        {
            Description = "Cloud storage with automatic backups"
        };
        AlderChoiceGroup.SetKey(item2, "storage");
        AutomationProperties.SetName(item2, "Storage");
        item2.Content = new AlderTextBlock { Text = "Storage", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        group.Children.Add(item2);

        var item3 = new AlderCheckboxButtonGroupItem
        {
            Description = "Usage trends and performance reports"
        };
        AlderChoiceGroup.SetKey(item3, "analytics");
        AutomationProperties.SetName(item3, "Analytics");
        item3.Content = new AlderTextBlock { Text = "Analytics", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        group.Children.Add(item3);
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleControlled" Title="{DynamicResource GalleryText.Controlled}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="360">
          <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardAddOns}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
          <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardAddOnHint}" FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
          <alder:AlderCheckboxButtonGroup SelectedKeys="{CompiledBinding SelectedAddOns, Mode=TwoWay}"
              AutomationProperties.Name="{DynamicResource GalleryText.CardAddOns}">
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="backups"
                Description="{DynamicResource GalleryText.CardBackupsDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardBackups}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardBackups}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Details>
                <alder:AlderTextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="{DynamicResource GalleryText.CardMonthly5}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.CardMonthlySuffix}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderTextBlock>
              </alder:AlderCheckboxButtonGroupItem.Details>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="monitoring"
                Description="{DynamicResource GalleryText.CardMonitoringDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardMonitoring}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardMonitoring}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Details>
                <alder:AlderTextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="{DynamicResource GalleryText.CardMonthly12}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.CardMonthlySuffix}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderTextBlock>
              </alder:AlderCheckboxButtonGroupItem.Details>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="support"
                Description="{DynamicResource GalleryText.CardSupportDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardSupport}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardSupport}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Details>
                <alder:AlderTextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="{DynamicResource GalleryText.CardMonthly8}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.CardMonthlySuffix}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderTextBlock>
              </alder:AlderCheckboxButtonGroupItem.Details>
            </alder:AlderCheckboxButtonGroupItem>
          </alder:AlderCheckboxButtonGroup>
          <alder:AlderTextBlock Text="{CompiledBinding SelectedAddOnsText}" Foreground="{DynamicResource AlderMuted}"
                     TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var preview = new StackPanel { Spacing = 12, MaxWidth = 360 };
        var heading = new AlderTextBlock { Text = "Add-ons", FontSize = 14,
            FontWeight = FontWeight.Medium, TextWrapping = TextWrapping.Wrap };
        preview.Children.Add(heading);
        var hint = new AlderTextBlock { FontSize = 12, LineHeight = 16, TextWrapping = TextWrapping.Wrap };
        hint.Text = "Select the add-ons you need.";
        hint[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        preview.Children.Add(hint);

        var group = new AlderCheckboxButtonGroup();
        AutomationProperties.SetName(group, "Add-ons");
        preview.Children.Add(group);
        group.Bind(AlderChoiceGroup.SelectedKeysProperty,
            CompiledBinding.Create((CheckboxButtonGroupViewModel vm) => vm.SelectedAddOns, mode: BindingMode.TwoWay));

        var item1 = new AlderCheckboxButtonGroupItem
        {
            Description = "Automatic daily backups"
        };
        AlderChoiceGroup.SetKey(item1, "backups");
        AutomationProperties.SetName(item1, "Backups");
        item1.Content = new AlderTextBlock { Text = "Backups", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var price1 = new Run { Text = "US$5.00", FontWeight = FontWeight.SemiBold };
        var suffix1 = new Run { Text = "/mo", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix1[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        item1.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price1, suffix1 } };
        group.Children.Add(item1);

        var item2 = new AlderCheckboxButtonGroupItem
        {
            Description = "Around-the-clock monitoring and alerts"
        };
        AlderChoiceGroup.SetKey(item2, "monitoring");
        AutomationProperties.SetName(item2, "Monitoring");
        item2.Content = new AlderTextBlock { Text = "Monitoring", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var price2 = new Run { Text = "US$12.00", FontWeight = FontWeight.SemiBold };
        var suffix2 = new Run { Text = "/mo", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix2[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        item2.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price2, suffix2 } };
        group.Children.Add(item2);

        var item3 = new AlderCheckboxButtonGroupItem
        {
            Description = "Priority support by email or chat"
        };
        AlderChoiceGroup.SetKey(item3, "support");
        AutomationProperties.SetName(item3, "Support");
        item3.Content = new AlderTextBlock { Text = "Support", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var price3 = new Run { Text = "US$8.00", FontWeight = FontWeight.SemiBold };
        var suffix3 = new Run { Text = "/mo", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix3[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        item3.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price3, suffix3 } };
        group.Children.Add(item3);

        var summary = new AlderTextBlock { TextWrapping = TextWrapping.Wrap };
        AutomationProperties.SetLiveSetting(summary, AutomationLiveSetting.Polite);
        summary[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        summary.Bind(TextBlock.TextProperty, CompiledBinding.Create((CheckboxButtonGroupViewModel vm) => vm.SelectedAddOnsText));
        preview.Children.Add(summary);
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleCustomIndicator" Title="{DynamicResource GalleryText.CardCustomIndicator}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="768">
          <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardNotificationPreferences}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
          <alder:AlderCheckboxButtonGroup Layout="Grid" Columns="3" SelectedKeys="updates,alerts"
              AutomationProperties.Name="{DynamicResource GalleryText.CardNotificationPreferences}">
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="updates"
                Description="{DynamicResource GalleryText.CardProductUpdatesDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardProductUpdates}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardProductUpdates}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Indicator>
                <alder:AlderPathIcon Width="20" Height="20" Data="{DynamicResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderAccent}" />
              </alder:AlderCheckboxButtonGroupItem.Indicator>
              <alder:AlderCheckboxButtonGroupItem.Details>
                <alder:AlderTextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="4,200" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.CardSubscribersSuffix}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderTextBlock>
              </alder:AlderCheckboxButtonGroupItem.Details>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="alerts"
                Description="{DynamicResource GalleryText.CardSecurityAlertsDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardSecurityAlerts}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardSecurityAlerts}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Indicator>
                <alder:AlderPathIcon Width="20" Height="20" Data="{DynamicResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderAccent}" />
              </alder:AlderCheckboxButtonGroupItem.Indicator>
              <alder:AlderCheckboxButtonGroupItem.Details>
                <alder:AlderTextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="8,100" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.CardSubscribersSuffix}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderTextBlock>
              </alder:AlderCheckboxButtonGroupItem.Details>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="marketing"
                Description="{DynamicResource GalleryText.CardMarketingDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardMarketing}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardMarketing}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Indicator>
                <alder:AlderPathIcon Width="20" Height="20" Data="{DynamicResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderAccent}" />
              </alder:AlderCheckboxButtonGroupItem.Indicator>
              <alder:AlderCheckboxButtonGroupItem.Details>
                <alder:AlderTextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="2,300" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.CardSubscribersSuffix}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderTextBlock>
              </alder:AlderCheckboxButtonGroupItem.Details>
            </alder:AlderCheckboxButtonGroupItem>
          </alder:AlderCheckboxButtonGroup>
        </StackPanel>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var preview = new StackPanel { Spacing = 12, MaxWidth = 768 };
        var heading = new AlderTextBlock { Text = "Notification preferences", FontSize = 14,
            FontWeight = FontWeight.Medium, TextWrapping = TextWrapping.Wrap };
        preview.Children.Add(heading);

        var group = new AlderCheckboxButtonGroup { Layout = CheckboxButtonGroupLayout.Grid, Columns = 3, SelectedKeys = ["updates", "alerts"] };
        AutomationProperties.SetName(group, "Notification preferences");
        preview.Children.Add(group);

        var item1 = new AlderCheckboxButtonGroupItem
        {
            Description = "Product news and practical tips"
        };
        AlderChoiceGroup.SetKey(item1, "updates");
        AutomationProperties.SetName(item1, "Product Updates");
        item1.Content = new AlderTextBlock { Text = "Product Updates", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var indicator1 = new AlderPathIcon { Width = 20, Height = 20 };
        indicator1[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircleFilled");
        indicator1[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderAccent");
        item1.Indicator = indicator1;
        var price1 = new Run { Text = "4,200", FontWeight = FontWeight.SemiBold };
        var suffix1 = new Run { Text = " subscribers", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix1[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        item1.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price1, suffix1 } };
        group.Children.Add(item1);

        var item2 = new AlderCheckboxButtonGroupItem
        {
            Description = "Security notices and maintenance alerts"
        };
        AlderChoiceGroup.SetKey(item2, "alerts");
        AutomationProperties.SetName(item2, "Security Alerts");
        item2.Content = new AlderTextBlock { Text = "Security Alerts", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var indicator2 = new AlderPathIcon { Width = 20, Height = 20 };
        indicator2[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircleFilled");
        indicator2[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderAccent");
        item2.Indicator = indicator2;
        var price2 = new Run { Text = "8,100", FontWeight = FontWeight.SemiBold };
        var suffix2 = new Run { Text = " subscribers", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix2[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        item2.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price2, suffix2 } };
        group.Children.Add(item2);

        var item3 = new AlderCheckboxButtonGroupItem
        {
            Description = "Promotions and special offers"
        };
        AlderChoiceGroup.SetKey(item3, "marketing");
        AutomationProperties.SetName(item3, "Marketing");
        item3.Content = new AlderTextBlock { Text = "Marketing", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var indicator3 = new AlderPathIcon { Width = 20, Height = 20 };
        indicator3[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircleFilled");
        indicator3[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderAccent");
        item3.Indicator = indicator3;
        var price3 = new Run { Text = "2,300", FontWeight = FontWeight.SemiBold };
        var suffix3 = new Run { Text = " subscribers", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix3[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        item3.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price3, suffix3 } };
        group.Children.Add(item3);
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleDisabledGroup" Title="{DynamicResource GalleryText.CardDisabledGroup}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="360">
          <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardSelectFeatures}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
          <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardFeaturePaused}" FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
          <alder:AlderCheckboxButtonGroup IsEnabled="False" SelectedKeys="security"
              AutomationProperties.Name="{DynamicResource GalleryText.CardSelectFeatures}">
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="security"
                Description="{DynamicResource GalleryText.CardSecurityDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardSecurity}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardSecurity}" TextWrapping="Wrap" LineHeight="20" />
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="storage"
                Description="{DynamicResource GalleryText.CardStorageDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardStorage}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardStorage}" TextWrapping="Wrap" LineHeight="20" />
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="analytics"
                Description="{DynamicResource GalleryText.CardAnalyticsDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardAnalytics}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardAnalytics}" TextWrapping="Wrap" LineHeight="20" />
            </alder:AlderCheckboxButtonGroupItem>
          </alder:AlderCheckboxButtonGroup>
        </StackPanel>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var preview = new StackPanel { Spacing = 12, MaxWidth = 360 };
        var heading = new AlderTextBlock { Text = "Select features", FontSize = 14,
            FontWeight = FontWeight.Medium, TextWrapping = TextWrapping.Wrap };
        preview.Children.Add(heading);
        var hint = new AlderTextBlock { FontSize = 12, LineHeight = 16, TextWrapping = TextWrapping.Wrap };
        hint.Text = "Feature selection is temporarily unavailable.";
        hint[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        preview.Children.Add(hint);

        var group = new AlderCheckboxButtonGroup { IsEnabled = false, SelectedKeys = ["security"] };
        AutomationProperties.SetName(group, "Select features");
        preview.Children.Add(group);

        var item1 = new AlderCheckboxButtonGroupItem
        {
            Description = "Detect and block threats in real time"
        };
        AlderChoiceGroup.SetKey(item1, "security");
        AutomationProperties.SetName(item1, "Security");
        item1.Content = new AlderTextBlock { Text = "Security", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        group.Children.Add(item1);

        var item2 = new AlderCheckboxButtonGroupItem
        {
            Description = "Cloud storage with automatic backups"
        };
        AlderChoiceGroup.SetKey(item2, "storage");
        AutomationProperties.SetName(item2, "Storage");
        item2.Content = new AlderTextBlock { Text = "Storage", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        group.Children.Add(item2);

        var item3 = new AlderCheckboxButtonGroupItem
        {
            Description = "Usage trends and performance reports"
        };
        AlderChoiceGroup.SetKey(item3, "analytics");
        AutomationProperties.SetName(item3, "Analytics");
        item3.Content = new AlderTextBlock { Text = "Analytics", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        group.Children.Add(item3);
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleGridLayout" Title="{DynamicResource GalleryText.CardGridLayout}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="672">
          <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardAddOns}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
          <alder:AlderCheckboxButtonGroup Layout="Grid" Columns="3" SelectedKeys="backups,monitoring"
              AutomationProperties.Name="{DynamicResource GalleryText.CardAddOns}">
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="backups"
                Description="{DynamicResource GalleryText.CardBackupsDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardBackups}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardBackups}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Details>
                <alder:AlderTextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="{DynamicResource GalleryText.CardMonthly5}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.CardMonthlySuffix}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderTextBlock>
              </alder:AlderCheckboxButtonGroupItem.Details>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="monitoring"
                Description="{DynamicResource GalleryText.CardMonitoringDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardMonitoring}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardMonitoring}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Details>
                <alder:AlderTextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="{DynamicResource GalleryText.CardMonthly12}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.CardMonthlySuffix}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderTextBlock>
              </alder:AlderCheckboxButtonGroupItem.Details>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="support"
                Description="{DynamicResource GalleryText.CardSupportDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardSupport}">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardSupport}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Details>
                <alder:AlderTextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="{DynamicResource GalleryText.CardMonthly8}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.CardMonthlySuffix}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderTextBlock>
              </alder:AlderCheckboxButtonGroupItem.Details>
            </alder:AlderCheckboxButtonGroupItem>
          </alder:AlderCheckboxButtonGroup>
        </StackPanel>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var preview = new StackPanel { Spacing = 12, MaxWidth = 672 };
        var heading = new AlderTextBlock { Text = "Add-ons", FontSize = 14,
            FontWeight = FontWeight.Medium, TextWrapping = TextWrapping.Wrap };
        preview.Children.Add(heading);

        var group = new AlderCheckboxButtonGroup { Layout = CheckboxButtonGroupLayout.Grid, Columns = 3, SelectedKeys = ["backups", "monitoring"] };
        AutomationProperties.SetName(group, "Add-ons");
        preview.Children.Add(group);

        var item1 = new AlderCheckboxButtonGroupItem
        {
            Description = "Automatic daily backups"
        };
        AlderChoiceGroup.SetKey(item1, "backups");
        AutomationProperties.SetName(item1, "Backups");
        item1.Content = new AlderTextBlock { Text = "Backups", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var price1 = new Run { Text = "US$5.00", FontWeight = FontWeight.SemiBold };
        var suffix1 = new Run { Text = "/mo", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix1[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
