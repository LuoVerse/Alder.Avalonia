      <g:ExampleCard.CSharpSource><![CDATA[
        var preview = new StackPanel { Spacing = 12, MaxWidth = 360 };
        var heading = new AlderTextBlock { Text = "Select features", FontSize = 14,
            FontWeight = FontWeight.Medium, TextWrapping = TextWrapping.Wrap };
        preview.Children.Add(heading);

        var group = new AlderCheckboxButtonGroup();
        AutomationProperties.SetName(group, "Select features");
        preview.Children.Add(group);
        group.Styles.Add(new Style(x => x.OfType<AlderCheckboxButtonGroupItem>().Class(":checked")
            .Descendant().OfType<Run>().Class("selectionPrice"))
        {
            Setters = { new Setter(Run.ForegroundProperty, new DynamicResourceExtension("AlderAccent")) }
        });

        var item1 = new AlderCheckboxButtonGroupItem
        {
            Description = "Automatic daily backups"
        };
        AlderChoiceGroup.SetKey(item1, "backups");
        AutomationProperties.SetName(item1, "Backups");
        item1.Content = new AlderTextBlock { Text = "Backups", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var price1 = new Run { Text = "US$5.00", FontWeight = FontWeight.SemiBold };
        var suffix1 = new Run { Text = "/mo", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix1[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        price1.Classes.Add("selectionPrice");
        item1.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price1, suffix1 } };
        group.Children.Add(item1);

        var item2 = new AlderCheckboxButtonGroupItem
        {
            Description = "Around-the-clock monitoring and alerts"
        };
        AlderChoiceGroup.SetKey(item2, "monitoring");
        AutomationProperties.SetName(item2, "Monitoring");
        item2.Content = new AlderTextBlock { Text = "Monitoring", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var price2 = new Run { Text = "US$12.00", FontWeight = FontWeight.SemiBold };
        var suffix2 = new Run { Text = "/mo", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix2[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        price2.Classes.Add("selectionPrice");
        item2.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price2, suffix2 } };
        group.Children.Add(item2);

        var item3 = new AlderCheckboxButtonGroupItem
        {
            Description = "Priority support by email or chat"
        };
        AlderChoiceGroup.SetKey(item3, "support");
        AutomationProperties.SetName(item3, "Support");
        item3.Content = new AlderTextBlock { Text = "Support", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var price3 = new Run { Text = "US$8.00", FontWeight = FontWeight.SemiBold };
        var suffix3 = new Run { Text = "/mo", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix3[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        price3.Classes.Add("selectionPrice");
        item3.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price3, suffix3 } };
        group.Children.Add(item3);
      ]]></g:ExampleCard.CSharpSource>
