            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="bronze"
                Description="{DynamicResource GalleryText.CardPlanBronzeDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardPlanBronze}" SelectionBrush="{DynamicResource AlderFeedbackSuccess}" FontSize="18" FontWeight="Bold">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardPlanBronze}" TextWrapping="Wrap" LineHeight="22" />
              <alder:AlderCheckboxButtonGroupItem.Indicator>
                <alder:AlderPathIcon Width="20" Height="20" Data="{DynamicResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderFeedbackSuccess}" />
              </alder:AlderCheckboxButtonGroupItem.Indicator>
              <alder:AlderCheckboxButtonGroupItem.Details>
                <alder:AlderTextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap">
                  <Run Text="{DynamicResource GalleryText.CardPlanBronzePrice}" FontWeight="SemiBold" Classes="selectionPrice" /><Run Text="{DynamicResource GalleryText.CardPlanBronzeCycle}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderTextBlock>
              </alder:AlderCheckboxButtonGroupItem.Details>
            </alder:AlderCheckboxButtonGroupItem>
          </alder:AlderCheckboxButtonGroup>
        </StackPanel>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var preview = new StackPanel { Spacing = 12, MaxWidth = 420 };
        var heading = new AlderTextBlock { Text = "Choose a subscription", FontSize = 28,
            FontWeight = FontWeight.Bold, TextWrapping = TextWrapping.Wrap, TextAlignment = TextAlignment.Center };
        preview.Children.Add(heading);
        var hint = new AlderTextBlock { FontSize = 12, LineHeight = 16, TextWrapping = TextWrapping.Wrap, TextAlignment = TextAlignment.Center };
        hint.Text = "Pick a plan. The first month is on us.";
        hint[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        preview.Children.Add(hint);

        var group = new AlderCheckboxButtonGroup { SelectedKeys = ["silver"] };
        AutomationProperties.SetName(group, "Choose a subscription");
        preview.Children.Add(group);
        group.Styles.Add(new Style(x => x.OfType<AlderCheckboxButtonGroupItem>().Class(":checked")
            .Descendant().OfType<Run>().Class("selectionPrice"))
        {
            Setters = { new Setter(Run.ForegroundProperty, new DynamicResourceExtension("AlderAlertSuccessInk")) }
        });

        var item1 = new AlderCheckboxButtonGroupItem
        {
            Description = "Saving, investing, and learning tools for the whole family.", FontSize = 18, FontWeight = FontWeight.Bold
        };
        AlderChoiceGroup.SetKey(item1, "gold");
        AutomationProperties.SetName(item1, "Gold");
        item1[!AlderCheckboxButtonGroupItem.SelectionBrushProperty] = new DynamicResourceExtension("AlderFeedbackSuccess");
        item1.Content = new AlderTextBlock { Text = "Gold", TextWrapping = TextWrapping.Wrap, LineHeight = 22 };
        var indicator1 = new AlderPathIcon { Width = 20, Height = 20 };
        indicator1[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircleFilled");
        indicator1[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderFeedbackSuccess");
        item1.Indicator = indicator1;
        var price1 = new Run { Text = "US$0.40/day", FontWeight = FontWeight.SemiBold };
        var suffix1 = new Run { Text = " (US$12 billed monthly)", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix1[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        price1.Classes.Add("selectionPrice");
        item1.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price1, suffix1 } };
        group.Children.Add(item1);

        var item2 = new AlderCheckboxButtonGroupItem
        {
            Description = "More tools to build your saving and investing skills.", FontSize = 18, FontWeight = FontWeight.Bold
        };
        AlderChoiceGroup.SetKey(item2, "silver");
        AutomationProperties.SetName(item2, "Silver");
        item2[!AlderCheckboxButtonGroupItem.SelectionBrushProperty] = new DynamicResourceExtension("AlderFeedbackSuccess");
        item2.Content = new AlderTextBlock { Text = "Silver", TextWrapping = TextWrapping.Wrap, LineHeight = 22 };
        var indicator2 = new AlderPathIcon { Width = 20, Height = 20 };
        indicator2[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircleFilled");
        indicator2[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderFeedbackSuccess");
        item2.Indicator = indicator2;
        var price2 = new Run { Text = "US$0.20/day", FontWeight = FontWeight.SemiBold };
        var suffix2 = new Run { Text = " (US$6 billed monthly)", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix2[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        price2.Classes.Add("selectionPrice");
        item2.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price2, suffix2 } };
        group.Children.Add(item2);

        var item3 = new AlderCheckboxButtonGroupItem
        {
            Description = "Basic tools for your first investments.", FontSize = 18, FontWeight = FontWeight.Bold
        };
        AlderChoiceGroup.SetKey(item3, "bronze");
        AutomationProperties.SetName(item3, "Bronze");
        item3[!AlderCheckboxButtonGroupItem.SelectionBrushProperty] = new DynamicResourceExtension("AlderFeedbackSuccess");
        item3.Content = new AlderTextBlock { Text = "Bronze", TextWrapping = TextWrapping.Wrap, LineHeight = 22 };
        var indicator3 = new AlderPathIcon { Width = 20, Height = 20 };
        indicator3[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconCheckCircleFilled");
        indicator3[!PathIcon.ForegroundProperty] = new DynamicResourceExtension("AlderFeedbackSuccess");
        item3.Indicator = indicator3;
        var price3 = new Run { Text = "US$0.10/day", FontWeight = FontWeight.SemiBold };
        var suffix3 = new Run { Text = " (US$3 billed monthly)", FontSize = 12, FontWeight = FontWeight.Normal };
        suffix3[!Run.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        price3.Classes.Add("selectionPrice");
        item3.Details = new AlderTextBlock { FontSize = 14, LineHeight = 20, TextWrapping = TextWrapping.Wrap, Inlines = new InlineCollection { price3, suffix3 } };
        group.Children.Add(item3);
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleWithIcons" Title="{DynamicResource GalleryText.CardWithIcons}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="560">
          <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardRolePermissions}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
          <alder:AlderCheckboxButtonGroup Layout="Grid" Columns="2" SelectedKeys="content,analytics"
              AutomationProperties.Name="{DynamicResource GalleryText.CardRolePermissions}">
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="content"
                Description="{DynamicResource GalleryText.CardContentManagementDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardContentManagement}" ShowIndicator="False">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardContentManagement}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Icon>
                <alder:AlderPathIcon Width="22" Height="22" Data="{DynamicResource AlderIconPencil}" />
              </alder:AlderCheckboxButtonGroupItem.Icon>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="users"
                Description="{DynamicResource GalleryText.CardUserAdministrationDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardUserAdministration}" ShowIndicator="False">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardUserAdministration}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Icon>
                <alder:AlderPathIcon Width="22" Height="22" Data="{DynamicResource AlderIconAvatarPerson}" />
              </alder:AlderCheckboxButtonGroupItem.Icon>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="analytics"
                Description="{DynamicResource GalleryText.CardAnalyticsAccessDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardAnalyticsAccess}" ShowIndicator="False">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardAnalyticsAccess}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Icon>
                <alder:AlderPathIcon Width="22" Height="22" Data="{DynamicResource AlderIconChart}" />
              </alder:AlderCheckboxButtonGroupItem.Icon>
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="settings"
                Description="{DynamicResource GalleryText.CardWorkspaceSettingsDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardWorkspaceSettings}" ShowIndicator="False">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardWorkspaceSettings}" TextWrapping="Wrap" LineHeight="20" />
              <alder:AlderCheckboxButtonGroupItem.Icon>
                <alder:AlderPathIcon Width="22" Height="22" Data="{DynamicResource AlderIconGear}" />
              </alder:AlderCheckboxButtonGroupItem.Icon>
            </alder:AlderCheckboxButtonGroupItem>
          </alder:AlderCheckboxButtonGroup>
        </StackPanel>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var preview = new StackPanel { Spacing = 12, MaxWidth = 560 };
        var heading = new AlderTextBlock { Text = "Role permissions", FontSize = 14,
            FontWeight = FontWeight.Medium, TextWrapping = TextWrapping.Wrap };
        preview.Children.Add(heading);

        var group = new AlderCheckboxButtonGroup { Layout = CheckboxButtonGroupLayout.Grid, Columns = 2, SelectedKeys = ["content", "analytics"] };
        AutomationProperties.SetName(group, "Role permissions");
        preview.Children.Add(group);

        var item1 = new AlderCheckboxButtonGroupItem
        {
            Description = "Create, edit, and remove content", ShowIndicator = false
        };
        AlderChoiceGroup.SetKey(item1, "content");
        AutomationProperties.SetName(item1, "Content Management");
        item1.Content = new AlderTextBlock { Text = "Content Management", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var icon1 = new AlderPathIcon { Width = 22, Height = 22 };
        icon1[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconPencil");
        item1.Icon = icon1;
        group.Children.Add(item1);

        var item2 = new AlderCheckboxButtonGroupItem
        {
            Description = "Manage team members and roles", ShowIndicator = false
        };
        AlderChoiceGroup.SetKey(item2, "users");
        AutomationProperties.SetName(item2, "User Administration");
        item2.Content = new AlderTextBlock { Text = "User Administration", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var icon2 = new AlderPathIcon { Width = 22, Height = 22 };
        icon2[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconAvatarPerson");
        item2.Icon = icon2;
        group.Children.Add(item2);

        var item3 = new AlderCheckboxButtonGroupItem
        {
            Description = "View and export reports", ShowIndicator = false
        };
        AlderChoiceGroup.SetKey(item3, "analytics");
        AutomationProperties.SetName(item3, "Analytics Access");
        item3.Content = new AlderTextBlock { Text = "Analytics Access", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var icon3 = new AlderPathIcon { Width = 22, Height = 22 };
        icon3[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconChart");
        item3.Icon = icon3;
        group.Children.Add(item3);

        var item4 = new AlderCheckboxButtonGroupItem
        {
            Description = "Configure workspace preferences", ShowIndicator = false
        };
        AlderChoiceGroup.SetKey(item4, "settings");
        AutomationProperties.SetName(item4, "Settings");
        item4.Content = new AlderTextBlock { Text = "Settings", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        var icon4 = new AlderPathIcon { Width = 22, Height = 22 };
        icon4[!PathIcon.DataProperty] = new DynamicResourceExtension("AlderIconGear");
        item4.Icon = icon4;
        group.Children.Add(item4);
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleWithRipple" Title="{DynamicResource GalleryText.CardWithRipple}">
      <g:ExampleCard.Preview>
        <StackPanel Spacing="12" MaxWidth="672">
          <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardIntegrations}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
          <alder:AlderCheckboxButtonGroup Layout="Grid" Columns="3" SelectedKeys="github"
              AutomationProperties.Name="{DynamicResource GalleryText.CardIntegrations}">
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="github"
                Description="{DynamicResource GalleryText.CardGitHubDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardGitHub}" IsRippleEnabled="True">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardGitHub}" TextWrapping="Wrap" LineHeight="20" />
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="slack"
                Description="{DynamicResource GalleryText.CardSlackDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardSlack}" IsRippleEnabled="True">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardSlack}" TextWrapping="Wrap" LineHeight="20" />
            </alder:AlderCheckboxButtonGroupItem>
            <alder:AlderCheckboxButtonGroupItem alder:AlderChoiceGroup.Key="linear"
                Description="{DynamicResource GalleryText.CardLinearDetail}" AutomationProperties.Name="{DynamicResource GalleryText.CardLinear}" IsRippleEnabled="True">
              <alder:AlderTextBlock Text="{DynamicResource GalleryText.CardLinear}" TextWrapping="Wrap" LineHeight="20" />
            </alder:AlderCheckboxButtonGroupItem>
          </alder:AlderCheckboxButtonGroup>
        </StackPanel>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var preview = new StackPanel { Spacing = 12, MaxWidth = 672 };
        var heading = new AlderTextBlock { Text = "Integrations", FontSize = 14,
            FontWeight = FontWeight.Medium, TextWrapping = TextWrapping.Wrap };
        preview.Children.Add(heading);

        var group = new AlderCheckboxButtonGroup { Layout = CheckboxButtonGroupLayout.Grid, Columns = 3, SelectedKeys = ["github"] };
        AutomationProperties.SetName(group, "Integrations");
        preview.Children.Add(group);

        var item1 = new AlderCheckboxButtonGroupItem
        {
            Description = "Connect your code repositories", IsRippleEnabled = true
        };
        AlderChoiceGroup.SetKey(item1, "github");
        AutomationProperties.SetName(item1, "GitHub");
        item1.Content = new AlderTextBlock { Text = "GitHub", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        group.Children.Add(item1);

        var item2 = new AlderCheckboxButtonGroupItem
        {
            Description = "Send notifications to your channels", IsRippleEnabled = true
        };
        AlderChoiceGroup.SetKey(item2, "slack");
        AutomationProperties.SetName(item2, "Slack");
        item2.Content = new AlderTextBlock { Text = "Slack", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        group.Children.Add(item2);

        var item3 = new AlderCheckboxButtonGroupItem
        {
            Description = "Sync tasks with your projects", IsRippleEnabled = true
        };
        AlderChoiceGroup.SetKey(item3, "linear");
        AutomationProperties.SetName(item3, "Linear");
        item3.Content = new AlderTextBlock { Text = "Linear", TextWrapping = TextWrapping.Wrap, LineHeight = 20 };
        group.Children.Add(item3);
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
