                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20">
                    <Run Text="{DynamicResource GalleryText.FormRadioProPrice}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.FormRadioPricePeriod}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="enterprise" ShowIndicator="False"
                  Content="{DynamicResource GalleryText.FormEnterprise}" Description="{DynamicResource GalleryText.FormEnterpriseHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20">
                    <Run Text="{DynamicResource GalleryText.FormRadioEnterprisePrice}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.FormRadioPricePeriod}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
            </alder:AlderRadioButtonGroup>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderRadioButtonGroup { MaxWidth = 360 };
        group.Children.Add(Plan("starter", "Starter", "For individuals and small projects", "US$5"));
        group.Children.Add(Plan("pro", "Pro", "For growing teams and businesses", "US$15"));
        group.Children.Add(Plan("enterprise", "Enterprise", "For large organizations at scale", "US$45"));
        group.SelectedKey = "pro";

        static AlderRadioButtonGroupItem Plan(string key, string title, string description, string amount)
        {
            var value = new AlderTextBlock { LineHeight = 20 };
            value.Inlines!.Add(new Run(amount) { FontWeight = FontWeight.SemiBold });
            value.Inlines.Add(new Run("/mo") { FontSize = 12, Foreground = Brushes.Gray });
            var card = new AlderRadioButtonGroupItem { Content = title, Description = description, Details = value, ShowIndicator = false };
            AlderChoiceGroup.SetKey(card, key);
            return card;
        }
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleDynamic" Title="{DynamicResource GalleryText.FormRadioDynamicDetails}">
      <g:ExampleCard.Preview>
        <Border Padding="18,23" MinHeight="120">
          <StackPanel MaxWidth="360" Spacing="12">
            <alder:AlderTextBlock x:Name="ReactiveTitle" Text="{DynamicResource GalleryText.FormRadioPlanTitle}" FontWeight="Medium" LineHeight="20" TextWrapping="Wrap" />
            <alder:AlderRadioButtonGroup SelectedKey="pro" AutomationProperties.LabeledBy="{CompiledBinding #ReactiveTitle}">
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="starter" x:Name="ReactiveStarter"
                  Content="{DynamicResource GalleryText.Starter}" Description="{DynamicResource GalleryText.FormRadioStarterHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20" Theme="{StaticResource RadioSelectedPrice}" Classes.selected="{CompiledBinding #ReactiveStarter.IsChecked, TargetNullValue=False}">
                    <Run Text="{DynamicResource GalleryText.FormRadioStarterPrice}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.FormRadioPricePeriod}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="pro" x:Name="ReactivePro"
                  Content="{DynamicResource GalleryText.SelectPro}" Description="{DynamicResource GalleryText.FormRadioProHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20" Theme="{StaticResource RadioSelectedPrice}" Classes.selected="{CompiledBinding #ReactivePro.IsChecked, TargetNullValue=False}">
                    <Run Text="{DynamicResource GalleryText.FormRadioProPrice}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.FormRadioPricePeriod}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="enterprise" x:Name="ReactiveEnterprise"
                  Content="{DynamicResource GalleryText.FormEnterprise}" Description="{DynamicResource GalleryText.FormEnterpriseHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20" Theme="{StaticResource RadioSelectedPrice}" Classes.selected="{CompiledBinding #ReactiveEnterprise.IsChecked, TargetNullValue=False}">
                    <Run Text="{DynamicResource GalleryText.FormRadioEnterprisePrice}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.FormRadioPricePeriod}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
            </alder:AlderRadioButtonGroup>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderRadioButtonGroup { MaxWidth = 360 };
        group.Children.Add(Plan("starter", "Starter", "For individuals and small projects", "US$5"));
        group.Children.Add(Plan("pro", "Pro", "For growing teams and businesses", "US$15"));
        group.Children.Add(Plan("enterprise", "Enterprise", "For large organizations at scale", "US$45"));
        group.SelectedKey = "pro";

        static AlderRadioButtonGroupItem Plan(string key, string title, string description, string amount)
        {
            var value = new AlderTextBlock { LineHeight = 20 };
            value.Inlines!.Add(new Run(amount) { FontWeight = FontWeight.SemiBold });
            value.Inlines.Add(new Run("/mo") { FontSize = 12, Foreground = Brushes.Gray });
            var card = new AlderRadioButtonGroupItem { Content = title, Description = description, Details = value };
            AlderChoiceGroup.SetKey(card, key);
            card.PropertyChanged += (_, change) =>
            {
                if (change.Property == ToggleButton.IsCheckedProperty)
                    value.Foreground = card.IsChecked == true ? Brushes.DodgerBlue : null;
            };
            return card;
        }
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
