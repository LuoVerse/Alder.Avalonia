                </alder:AlderRadioButtonGroupItem.Indicator>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="business" Background="{DynamicResource AlderNeutral}" AutomationProperties.Name="{DynamicResource GalleryText.RadioDemoBusiness}">
                <alder:AlderRadioButtonGroupItem.Content>
                  <StackPanel Spacing="8">
