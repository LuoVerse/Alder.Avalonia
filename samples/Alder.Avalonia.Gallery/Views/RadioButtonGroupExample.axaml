      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderRadioButtonGroup { MaxWidth = 360 };
        group.Children.Add(Plan("starter", "Starter", "For individuals and small projects", "US$5"));
        group.Children.Add(Plan("pro", "Pro", "For growing teams and businesses", "US$15"));
        group.Children.Add(Plan("enterprise", "Enterprise", "For large organizations at scale", "US$45"));
        group.Bind(AlderRadioButtonGroup.SelectedKeyProperty,
            CompiledBinding.Create((RadioButtonGroupViewModel model) => model.Plan, mode: BindingMode.TwoWay));

        static AlderRadioButtonGroupItem Plan(string key, string title, string description, string amount)
        {
            var value = new AlderTextBlock { LineHeight = 20 };
            value.Inlines!.Add(new Run(amount) { FontWeight = FontWeight.SemiBold });
            value.Inlines.Add(new Run("/mo") { FontSize = 12, Foreground = Brushes.Gray });
            var card = new AlderRadioButtonGroupItem { Content = title, Description = description, Details = value };
            AlderChoiceGroup.SetKey(card, key);
            return card;
        }
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleIndicators" Title="{DynamicResource GalleryText.RadioDemoCustomIndicator}">
      <g:ExampleCard.Preview>
        <Border Padding="18,23" MinHeight="120" Container.Name="RadioPreview" Container.Sizing="Width">
          <StackPanel MaxWidth="672" Spacing="12">
            <alder:AlderTextBlock x:Name="MailingListTitle" Text="{DynamicResource GalleryText.RadioDemoMailingList}" FontWeight="Medium" LineHeight="20" TextWrapping="Wrap" />
            <alder:AlderRadioButtonGroup SelectedKey="newsletter" AutomationProperties.LabeledBy="{CompiledBinding #MailingListTitle}" Layout="Grid" Theme="{StaticResource RadioDemoGrid}">
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="newsletter"
                  Content="{DynamicResource GalleryText.RadioDemoNewsletter}" Description="{DynamicResource GalleryText.RadioDemoNewsletterHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20" Margin="0,4,0,0">
                    <Run Text="{DynamicResource GalleryText.RadioDemoNewsletterCount}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.RadioDemoUserCountSuffix}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
                <alder:AlderRadioButtonGroupItem.Indicator>
                  <alder:AlderPathIcon Width="20" Height="20" Data="{StaticResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderAccent}" />
                </alder:AlderRadioButtonGroupItem.Indicator>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="existing"
                  Content="{DynamicResource GalleryText.RadioDemoExistingCustomers}" Description="{DynamicResource GalleryText.RadioDemoExistingHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20" Margin="0,4,0,0">
                    <Run Text="{DynamicResource GalleryText.RadioDemoExistingCount}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.RadioDemoUserCountSuffix}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
                <alder:AlderRadioButtonGroupItem.Indicator>
                  <alder:AlderPathIcon Width="20" Height="20" Data="{StaticResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderAccent}" />
                </alder:AlderRadioButtonGroupItem.Indicator>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="trial"
                  Content="{DynamicResource GalleryText.RadioDemoTrialUsers}" Description="{DynamicResource GalleryText.RadioDemoTrialHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20" Margin="0,4,0,0">
                    <Run Text="{DynamicResource GalleryText.RadioDemoTrialCount}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.RadioDemoUserCountSuffix}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
                <alder:AlderRadioButtonGroupItem.Indicator>
                  <alder:AlderPathIcon Width="20" Height="20" Data="{StaticResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderAccent}" />
