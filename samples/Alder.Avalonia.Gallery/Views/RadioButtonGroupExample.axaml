      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderRadioButtonGroup { Layout = RadioButtonGroupLayout.Grid, Columns = 3 };
        var check = (Geometry)Application.Current!.FindResource("AlderIconCheckCircleFilled")!;
        AddList("newsletter", "Newsletter", "Last message sent an hour ago", "621 users");
        AddList("existing", "Existing Customers", "Last message sent 2 weeks ago", "1,200 users");
        AddList("trial", "Trial Users", "Last message sent 4 days ago", "2,740 users");
        group.SelectedKey = "newsletter";

        void AddList(string key, string title, string description, string count)
        {
            var card = new AlderRadioButtonGroupItem
            {
                Content = title, Description = description, Details = new AlderTextBlock { Text = count },
                Indicator = new AlderPathIcon { Width = 20, Height = 20, Foreground = Brushes.DodgerBlue, Data = check }
            };
            AlderChoiceGroup.SetKey(card, key);
            group.Children.Add(card);
        }
      ]]></g:ExampleCard.CSharpSource>
