        <Border Padding="18,23" MinHeight="120" Container.Name="RadioPreview" Container.Sizing="Width">
          <StackPanel MaxWidth="672" Spacing="12">
            <alder:AlderTextBlock x:Name="DeployRegionTitle" Text="{DynamicResource GalleryText.RadioDemoDeployRegion}" FontWeight="Medium" LineHeight="20" TextWrapping="Wrap" />
            <alder:AlderRadioButtonGroup SelectedKey="east" AutomationProperties.LabeledBy="{CompiledBinding #DeployRegionTitle}" Layout="Grid" Theme="{StaticResource RadioDemoGrid}">
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="east" IsRippleEnabled="True"
                  Content="{DynamicResource GalleryText.FormEast}" Description="{DynamicResource GalleryText.RadioDemoEastHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock Text="{DynamicResource GalleryText.RadioDemoEastCode}" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="west" IsRippleEnabled="True"
                  Content="{DynamicResource GalleryText.FormWestEurope}" Description="{DynamicResource GalleryText.RadioDemoWestHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock Text="{DynamicResource GalleryText.RadioDemoWestCode}" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="asia" IsRippleEnabled="True"
                  Content="{DynamicResource GalleryText.FormAsiaPacific}" Description="{DynamicResource GalleryText.RadioDemoAsiaHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock Text="{DynamicResource GalleryText.RadioDemoAsiaCode}" FontFamily="Cascadia Mono, Menlo, monospace" FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
            </alder:AlderRadioButtonGroup>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderRadioButtonGroup { Layout = RadioButtonGroupLayout.Grid, Columns = 3 };
        AddRegion("east", "US East", "Lowest latency for US-based users", "us-east-1");
        AddRegion("west", "EU West", "Covers Western Europe and UK", "eu-west-1");
        AddRegion("asia", "Asia Pacific", "Optimized for Asia-Pacific traffic", "ap-south-1");
        group.SelectedKey = "east";

        void AddRegion(string key, string title, string description, string code)
        {
            var region = new AlderRadioButtonGroupItem
            {
                Content = title, Description = description, IsRippleEnabled = true,
                Details = new AlderTextBlock { Text = code, FontFamily = new FontFamily("Cascadia Mono, Menlo, monospace"), FontSize = 12 }
            };
            AlderChoiceGroup.SetKey(region, key);
            group.Children.Add(region);
        }
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleDisabled" Title="{DynamicResource GalleryText.RadioDemoDisabledGroup}">
      <g:ExampleCard.Preview>
        <Border Padding="18,23" MinHeight="120">
          <StackPanel MaxWidth="360" Spacing="12">
            <alder:AlderTextBlock x:Name="DisabledTitle" Text="{DynamicResource GalleryText.FormRadioPlanTitle}" FontWeight="Medium" LineHeight="20" TextWrapping="Wrap" />
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.RadioDemoChangesUnavailable}" FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
            <alder:AlderRadioButtonGroup SelectedKey="pro" AutomationProperties.LabeledBy="{CompiledBinding #DisabledTitle}" IsEnabled="False">
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="starter"
                  Content="{DynamicResource GalleryText.Starter}" Description="{DynamicResource GalleryText.FormRadioStarterHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20">
                    <Run Text="{DynamicResource GalleryText.FormRadioStarterPrice}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.FormRadioPricePeriod}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="pro"
                  Content="{DynamicResource GalleryText.SelectPro}" Description="{DynamicResource GalleryText.FormRadioProHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20">
                    <Run Text="{DynamicResource GalleryText.FormRadioProPrice}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.FormRadioPricePeriod}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="enterprise"
                  Content="{DynamicResource GalleryText.FormEnterprise}" Description="{DynamicResource GalleryText.FormEnterpriseHint}">
                <alder:AlderRadioButtonGroupItem.Details>
                  <alder:AlderTextBlock LineHeight="20">
                    <Run Text="{DynamicResource GalleryText.FormRadioEnterprisePrice}" FontWeight="SemiBold" /><Run Text="{DynamicResource GalleryText.FormRadioPricePeriod}" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                  </alder:AlderTextBlock>
                </alder:AlderRadioButtonGroupItem.Details>
              </alder:AlderRadioButtonGroupItem>
            </alder:AlderRadioButtonGroup>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var group = new AlderRadioButtonGroup { MaxWidth = 360, IsEnabled = false };
        group.Children.Add(Plan("starter", "Starter", "For individuals and small projects", "US$5"));
        group.Children.Add(Plan("pro", "Pro", "For growing teams and businesses", "US$15"));
        group.Children.Add(Plan("enterprise", "Enterprise", "For large organizations at scale", "US$45"));
        group.SelectedKey = "pro";

        static AlderRadioButtonGroupItem Plan(string key, string title, string description, string amount)
        {
            var value = new AlderTextBlock { LineHeight = 20 };
            value.Inlines!.Add(new Run(amount) { FontWeight = FontWeight.SemiBold });
            value.Inlines.Add(new Run("/mo") { FontSize = 12, Foreground = Brushes.Gray });
            var card = new AlderRadioButtonGroupItem { Content = title, Description = description, Details = value };
            AlderChoiceGroup.SetKey(card, key);
            return card;
        }
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleControlled" Title="{DynamicResource GalleryText.Controlled}">
