              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="growth" Background="{DynamicResource AlderNeutral}" AutomationProperties.Name="{DynamicResource GalleryText.FormGrowth}">
                <alder:AlderRadioButtonGroupItem.Content>
