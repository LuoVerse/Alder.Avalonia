                </alder:AlderRadioButtonGroupItem.Indicator>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="scale" Background="{DynamicResource AlderNeutral}" AutomationProperties.Name="{DynamicResource GalleryText.RadioDemoScale}">
                <alder:AlderRadioButtonGroupItem.Content>
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Border Width="32" Height="32" CornerRadius="12" Background="{DynamicResource AlderSurface}">
                        <Viewbox Width="16" Height="16">
                          <Path Width="16" Height="16" Data="{StaticResource RadioPlanScaleIcon}" Stroke="{DynamicResource AlderInk}"
                                StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Viewbox>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <alder:AlderTextBlock Text="{DynamicResource GalleryText.RadioDemoScale}" FontWeight="SemiBold" LineHeight="20" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <alder:AlderTextBlock LineHeight="32" FontSize="24">
                        <Run Text="{DynamicResource GalleryText.RadioDemoScalePrice}" FontWeight="Bold" /><Run Text="{DynamicResource GalleryText.RadioDemoPerMonth}" FontSize="14" Foreground="{DynamicResource AlderMuted}" />
                      </alder:AlderTextBlock>
                      <alder:AlderTextBlock Text="{DynamicResource GalleryText.RadioDemoScaleHint}" FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </alder:AlderRadioButtonGroupItem.Content>
                <alder:AlderRadioButtonGroupItem.Indicator>
                  <alder:AlderPathIcon Width="20" Height="20" Data="{StaticResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderAccent}" />
                </alder:AlderRadioButtonGroupItem.Indicator>
              </alder:AlderRadioButtonGroupItem>
              <alder:AlderRadioButtonGroupItem alder:AlderChoiceGroup.Key="enterprise" Background="{DynamicResource AlderNeutral}" AutomationProperties.Name="{DynamicResource GalleryText.FormEnterprise}">
                <alder:AlderRadioButtonGroupItem.Content>
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Border Width="32" Height="32" CornerRadius="12" Background="{DynamicResource AlderSurface}">
                        <Viewbox Width="16" Height="16">
                          <Path Width="16" Height="16" Data="{StaticResource RadioPlanEnterpriseIcon}" Stroke="{DynamicResource AlderInk}"
                                StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Viewbox>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <alder:AlderTextBlock Text="{DynamicResource GalleryText.FormEnterprise}" FontWeight="SemiBold" LineHeight="20" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="4">
                      <alder:AlderTextBlock LineHeight="32" FontSize="24">
                        <Run Text="{DynamicResource GalleryText.RadioDemoEnterprisePrice}" FontWeight="Bold" /><Run Text="{DynamicResource GalleryText.RadioDemoPerMonth}" FontSize="14" Foreground="{DynamicResource AlderMuted}" />
                      </alder:AlderTextBlock>
                      <alder:AlderTextBlock Text="{DynamicResource GalleryText.RadioDemoEnterpriseHint}" FontSize="12" LineHeight="16" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </alder:AlderRadioButtonGroupItem.Content>
                <alder:AlderRadioButtonGroupItem.Indicator>
                  <alder:AlderPathIcon Width="20" Height="20" Data="{StaticResource AlderIconCheckCircleFilled}" Foreground="{DynamicResource AlderAccent}" />
                </alder:AlderRadioButtonGroupItem.Indicator>
              </alder:AlderRadioButtonGroupItem>
            </alder:AlderRadioButtonGroup>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var workspace = new AlderRadioButtonGroup { MaxWidth = 520 };
        AddPlan("starter", "Starter", "US$12", true);
        AddPlan("growth", "Growth", "US$29");
        AddPlan("business", "Business", "US$59");
        AddPlan("scale", "Scale", "US$149");
        AddPlan("enterprise", "Enterprise", "US$299");
        workspace.SelectedKey = "starter";

        void AddPlan(string key, string title, string amount, bool popular = false)
        {
            var header = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 8 };
            header.Children.Add(new AlderTextBlock { Text = title, FontWeight = FontWeight.SemiBold });
            if (popular)
                header.Children.Add(new AlderChip { Content = "Most popular", Color = AlderStatusColor.Success, Variant = ChipVariant.Soft });
            var card = new AlderRadioButtonGroupItem
            {
                Content = new StackPanel
                {
                    Spacing = 8,
                    Children = { header, new AlderTextBlock { Text = amount, FontSize = 24, FontWeight = FontWeight.Bold } }
                },
                Indicator = new AlderPathIcon
                {
                    Width = 20, Height = 20,
                    Data = (Geometry)Application.Current!.FindResource("AlderIconCheckCircleFilled")!
                }
            };
            AlderChoiceGroup.SetKey(card, key);
            workspace.Children.Add(card);
        }
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleRipple" Title="{DynamicResource GalleryText.FormRadioRipple}">
