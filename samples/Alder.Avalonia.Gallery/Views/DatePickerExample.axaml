<UserControl xmlns:gallery="using:Alder.Avalonia.Gallery.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.DatePickerExample" x:DataType="vm:DatePickerViewModel" FontFamily="fonts:Inter#Inter">
  <Design.DataContext>
    <vm:DatePickerViewModel />
  </Design.DataContext>
  <UserControl.Styles><Style Selector=":is(Label)"><Setter Property="Theme" Value="{StaticResource AlderLabelTheme}" /></Style></UserControl.Styles>
  <gallery:GalleryExampleList>
    <gallery:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:DatePickerViewModel /></Border.DataContext>
          <StackPanel MaxWidth="288" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="UsageLabel" Content="{DynamicResource GalleryText.Date}" Target="{CompiledBinding #UsageField}" />
            <alder:AlderDatePicker x:Name="UsageField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #UsageLabel}"  />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new DatePickerViewModel();
        var field = new AlderDatePicker { DataContext = model, FullWidth = true };
        field[!AlderDatePicker.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Date");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 288, Spacing = 4, Children = { label, field } };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleControlled" Title="{DynamicResource GalleryText.Controlled}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:DatePickerViewModel /></Border.DataContext>
          <StackPanel MaxWidth="288" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="ControlledLabel" Content="{DynamicResource GalleryText.Date}" Target="{CompiledBinding #ControlledField}" />
            <alder:AlderDatePicker x:Name="ControlledField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #ControlledLabel}"
                                  Value="{CompiledBinding Date, Mode=TwoWay}" />
            <alder:AlderTextBlock Text="{CompiledBinding Summary}" FontSize="12" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new DatePickerViewModel();
        var field = new AlderDatePicker { DataContext = model, FullWidth = true };
        field[!AlderDatePicker.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Date");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 288, Spacing = 4, Children = { label, field } };
        field.Bind(AlderDatePicker.ValueProperty, CompiledBinding.Create((DatePickerViewModel vm) => vm.Date, mode: BindingMode.TwoWay));
        var detail = new AlderTextBlock { FontSize = 12, TextWrapping = TextWrapping.Wrap };
        detail.Bind(TextBlock.TextProperty, CompiledBinding.Create((DatePickerViewModel vm) => vm.Summary));
        detail[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderMuted");
        preview.Children.Add(detail);
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleInvalid" Title="{DynamicResource GalleryText.TemporalInvalid}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:DatePickerViewModel /></Border.DataContext>
          <StackPanel MaxWidth="288" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="InvalidLabel" Content="{DynamicResource GalleryText.Date}" Target="{CompiledBinding #InvalidField}" />
            <alder:AlderDatePicker x:Name="InvalidField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #InvalidLabel}" IsInvalid="True" />
            <alder:AlderTextBlock Text="{DynamicResource GalleryText.TemporalDateError}" FontSize="12" Foreground="{DynamicResource AlderDangerInk}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new DatePickerViewModel();
        var field = new AlderDatePicker { DataContext = model, FullWidth = true, IsInvalid = true };
        field[!AlderDatePicker.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Date");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 288, Spacing = 4, Children = { label, field } };
        var detail = new AlderTextBlock { FontSize = 12, TextWrapping = TextWrapping.Wrap };
        detail[!TextBlock.TextProperty] = new DynamicResourceExtension("GalleryText.TemporalDateError");
        detail[!TextBlock.ForegroundProperty] = new DynamicResourceExtension("AlderDangerInk");
        preview.Children.Add(detail);
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleIndicator" Title="{DynamicResource GalleryText.TemporalIndicator}">
      <gallery:ExampleCard.Preview>
        <Border Padding="16,20" MinHeight="120">
          <Border.DataContext><vm:DatePickerViewModel /></Border.DataContext>
          <StackPanel MaxWidth="288" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderLabel x:Name="IndicatorLabel" Content="{DynamicResource GalleryText.Date}" Target="{CompiledBinding #IndicatorField}" />
            <alder:AlderDatePicker x:Name="IndicatorField" FullWidth="True" Culture="{DynamicResource GalleryCulture}"
                                  AutomationProperties.LabeledBy="{CompiledBinding #IndicatorLabel}" Indicator="{DynamicResource AlderIconClock}" />
          </StackPanel>
        </Border>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var model = new DatePickerViewModel();
        var field = new AlderDatePicker { DataContext = model, FullWidth = true };
        field[!AlderDatePicker.CultureProperty] = new DynamicResourceExtension("GalleryCulture");
        var label = new AlderLabel { Target = field };
        label[!ContentControl.ContentProperty] = new DynamicResourceExtension("GalleryText.Date");
        label.Theme = (ControlTheme)Application.Current!.FindResource("AlderLabelTheme")!;
        AutomationProperties.SetLabeledBy(field, label);
        var preview = new StackPanel { DataContext = model, MaxWidth = 288, Spacing = 4, Children = { label, field } };
        field[!AlderDatePicker.IndicatorProperty] = new DynamicResourceExtension("AlderIconClock");
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleScheduleAnAppointment" Title="{DynamicResource GalleryText.ScheduleAnAppointment}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="8">
          <WrapPanel ItemSpacing="12" LineSpacing="8">
            <StackPanel Spacing="4">
              <alder:AlderLabel x:Name="DateLabel" Content="{DynamicResource GalleryText.Date}" Target="{Binding #AppointmentDate}" />
              <alder:AlderDatePicker x:Name="AppointmentDate" Culture="{DynamicResource GalleryCulture}" IsRequired="True" Value="{Binding Date, Mode=TwoWay}"
                                Minimum="{Binding Minimum}" IsDateUnavailable="{Binding Weekends}" PlaceholderDate="{Binding Example}"
                                AutomationProperties.LabeledBy="{Binding #DateLabel}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <alder:AlderLabel x:Name="TimeLabel" Content="{DynamicResource GalleryText.Time}" Target="{Binding #AppointmentTime}" />
              <alder:AlderTimeField x:Name="AppointmentTime" Culture="{DynamicResource GalleryCulture}" Value="{Binding Time, Mode=TwoWay}"
                               AutomationProperties.LabeledBy="{Binding #TimeLabel}" />
            </StackPanel>
          </WrapPanel>
          <alder:AlderTextBlock Text="{Binding Summary}" Foreground="{DynamicResource AlderMuted}" />
          <alder:AlderTextBlock IsVisible="{Binding #AppointmentDate.HasInvalidInput}" Text="{DynamicResource GalleryText.ChooseAnAvailableWeekday}" Foreground="{DynamicResource AlderDangerInk}" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <alder:AlderButton Content="{DynamicResource GalleryText.ClearDate}" Command="{CompiledBinding Clear}" Variant="Ghost" Size="Small" HorizontalAlignment="Left" />
            <alder:AlderButton Content="{DynamicResource GalleryText.Reset}" Command="{CompiledBinding Reset}" Variant="Secondary" Size="Small" />
          </WrapPanel>
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var datePicker = new AlderDatePicker { Culture = CultureInfo.CurrentCulture, IsRequired = true };
        datePicker.Bind(AlderDatePicker.ValueProperty, CompiledBinding.Create((DatePickerViewModel model) => model.Date, mode: BindingMode.TwoWay));
        datePicker.Bind(AlderDatePicker.MinimumProperty, CompiledBinding.Create((DatePickerViewModel model) => model.Minimum));
        datePicker.Bind(AlderDatePicker.IsDateUnavailableProperty, CompiledBinding.Create((DatePickerViewModel model) => model.Weekends));
        datePicker.Bind(AlderDatePicker.PlaceholderDateProperty, CompiledBinding.Create((DatePickerViewModel model) => model.Example));

        var timeField = new AlderTimeField { Culture = CultureInfo.CurrentCulture };
        timeField.Bind(AlderTimeField.ValueProperty, CompiledBinding.Create((DatePickerViewModel model) => model.Time, mode: BindingMode.TwoWay));

        var model = (DatePickerViewModel)DataContext!;
        var clear = new AlderButton { Content = "Clear date", Size = AlderSize.Small, Variant = ButtonVariant.Ghost };
        var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary };
        clear.Click += (_, _) => model.Clear();
        reset.Click += (_, _) => model.Reset();
        var actions = new WrapPanel { ItemSpacing = 8, LineSpacing = 8, Children = { clear, reset } };
        var preview = new StackPanel { Spacing = 8, Children = { datePicker, timeField, actions } };
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleBuddhistCalendar" Title="{DynamicResource GalleryText.BuddhistCalendar}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="4">
          <alder:AlderLabel x:Name="ThaiLabel" Content="{DynamicResource GalleryText.BuddhistCalendar}" Target="{Binding #ThaiPicker}" />
          <alder:AlderDatePicker x:Name="ThaiPicker" Culture="{Binding ThaiCulture}" Value="{Binding Example, Mode=OneWay}"
                            Indicator="{StaticResource AlderIconChevronDown}" AutomationProperties.LabeledBy="{Binding #ThaiLabel}" />
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var datePicker = new AlderDatePicker { Indicator = (Geometry)this.FindResource("AlderIconChevronDown")! };
        datePicker.Bind(AlderDatePicker.CultureProperty, CompiledBinding.Create((DatePickerViewModel model) => model.ThaiCulture));
        datePicker.Bind(AlderDatePicker.ValueProperty, CompiledBinding.Create((DatePickerViewModel model) => model.Example, mode: BindingMode.OneWay));
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
    <gallery:ExampleCard x:Name="SampleDisabled" Title="{DynamicResource GalleryText.Disabled}">
      <gallery:ExampleCard.Preview>
        <StackPanel Spacing="4">
          <alder:AlderLabel x:Name="DisabledLabel" Content="{DynamicResource GalleryText.Disabled}" Target="{Binding #DisabledDate}" />
          <alder:AlderDatePicker x:Name="DisabledDate" Culture="{DynamicResource GalleryCulture}" IsEnabled="False"
                            Value="{Binding Example, Mode=OneWay}" AutomationProperties.LabeledBy="{Binding #DisabledLabel}" />
        </StackPanel>
      </gallery:ExampleCard.Preview>
      <gallery:ExampleCard.CSharpSource><![CDATA[
        var datePicker = new AlderDatePicker { Culture = CultureInfo.CurrentCulture, IsEnabled = false };
        datePicker.Bind(AlderDatePicker.ValueProperty, CompiledBinding.Create((DatePickerViewModel model) => model.Example, mode: BindingMode.OneWay));
      ]]></gallery:ExampleCard.CSharpSource>
    </gallery:ExampleCard>
  </gallery:GalleryExampleList>
</UserControl>
