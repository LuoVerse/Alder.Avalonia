<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:alder="using:Alder.Avalonia.Controls" xmlns:g="using:Alder.Avalonia.Gallery.Controls" xmlns:vm="using:Alder.Avalonia.Gallery.ViewModels"
             x:Class="Alder.Avalonia.Gallery.Views.SelectExample" x:DataType="vm:SelectViewModel">
  <StackPanel Spacing="20">
    <g:ExampleCard x:Name="SampleUsage" Title="{DynamicResource GalleryText.Usage}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="300" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerState}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding StateOptions}" TextSelector="{CompiledBinding Caption}" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Label = "State" };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.StateOptions));
        picker.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((SelectViewModel model) => model.Caption));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleVariants" Title="{DynamicResource GalleryText.Variants}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerPrimary}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding Options}" />
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerSecondary}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding Options}"
                          Variant="Secondary" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Variant = InputVariant.Secondary };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.Options));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleFullWidth" Title="{DynamicResource GalleryText.FullWidth}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <Panel MaxWidth="400" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerFavoriteAnimal}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding Animals}"
                          FullWidth="True" />
          </Panel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Label = "Favorite Animal", FullWidth = true };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.Animals));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleDescription" Title="{DynamicResource GalleryText.AutocompleteDescription}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerState}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding StateOptions}" TextSelector="{CompiledBinding Caption}"
                          Description="{DynamicResource GalleryText.AutocompleteResidence}" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Label = "State", Description = "Select your state of residence" };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.StateOptions));
        picker.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((SelectViewModel model) => model.Caption));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleRequired" Title="{DynamicResource GalleryText.AutocompleteRequired}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="256">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerState}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding StateOptions}" TextSelector="{CompiledBinding Caption}"
                          IsRequired="True" FullWidth="True" Variant="Primary"
                          SelectedItem="{CompiledBinding RequiredForm.State, Mode=TwoWay}"
                          IsInvalid="{CompiledBinding RequiredForm.IsStateInvalid}" ErrorText="{DynamicResource GalleryText.SelectStateError}" />
            <alder:AlderSelect Label="{DynamicResource GalleryText.AutocompleteCountry}" PlaceholderText="{DynamicResource GalleryText.AutocompleteChooseCountry}"
                          ItemsSource="{CompiledBinding Countries}"
                          IsRequired="True" FullWidth="True" Variant="Primary"
                          SelectedItem="{CompiledBinding RequiredForm.Country, Mode=TwoWay}"
                          IsInvalid="{CompiledBinding RequiredForm.IsCountryInvalid}" ErrorText="{DynamicResource GalleryText.SelectCountryError}" />
            <alder:AlderButton Content="{DynamicResource GalleryText.Submit}" Command="{CompiledBinding RequiredForm.Submit}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Label = "State", IsRequired = true, ErrorText = "Select a state." };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.StateOptions));
        picker.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((SelectViewModel model) => model.Caption));
        picker.Bind(SelectingItemsControl.SelectedItemProperty, CompiledBinding.Create((SelectViewModel model) => model.RequiredForm.State, mode: BindingMode.TwoWay));
        picker.Bind(AlderPicker.IsInvalidProperty, CompiledBinding.Create((SelectViewModel model) => model.RequiredForm.IsStateInvalid));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleDisabled" Title="{DynamicResource GalleryText.Disabled}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerState}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding StateOptions}" TextSelector="{CompiledBinding Caption}"
                          IsEnabled="False" SelectedIndex="2" />
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerCountries}" PlaceholderText="{DynamicResource GalleryText.PickerChooseCountries}"
                          ItemsSource="{CompiledBinding Countries}"
                          IsEnabled="False" SelectionMode="Multiple" SelectedItems="{CompiledBinding DisabledCountries}" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { IsEnabled = false, SelectedIndex = 2 };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.StateOptions));
        picker.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((SelectViewModel model) => model.Caption));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleDisabledOptions" Title="{DynamicResource GalleryText.AutocompleteDisabledOptions}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.AutocompleteAnimal}" PlaceholderText="{DynamicResource GalleryText.AutocompleteChooseAnimal}"
                          ItemsSource="{CompiledBinding DisabledAnimals}" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Label = "Animal" };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.DisabledAnimals));
        var disabled = new AlderPickerOption { Text = "Cat", IsEnabled = false };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleMultiple" Title="{DynamicResource GalleryText.AutocompleteMultiple}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerCountries}" PlaceholderText="{DynamicResource GalleryText.PickerChooseCountries}"
                          ItemsSource="{CompiledBinding Countries}"
                          SelectionMode="Multiple" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Label = "Countries to Visit", SelectionMode = SelectionMode.Multiple };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.Countries));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleOptions" Title="{DynamicResource GalleryText.AutocompleteSections}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.AutocompleteCountry}" PlaceholderText="{DynamicResource GalleryText.AutocompleteChooseCountry}"
                          ItemsSource="{CompiledBinding CountrySections}" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Label = "Country" };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.CountrySections));
        var country = new AlderPickerOption { Text = "Canada", Group = "North America" };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleControlled" Title="{DynamicResource GalleryText.Controlled}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <alder:AlderSelect Label="{DynamicResource GalleryText.AutocompleteControlledState}" PlaceholderText="{DynamicResource GalleryText.AutocompleteChooseState}"
                          ItemsSource="{CompiledBinding ControlledStates}" TextSelector="{CompiledBinding Caption}"
                          SelectedItem="{CompiledBinding SelectedState, Mode=TwoWay}" />
            <alder:AlderTextBlock Text="{CompiledBinding SelectedStatus}" FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Label = "State (controlled)" };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.ControlledStates));
        picker.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((SelectViewModel model) => model.Caption));
        picker.Bind(SelectingItemsControl.SelectedItemProperty, CompiledBinding.Create((SelectViewModel model) => model.SelectedState, mode: BindingMode.TwoWay));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleControlledMultiple" Title="{DynamicResource GalleryText.AutocompleteControlledMultiple}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <alder:AlderSelect Label="{DynamicResource GalleryText.SelectControlledStates}" PlaceholderText="{DynamicResource GalleryText.AutocompleteSelectStates}"
                          ItemsSource="{CompiledBinding ControlledStates}" TextSelector="{CompiledBinding Caption}"
                          SelectionMode="Multiple" SelectedItems="{CompiledBinding SelectedStates}" />
            <alder:AlderTextBlock Text="{CompiledBinding MultipleStatus}" FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
            <alder:AlderButton Content="{DynamicResource GalleryText.Reset}" Command="{CompiledBinding ResetSelectedStates}" Variant="Secondary" Size="Small" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { SelectionMode = SelectionMode.Multiple };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.ControlledStates));
        picker.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((SelectViewModel model) => model.Caption));
        picker.Bind(AlderPicker.SelectedItemsProperty, CompiledBinding.Create((SelectViewModel model) => model.SelectedStates));

        var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary, HorizontalAlignment = HorizontalAlignment.Right };
        reset.Bind(Button.CommandProperty, CompiledBinding.Create((SelectViewModel model) => model.ResetSelectedStates));
        var preview = new StackPanel { Spacing = 8, Children = { picker, reset } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleControlledOpen" Title="{DynamicResource GalleryText.AutocompleteControlledOpen}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Width="256">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerState}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding StateOptions}" TextSelector="{CompiledBinding Caption}"
                          IsDropDownOpen="{CompiledBinding IsOpen, Mode=TwoWay}" />
            <alder:AlderButton Content="{CompiledBinding OpenButton}" Command="{CompiledBinding ToggleOpen}" HorizontalAlignment="Left" />
            <alder:AlderTextBlock Text="{CompiledBinding OpenStatus}" FontSize="14" LineHeight="20" Foreground="{DynamicResource AlderMuted}" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect();
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.StateOptions));
        picker.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((SelectViewModel model) => model.Caption));
        picker.Bind(AlderPicker.IsDropDownOpenProperty, CompiledBinding.Create((SelectViewModel model) => model.IsOpen, mode: BindingMode.TwoWay));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleAsync" Title="{DynamicResource GalleryText.PickerAsync}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.SelectPokemon}" PlaceholderText="{DynamicResource GalleryText.SelectChoosePokemon}"
                          ItemsSource="{CompiledBinding LoadedPokemon}"
                          AllowsEmptyCollection="True"
                          IsLoading="{CompiledBinding IsLoading}" LoadMoreCommand="{CompiledBinding LoadMore}" LoadingText="{DynamicResource GalleryText.SelectLoadingMore}" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { AllowsEmptyCollection = true };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.LoadedPokemon));
        picker.Bind(AlderPicker.IsLoadingProperty, CompiledBinding.Create((SelectViewModel model) => model.IsLoading));
        picker.Bind(AlderSelect.LoadMoreCommandProperty, CompiledBinding.Create((SelectViewModel model) => model.LoadMore));
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleIndicator" Title="{DynamicResource GalleryText.AutocompleteCustomIndicator}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerState}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding StateOptions}" TextSelector="{CompiledBinding Caption}"
                          Classes="custom-indicator" Indicator="{DynamicResource AlderIconChevronsExpandVertical}" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect();
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.StateOptions));
        picker.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((SelectViewModel model) => model.Caption));
        picker.Classes.Add("custom-indicator");
        picker[!AlderPicker.IndicatorProperty] = new DynamicResourceExtension("AlderIconChevronsExpandVertical");
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleClear" Title="{DynamicResource GalleryText.SelectClearButton}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerState}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding StateOptions}" TextSelector="{CompiledBinding Caption}"
                          SelectedIndex="{CompiledBinding ClearableStateIndex, Mode=TwoWay}" ShowClearButton="True" />
            <alder:AlderButton Content="{DynamicResource GalleryText.Reset}" Command="{CompiledBinding ResetClearableState}" Variant="Secondary" Size="Small" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { ShowClearButton = true };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.StateOptions));
        picker.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((SelectViewModel model) => model.Caption));
        picker.Bind(SelectingItemsControl.SelectedIndexProperty, CompiledBinding.Create((SelectViewModel model) => model.ClearableStateIndex, mode: BindingMode.TwoWay));

        var reset = new AlderButton { Content = "Reset", Size = AlderSize.Small, Variant = ButtonVariant.Secondary, HorizontalAlignment = HorizontalAlignment.Right };
        reset.Bind(Button.CommandProperty, CompiledBinding.Create((SelectViewModel model) => model.ResetClearableState));
        var preview = new StackPanel { Spacing = 8, Children = { picker, reset } };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleValue" Title="{DynamicResource GalleryText.AutocompleteCustomValue}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.AutocompleteUser}" PlaceholderText="{DynamicResource GalleryText.AutocompleteChooseUser}"
                          ItemsSource="{CompiledBinding Users}"
                          TextSelector="{x:Static vm:SelectViewModel.UserCaption}">
              <alder:AlderSelect.SelectionTemplate>
                <DataTemplate x:DataType="vm:SelectExampleUser">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <alder:AlderAvatar Width="16" Height="16" CornerRadius="8" FontSize="8" Source="{CompiledBinding Photo}" Fallback="{CompiledBinding Initials}" />
                    <alder:AlderTextBlock Text="{CompiledBinding Name}" LineHeight="20" />
                  </StackPanel>
                </DataTemplate>
              </alder:AlderSelect.SelectionTemplate>
              <alder:AlderSelect.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectExampleUser">
                  <Grid ColumnDefinitions="32,*" ColumnSpacing="12">
                    <alder:AlderAvatar Size="Small" Source="{CompiledBinding Photo}" Fallback="{CompiledBinding Initials}" />
                    <StackPanel Grid.Column="1">
                      <alder:AlderTextBlock Text="{CompiledBinding Name}" LineHeight="20" FontWeight="Medium" />
                      <alder:AlderTextBlock Text="{CompiledBinding Email}" LineHeight="16" FontSize="12" Foreground="{DynamicResource AlderMuted}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </alder:AlderSelect.ItemTemplate>
            </alder:AlderSelect>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Label = "User", TextSelector = SelectViewModel.UserCaption };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.Users));
        picker.SelectionTemplate = new FuncDataTemplate<SelectExampleUser>((user, _) => new StackPanel
        {
            Orientation = Orientation.Horizontal, Spacing = 8,
            Children =
            {
                new AlderAvatar { Width = 16, Height = 16, CornerRadius = new CornerRadius(8), Source = user!.Photo },
                new AlderTextBlock { Text = user.Name }
            }
        });
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleRender" Title="{DynamicResource GalleryText.SelectCustomRendering}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.PickerState}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                          ItemsSource="{CompiledBinding DisplayStates}">
              <alder:AlderSelect.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <alder:AlderTextBlock Text="{CompiledBinding}" LineHeight="20" TextWrapping="Wrap" />
                </DataTemplate>
              </alder:AlderSelect.ItemTemplate>
            </alder:AlderSelect>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect();
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.DisplayStates));
        picker.ItemTemplate = new FuncDataTemplate<string>((key, _) => new AlderTextBlock
        {
            Text = key
        });
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleSurface" Title="{DynamicResource GalleryText.AutocompleteInSurface}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="260" TextElement.FontFamily="fonts:Inter#Inter">
          <alder:AlderSurface MaxWidth="320" Padding="24" CornerRadius="24" VerticalAlignment="Center">
            <StackPanel Spacing="16">
              <alder:AlderSelect Label="{DynamicResource GalleryText.PickerState}" PlaceholderText="{DynamicResource GalleryText.PickerPlaceholder}"
                            ItemsSource="{CompiledBinding StateOptions}" TextSelector="{CompiledBinding Caption}"
                            IsRequired="True" FullWidth="True" Variant="Secondary"
                            SelectedItem="{CompiledBinding SurfaceForm.State, Mode=TwoWay}"
                            IsInvalid="{CompiledBinding SurfaceForm.IsStateInvalid}" ErrorText="{DynamicResource GalleryText.SelectStateError}" />
              <alder:AlderSelect Label="{DynamicResource GalleryText.AutocompleteCountry}" PlaceholderText="{DynamicResource GalleryText.AutocompleteChooseCountry}"
                            ItemsSource="{CompiledBinding Countries}"
                            IsRequired="True" FullWidth="True" Variant="Secondary"
                            SelectedItem="{CompiledBinding SurfaceForm.Country, Mode=TwoWay}"
                            IsInvalid="{CompiledBinding SurfaceForm.IsCountryInvalid}" ErrorText="{DynamicResource GalleryText.SelectCountryError}" />
              <alder:AlderButton Content="{DynamicResource GalleryText.Submit}" Command="{CompiledBinding SurfaceForm.Submit}" HorizontalAlignment="Left" />
            </StackPanel>
          </alder:AlderSurface>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Variant = InputVariant.Secondary, FullWidth = true, IsRequired = true };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.StateOptions));
        picker.Bind(AlderPicker.TextSelectorProperty, CompiledBinding.Create((SelectViewModel model) => model.Caption));
        var surface = new AlderSurface { MaxWidth = 320, Padding = new Thickness(24), Content = picker };
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
    <g:ExampleCard x:Name="SampleCustom" Title="{DynamicResource GalleryText.CustomStyles}">
      <g:ExampleCard.Preview>
        <Border Padding="8,12" MinHeight="180" TextElement.FontFamily="fonts:Inter#Inter">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <alder:AlderSelect Label="{DynamicResource GalleryText.SelectPlan}" PlaceholderText="{DynamicResource GalleryText.SelectChoosePlan}"
                          ItemsSource="{CompiledBinding Plans}"
                          Width="224" Variant="Secondary" DropDownCornerRadius="12" DropDownPadding="4"
                          DropDownBorderBrush="{DynamicResource AlderBorder}" DropDownBorderThickness="1">
              <alder:AlderSelect.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource AlderSelectRowTheme}">
                  <Setter Property="CornerRadius" Value="8" />
                </ControlTheme>
              </alder:AlderSelect.ItemContainerTheme>
            </alder:AlderSelect>
          </StackPanel>
        </Border>
      </g:ExampleCard.Preview>
      <g:ExampleCard.CSharpSource><![CDATA[
        var picker = new AlderSelect { Width = 224, Variant = InputVariant.Secondary, DropDownCornerRadius = new CornerRadius(12), DropDownPadding = new Thickness(4) };
        picker.Bind(ItemsControl.ItemsSourceProperty, CompiledBinding.Create((SelectViewModel model) => model.Plans));
        picker.DropDownBorderThickness = new Thickness(1);
        picker[!AlderSelect.DropDownBorderBrushProperty] = new DynamicResourceExtension("AlderBorder");
      ]]></g:ExampleCard.CSharpSource>
    </g:ExampleCard>
  </StackPanel>
</UserControl>
