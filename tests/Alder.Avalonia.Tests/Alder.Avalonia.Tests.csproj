    <ProjectReference Include="../../src/Alder.Avalonia/Alder.Avalonia.csproj" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent2" Version="12.2.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
