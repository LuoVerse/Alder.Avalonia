<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alder="using:Alder.Avalonia.Controls"
                    xmlns:conv="using:Avalonia.Data.Converters">
  <ControlTheme x:Key="AlderDisclosureIndicatorTheme" TargetType="PathIcon" BasedOn="{StaticResource AlderFittedPathIconTheme}">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="2" />
  </ControlTheme>

  <ControlTheme x:Key="AlderDisclosureTriggerTheme" TargetType="ToggleButton" BasedOn="{StaticResource AlderButtonTheme}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource AlderNeutral}" />
    <Setter Property="Foreground" Value="{DynamicResource AlderSoftInk}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <alder:ButtonFeedback Name="Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}" VerticalContentAlignment="Center" />
        </alder:ButtonFeedback>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover:not(:disabled), ^:focus-visible:not(:disabled), ^:pressed:not(:disabled)">
      <Setter Property="Background" Value="{DynamicResource AlderNeutralHover}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type alder:AlderDisclosure}" TargetType="alder:AlderDisclosure">
    <Setter Property="IndicatorIcon" Value="{StaticResource AlderIconChevronDown}" />
    <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="TriggerTheme" Value="{StaticResource AlderDisclosureTriggerTheme}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <alder:AlderToggleButton Name="PART_Trigger" Theme="{TemplateBinding TriggerTheme}"
                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        AutomationProperties.Name="{TemplateBinding (AutomationProperties.Name)}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <alder:AlderIconPresenter Content="{TemplateBinding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                        IsVisible="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                        IsHitTestVisible="False" />
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                VerticalContentAlignment="Center" TextBlock.LineHeight="20" TextBlock.TextWrapping="Wrap" />
              <Panel Name="IndicatorSlot" Grid.Column="2" Width="16" Height="16"
                     VerticalAlignment="Center" IsHitTestVisible="False"
                     IsVisible="{Binding #PART_Indicator.Data, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <alder:AlderPathIcon Name="PART_Indicator" Theme="{StaticResource AlderDisclosureIndicatorTheme}" />
              </Panel>
            </Grid>
          </alder:AlderToggleButton>
          <alder:AlderAccordionPanel Name="PART_Panel" ClipToBounds="True">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" FontSize="14" FontWeight="Normal" Foreground="{TemplateBinding Foreground}"
                              TextBlock.LineHeight="20" TextBlock.TextWrapping="Wrap" />
          </alder:AlderAccordionPanel>
          <Border Name="Separator" Height="1" Margin="0,-1,0,0" IsHitTestVisible="False" IsVisible="False"
                  Background="{DynamicResource AlderSeparator}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ Panel#IndicatorSlot"><Setter Property="Margin" Value="8,0,0,0" /></Style>
    <Style Selector="^ /template/ PathIcon#PART_Indicator">
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="0,0,0.2,1" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ alder|AlderAccordionPanel#PART_Panel">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Progress" Duration="0:0:0.2" Easing="0.25,0.46,0.45,0.94" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="0,0,0.2,1" />
        </Transitions>
      </Setter>
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="IsEnabled" Value="False" />
    </Style>
    <Style Selector="^:expanded /template/ alder|AlderAccordionPanel#PART_Panel">
      <Setter Property="Progress" Value="1" />
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="IsEnabled" Value="True" />
    </Style>
    <Style Selector="^ /template/ alder|AlderAccordionPanel[Progress=0] > ContentPresenter#PART_ContentPresenter">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[(alder|AlderMotion.Reduced)=True] /template/ alder|AlderAccordionPanel#PART_Panel,
                     ^[(alder|AlderMotion.Reduced)=True] /template/ PathIcon#PART_Indicator">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type alder:AlderDisclosureGroup}" TargetType="alder:AlderDisclosureGroup">
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
