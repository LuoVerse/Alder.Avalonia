<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:alder="using:Alder.Avalonia.Controls">
  <Styles.Resources>
    <ResourceDictionary>
      <x:String x:Key="AlderText.RichEditor">Rich text editor</x:String>
      <x:String x:Key="AlderText.RichPlaceholder">Start writing…</x:String>
      <x:String x:Key="AlderText.RichCounts">{0} characters, {1} words</x:String>
      <x:String x:Key="AlderText.RichCharacters">{0} characters</x:String>
      <x:String x:Key="AlderText.RichUndo">Undo</x:String>
      <x:String x:Key="AlderText.RichRedo">Redo</x:String>
      <x:String x:Key="AlderText.RichBold">Bold</x:String>
      <x:String x:Key="AlderText.RichItalic">Italic</x:String>
      <x:String x:Key="AlderText.RichUnderline">Underline</x:String>
      <x:String x:Key="AlderText.RichStrike">Strikethrough</x:String>
      <x:String x:Key="AlderText.RichCode">Inline code</x:String>
      <x:String x:Key="AlderText.RichHeading1">Heading 1</x:String>
      <x:String x:Key="AlderText.RichHeading2">Heading 2</x:String>
      <x:String x:Key="AlderText.RichHeading3">Heading 3</x:String>
      <x:String x:Key="AlderText.RichQuote">Blockquote</x:String>
      <x:String x:Key="AlderText.RichCodeBlock">Code block</x:String>
      <x:String x:Key="AlderText.RichBulletList">Bulleted list</x:String>
      <x:String x:Key="AlderText.RichOrderedList">Numbered list</x:String>
      <x:String x:Key="AlderText.RichLinkUrl">Link URL</x:String>
      <x:String x:Key="AlderText.RichLink">Link</x:String>
      <x:String x:Key="AlderText.RichClearFormatting">Clear formatting</x:String>
      <x:String x:Key="AlderText.RichClearContent">Clear content</x:String>
      <x:String x:Key="AlderText.RichNoCommands">No matching commands</x:String>
      <x:String x:Key="AlderText.RichRemove">Remove</x:String>
      <x:String x:Key="AlderText.RichApply">Apply</x:String>
      <x:String x:Key="AlderText.RichHeading1Hint">Large section title</x:String>
      <x:String x:Key="AlderText.RichHeading2Hint">Medium section title</x:String>
      <x:String x:Key="AlderText.RichHeading3Hint">Small section title</x:String>
      <x:String x:Key="AlderText.RichBulletListHint">Simple bulleted list</x:String>
      <x:String x:Key="AlderText.RichOrderedListHint">List with numbering</x:String>
      <x:String x:Key="AlderText.RichQuoteHint">Capture a quote or callout</x:String>
      <x:String x:Key="AlderText.RichCodeBlockHint">Preformatted code snippet</x:String>
