      <ControlTheme x:Key="AlderRichInput" TargetType="TextBox">
        <Setter Property="Template">
          <ControlTemplate>
            <alder:AlderScrollViewer Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <Panel>
                <alder:RichTextGutter Name="PART_Gutter" IsHitTestVisible="False" />
                <alder:RichTextPresenter Name="PART_TextPresenter"
                    Text="{TemplateBinding Text}" CaretIndex="{TemplateBinding CaretIndex}"
                    SelectionStart="{TemplateBinding SelectionStart}" SelectionEnd="{TemplateBinding SelectionEnd}"
                    CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}" TextWrapping="Wrap"
                    CaretBrush="{DynamicResource AlderInk}"
                    SelectionBrush="{DynamicResource AlderSelectionCardFill}" />
              </Panel>
            </alder:AlderScrollViewer>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="{x:Type alder:AlderRichTextEditor}" TargetType="alder:AlderRichTextEditor">
        <Setter Property="Background" Value="{DynamicResource AlderSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
        <Setter Property="FontSize" Value="14" /><Setter Property="CornerRadius" Value="16" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Placeholder" Value="{DynamicResource AlderText.RichPlaceholder}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Shell" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
              <Grid RowDefinitions="Auto,*,Auto,Auto">
                <WrapPanel Name="Tools" Margin="8">
                  <WrapPanel Name="PART_Commands" ItemSpacing="4" LineSpacing="4" />
                  <ContentPresenter Content="{TemplateBinding AdditionalToolbarContent}" />
                </WrapPanel>
                <Panel Grid.Row="1" Margin="16,12" MinHeight="112">
                  <alder:AlderInput Name="PART_Input" Theme="{StaticResource AlderRichInput}" AcceptsReturn="True" NewLine="&#10;"
                           TextWrapping="Wrap" IsUndoEnabled="False" FocusAdorner="{x:Null}"
                           ClearSelectionOnLostFocus="False"
                           FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                           Background="Transparent" IsReadOnly="{TemplateBinding IsReadOnly}" AutomationProperties.Name="{DynamicResource AlderText.RichEditor}" />
                  <alder:AlderTextBlock Name="PART_Placeholder" Margin="0,2" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource AlderMuted}"
                             TextWrapping="Wrap" IsHitTestVisible="False" />
                </Panel>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="12,0" MinHeight="40" Name="FooterPanel">
                  <alder:AlderTextBlock Text="{TemplateBinding Footer}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AlderMuted}" VerticalAlignment="Center" />
                  <alder:AlderTextBlock Name="PART_Count" VerticalAlignment="Center" Grid.Column="1" Margin="4,0,0,0" FontSize="12" Foreground="{DynamicResource AlderMuted}" IsVisible="{TemplateBinding ShowCharacterCount}" />
                </Grid>
                <alder:AlderPopup Name="PART_Popup" WindowManagerAddShadowHint="False" ShouldUseOverlayLayer="True"
                       TakesFocusFromNativeControl="False" PlacementConstraintAdjustment="FlipY,SlideX,SlideY" VerticalOffset="4" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^[Variant=Secondary]"><Setter Property="Background" Value="{DynamicResource AlderNeutral}" /></Style>
        <Style Selector="^[ToolbarAtBottom=True] /template/ WrapPanel#Tools"><Setter Property="Grid.Row" Value="2" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value=".5" /></Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector=":is(Button).rich-command, :is(Button).rich-suggestion">
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
    <Setter Property="CornerRadius" Value="16" /><Setter Property="Height" Value="32" /><Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Face" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=":is(Button).rich-command">
    <Setter Property="Focusable" Value="False" /><Setter Property="Width" Value="32" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Button).rich-suggestion"><Setter Property="Height" Value="48" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="8,4" /><Setter Property="CornerRadius" Value="24" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector=":is(Button).rich-command.tertiary"><Setter Property="Background" Value="{DynamicResource AlderNeutral}" /></Style>
  <Style Selector=":is(Button).rich-command:not(.rich-link):pointerover, :is(Button).rich-suggestion.active"><Setter Property="Background" Value="{DynamicResource AlderNeutral}" /></Style>
  <Style Selector=":is(Button).rich-command.active"><Setter Property="Background" Value="{DynamicResource AlderSelectionCardFill}" /><Setter Property="Foreground" Value="{DynamicResource AlderAccent}" /></Style>
  <Style Selector=":is(Button).rich-link.link-open">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
  </Style>
  <Style Selector=":is(Button).rich-link">
    <Setter Property="Template">
      <ControlTemplate>
        <alder:ButtonFeedback Name="LinkFace" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}">
          <Panel>
            <alder:ButtonTint Name="LinkTint" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"
                              Background="{DynamicResource AlderNeutral}" Opacity="0" />
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </alder:ButtonFeedback>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector=":is(Button).rich-link:pressed /template/ alder|ButtonFeedback#LinkFace">
    <Setter Property="PressScale" Value=".98" />
  </Style>
  <Style Selector=":is(Button).rich-link:pointerover:not(.active):not(:disabled) /template/ alder|ButtonTint#LinkTint,
                   :is(Button).rich-link.link-open /template/ alder|ButtonTint#LinkTint">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector=":is(Button).rich-command:disabled"><Setter Property="Opacity" Value=".4" /></Style>
  <Style Selector="Border.rich-popup">
    <Setter Property="CornerRadius" Value="12" /><Setter Property="Background" Value="{DynamicResource AlderSurface}" />
    <Setter Property="Padding" Value="6" /><Setter Property="Margin" Value="6" /><Setter Property="BoxShadow" Value="{DynamicResource AlderFieldShadow}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlderBorder}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.rich-popup.floating">
    <Setter Property="CornerRadius" Value="24" /><Setter Property="Padding" Value="4" /><Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBlock.over-limit"><Setter Property="Foreground" Value="{DynamicResource AlderDanger}" /></Style>
</Styles>
