<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alder="using:Alder.Avalonia.Controls">
  <LinearGradientBrush x:Key="AlderHoloCardBackground" StartPoint="-7.6%,4.3%" EndPoint="107.6%,95.7%">
    <GradientStop Color="#3A3730" Offset="0" />
    <GradientStop Color="#302F2C" Offset="0.18" />
    <GradientStop Color="#282829" Offset="0.38" />
    <GradientStop Color="#212226" Offset="0.58" />
    <GradientStop Color="#1A1B22" Offset="0.78" />
    <GradientStop Color="#12131C" Offset="1" />
  </LinearGradientBrush>
  <ControlTheme x:Key="{x:Type alder:AlderHoloCard}" TargetType="alder:AlderHoloCard">
    <Setter Property="Width" Value="302" />
    <Setter Property="Height" Value="453" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{StaticResource AlderHoloCardBackground}" />
    <Setter Property="Foreground" Value="#FAFAFF" />
    <Setter Property="InsetBrush" Value="#0FFFFFFF" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Border Name="PART_Rotator" ClipToBounds="False">
            <Panel>
              <Border Name="PART_Shadow" CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent"
                      BoxShadow="0 4 16 0 #1F000000, 0 12 32 0 #14000000" Opacity="0" IsHitTestVisible="False" />
              <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                <Grid>
                  <alder:AlderImage Source="{TemplateBinding ImageSource}" Stretch="{TemplateBinding ImageStretch}" IsHitTestVisible="False" />
                  <Border Name="PART_Inset" IsVisible="{TemplateBinding ShowInset}" Margin="8"
                          BorderBrush="{TemplateBinding InsetBrush}" BorderThickness="1" IsHitTestVisible="False" />
                  <alder:HoloCardEffects Name="PART_Effects" Pattern="{TemplateBinding Pattern}" ShinePattern="{TemplateBinding ShinePattern}"
                                         TextureOpacity="{TemplateBinding TextureOpacity}" ShineOpacity="{TemplateBinding ShineOpacity}"
                                         IsHitTestVisible="False" />
                  <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
              </Border>
            </Panel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
