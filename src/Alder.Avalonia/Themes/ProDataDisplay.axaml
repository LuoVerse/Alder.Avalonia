<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alder="using:Alder.Avalonia.Controls" xmlns:conv="using:Avalonia.Data.Converters">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <BoxShadows x:Key="AlderWidgetContentShadow">0 0 0 1 #08000000, 0 1 2 0 #0A000000</BoxShadows>
      <SolidColorBrush x:Key="AlderTimelineSuccessStroke" Color="#70D29C" />
      <SolidColorBrush x:Key="AlderTimelineWarningStroke" Color="#EABE79" />
      <SolidColorBrush x:Key="AlderTimelineDangerStroke" Color="#E79695" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <BoxShadows x:Key="AlderWidgetContentShadow">0 0 0 1 #08000000, 0 1 2 0 #0A000000</BoxShadows>
      <SolidColorBrush x:Key="AlderTimelineSuccessStroke" Color="#236941" />
      <SolidColorBrush x:Key="AlderTimelineWarningStroke" Color="#80561D" />
      <SolidColorBrush x:Key="AlderTimelineDangerStroke" Color="#8A3535" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <ControlTheme x:Key="AlderItemRowCommand" TargetType="Button">
    <Setter Property="Template">
      <ControlTemplate><Border Name="Feedback" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" /></ControlTemplate>
    </Setter>
    <Setter Property="Cursor" Value="Hand" />
    <Style Selector="^:pointerover /template/ Border#Feedback"><Setter Property="Background" Value="{DynamicResource AlderSurfaceSecondary}" /></Style>
    <Style Selector="^:pressed /template/ Border#Feedback"><Setter Property="Background" Value="{DynamicResource AlderNeutral}" /></Style>
    <Style Selector="^:focus-visible /template/ Border#Feedback">
      <Setter Property="BorderBrush" Value="{DynamicResource AlderAccent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type alder:AlderItemCard}" TargetType="alder:AlderItemCard">
    <Setter Property="Background" Value="{DynamicResource AlderSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlderBorder}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="alder:DataDisplaySurface.Shadow" Value="{DynamicResource AlderFieldShadow}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                BoxShadow="{CompiledBinding (alder:DataDisplaySurface.Shadow), RelativeSource={RelativeSource TemplatedParent}}">
          <Grid>
            <alder:AlderButton Theme="{StaticResource AlderItemRowCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    CornerRadius="{TemplateBinding CornerRadius}" Command="{TemplateBinding Command}" CommandParameter="{TemplateBinding CommandParameter}" IsVisible="{CompiledBinding Command, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                    AutomationProperties.Name="{TemplateBinding Title}" />
            <Grid Name="ItemLayout" Margin="{TemplateBinding Padding}" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
              <Border Name="IconPart" Background="{DynamicResource AlderSurfaceSecondary}" CornerRadius="9"
                      Width="38" Height="38" VerticalAlignment="Center" HorizontalAlignment="Left" IsVisible="{CompiledBinding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                      IsHitTestVisible="False">
                <ContentPresenter Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
              </Border>
              <StackPanel Name="ItemText" Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <alder:AlderTextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" IsHitTestVisible="False" IsVisible="{CompiledBinding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                <alder:AlderTextBlock Text="{TemplateBinding Description}" FontSize="13" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" IsHitTestVisible="False" IsVisible="{CompiledBinding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsVisible="{CompiledBinding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <ContentPresenter Name="ActionPart" Content="{TemplateBinding Action}" Grid.Column="2" VerticalAlignment="Center" ContentTemplate="{TemplateBinding ActionTemplate}" IsVisible="{CompiledBinding Action, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            </Grid>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[Variant=Secondary]"><Setter Property="Background" Value="{DynamicResource AlderSurfaceSecondary}" /></Style>
    <Style Selector="^[Variant=Tertiary]"><Setter Property="Background" Value="{DynamicResource AlderSurfaceTertiary}" /></Style>
    <Style Selector="^[Variant=Outline]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <!-- Avalonia positions the radius at the stroke centerline. The outside radius is 16. -->
      <Setter Property="CornerRadius" Value="15.5" />
    </Style>
    <Style Selector="^[Variant=Transparent]"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="^[Variant=Secondary], ^[Variant=Tertiary], ^[Variant=Outline], ^[Variant=Transparent]">
      <Setter Property="alder:DataDisplaySurface.Shadow" Value="none" />
    </Style>
    <Style Selector="^[Size=Small]"><Setter Property="Padding" Value="10,8" /></Style>
    <Style Selector="^[Size=Large]"><Setter Property="Padding" Value="18,16" /></Style>
    <Style Selector="^[Orientation=Vertical] /template/ Grid#ItemLayout">
      <Setter Property="RowSpacing" Value="8" />
    </Style>
    <Style Selector="^[Orientation=Vertical] /template/ StackPanel#ItemText"><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
    <Style Selector="^[Orientation=Vertical] /template/ ContentPresenter#ActionPart"><Setter Property="Grid.Row" Value="2" /><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /></Style>
    <Style Selector="^[(alder|DataDisplaySurface.IsGrouped)=True]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="alder:DataDisplaySurface.Shadow" Value="none" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type alder:AlderItemCardGroup}" TargetType="alder:AlderItemCardGroup">
    <Setter Property="Background" Value="{DynamicResource AlderSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlderBorder}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="alder:DataDisplaySurface.Shadow" Value="{DynamicResource AlderFieldShadow}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="GroupSurface" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{CompiledBinding (alder:DataDisplaySurface.Shadow), RelativeSource={RelativeSource TemplatedParent}}">
          <Border Name="GroupClip" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
            <StackPanel Margin="{TemplateBinding Padding}">
              <Grid Name="GroupHeader" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Grid.IsVisible>
                  <MultiBinding Converter="{x:Static conv:BoolConverters.Or}">
                    <Binding Path="Title" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static conv:StringConverters.IsNotNullOrEmpty}" />
                    <Binding Path="Description" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static conv:StringConverters.IsNotNullOrEmpty}" />
                    <Binding Path="Header" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
                  </MultiBinding>
                </Grid.IsVisible>
                <StackPanel VerticalAlignment="Center">
                  <alder:AlderTextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="16" LineHeight="20" TextWrapping="Wrap"
                             IsVisible="{CompiledBinding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  <alder:AlderTextBlock Text="{TemplateBinding Description}" FontSize="14" LineHeight="18" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap"
                             IsVisible="{CompiledBinding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <ContentPresenter Content="{TemplateBinding Header}" Grid.Column="1" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center"
                                  IsVisible="{CompiledBinding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              </Grid>
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </StackPanel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[Variant=Secondary]"><Setter Property="Background" Value="{DynamicResource AlderSurfaceSecondary}" /></Style>
    <Style Selector="^[Variant=Tertiary]"><Setter Property="Background" Value="{DynamicResource AlderSurfaceTertiary}" /></Style>
    <Style Selector="^[Variant=Outline]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15.5" />
    </Style>
    <Style Selector="^[Variant=Transparent]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^[Variant=Secondary], ^[Variant=Tertiary], ^[Variant=Outline], ^[Variant=Transparent], ^[Layout=Grid]">
      <Setter Property="alder:DataDisplaySurface.Shadow" Value="none" />
    </Style>
    <Style Selector="^[Layout=Grid]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="alder:DataDisplaySurface.IsGrouped" Value="False" />
    </Style>
    <Style Selector="^[Layout=Grid] /template/ Border#GroupClip, ^[Variant=Transparent] /template/ Border#GroupClip">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="^[Layout=List]"><Setter Property="alder:DataDisplaySurface.IsGrouped" Value="True" /></Style>
    <Style Selector="^ /template/ Grid#GroupHeader"><Setter Property="Margin" Value="16,16,16,8" /></Style>
    <Style Selector="^[Layout=Grid] /template/ Grid#GroupHeader"><Setter Property="Margin" Value="0,0,0,12" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type alder:AlderKpi}" TargetType="alder:AlderKpi">
    <Setter Property="Background" Value="{DynamicResource AlderSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlderBorder}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="alder:DataDisplaySurface.Shadow" Value="{DynamicResource AlderFieldShadow}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                ClipToBounds="False"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                BoxShadow="{CompiledBinding (alder:DataDisplaySurface.Shadow), RelativeSource={RelativeSource TemplatedParent}}">
          <StackPanel Spacing="11">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <ContentPresenter Content="{TemplateBinding Icon}" VerticalAlignment="Center" IsVisible="{CompiledBinding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              <alder:AlderTextBlock Text="{TemplateBinding Title}" Grid.Column="1" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource AlderMuted}" IsVisible="{CompiledBinding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
              <ContentPresenter Content="{TemplateBinding Actions}" Grid.Column="2" VerticalAlignment="Center" IsVisible="{CompiledBinding Actions, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            </Grid>
            <Border Container.Name="Metric" Container.Sizing="Width">
              <Grid Name="MetricContent" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <alder:AlderTextBlock Text="{TemplateBinding DisplayValue}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                <alder:AlderChip Name="TrendPart" Grid.Column="1" Content="{TemplateBinding Trend}" Size="Small"
                                Color="{TemplateBinding TrendColor}" Variant="Soft" VerticalAlignment="Center" HorizontalAlignment="Right"
                                IsVisible="{CompiledBinding Trend, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                <ContentPresenter Name="ChartPart" Content="{TemplateBinding Chart}" Grid.Row="1" Grid.ColumnSpan="2" ContentTemplate="{TemplateBinding ChartTemplate}" IsVisible="{CompiledBinding Chart, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              </Grid>
            </Border>
            <alder:AlderProgressBar Minimum="0" Maximum="100"
                                    Value="{CompiledBinding Progress, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=0}"
                                    IsVisible="{CompiledBinding Progress, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsVisible="{CompiledBinding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <StackPanel Name="KpiFooter" Spacing="10" IsVisible="{CompiledBinding Footer, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
              <Border Height="1" Background="{DynamicResource AlderSeparator}" IsVisible="{TemplateBinding ShowSeparator}" />
              <ContentPresenter Content="{TemplateBinding Footer}" ContentTemplate="{TemplateBinding FooterTemplate}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <ContainerQuery Name="Metric" Query="min-width:220">
      <Style Selector="^[ChartPlacement=Inline] /template/ alder|AlderChip#TrendPart"><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
      <Style Selector="^[ChartPlacement=Inline] /template/ ContentPresenter#ChartPart"><Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.RowSpan" Value="2" /><Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Width" Value="110" /></Style>
    </ContainerQuery>
    <Style Selector="^[(alder|DataDisplaySurface.IsGrouped)=True]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="alder:DataDisplaySurface.Shadow" Value="none" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type alder:AlderKpiGroup}" TargetType="alder:AlderKpiGroup">
    <Setter Property="Background" Value="{DynamicResource AlderSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlderBorder}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="alder:DataDisplaySurface.Shadow" Value="{DynamicResource AlderFieldShadow}" />
    <Setter Property="alder:DataDisplaySurface.IsGrouped" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="False"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                BoxShadow="{CompiledBinding (alder:DataDisplaySurface.Shadow), RelativeSource={RelativeSource TemplatedParent}}">
          <Border CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type alder:AlderListView}" TargetType="alder:AlderListView">
    <Setter Property="Background" Value="{DynamicResource AlderSurfaceSecondary}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource AlderProListViewItemTheme}" />
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
          <Border Name="ListSurface" Background="{DynamicResource AlderSurface}" CornerRadius="16" ClipToBounds="True">
            <alder:AlderScrollViewer Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </alder:AlderScrollViewer>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[Variant=Secondary]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="^[Variant=Secondary] /template/ Border#ListSurface">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="AlderProListViewItemTheme" TargetType="alder:AlderListViewItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="RowSurface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AlderSeparator}">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
            <alder:AlderCheckBox Name="SelectMark" Variant="Secondary" VerticalAlignment="Center"
                                 IsChecked="{TemplateBinding IsSelected, Mode=OneWay}"
                                 IsVisible="False" Focusable="False" IsHitTestVisible="False" IsReadOnly="True"
                                 AutomationProperties.AccessibilityView="Raw" />
            <ContentPresenter Content="{TemplateBinding Icon}" Grid.Column="1" VerticalAlignment="Center" IsVisible="{CompiledBinding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
              <alder:AlderTextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{CompiledBinding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
              <alder:AlderTextBlock Text="{TemplateBinding Description}" FontSize="12" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" IsVisible="{CompiledBinding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsVisible="{CompiledBinding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <ContentPresenter Content="{TemplateBinding Action}" Grid.Column="3" VerticalAlignment="Center" IsVisible="{CompiledBinding Action, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource AlderSurfaceSecondary}" /></Style>
    <Style Selector="^.selection-indicator /template/ alder|AlderCheckBox#SelectMark"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource AlderSurfaceSecondary}" /></Style>
    <Style Selector="^:focus-visible /template/ Border#RowSurface"><Setter Property="BorderBrush" Value="{DynamicResource AlderAccent}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value=".5" /></Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type alder:AlderListViewItem}" TargetType="alder:AlderListViewItem" BasedOn="{StaticResource AlderProListViewItemTheme}" />
  <ControlTheme x:Key="{x:Type alder:AlderTimeline}" TargetType="alder:AlderTimeline">
    <Setter Property="Template"><ControlTemplate><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" /></ControlTemplate></Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type alder:AlderTimelineItem}" TargetType="alder:AlderTimelineItem">
    <Setter Property="MarkerBrush" Value="{DynamicResource AlderMuted}" />
    <Setter Property="Template">
      <ControlTemplate>
        <alder:TimelineLayoutPanel Name="TimelineLayout">
          <Grid Name="PART_Rail" Width="22" RowDefinitions="0,Auto,*" IsHitTestVisible="False">
            <Border Name="Before" Width="2" Background="{DynamicResource AlderSeparator}" IsVisible="False" />
            <Border Name="After" Grid.Row="2" Width="2" Background="{DynamicResource AlderSeparator}" IsVisible="False" />
            <Panel Grid.Row="1" MinHeight="22">
              <Border Name="MarkerFrame" Width="22" Height="22" CornerRadius="11"
                      VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{DynamicResource AlderBorder}" BorderThickness="1"
                      IsVisible="{TemplateBinding ShowMarkerFrame}" />
              <Panel IsVisible="{TemplateBinding ShowMarkerDot}">
                <Ellipse Width="7" Height="7" Fill="{TemplateBinding MarkerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         IsVisible="{CompiledBinding Marker, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNull}}" />
              </Panel>
              <ContentPresenter Name="MarkerContent" Content="{TemplateBinding Marker}" Foreground="{TemplateBinding MarkerBrush}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            </Panel>
          </Grid>
          <StackPanel Name="Entry" Margin="10,0,10,16" Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Grid.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.Or}">
                  <Binding Path="Header" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static conv:ObjectConverters.IsNotNull}" />
                  <Binding Path="Time" RelativeSource="{RelativeSource TemplatedParent}" Converter="{x:Static conv:StringConverters.IsNotNullOrEmpty}" />
                </MultiBinding>
              </Grid.IsVisible>
              <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" FontWeight="Medium"
                                VerticalContentAlignment="Center" MinHeight="20" TextBlock.TextWrapping="Wrap"
                                IsVisible="{CompiledBinding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              <alder:AlderTextBlock Text="{TemplateBinding Time}" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AlderMuted}" VerticalAlignment="Center"
                         IsVisible="{CompiledBinding Time, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
            <alder:AlderTextBlock Text="{TemplateBinding Description}" Foreground="{DynamicResource AlderMuted}" FontSize="12" LineHeight="20" TextWrapping="Wrap" IsVisible="{CompiledBinding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsVisible="{CompiledBinding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          </StackPanel>
          <ContentPresenter Name="LeadingContext" Content="{TemplateBinding LeadingContent}" ContentTemplate="{TemplateBinding LeadingContentTemplate}"
                            Margin="10,0,10,16" HorizontalContentAlignment="Right" IsVisible="False" />
        </alder:TimelineLayoutPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.connect-before /template/ Border#Before"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^.connect-after /template/ Border#After"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^[ShowMarkerFrame=False] /template/ ContentPresenter#MarkerContent"><Setter Property="Margin" Value="-3,0" /></Style>
    <Style Selector="^.centered /template/ alder|TimelineLayoutPanel#TimelineLayout"><Setter Property="Alignment" Value="Center" /></Style>
    <Style Selector="^.centered /template/ ContentPresenter#LeadingContext:not(:empty)"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^.trailing-rail /template/ alder|TimelineLayoutPanel#TimelineLayout"><Setter Property="Alignment" Value="End" /></Style>
    <Style Selector="^.leading-entry /template/ alder|TimelineLayoutPanel#TimelineLayout"><Setter Property="BeforeRail" Value="True" /></Style>
    <Style Selector="^.compact /template/ StackPanel#Entry, ^.compact /template/ ContentPresenter#LeadingContext"><Setter Property="Margin" Value="10,0,10,12" /></Style>
    <Style Selector="^.spacious /template/ StackPanel#Entry"><Setter Property="Margin" Value="12,2,12,24" /></Style>
    <Style Selector="^.last-entry /template/ StackPanel#Entry, ^.last-entry /template/ ContentPresenter#LeadingContext"><Setter Property="Margin" Value="10,0" /></Style>
    <Style Selector="^.centered /template/ StackPanel#Entry"><Setter Property="Margin" Value="10,0,0,16" /></Style>
    <Style Selector="^.centered.leading-entry /template/ StackPanel#Entry"><Setter Property="Margin" Value="0,0,10,16" /></Style>
    <Style Selector="^.centered.compact /template/ StackPanel#Entry"><Setter Property="Margin" Value="10,0,0,12" /></Style>
    <Style Selector="^.centered.compact.leading-entry /template/ StackPanel#Entry"><Setter Property="Margin" Value="0,0,10,12" /></Style>
    <Style Selector="^.centered.last-entry /template/ StackPanel#Entry"><Setter Property="Margin" Value="10,0,0,0" /></Style>
    <Style Selector="^.centered.last-entry.leading-entry /template/ StackPanel#Entry"><Setter Property="Margin" Value="0,0,10,0" /></Style>
    <Style Selector="^[MarkerColor=Accent]"><Setter Property="MarkerBrush" Value="{DynamicResource AlderAccent}" /></Style>
    <Style Selector="^[MarkerColor=Accent] /template/ Border#MarkerFrame">
      <Setter Property="Background" Value="{DynamicResource AlderSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlderAccent}" />
    </Style>
    <Style Selector="^[MarkerColor=Success]"><Setter Property="MarkerBrush" Value="#17C964" /></Style>
    <Style Selector="^[MarkerColor=Success] /template/ Border#MarkerFrame">
      <Setter Property="Background" Value="{DynamicResource AlderAvatarSuccessSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlderTimelineSuccessStroke}" />
    </Style>
    <Style Selector="^[MarkerColor=Warning]"><Setter Property="MarkerBrush" Value="#F5A524" /></Style>
    <Style Selector="^[MarkerColor=Warning] /template/ Border#MarkerFrame">
      <Setter Property="Background" Value="{DynamicResource AlderAvatarWarningSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlderTimelineWarningStroke}" />
    </Style>
    <Style Selector="^[MarkerColor=Danger]"><Setter Property="MarkerBrush" Value="{DynamicResource AlderDanger}" /></Style>
    <Style Selector="^[MarkerColor=Danger] /template/ Border#MarkerFrame">
      <Setter Property="Background" Value="{DynamicResource AlderDangerSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlderTimelineDangerStroke}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type alder:AlderWidget}" TargetType="alder:AlderWidget" BasedOn="{StaticResource {x:Type alder:AlderSurface}}">
    <Setter Property="Padding" Value="6,2,6,6" />
    <Setter Property="ContentPadding" Value="16" />
    <Setter Property="Background" Value="{DynamicResource AlderSurfaceSecondary}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" BoxShadow="{TemplateBinding BoxShadow}" CornerRadius="{TemplateBinding CornerRadius}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="10,0" MinHeight="32">
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsVisible="{CompiledBinding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                <alder:AlderTextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" IsVisible="{CompiledBinding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                <alder:AlderTextBlock Text="{TemplateBinding Description}" FontSize="13" Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap" IsVisible="{CompiledBinding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ContentPresenter Content="{TemplateBinding Legend}" ContentTemplate="{TemplateBinding LegendTemplate}" IsVisible="{CompiledBinding Legend, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                <ContentPresenter Content="{TemplateBinding Actions}" IsVisible="{CompiledBinding Actions, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </Grid>
            <Border Name="ContentSurface" Background="{DynamicResource AlderSurface}" CornerRadius="12" ClipToBounds="False"
                    BoxShadow="{DynamicResource AlderWidgetContentShadow}">
              <Border Name="ContentClip" CornerRadius="12" ClipToBounds="{TemplateBinding ClipContent}" Padding="{TemplateBinding ContentPadding}">
                <Grid>
                  <alder:AlderProgressBar Name="Loading" IsVisible="{TemplateBinding IsLoading}" IsIndeterminate="True" />
                  <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    IsVisible="{CompiledBinding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                  <ContentPresenter Name="Empty" Content="{TemplateBinding EmptyContent}" IsVisible="{CompiledBinding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNull}}" />
                </Grid>
              </Border>
            </Border>
            <ContentPresenter Content="{TemplateBinding Footer}" ContentTemplate="{TemplateBinding FooterTemplate}" IsVisible="{CompiledBinding Footer, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsLoading=True] /template/ ContentPresenter#PART_ContentPresenter, ^[IsLoading=True] /template/ ContentPresenter#Empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
