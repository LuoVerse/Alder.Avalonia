<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alder="using:Alder.Avalonia.Controls"
                    xmlns:c="using:Avalonia.Data.Converters">
  <x:String x:Key="AlderText.StepperProgress">Progress</x:String>
  <x:String x:Key="AlderText.StepperActive">Current step</x:String>
  <x:String x:Key="AlderText.StepperComplete">Completed</x:String>
  <x:String x:Key="AlderText.StepperInactive">Upcoming</x:String>
  <ControlTheme x:Key="{x:Type alder:AlderStepper}" TargetType="alder:AlderStepper">
    <Setter Property="AccentBrush" Value="{DynamicResource AlderAccent}" />
    <Setter Property="OnAccentBrush" Value="{DynamicResource AlderOnAccent}" />
    <Setter Property="CompletedIcon" Value="{StaticResource AlderIconCheck}" />
    <Setter Property="AutomationProperties.Name" Value="{DynamicResource AlderText.StepperProgress}" />
    <Setter Property="AutomationProperties.ControlTypeOverride" Value="List" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate><ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" /></ControlTemplate>
    </Setter>
    <Style Selector="^[Orientation=Vertical]">
      <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter>
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type alder:AlderStepperStep}" TargetType="alder:AlderStepperStep">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="AutomationProperties.HelpText" Value="{CompiledBinding Description, RelativeSource={RelativeSource Self}, x:DataType=alder:AlderStepperStep}" />
    <Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource AlderText.StepperInactive}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Name="StepLayout" ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*" Background="{TemplateBinding Background}">
          <alder:AlderStepperRail Name="LeadingRail" Segment="Leading" Height="2" VerticalAlignment="Center" IsHitTestVisible="False"
                                 TrackBrush="{DynamicResource AlderSeparator}" FillBrush="{TemplateBinding StepAccent}" />
          <alder:AlderStepperRail Name="TrailingRail" Segment="Trailing" Grid.Column="2" Height="2" VerticalAlignment="Center" IsHitTestVisible="False"
                                 TrackBrush="{DynamicResource AlderSeparator}" FillBrush="{TemplateBinding StepAccent}" />
          <Border Name="Indicator" Grid.Column="1" Width="28" Height="28" CornerRadius="20" BorderThickness="2"
                  BorderBrush="{DynamicResource AlderBorder}" VerticalAlignment="Top">
            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
            <Panel>
              <alder:AlderTextBlock Name="Number" Text="{TemplateBinding Number}" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AlderMuted}" />
              <alder:AlderPathIcon Name="Glyph" Data="{TemplateBinding DisplayIcon}" Width="14" Height="14" FlowDirection="LeftToRight"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AlderMuted}" IsVisible="False" />
              <Border Name="Dot" Width="7" Height="7" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource AlderMuted}" IsVisible="False" />
              <ContentPresenter Name="CustomIndicator" Content="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                ContentTemplate="{TemplateBinding IndicatorTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
            </Panel>
          </Border>
          <Grid Name="Labels" Grid.Row="1" Grid.ColumnSpan="3" Margin="3,6,3,0" ColumnDefinitions="*,Auto">
            <StackPanel Name="Copy" Spacing="2">
              <alder:AlderTextBlock Name="Title" Text="{TemplateBinding Title}" FontWeight="Medium" TextAlignment="Center"
                         Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap"
                         IsVisible="{CompiledBinding Title, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}" />
              <alder:AlderTextBlock Name="Description" Text="{TemplateBinding Description}" TextAlignment="Center"
                         Foreground="{DynamicResource AlderMuted}" TextWrapping="Wrap"
                         IsVisible="{CompiledBinding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:StringConverters.IsNotNullOrEmpty}}" />
              <ContentPresenter Name="ItemContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" />
            </StackPanel>
            <ContentPresenter Name="TrailingContent" Grid.Column="1" Content="{TemplateBinding TrailingContent}"
                              VerticalAlignment="Top" Margin="8,0,0,0"
                              IsVisible="{CompiledBinding TrailingContent, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:ObjectConverters.IsNotNull}}" />
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:display-only">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="^:small">
      <Setter Property="FontSize" Value="11" />
      <Style Selector="^ /template/ Border#Indicator"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /></Style>
      <Style Selector="^ /template/ PathIcon#Glyph"><Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" /></Style>
    </Style>
    <Style Selector="^:large">
      <Setter Property="FontSize" Value="14" />
      <Style Selector="^ /template/ Border#Indicator"><Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /></Style>
      <Style Selector="^ /template/ PathIcon#Glyph"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /></Style>
    </Style>
    <Style Selector="^:first /template/ alder|AlderStepperRail#LeadingRail, ^:last /template/ alder|AlderStepperRail#TrailingRail, ^:vertical /template/ alder|AlderStepperRail#LeadingRail">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:vertical /template/ Border#Indicator"><Setter Property="Grid.Column" Value="0" /></Style>
    <Style Selector="^:vertical /template/ alder|AlderStepperRail#TrailingRail">
      <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="0" />
      <Setter Property="Segment" Value="Vertical" />
      <Setter Property="Height" Value="NaN" /><Setter Property="Width" Value="2" />
      <Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:vertical /template/ Grid#Labels">
      <Setter Property="Grid.Row" Value="0" /><Setter Property="Grid.RowSpan" Value="2" />
      <Setter Property="Grid.Column" Value="1" /><Setter Property="Grid.ColumnSpan" Value="1" />
      <Setter Property="Margin" Value="10,1,0,16" />
    </Style>
    <Style Selector="^:vertical:small /template/ Grid#Labels"><Setter Property="Margin" Value="8,0,0,12" /></Style>
    <Style Selector="^:vertical:large /template/ Grid#Labels"><Setter Property="Margin" Value="12,1,0,24" /></Style>
    <Style Selector="^:vertical:last /template/ Grid#Labels"><Setter Property="Margin" Value="10,1,0,0" /></Style>
    <Style Selector="^:vertical /template/ TextBlock#Title, ^:vertical /template/ TextBlock#Description"><Setter Property="TextAlignment" Value="Start" /></Style>
    <Style Selector="^:vertical /template/ ContentPresenter#ItemContent"><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    <Style Selector="^:icon /template/ PathIcon#Glyph, ^:bullet /template/ Border#Dot, ^:custom-indicator /template/ ContentPresenter#CustomIndicator">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:icon /template/ TextBlock#Number, ^:bullet /template/ TextBlock#Number, ^:custom-indicator /template/ TextBlock#Number,
                     ^:custom-indicator /template/ PathIcon#Glyph, ^:custom-indicator /template/ Border#Dot">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[Status=Active]"><Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource AlderText.StepperActive}" /></Style>
    <Style Selector="^[Status=Complete]"><Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource AlderText.StepperComplete}" /></Style>
    <Style Selector="^[Status=Active] /template/ TextBlock#Title, ^[Status=Complete] /template/ TextBlock#Title">
      <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
    </Style>
    <Style Selector="^[Status=Active] /template/ Border#Indicator, ^[Status=Complete] /template/ Border#Indicator">
      <Setter Property="BorderBrush" Value="{CompiledBinding StepAccent, RelativeSource={RelativeSource AncestorType=alder:AlderStepperStep}}" />
    </Style>
    <Style Selector="^[Status=Complete] /template/ Border#Indicator">
      <Setter Property="Background" Value="{CompiledBinding StepAccent, RelativeSource={RelativeSource AncestorType=alder:AlderStepperStep}}" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #1A000000, 0 1 2 -1 #1A000000" />
    </Style>
    <Style Selector="^[Status=Complete] /template/ alder|AlderStepperRail#TrailingRail,
                     ^[Status=Complete] /template/ alder|AlderStepperRail#LeadingRail, ^[Status=Active] /template/ alder|AlderStepperRail#LeadingRail">
      <Setter Property="Progress" Value="1" />
    </Style>
    <Style Selector="^[Status=Active] /template/ TextBlock#Number">
      <Setter Property="Foreground" Value="{CompiledBinding StepAccent, RelativeSource={RelativeSource AncestorType=alder:AlderStepperStep}}" />
    </Style>
    <Style Selector="^[Status=Active] /template/ PathIcon#Glyph">
      <Setter Property="Foreground" Value="{CompiledBinding StepAccent, RelativeSource={RelativeSource AncestorType=alder:AlderStepperStep}}" />
    </Style>
    <Style Selector="^[Status=Complete] /template/ TextBlock#Number">
      <Setter Property="Foreground" Value="{CompiledBinding StepOnAccent, RelativeSource={RelativeSource AncestorType=alder:AlderStepperStep}}" />
    </Style>
    <Style Selector="^[Status=Complete] /template/ PathIcon#Glyph">
      <Setter Property="Foreground" Value="{CompiledBinding StepOnAccent, RelativeSource={RelativeSource AncestorType=alder:AlderStepperStep}}" />
    </Style>
    <Style Selector="^[Status=Active] /template/ Border#Dot">
      <Setter Property="Background" Value="{CompiledBinding StepAccent, RelativeSource={RelativeSource AncestorType=alder:AlderStepperStep}}" />
    </Style>
    <Style Selector="^[Status=Complete] /template/ Border#Dot">
      <Setter Property="Background" Value="{CompiledBinding StepOnAccent, RelativeSource={RelativeSource AncestorType=alder:AlderStepperStep}}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#Indicator">
      <Setter Property="BoxShadow" Value="{DynamicResource AlderFocusShadow}" />
    </Style>
    <Style Selector="^:pointerover:not(:display-only) /template/ TextBlock#Title">
      <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
    </Style>
    <Style Selector="^:disabled /template/ Grid#StepLayout"><Setter Property="Opacity" Value="0.5" /></Style>
    <Style Selector="^[(alder|AlderMotion.Reduced)=False] /template/ alder|AlderStepperRail#LeadingRail,
                     ^[(alder|AlderMotion.Reduced)=False] /template/ alder|AlderStepperRail#TrailingRail">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Progress" Duration="0:0:0.3" Easing="0.25,0.1,0.25,1" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^[(alder|AlderMotion.Reduced)=False] /template/ TextBlock#Title">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Foreground" Duration="0:0:0.3" /></Transitions></Setter>
    </Style>
    <Style Selector="^[Status=Complete][(alder|AlderMotion.Reduced)=False] /template/ Border#Indicator">
      <Style.Animations>
        <Animation Duration="0:0:0.24">
          <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.94" /><Setter Property="ScaleTransform.ScaleY" Value="0.94" /></KeyFrame>
          <KeyFrame Cue="45%"><Setter Property="ScaleTransform.ScaleX" Value="1.11" /><Setter Property="ScaleTransform.ScaleY" Value="1.11" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>
</ResourceDictionary>
