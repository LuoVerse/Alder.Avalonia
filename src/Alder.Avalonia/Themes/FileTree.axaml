<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alder="using:Alder.Avalonia.Controls" xmlns:conv="using:Avalonia.Data.Converters">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AlderFileTreeRowRest" Color="#00EBEBEC" />
      <BoxShadows x:Key="AlderFileTreeDragShadow">0 4 12 0 #0C000000, 0 15 42 5 #2B000000</BoxShadows>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AlderFileTreeRowRest" Color="#0027272A" />
      <BoxShadows x:Key="AlderFileTreeDragShadow">0 4 12 0 #26000000, 0 15 42 5 #66000000</BoxShadows>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <x:String x:Key="AlderText.FileTreeEmpty">No files</x:String>
  <x:String x:Key="AlderText.FileTreeExpand">Expand or collapse folder</x:String>
  <x:String x:Key="AlderText.FileTreeSelect">Select item</x:String>
  <x:String x:Key="AlderText.FileTreeMove">Move item</x:String>
  <StreamGeometry x:Key="AlderFileTreeFolderIcon">F0 M0 3 A1 1 0 0 1 1 2 H6 L8 4 H15 A1 1 0 0 1 16 5 V13 A1 1 0 0 1 15 14 H1 A1 1 0 0 1 0 13 Z M1.4 3.4 V12.6 H14.6 V5.4 H7.4 L5.4 3.4 Z</StreamGeometry>
  <StreamGeometry x:Key="AlderFileTreeFileIcon">F0 M2 0 H9 L14 5 V14 A1 1 0 0 1 13 15 H2 A1 1 0 0 1 1 14 V1 A1 1 0 0 1 2 0 Z M2.4 1.4 V13.6 H12.6 V6 H8 V1.4 Z M9.4 2 V4.6 H12 Z</StreamGeometry>
  <StreamGeometry x:Key="AlderFileTreeGripIcon">M3 2 A1 1 0 1 1 1 2 A1 1 0 1 1 3 2 M7 2 A1 1 0 1 1 5 2 A1 1 0 1 1 7 2 M3 6 A1 1 0 1 1 1 6 A1 1 0 1 1 3 6 M7 6 A1 1 0 1 1 5 6 A1 1 0 1 1 7 6 M3 10 A1 1 0 1 1 1 10 A1 1 0 1 1 3 10 M7 10 A1 1 0 1 1 5 10 A1 1 0 1 1 7 10</StreamGeometry>

  <StreamGeometry x:Key="AlderFileTreeFolderOpenIcon">F0 M1 3 H6.5 L8.5 5 H14 A1 1 0 0 1 15 6 V7 H16 A.8 .8 0 0 1 16.7 8.1 L14.7 13.4 A1 1 0 0 1 13.8 14 H2 A1.5 1.5 0 0 1 .5 12.5 V4 A1 1 0 0 1 1 3 Z M2 4.3 V10.8 L3.4 7 H13.7 V6.3 H8 L6 4.3 Z M4.3 8.3 L2.7 12.7 H13.6 L15.3 8.3 Z</StreamGeometry>
  <StreamGeometry x:Key="AlderFileTreeSourceIcon">F0 M3 1 H9 L13.5 5.5 V13.5 A1.5 1.5 0 0 1 12 15 H3 A1.5 1.5 0 0 1 1.5 13.5 V2.5 A1.5 1.5 0 0 1 3 1 Z M3 2.2 A.3 .3 0 0 0 2.7 2.5 V13.5 A.3 .3 0 0 0 3 13.8 H12 A.3 .3 0 0 0 12.3 13.5 V6 H8.6 V2.2 Z M9.8 2.7 V4.8 H11.9 Z M5.6 7.6 L6.4 8.4 L5.3 9.5 L6.4 10.6 L5.6 11.4 L3.7 9.5 Z M9.4 7.6 L11.3 9.5 L9.4 11.4 L8.6 10.6 L9.7 9.5 L8.6 8.4 Z</StreamGeometry>
  <StreamGeometry x:Key="AlderFileTreeMarkupIcon">M4.3 4.2 L.5 8 L4.3 11.8 L5.4 10.7 L2.7 8 L5.4 5.3 Z M11.7 4.2 L15.5 8 L11.7 11.8 L10.6 10.7 L13.3 8 L10.6 5.3 Z M9.9 2.7 L11.1 3.2 L6.1 13.3 L4.9 12.8 Z</StreamGeometry>
  <StreamGeometry x:Key="AlderFileTreeConfigIcon">M5.5 1.5 H4 A2 2 0 0 0 2 3.5 V6 A1.2 1.2 0 0 1 .8 7.2 H0 V8.8 H.8 A1.2 1.2 0 0 1 2 10 V12.5 A2 2 0 0 0 4 14.5 H5.5 V13 H4 A.5 .5 0 0 1 3.5 12.5 V10 A2.6 2.6 0 0 0 2.6 8 A2.6 2.6 0 0 0 3.5 6 V3.5 A.5 .5 0 0 1 4 3 H5.5 Z M10.5 1.5 H12 A2 2 0 0 1 14 3.5 V6 A1.2 1.2 0 0 0 15.2 7.2 H16 V8.8 H15.2 A1.2 1.2 0 0 0 14 10 V12.5 A2 2 0 0 1 12 14.5 H10.5 V13 H12 A.5 .5 0 0 0 12.5 12.5 V10 A2.6 2.6 0 0 1 13.4 8 A2.6 2.6 0 0 1 12.5 6 V3.5 A.5 .5 0 0 0 12 3 H10.5 Z</StreamGeometry>
  <StreamGeometry x:Key="AlderFileTreeTextIcon">F0 M3 1 H9 L14 6 V13.5 A1.5 1.5 0 0 1 12.5 15 H3 A1.5 1.5 0 0 1 1.5 13.5 V2.5 A1.5 1.5 0 0 1 3 1 Z M3 2.2 A.3 .3 0 0 0 2.7 2.5 V13.5 A.3 .3 0 0 0 3 13.8 H12.5 A.3 .3 0 0 0 12.8 13.5 V6.5 H8.5 V2.2 Z M9.7 2.8 V5.3 H12.2 Z M4.5 8 H11 V9.2 H4.5 Z M4.5 10.6 H9.5 V11.8 H4.5 Z</StreamGeometry>
  <StreamGeometry x:Key="AlderFileTreeCaretIcon">M4.5 3.5 Q4.5 2.5 5.5 3 L11.5 7.2 Q12.7 8 11.5 8.8 L5.5 13 Q4.5 13.5 4.5 12.5 Z</StreamGeometry>

  <ControlTheme x:Key="AlderFileTreeDragPreviewTheme" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource AlderNeutral}" />
    <Setter Property="Opacity" Value="0.9" />
    <Setter Property="BoxShadow" Value="{DynamicResource AlderFileTreeDragShadow}" />
  </ControlTheme>

  <TreeDataTemplate x:Key="AlderFileTreeNodeTemplate" DataType="alder:AlderFileTreeNode" ItemsSource="{CompiledBinding Children}">
    <alder:AlderTextBlock Text="{CompiledBinding Title}" TextTrimming="CharacterEllipsis" />
  </TreeDataTemplate>

  <ControlTheme x:Key="AlderFileTreeIndicatorTheme" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Width="16" MinHeight="24">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type alder:AlderFileTreeItem}" TargetType="alder:AlderFileTreeItem">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <Border Name="PART_Row" MinHeight="28" Padding="8,0" Background="{DynamicResource AlderFileTreeRowRest}" CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Styles>
              <Style Selector="Border#PART_Row:pointerover"><Setter Property="Background" Value="{DynamicResource AlderNeutral}" /></Style>
              <Style Selector="Border#PART_Row:pointerover Border#PART_DragHandle">
                <Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" />
              </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="{TemplateBinding RowIndent}">
              <Border Name="PART_DragHandle" MinWidth="16" Background="Transparent" Cursor="SizeAll" Opacity="0"
                      IsHitTestVisible="False" AutomationProperties.Name="{DynamicResource AlderText.FileTreeMove}"
                      IsVisible="{TemplateBinding MoveCommand, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <alder:AlderPathIcon Data="{StaticResource AlderFileTreeGripIcon}" Width="7" Height="10" Foreground="{DynamicResource AlderMuted}" />
              </Border>
              <alder:AlderCheckBox Name="PART_Selection" Grid.Column="1" Margin="2,0,4,0" Focusable="False"
                                   AutomationProperties.Name="{DynamicResource AlderText.FileTreeSelect}" IsVisible="{TemplateBinding ShowSelectionCheckboxes}"
                                   IsChecked="{TemplateBinding IsSelected, Mode=OneWay}" />
              <Panel Grid.Column="2" Width="20">
                <alder:AlderToggleButton Name="Chevron" Theme="{StaticResource AlderFileTreeIndicatorTheme}"
                              AutomationProperties.Name="{DynamicResource AlderText.FileTreeExpand}" IsVisible="False"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                  <alder:AlderPathIcon Name="Indicator" Theme="{StaticResource AlderFittedPathIconTheme}" Data="{TemplateBinding IndicatorIcon}"
                                      Width="12" Height="12" Foreground="{DynamicResource AlderMuted}" />
                </alder:AlderToggleButton>
              </Panel>
              <Panel Grid.Column="3" Margin="1,0,4,0" IsVisible="{TemplateBinding ShowIcons}">
                <alder:AlderPathIcon Name="DefaultIcon" Width="16" Height="16" IsVisible="{TemplateBinding DisplayIcon, Converter={x:Static conv:ObjectConverters.IsNull}}" Foreground="{DynamicResource AlderMuted}" Data="{StaticResource AlderFileTreeFileIcon}" />
                <alder:AlderIconPresenter Name="CustomIcon" Foreground="{DynamicResource AlderMuted}" Content="{TemplateBinding DisplayIcon}"
                          IsVisible="{TemplateBinding DisplayIcon, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
              </Panel>
              <ContentPresenter Name="PART_HeaderPresenter" Grid.Column="4" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="5" Content="{TemplateBinding Badge}" VerticalAlignment="Center" Foreground="{DynamicResource AlderMuted}" />
              <Border Name="DropBefore" Grid.ColumnSpan="6" Height="2" CornerRadius="1" VerticalAlignment="Top" Background="{DynamicResource AlderAccent}" IsVisible="False" IsHitTestVisible="False" />
              <Border Name="DropAfter" Grid.ColumnSpan="6" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Background="{DynamicResource AlderAccent}" IsVisible="False" IsHitTestVisible="False" />
            </Grid>
          </Border>
          <alder:AlderAccordionPanel Name="Subtree" ClipToBounds="True" IsEnabled="False" IsHitTestVisible="False">
            <Grid Name="SubtreeContent">
              <Border Name="Guide" Width="1" Margin="{TemplateBinding GuideIndent}" HorizontalAlignment="Left" Background="{DynamicResource AlderSeparator}"
                      IsVisible="{TemplateBinding ShowGuides}" />
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Grid>
          </alder:AlderAccordionPanel>
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected /template/ Border#PART_Row"><Setter Property="Background" Value="{DynamicResource AlderNeutral}" /></Style>
    <Style Selector="^:focus-visible /template/ Border#PART_Row"><Setter Property="Background" Value="{DynamicResource AlderNeutralHover}" /></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    <Style Selector="^:branch /template/ :is(ToggleButton)#Chevron"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="^:branch /template/ :is(PathIcon)#DefaultIcon"><Setter Property="Data" Value="{StaticResource AlderFileTreeFolderIcon}" /></Style>
    <Style Selector="^:branch[IsExpanded=True] /template/ :is(PathIcon)#DefaultIcon"><Setter Property="Data" Value="{StaticResource AlderFileTreeFolderOpenIcon}" /></Style>
    <Style Selector="^[IsExpanded=True] /template/ :is(PathIcon)#Indicator"><Setter Property="RenderTransform" Value="rotate(90deg)" /></Style>
    <Style Selector="^[IsExpanded=True] /template/ alder|AlderAccordionPanel#Subtree">
      <Setter Property="Progress" Value="1" /><Setter Property="IsEnabled" Value="True" /><Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="^ /template/ alder|AlderAccordionPanel#Subtree[Progress=0] > Grid#SubtreeContent">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^[(alder|AlderMotion.Reduced)=False] /template/ alder|AlderAccordionPanel#Subtree">
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Progress" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions></Setter>
    </Style>
    <Style Selector="^[(alder|AlderMotion.Reduced)=False] /template/ :is(PathIcon)#Indicator">
      <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" /></Transitions></Setter>
    </Style>
    <Style Selector="^ /template/ alder|AlderIconPresenter#CustomIcon">
      <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="^[Size=Small] /template/ alder|AlderIconPresenter#CustomIcon">
      <Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="^[Size=Large] /template/ alder|AlderIconPresenter#CustomIcon">
      <Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="^[Size=Small]"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="^[Size=Small] /template/ Border#PART_Row"><Setter Property="MinHeight" Value="24" /></Style>
    <Style Selector="^[Size=Large]"><Setter Property="FontSize" Value="16" /></Style>
    <Style Selector="^[Size=Large] /template/ Border#PART_Row"><Setter Property="MinHeight" Value="32" /></Style>
    <Style Selector="^[IsSection=True]"><Setter Property="Focusable" Value="False" /></Style>
    <Style Selector="^[IsSection=True] /template/ Border#PART_Row">
      <Setter Property="IsHitTestVisible" Value="False" /><Setter Property="TextElement.Foreground" Value="{DynamicResource AlderMuted}" />
      <Setter Property="TextElement.FontSize" Value="12" />
    </Style>
    <Style Selector="^[IsSection=True] /template/ :is(ToggleButton)#Chevron, ^[IsSection=True] /template/ Border#Guide,
                     ^[IsSection=True] /template/ alder|AlderCheckBox#PART_Selection, ^[IsSection=True] /template/ Border#PART_DragHandle">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_DragHandle, ^.drag-grip-visible /template/ Border#PART_DragHandle">
      <Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="^[(alder|AlderMotion.Reduced)=False] /template/ Border#PART_Row">
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.13" /><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="^.dragging /template/ Border#PART_Row">
      <Setter Property="Background" Value="{DynamicResource AlderNeutral}" />
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^:drop-into /template/ Border#PART_Row">
      <Setter Property="Background" Value="{DynamicResource AlderSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource AlderAccent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^:drop-before /template/ Border#DropBefore, ^:drop-after /template/ Border#DropAfter"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type alder:AlderFileTree}" TargetType="alder:AlderFileTree">
    <Setter Property="Padding" Value="4" />
    <!-- Measure nearby roots across the viewport edge when expanded branches vary in height. -->
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate></Setter>
    <Setter Property="IndicatorIcon" Value="{StaticResource AlderIconChevronRight}" />
    <Setter Property="ItemTemplate" Value="{StaticResource AlderFileTreeNodeTemplate}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource {x:Type alder:AlderFileTreeItem}}" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <alder:AlderFileTreeScrollViewer Padding="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Disabled">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </alder:AlderFileTreeScrollViewer>
          <alder:AlderTextBlock Name="Placeholder" IsVisible="False" Foreground="{DynamicResource AlderMuted}" FontStyle="Italic"
                     Text="{DynamicResource AlderText.FileTreeEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:empty /template/ TextBlock#Placeholder"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>
</ResourceDictionary>
