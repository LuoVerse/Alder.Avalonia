<Styles xmlns="https://github.com/avaloniaui" xmlns:alder="using:Alder.Avalonia.Controls">
  <Style Selector="alder|AlderProse > TextBlock, alder|AlderProse .prose-list TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="alder|AlderProse Border.prose-quote">
    <Setter Property="Margin" Value="0,16,0,0" />
    <Setter Property="Padding" Value="16,0,0,0" />
    <Setter Property="BorderThickness" Value="4,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlderBorder}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AlderMuted}" />
    <Setter Property="TextElement.FontStyle" Value="Italic" />
  </Style>
  <Style Selector="alder|AlderProse Border.prose-quote > TextBlock">
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="alder|AlderProse StackPanel.prose-list">
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="24,16,0,16" />
  </Style>
  <Style Selector="alder|AlderProse alder|AlderSeparator.prose-rule">
    <Setter Property="Margin" Value="0,32" />
  </Style>
  <Style Selector="alder|AlderProse Border.prose-pre, alder|AlderProse Border.prose-image">
    <Setter Property="Margin" Value="0,16" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="alder|AlderProse Border.prose-pre">
    <Setter Property="Background" Value="{DynamicResource AlderNeutral}" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="alder|AlderProse Border.prose-pre > :is(ScrollViewer)">
    <Setter Property="FlowDirection" Value="LeftToRight" />
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
  <Style Selector="alder|AlderProse Border.prose-pre :is(TextBlock)">
    <Setter Property="FontFamily" Value="{DynamicResource AlderTypographyMonoFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="22.75" />
    <Setter Property="FlowDirection" Value="LeftToRight" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="alder|AlderProse alder|AlderLink">
    <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
    <Setter Property="Underline" Value="Always" />
  </Style>
  <Style Selector="alder|AlderProse alder|AlderLink[Underline=Always] :is(TextBlock)">
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="Padding" Value="0,0,0,4" />
    <Setter Property="TextDecorations">
      <TextDecorationCollection>
        <TextDecoration Location="Underline" StrokeOffset="4" StrokeOffsetUnit="Pixel" />
      </TextDecorationCollection>
    </Setter>
  </Style>
  <Style Selector="alder|AlderProse alder|AlderLink[Underline=Always] /template/ Border#UnderlineGap,
                   alder|AlderProse alder|AlderLink[Underline=Always] /template/ Border#UnderlineMark">
    <Setter Property="IsVisible" Value="False" />
  </Style>
</Styles>
