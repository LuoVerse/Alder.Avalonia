  <x:String x:Key="AlderText.AiApprove">Approve</x:String>
  <x:String x:Key="AlderText.AiReject">Reject</x:String>
  <x:String x:Key="AlderText.AiApproved">Approved</x:String>
  <x:String x:Key="AlderText.AiRejected">Rejected</x:String>
  <x:String x:Key="AlderText.AiAsk">Ask anything</x:String>
  <x:String x:Key="AlderText.AiSend">Send message</x:String>
  <x:String x:Key="AlderText.AiStop">Stop generating</x:String>
  <x:String x:Key="AlderText.AiAttach">Attach files</x:String>
  <x:String x:Key="AlderText.AiRemove">Remove attachment</x:String>
  <x:String x:Key="AlderText.AiCopy">Copy</x:String>
  <x:String x:Key="AlderText.AiCopyCode">Copy code</x:String>
  <x:String x:Key="AlderText.AiJump">Scroll to bottom</x:String>
  <x:String x:Key="AlderText.AiConversation">Conversation</x:String>
