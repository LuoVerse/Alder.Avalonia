  <StreamGeometry x:Key="AlderAiThumbUp">F0 M1 7h3v8H1z M5 7l3.6-5.8c.45-.75 1.5-.65 2 .1.5.7.5 1.6.3 2.4l-.55 2.1h3.1c1.45 0 2.4 1.3 2.1 2.65l-1.15 4.9c-.2.9-1 1.65-2 1.65H5z M6.3 7.4v6.3h6.15c.3 0 .64-.2.72-.55l1.15-4.9c.15-.65-.22-1.1-.83-1.1H8.65l1-3.85c.13-.4.14-.85.03-1.15z</StreamGeometry>
