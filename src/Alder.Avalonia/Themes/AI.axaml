  <x:String x:Key="AlderText.AiFaster">Faster</x:String>
  <x:String x:Key="AlderText.AiModels">Models</x:String>
  <x:String x:Key="AlderText.AiModelSearch">Search models</x:String>
  <x:String x:Key="AlderText.AiNoModels">No matching models</x:String>
