  <ControlTheme x:Key="{x:Type alder:AlderPathIcon}" TargetType="alder:AlderPathIcon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" Stretch="Uniform" />
          </Viewbox>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="AlderFittedPathIconTheme" TargetType="PathIcon">
    <Setter Property="Template">
      <ControlTemplate>
        <alder:AlderFittedIcon Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}"
                              Margin="{TemplateBinding Padding}" IsHitTestVisible="False" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="AlderIcon16Theme" TargetType="PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Stretch="Uniform" IsHitTestVisible="False">
          <Path Width="16" Height="16" Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" Stretch="None" />
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
