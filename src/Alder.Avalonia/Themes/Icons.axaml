<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alder="using:Alder.Avalonia.Controls"
                    xmlns:media="using:Avalonia.Media">
  <ControlTheme x:Key="{x:Type alder:AlderIconPresenter}" TargetType="alder:AlderIconPresenter">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Stretch="Uniform">
          <ContentPresenter Content="{TemplateBinding PresentedContent}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}">
            <ContentPresenter.DataTemplates>
              <DataTemplate DataType="media:Geometry" x:DataType="media:Geometry">
                <alder:AlderPathIcon Classes="alder-icon-vector" Data="{CompiledBinding}"
                                     Width="{CompiledBinding $parent[alder:AlderIconPresenter].Width}"
                                     Height="{CompiledBinding $parent[alder:AlderIconPresenter].Height}"
                                     Theme="{CompiledBinding $parent[alder:AlderIconPresenter].VectorTheme, Converter={x:Static alder:AlderIconPresenter.OptionalVectorTheme}}" />
              </DataTemplate>
            </ContentPresenter.DataTemplates>
          </ContentPresenter>
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
