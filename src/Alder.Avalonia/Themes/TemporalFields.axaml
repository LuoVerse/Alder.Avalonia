<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alder="using:Alder.Avalonia.Controls">
  <ControlTheme x:Key="AlderTemporalSegmentTheme" TargetType="Button">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="FontFeatures" Value="tnum" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.placeholder"><Setter Property="Foreground" Value="{DynamicResource AlderMuted}" /></Style>
    <Style Selector="^:focus"><Setter Property="Background" Value="{DynamicResource AlderSoft}" /><Setter Property="Foreground" Value="{DynamicResource AlderSoftInk}" /></Style>
    <Style Selector="^.invalid"><Setter Property="Foreground" Value="{DynamicResource AlderDangerInk}" /></Style>
    <Style Selector="^.invalid:focus"><Setter Property="Background" Value="{DynamicResource AlderDangerSoft}" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="AlderTemporalInputTheme" TargetType="alder:AlderTemporalInput">
    <Setter Property="Height" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource AlderSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
    <Setter Property="AutomationProperties.ControlTypeOverride" Value="Group" />
    <Style Selector="^[FullWidth=True]"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style Selector="^[Variant=Secondary]"><Setter Property="Background" Value="{DynamicResource AlderNeutral}" /></Style>
    <Style Selector="^ /template/ Border#FieldSurface">
      <Setter Property="BoxShadow" Value="{DynamicResource AlderFieldShadow}" />
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.15" Easing="0.25,0.1,0.25,1" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^[Variant=Secondary] /template/ Border#FieldSurface"><Setter Property="BoxShadow" Value="none" /></Style>
    <Style Selector="^:pointerover:not(:focus-within):not(:disabled):not(:alder-invalid) /template/ Border#FieldSurface">
      <Setter Property="Background" Value="{DynamicResource AlderInputHover}" />
    </Style>
    <Style Selector="^[Variant=Secondary]:pointerover:not(:focus-within):not(:disabled):not(:alder-invalid) /template/ Border#FieldSurface">
      <Setter Property="Background" Value="{DynamicResource AlderNeutralHover}" />
    </Style>
    <Style Selector="^ /template/ alder|InputFocusRing#FieldRing">
      <Setter Property="BoxShadow" Value="0 0 0 0 #000485F7" />
      <Setter Property="Transitions">
        <Transitions><BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" Easing="0,0,0.2,1" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^:focus-within /template/ alder|InputFocusRing#FieldRing"><Setter Property="BoxShadow" Value="{DynamicResource AlderFocusShadow}" /></Style>
    <Style Selector="^:alder-invalid /template/ alder|InputFocusRing#FieldRing"><Setter Property="BoxShadow" Value="{DynamicResource AlderFieldInvalidOutline}" /></Style>
    <Style Selector="^:alder-invalid:focus-within /template/ alder|InputFocusRing#FieldRing"><Setter Property="BoxShadow" Value="{DynamicResource AlderFieldInvalidRing}" /></Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    <Style Selector="^[(alder|AlderMotion.Reduced)=True] /template/ Border#FieldSurface,
                     ^[(alder|AlderMotion.Reduced)=True] /template/ alder|InputFocusRing#FieldRing">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="AlderTemporalFieldTheme" TargetType="alder:AlderTemporalField" BasedOn="{StaticResource AlderTemporalInputTheme}">
    <Setter Property="MinWidth" Value="168" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="FieldSurface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{TemplateBinding Padding}">
              <ContentPresenter Name="Prefix" Content="{TemplateBinding Prefix}" VerticalContentAlignment="Center" />
              <alder:AlderScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsScrollChainingEnabled="True">
                <StackPanel Name="PART_Segments" Orientation="Horizontal" VerticalAlignment="Center" />
              </alder:AlderScrollViewer>
              <ContentPresenter Name="Suffix" Grid.Column="2" Content="{TemplateBinding Suffix}" VerticalContentAlignment="Center" />
            </Grid>
          </Border>
          <alder:InputFocusRing Name="FieldRing" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^ /template/ ContentPresenter#Prefix:not(:empty)"><Setter Property="Margin" Value="0,0,6,0" /></Style>
    <Style Selector="^ /template/ ContentPresenter#Suffix:not(:empty)"><Setter Property="Margin" Value="6,0,0,0" /></Style>
    <Style Selector="^.range-endpoint">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.range-endpoint /template/ Border#FieldSurface, ^.range-endpoint:pointerover /template/ Border#FieldSurface">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BoxShadow" Value="none" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="^.range-endpoint /template/ alder|InputFocusRing#FieldRing"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^.range-endpoint:disabled"><Setter Property="Opacity" Value="1" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type alder:AlderDateField}" TargetType="alder:AlderDateField" BasedOn="{StaticResource AlderTemporalFieldTheme}" />
  <ControlTheme x:Key="{x:Type alder:AlderTimeField}" TargetType="alder:AlderTimeField" BasedOn="{StaticResource AlderTemporalFieldTheme}" />
</ResourceDictionary>
