<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alder="using:Alder.Avalonia.Controls"
                    xmlns:media="using:Avalonia.Media">
  <ControlTheme x:Key="AlderExpandableTabItemTheme" TargetType="TabItem">
    <Setter Property="Height" Value="36" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource AlderMuted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="18">
          <Grid>
            <alder:AlderExpandableTabHeader Name="ExpandableHeader">
              <ContentPresenter Content="{TemplateBinding Icon}" ContentTemplate="{TemplateBinding IconTemplate}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <ContentPresenter.DataTemplates>
                  <DataTemplate DataType="media:Geometry" x:DataType="media:Geometry">
                    <alder:AlderPathIcon Width="16" Height="16" Data="{CompiledBinding}" />
                  </DataTemplate>
                </ContentPresenter.DataTemplates>
              </ContentPresenter>
              <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}" RecognizesAccessKey="True"
                                VerticalContentAlignment="Center" />
            </alder:AlderExpandableTabHeader>
            <Border Name="FocusRing" BorderThickness="2" CornerRadius="18"
                    BorderBrush="{DynamicResource AlderAccent}" IsHitTestVisible="False" IsVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover:not(:disabled)">
      <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
      <Setter Property="Background" Value="{DynamicResource AlderNeutralHover}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource AlderInk}" />
      <Setter Property="Background" Value="{DynamicResource AlderNeutral}" />
    </Style>
    <Style Selector="^:selected /template/ alder|AlderExpandableTabHeader#ExpandableHeader">
      <Setter Property="IsExpanded" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type alder:AlderExpandableTabsContent}" TargetType="alder:AlderExpandableTabsContent">
    <Setter Property="PageTransition"><alder:AlderExpandableTabsTransition /></Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <ContentPresenter Name="PART_ContentPresenter" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top" RenderTransformOrigin="50%,0%" />
          <ContentPresenter Name="PART_ContentPresenter2" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top" RenderTransformOrigin="50%,0%" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type alder:AlderExpandableTabs}" TargetType="alder:AlderExpandableTabs">
    <Setter Property="Background" Value="{DynamicResource AlderSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AlderBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="TabStripPlacement" Value="Bottom" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource AlderExpandableTabItemTheme}" />
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><alder:AlderExpandableTabsRail UseLayoutRounding="False" /></ItemsPanelTemplate></Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <alder:AlderExpandableTabsShell Name="PART_ExpandableShell">
            <alder:AlderExpandableTabsViewport ClipToBounds="True" Padding="8,8,8,0">
              <alder:AlderExpandableTabsContent Name="PART_ExpandableContent" VerticalAlignment="Top" />
            </alder:AlderExpandableTabsViewport>
            <alder:AlderScrollViewer Padding="8" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </alder:AlderScrollViewer>
          </alder:AlderExpandableTabsShell>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
