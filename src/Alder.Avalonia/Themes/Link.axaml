<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:alder="using:Alder.Avalonia.Controls"
                    xmlns:conv="using:Avalonia.Data.Converters">
  <ControlTheme x:Key="{x:Type alder:AlderLink}" TargetType="alder:AlderLink">
    <Setter Property="Foreground" Value="{DynamicResource AlderSoftInk}" />
    <Setter Property="UnderlineBrush" Value="{DynamicResource AlderMuted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Background="Transparent">
          <DockPanel LastChildFill="True">
            <Viewbox Name="LinkIconBox" Width="12" Height="12" Margin="4,-4,0,0" DockPanel.Dock="Right"
                     IsHitTestVisible="False" Opacity="0.6"
                     IsVisible="{CompiledBinding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
              <alder:AlderIconPresenter Width="16" Height="16" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" />
            </Viewbox>
            <StackPanel VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" RecognizesAccessKey="True"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
              <Border Name="UnderlineGap" Height="{TemplateBinding UnderlineOffset}" IsHitTestVisible="False" />
              <Border Name="UnderlineMark" Height="{TemplateBinding UnderlineThickness}" CornerRadius="1"
                      Background="{TemplateBinding UnderlineBrush}" IsHitTestVisible="False" Opacity="0" />
            </StackPanel>
          </DockPanel>
          <Border Name="FocusRing" Margin="-3" CornerRadius="6" BorderThickness="2"
                  BorderBrush="{DynamicResource AlderInk}" IsHitTestVisible="False" IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[ShowExternalIcon=True]">
      <Setter Property="Icon" Value="{DynamicResource AlderIconArrowUpRight}" />
      <Style Selector="^ /template/ PathIcon"><Setter Property="FlowDirection" Value="LeftToRight" /></Style>
    </Style>
    <Style Selector="^[IconPlacement=Start] /template/ Viewbox#LinkIconBox">
      <Setter Property="DockPanel.Dock" Value="Left" />
      <Setter Property="Margin" Value="0,-4,4,0" />
    </Style>
    <Style Selector="^ /template/ Border#UnderlineMark, ^ /template/ Viewbox#LinkIconBox">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="^[(alder|AlderMotion.Reduced)=True] /template/ Border#UnderlineMark,
                     ^[(alder|AlderMotion.Reduced)=True] /template/ Viewbox#LinkIconBox">
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="^[Underline=Always] /template/ Border#UnderlineMark,
                     ^[Underline=Hover]:pointerover:not(:disabled) /template/ Border#UnderlineMark,
                     ^[Underline=Hover]:focus-visible /template/ Border#UnderlineMark">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^[Underline=Hover]:pressed /template/ Border#UnderlineMark, ^[Underline=Always]:pressed /template/ Border#UnderlineMark">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pointerover:not(:disabled) /template/ Viewbox#LinkIconBox,
                     ^:pressed /template/ Viewbox#LinkIconBox,
                     ^:focus-visible /template/ Viewbox#LinkIconBox">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^[Underline=Always]:focus-visible /template/ Border#FocusRing, ^[Underline=None]:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Style>
  </ControlTheme>
</ResourceDictionary>
